# Cloudflare Pages: every tasting has its own address, /t/<slug>/...
# The pages are built once under /tasting/ and served for any slug (200 = rewrite).
/t/:slug                  /t/:slug/                 301
/t/:slug/                 /tasting/                 200
/t/:slug/wines            /t/:slug/wines/           301
/t/:slug/wines/           /tasting/wines/           200
/t/:slug/wines/:id        /t/:slug/wines/:id/       301
/t/:slug/wines/:id/       /tasting/wine/            200
/t/:slug/cart             /t/:slug/cart/            301
/t/:slug/cart/            /tasting/cart/            200
/t/:slug/quiz             /t/:slug/quiz/            301
/t/:slug/quiz/            /tasting/quiz/            200
/t/:slug/chat             /t/:slug/chat/            301
/t/:slug/chat/            /tasting/chat/            200
/t/:slug/leaderboard      /t/:slug/leaderboard/     301
/t/:slug/leaderboard/     /tasting/leaderboard/     200
/t/:slug/admin            /t/:slug/admin/           301
/t/:slug/admin/           /admin/tasting/           200
/t/:slug/admin/:section   /t/:slug/admin/:section/  301
/t/:slug/admin/:section/  /admin/tasting/           200
# "My tastings" now lives on the home page (a rule, not a page with an inline script: the CSP blocks those)
/tastings                 /home/                    301
/tastings/                /home/                    301
# Superadmin: one tenant and its parts, /superadmin/tenants/<id>/<section>/
/superadmin/tenants/:id            /superadmin/tenants/:id/            301
/superadmin/tenants/:id/           /superadmin/tenant/                 200
/superadmin/tenants/:id/:section   /superadmin/tenants/:id/:section/   301
/superadmin/tenants/:id/:section/  /superadmin/tenant/                 200
# WIN-253: the host's account pages carry the account, /w/<account id>/<page>/ (the /admin/ pages, which read the
# account from the address; an old /admin/… address becomes the account's address in the page, after sign-in)
/w/:ws                    /w/:ws/                   301
/w/:ws/                   /admin/                   200
/w/:ws/wines              /w/:ws/wines/             301
/w/:ws/wines/*            /admin/wines/             200
/w/:ws/guests             /w/:ws/guests/            301
/w/:ws/guests/*           /admin/guests/            200
/w/:ws/tastings           /w/:ws/tastings/          301
/w/:ws/tastings/          /admin/tastings/          200
/w/:ws/account            /w/:ws/account/           301
/w/:ws/account/           /admin/account/           200
/w/:ws/help               /w/:ws/help/              301
/w/:ws/help/              /admin/help/              200
/w/:ws/news               /w/:ws/news/              301
/w/:ws/news/              /admin/news/              200
# Host admin: one wine in the library, /admin/wines/<country>/<region>/<appellation>/<name>/<vintage>/
# (served by the wines page, which finds the wine from the address)
/admin/wines/*            /admin/wines/              200
# Host admin: one guest in the library, /admin/guests/<name>/ (served by the guests page, which finds the guest from the address)
/admin/guests/*           /admin/guests/             200
# The Dev pages moved under superadmin (old bookmarks)
/dev/components           /superadmin/dev/components/   301
/dev/components/          /superadmin/dev/components/   301
/dev/maps                 /superadmin/dev/maps/         301
/dev/maps/                /superadmin/dev/maps/         301
/dev/personas             /superadmin/dev/components/   301
/dev/personas/            /superadmin/dev/components/   301
# The personas page is gone (the personas live in Confluence)
/superadmin/dev/personas  /superadmin/dev/components/   301
/superadmin/dev/personas/ /superadmin/dev/components/   301
# WIN-278: MobilePay moved to each tasting's settings; the old Payments page goes to the tastings
/admin/payments           /admin/tastings/           301
/admin/payments/          /admin/tastings/           301
