      "state": "translated",
      "value": "Skráningu er lokið. Hafðu samband við gestgjafann til að breyta svarinu."
     }
    }
   }
  },
  "guest.fullHint": {
   "localizations": {
    "da": {
     "stringUnit": {
      "state": "translated",
      "value": "Smagningen er fuld. Svarer du ja, kommer du på ventelisten."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "The tasting is full. If you say yes, you go on the waiting list."
     }
    },
    "is": {
     "stringUnit": {
      "state": "translated",
      "value": "Smökkunin er full. Ef þú segir já ferðu á biðlistann."
     }
    }
   }
  },
