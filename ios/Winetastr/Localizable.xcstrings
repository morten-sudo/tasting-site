      "value": "Skráningu er lokið. Hafðu samband við gestgjafann til að breyta svarinu."
     }
    }
   }
  },
  "guest.fullHint": {
   "localizations": {
    "da": {
     "stringUnit": {
      "state": "translated",
      "value": "Smagningen er fuld. Svarer du ja, kommer du på ventelisten."
     }
