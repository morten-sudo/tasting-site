  "login.lostHint": {
   "localizations": {
    "da": {
     "stringUnit": {
      "state": "translated",
      "value": "Kender vi ikke din e-mail, så log ind med dit invitationslink og tilføj den på din side. Har du mistet begge dele, så skriv til værten."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "If we don't know your email, sign in with your invitation link and add it on your page. If you have lost both, contact the host."
