  "guest.emailLead": {
   "localizations": {
    "da": {
     "stringUnit": {
      "state": "translated",
      "value": "Før du går videre, skal vi have din e-mail. Den bruges til at logge ind med en kode – fx hvis du skifter telefon."
     }
    },
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Before you continue, we need your email. You use it to sign in with a code – for example if you switch phones."
     }
    },
    "is": {
     "stringUnit": {
      "state": "translated",
      "value": "Áður en þú heldur áfram þurfum við netfangið þitt. Þú notar það til að skrá þig inn með kóða – t.d. ef þú skiptir um síma."
     }
    }
   }
  },
  "guest.yourEmail": {
   "localizations": {
