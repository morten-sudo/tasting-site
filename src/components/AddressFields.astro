---
// Country, street, house number, postal code and city for a tasting. `prefix` makes the ids unique (e.g. "wz" → wz-street).
import { COUNTRIES } from '../lib/countries';
const { prefix } = Astro.props as { prefix: string };
---
<div class="address-fields" data-address={prefix}>
  <div class="addr-country">
    <label for={`${prefix}-country`} data-i18n="address.country">Country</label>
    <select id={`${prefix}-country`} autocomplete="country">
      {COUNTRIES.map((c) => <option value={c.code}>{c.name}</option>)}
    </select>
  </div>
  <div class="addr-row addr-street">
    <div>
      <label for={`${prefix}-street`} data-i18n="address.street">Street</label>
      <input id={`${prefix}-street`} type="text" autocomplete="address-line1" />
    </div>
    <div>
      <label for={`${prefix}-number`} data-i18n="address.number">No.</label>
      <input id={`${prefix}-number`} type="text" autocomplete="off" />
    </div>
  </div>
  <div class="addr-row addr-city">
    <div>
      <label for={`${prefix}-postal`} data-i18n="address.postalCode">Postal code</label>
      <input id={`${prefix}-postal`} type="text" inputmode="numeric" autocomplete="postal-code" maxlength="10" placeholder="2840" />
    </div>
    <div>
      <label for={`${prefix}-city`} data-i18n="address.city">City</label>
      <input id={`${prefix}-city`} type="text" autocomplete="address-level2" />
    </div>
  </div>
  <p id={`${prefix}-postal-hint`} class="addr-hint" hidden aria-live="polite"></p>
</div>

<style>
  .addr-country { display: flex; flex-direction: column; }
  .addr-hint { margin: 0.2rem 0 0; font-size: 0.85rem; color: var(--muted); }
  .addr-row { display: grid; gap: 0.75rem; }
  .addr-street { grid-template-columns: minmax(0, 1fr) 5.5rem; }
  .addr-city { grid-template-columns: 7.5rem minmax(0, 1fr); }
  .addr-row > div { min-width: 0; display: flex; flex-direction: column; }
  .addr-row input { width: 100%; min-width: 0; box-sizing: border-box; }
</style>
