---
// Component 14 – address: country, street, house number, postal code and city for a tasting (src/lib/address.ts).
// `prefix` makes the ids unique (e.g. "wz" → wz-street). The country (and a state where one is needed) is the one
// dropdown (7) with a search field. Styles: src/styles/components.css.
import Dropdown from './ui/Dropdown.astro';
import { COUNTRIES, DEFAULT_COUNTRY } from '../lib/countries';
const { prefix } = Astro.props as { prefix: string };
---
<div class="address-fields" data-address={prefix}>
  <div class="addr-country">
    <label for={`${prefix}-country-btn`} data-i18n="address.country">Country</label>
    <Dropdown id={`${prefix}-country`} options={COUNTRIES.map((c) => ({ value: c.code, label: c.name }))} value={DEFAULT_COUNTRY} search />
  </div>
  <div class="addr-row addr-street">
    <div>
      <label for={`${prefix}-street`} data-i18n="address.street">Street</label>
      <input class="input" id={`${prefix}-street`} type="text" autocomplete="address-line1" />
    </div>
    <div>
      <label for={`${prefix}-number`} data-i18n="address.number">No.</label>
      <input class="input" id={`${prefix}-number`} type="text" autocomplete="off" />
    </div>
  </div>
  <div class="addr-row addr-city">
    <div>
      <label for={`${prefix}-postal`} data-i18n="address.postalCode">Postal code</label>
      <input class="input" id={`${prefix}-postal`} type="text" inputmode="numeric" autocomplete="postal-code" maxlength="10" placeholder="2840" />
    </div>
    <div>
      <label for={`${prefix}-city`} data-i18n="address.city">City</label>
      <input class="input" id={`${prefix}-city`} type="text" autocomplete="address-level2" />
    </div>
  </div>
  <p id={`${prefix}-postal-hint`} class="addr-hint" hidden aria-live="polite"></p>
  <!-- State / province: only for countries whose addresses need one (USA, Canada) -->
  <div id={`${prefix}-region-box`} class="addr-region" hidden>
    <label for={`${prefix}-region-btn`} data-i18n="address.region">State / province</label>
    <Dropdown id={`${prefix}-region`} search />
  </div>
</div>
