---
import CloseButton from './ui/CloseButton.astro';
import EmptyState from './ui/EmptyState.astro';
import Loading from './ui/Loading.astro';
// Superadmin shell: its own menu on the left (a drawer on phones) – Tenants (with the open
// tenant's parts underneath), Log (all accounts), Maps and GDPR. Uses the same look as the host's admin menu.
interface Props { active?: 'tenants' | 'log' | 'usage' | 'maps' | 'gdpr' }
const { active } = Astro.props;
const cur = (key: string) => (active === key ? 'page' : undefined);
---
<div class="admin-shell super-shell">
  <button id="side-open" class="side-open" type="button" aria-controls="admin-side" aria-expanded="false" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    <span data-i18n="adminNav.menu">Menu</span>
  </button>
  <div id="side-backdrop" class="side-backdrop" hidden></div>

  <aside id="admin-side" class="admin-side" data-active={active} hidden>
    <div class="side-head">
      <span class="side-kicker">Superadmin</span>
      <CloseButton id="side-close" />
    </div>
    <nav aria-label="Superadmin">
      <a class="side-group side-home" href="/superadmin/" aria-current={cur('tenants')}><svg class="side-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21V8l9-5 9 5v13" /><path d="M9 21v-6h6v6" /></svg><span data-i18n="super.tenantsNav">Tenants</span></a>
      <!-- The open tenant and its parts (filled in by the tenant page) -->
      <ul id="side-tenant" class="side-list"></ul>
      <a class="side-group" href="/superadmin/log/" aria-current={cur('log')}><svg class="side-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12" /><circle cx="4" cy="6" r="1" /><circle cx="4" cy="12" r="1" /><circle cx="4" cy="18" r="1" /></svg><span data-i18n="super.log">Log</span></a>
      <a class="side-group" href="/superadmin/usage/" aria-current={cur('usage')}><svg class="side-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg><span data-i18n="usage.title">Usage</span></a>
      <a class="side-group" href="/superadmin/maps/" aria-current={cur('maps')}><svg class="side-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2z" /><path d="M9 4v14M15 6v14" /></svg><span data-i18n="super.mapsTitle">Maps</span></a>
      <a class="side-group" href="/superadmin/gdpr/" aria-current={cur('gdpr')}><svg class="side-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6z" /></svg><span>GDPR</span></a>
    </nav>
    <div class="side-foot">
      <span id="me" class="side-me"></span>
      <a class="side-back" href="/admin/" data-i18n="super.toHostAdmin">To host admin</a>
      <button id="side-logout" class="text-btn small" type="button" data-i18n="nav.signOut">Sign out</button>
    </div>
  </aside>

  <div class="admin-content">
    <Loading />
    <EmptyState id="denied" icon="user" title="super.denied" hidden>
      <a class="btn small" href="/admin/" data-i18n="super.toHostAdmin">To host admin</a>
    </EmptyState>
    <div id="super-main" hidden>
      <slot />
    </div>
  </div>
</div>
