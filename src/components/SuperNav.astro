---
import EmptyState from './ui/EmptyState.astro';
import SideMenu, { type SideGroup } from './ui/SideMenu.astro';
// The superadmin's shell: the one side menu (SideMenu.astro) with its own groups – Tenants (with the open tenant's
// parts underneath, filled in by the tenant page), Log, Usage, Pictures from links, Maps, GDPR and Dev (components
// and maps – for developers and Morten, the superadmin only).
interface Props { active?: 'tenants' | 'log' | 'usage' | 'pictures' | 'maps' | 'gdpr' | 'dev-components' | 'dev-maps' }
const { active } = Astro.props;
const groups: SideGroup[] = [
  { icon: 'home', label: 'super.tenantsNav', href: '/superadmin/', current: active === 'tenants', listId: 'side-tenant' },
  { icon: 'list', label: 'super.log', href: '/superadmin/log/', current: active === 'log' },
  { icon: 'chart', label: 'usage.title', href: '/superadmin/usage/', current: active === 'usage' },
  { icon: 'image', label: 'pics.title', href: '/superadmin/pictures/', current: active === 'pictures' },
  { icon: 'map', label: 'super.mapsTitle', href: '/superadmin/maps/', current: active === 'maps' },
  { icon: 'shield', label: 'GDPR', href: '/superadmin/gdpr/', current: active === 'gdpr' },
  { icon: 'grid', label: 'Dev', links: [
    { href: '/superadmin/dev/components/', label: 'dev.components', current: active === 'dev-components' },
    { href: '/superadmin/dev/maps/', label: 'super.mapsTitle', current: active === 'dev-maps' }] },
];
---
<SideMenu label="Superadmin" groups={groups} class="super-shell">
  <a slot="foot" class="text-btn small" href="/admin/" data-i18n="super.toHostAdmin">To host admin</a>
  <EmptyState id="denied" icon="user" title="super.denied" hidden>
    <a class="btn small" href="/admin/" data-i18n="super.toHostAdmin">To host admin</a>
  </EmptyState>
  <div id="super-main" hidden>
    <slot />
  </div>
</SideMenu>
