---
import Icon from './ui/Icon.astro';
// Component 13 – date and time: the date (our own calendar, see datetime.ts), start and end time, with quick picks
// for the start. Styles: src/styles/components.css.
// `prefix` makes the ids unique (e.g. "wz" → wz-date).
const { prefix } = Astro.props as { prefix: string };
const quick = ['18:00', '18:30', '19:00', '19:30', '20:00'];
---
<div class="dt-row">
  <div class="dt-date">
    <label for={`${prefix}-date-show`} data-i18n="admin.date">Date</label>
    <button id={`${prefix}-date-show`} class="input dt-field empty" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls={`${prefix}-cal`}>
      <Icon name="calendar" />
      <span data-i18n="dt.choose">Choose a date</span>
    </button>
    <input id={`${prefix}-date`} type="hidden" />
    <div id={`${prefix}-cal`} class="dt-cal" role="dialog" aria-label="Calendar" data-i18n-attr="aria-label=dt.calendar" hidden></div>
  </div>
  <div class="dt-times">
    <div>
      <label for={`${prefix}-time`} data-i18n="dt.start">Starts</label>
      <input id={`${prefix}-time`} class="input dt-time" type="text" inputmode="numeric" placeholder="19:00" autocomplete="off" maxlength="5" />
    </div>
    <div>
      <label for={`${prefix}-end`}><span data-i18n="dt.end">Ends</span> <span class="opt" data-i18n="dt.optional">(optional)</span></label>
      <input id={`${prefix}-end`} class="input dt-time" type="text" inputmode="numeric" placeholder="23:00" autocomplete="off" maxlength="5" />
    </div>
  </div>
</div>
<div id={`${prefix}-quick`} class="dt-quick" aria-label="Start time" data-i18n-attr="aria-label=dt.start">
  {quick.map((q) => <button type="button" class="btn small secondary" data-time={q}>{q}</button>)}
</div>
