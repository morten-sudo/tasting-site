---
import CloseButton from './ui/CloseButton.astro';
// New tasting: one form with the details and MobilePay (empty and off, WIN-278). Wines and
// guests are added afterwards on the tasting's page,
// where a "Get started" card leads to each of them. A centred window on larger screens, a bottom sheet on phones –
// with the side panel's head (title, ×) and foot (the primary button first, then Cancel).
import AddressFields from './AddressFields.astro';
import DateTimeFields from './DateTimeFields.astro';
import MobilePayFields from './MobilePayFields.astro';
---
<dialog id="wizard" class="wizard" aria-labelledby="wz-title">
  <div class="sh-grab" aria-hidden="true"></div>
  <div class="sh-head">
    <h2 id="wz-title" data-i18n="admin.newTasting">New tasting</h2>
    <CloseButton id="wz-close" />
  </div>

  <!-- The tasting's details; everything else is added on its page afterwards -->
  <div class="sh-body tasting-form">
    <p class="help" data-i18n="wizard.createNote">Only the title is needed. Wines and guests you add afterwards, on the tasting's own page.</p>
    <label for="wz-title-input"><span data-i18n="admin.title">Title</span> <span class="req" aria-hidden="true">*</span></label>
    <input class="input" id="wz-title-input" type="text" placeholder="E.g. Port wine evening" data-i18n-attr="placeholder=admin.titlePlaceholder" required aria-required="true" />
    <DateTimeFields prefix="wz" />
    <label for="wz-max"><span data-i18n="wizard.maxGuests">Max. number of guests</span> <span class="opt" data-i18n="dt.optional">(optional)</span></label>
    <div class="affix w-num u-long"><input id="wz-max" class="input" type="text" inputmode="numeric" autocomplete="off" /><span class="unit" data-i18n="set.guestsUnit">guests</span></div>
    <p class="help" data-i18n="set.maxHint">Leave it empty for no limit. When it is full, guests who say yes go on a waiting list – and move up by themselves when someone says no.</p>
    <AddressFields prefix="wz" />
    <label for="wz-intro"><span data-i18n="admin.intro">Introduction</span> <span class="opt" data-i18n="admin.introHint">(what is going to happen – shown to your guests)</span></label>
    <textarea class="input" id="wz-intro" rows="4" maxlength="4000" placeholder="E.g. We start with a glass of white port…" data-i18n-attr="placeholder=admin.introPlaceholder"></textarea>
    <!-- MobilePay: empty and off – the host fills it in for this tasting -->
    <MobilePayFields prefix="wz" />
  </div>

  <div class="sh-foot">
    <div class="actions">
      <button id="wz-create" class="btn" type="button" data-i18n="wizard.create">Create tasting</button>
      <button id="wz-cancel" class="btn secondary" type="button" data-i18n="common.cancel">Cancel</button>
    </div>
  </div>
</dialog>
