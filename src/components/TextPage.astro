---
// A plain text page (About, Contact, Privacy, Terms, Not found): a title, translated body text and an optional slot
// (e.g. a button) after it.
import Base from '../layouts/Base.astro';
import PageHeader from './ui/PageHeader.astro';
import { en } from '../i18n/en';
interface Props { title: keyof typeof en; body: keyof typeof en; updated?: keyof typeof en }
const { title, body, updated } = Astro.props;
---
<Base title={title}>
  <article class="wrap text-page">
    <PageHeader title={title} lead={updated} />
    <div class="text-body" data-i18n-html={body} set:html={en[body]} />
    <slot />
  </article>
</Base>

<style>
  .text-page { max-width: 44rem; padding-top: 2.5rem; padding-bottom: 1rem; }
  .text-body { line-height: 1.65; }
  .text-body :global(.lead) { font-size: 1.15rem; }
  /* Headings inside the text: the sub-heading scale (h3) */
  .text-body :global(h2) { font: 600 1rem/1.3 var(--body); margin: 2rem 0 0.5rem; }
  .text-body :global(ul) { padding-left: 1.2rem; }
  .text-body :global(li) { margin-bottom: 0.4rem; }
  .text-body :global(.contact-mail) { font-size: 1.3rem; margin: 1.25rem 0; }
  .text-body :global(a) { color: var(--amber); }
  .text-page > :global(.btn) { margin-top: 1rem; }
  .text-page :global(.ph) { margin-bottom: 1rem; }
</style>
