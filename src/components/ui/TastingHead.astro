---
// Component 57 – the head of a tasting's guest pages (/t/<slug>/…), the same as the admin's: chips over the name
// (slot "chips": the countdown and the guest's answer on the tasting page), the tasting's name with – for its hosts –
// the way to its admin in the corner (the gear), and its tabs (the one tab bar) under it. Base.astro fills it in.
import AdminLink from './AdminLink.astro';
import Tabs from './Tabs.astro';
import PageHeader from './PageHeader.astro';
interface Props { path: string }
const { path } = Astro.props;
const tab = path === '/tasting/' || path === '/tasting' ? 'tasting' : path.startsWith('/tasting/wine') ? 'wines'
  : path.startsWith('/tasting/quiz') ? 'quiz' : path.startsWith('/tasting/chat') ? 'chat' : undefined;
---
<div id="t-head" class="wrap t-head">
  {Astro.slots.has('chips') && <slot name="chips" />}
  <PageHeader id="t-title" class="title-row">
    <!-- The host's way into this tasting's admin: the gear (opens in a new tab) -->
    <AdminLink slot="actions" id="t-admin" class="t-admin tip-below" href="/admin/" target="_blank" rel="noopener" data-tpath="admin/" what="nav.thisTasting" hidden />
  </PageHeader>
  <Tabs id="t-tabs" label="Tasting menu" labelKey="nav.tastingMenu" current={tab} items={[
    { id: 'tasting', label: 'nav.tasting', href: '/home/', attrs: { 'data-tpath': '' } },
    { id: 'wines', label: 'nav.wines', href: '/home/', attrs: { 'data-tpath': 'wines/' } },
    // Only when the tasting has a quiz (shown by the script)
    { id: 'quiz', label: 'nav.quiz', href: '/home/', hidden: tab !== 'quiz', attrs: { 'data-tpath': 'quiz/', id: 't-quiz-tab' } },
    { id: 'chat', label: 'nav.chat', href: '/home/', attrs: { 'data-tpath': 'chat/' } },
  ]} />
</div>
