---
// Component 50 – the one cart bar: at the bottom of the wine list and a wine's page while the cart has bottles –
// how many and what they cost, and the way to the cart. initCartBar() in src/lib/cart-bar.ts keeps it up to date.
---
<div id="cartbar" class="cartbar" hidden>
  <span><b id="cartbar-count"></b><small id="cartbar-total"></small></span>
  <a class="btn small on-photo" href="/home/" data-tpath="cart/" data-i18n="wines.toCart">Go to cart</a>
</div>
