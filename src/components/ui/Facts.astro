---
// Component 22 – the one facts list (label and value side by side), static: the script fills each value with
// setFact() from src/lib/ui/facts.ts, which also hides a pair without a value. facts() builds the same list in TS.
//   items: { label (i18n key), id (of the value), icon?, class? }
import { en } from '../../i18n/en';
import { ICONS, type IconName } from '../../lib/ui/icons';
interface Item { label: string; id: string; icon?: IconName; class?: string }
interface Props { items: Item[]; id?: string; class?: string }
const { items, id, class: cls } = Astro.props;
const tr = (k: string) => (en as Record<string, string>)[k] ?? k;
---
<dl id={id} class:list={['facts', cls]}>
  {items.map((it) => <Fragment>
    <dt>{it.icon && <svg class="i" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[it.icon]} />}<span data-i18n={it.label}>{tr(it.label)}</span></dt>
    <dd id={it.id} class={it.class}></dd>
  </Fragment>)}
</dl>
