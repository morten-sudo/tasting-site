---
// Admin shell shared by all host pages: the menu on the left (a drawer on phones),
// the signed-in line and the "not a host" notice. Page content goes in the slot.
interface Props { active?: 'overview' | 'tastings' | 'wines' | 'guests' | 'payments' }
const { active } = Astro.props;
const cur = (key: string) => (active === key ? 'page' : undefined);
---
<div class="admin-shell">
  <p id="not-host" class="message error" hidden>
    <span data-i18n-html="admin.notHost">You are signed in but not registered as a host. <a href="/signup/">Become a host</a></span> ·
    <button id="logout2" class="link-btn" type="button" data-i18n="nav.signOut">Sign out</button>
  </p>

  <!-- Phones: a menu button that opens the menu as a drawer from the left -->
  <button id="side-open" class="side-open" type="button" aria-controls="admin-side" aria-expanded="false" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    <span id="side-where" data-i18n="adminNav.menu">Menu</span>
  </button>
  <div id="side-backdrop" class="side-backdrop" hidden></div>

  <aside id="admin-side" class="admin-side" data-active={active} hidden>
    <div class="side-head">
      <span class="side-kicker">Admin</span>
      <button id="side-close" class="side-close" type="button" aria-label="Close" data-i18n-attr="aria-label=admin.close">×</button>
    </div>
    <nav aria-label="Admin">
      <a class="side-group side-home" href="/admin/" aria-current={cur('overview')}><svg class="side-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1.5" /><rect x="13" y="4" width="7" height="7" rx="1.5" /><rect x="4" y="13" width="7" height="7" rx="1.5" /><rect x="13" y="13" width="7" height="7" rx="1.5" /></svg><span data-i18n="adminNav.overview">Overview</span></a>
      <a class="side-group" href="/admin/tastings/" aria-current={cur('tastings')}><svg class="side-icon" viewBox="0 0 100 100" aria-hidden="true"><defs><clipPath id="side-bowl"><path transform="translate(4.3 4.3) rotate(-45 50 50)" d="M37 14 C30 21 27 30 27.5 37 C28.5 50 39 58 50 58 C61 58 71.5 50 72.5 37 C73 30 70 21 63 14 Z" /></clipPath></defs><rect x="0" y="43" width="100" height="100" fill="currentColor" stroke="none" clip-path="url(#side-bowl)" /><g transform="translate(4.3 4.3) rotate(-45 50 50)" stroke-width="7"><path d="M37 14 C30 21 27 30 27.5 37 C28.5 50 39 58 50 58 C61 58 71.5 50 72.5 37 C73 30 70 21 63 14 Z" /><path d="M50 58 V79 M38 80 H62" /></g></svg><span data-i18n="adminNav.tastings">Tastings</span></a>
      <ul id="side-tastings" class="side-list"></ul>
      <details id="side-past" class="side-past" hidden>
        <summary data-i18n="adminNav.past">Past</summary>
        <ul id="side-past-list" class="side-list"></ul>
      </details>
      <a class="side-new" href="/admin/tastings/?new=1"><span aria-hidden="true">+ </span><span data-i18n="admin.newTasting">New tasting</span></a>

      <p class="side-group"><svg class="side-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H10a2 2 0 0 1 2 2v14a1.5 1.5 0 0 0-1.5-1.5H4z" /><path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H14a2 2 0 0 0-2 2v14a1.5 1.5 0 0 1 1.5-1.5H20z" /></svg><span data-i18n="adminNav.library">Library</span></p>
      <ul class="side-list">
        <li><a href="/admin/wines/" aria-current={cur('wines')} data-i18n="adminNav.wines">Wines</a></li>
        <li><a href="/admin/guests/" aria-current={cur('guests')} data-i18n="adminNav.guests">Guests</a></li>
      </ul>

      <p class="side-group"><svg class="side-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" /></svg><span data-i18n="adminNav.settings">Settings</span></p>
      <ul class="side-list">
        <li><a href="/admin/payments/" aria-current={cur('payments')} data-i18n="adminNav.payments">Payments</a></li>
        <li id="side-super" hidden><a href="/superadmin/" data-i18n="page.superadmin">Superadmin</a></li>
      </ul>
    </nav>
    <div class="side-foot">
      <span id="me" class="side-me"></span>
      <button id="side-logout" class="link-btn" type="button" data-i18n="nav.signOut">Sign out</button>
    </div>
  </aside>

  <div class="admin-content">
    <slot />
  </div>
</div>
