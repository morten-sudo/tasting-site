---
// "New wine" in one line above a wine list – see src/lib/wine-quick-add.ts. The line is hidden until the
// page's "+ New wine" button opens it; the cards below it show wines being read and saved.
---
<div class="qa">
  <div id="qa-bar" class="qa-bar" hidden>
    <div id="qa-row" class="qa-row">
      <label for="qa-input" class="visually-hidden" data-i18n="qa.label">Name, link or photo of the wine</label>
      <div class="qa-field">
        <span id="qa-attached" class="qa-attached" hidden>
          <span id="qa-attached-text"></span>
          <button id="qa-attached-x" type="button" aria-label="Remove" data-i18n-attr="aria-label=qa.dismiss">×</button>
        </span>
        <input id="qa-input" type="text" autocomplete="off" enterkeyhint="go"
          placeholder="Name of the wine, or paste a link" data-i18n-attr="placeholder=qa.placeholder" />
      </div>
      <button id="qa-photo" class="btn small ghost qa-photo" type="button">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.5-2.5h7L17 8h3v11H4z" /><circle cx="12" cy="13.5" r="3.5" /></svg>
        <span data-i18n="qa.photoBtn">Photo</span>
      </button>
      <input id="qa-file" class="visually-hidden" type="file" accept="image/*" tabindex="-1" />
      <button id="qa-go" class="btn small" type="button" data-i18n="admin.add">Add</button>
      <button id="qa-close" class="sheet-close qa-close" type="button" aria-label="Close" data-i18n-attr="aria-label=admin.close">×</button>
    </div>
    <p class="qa-hint" data-i18n="qa.hint">A link from a web shop or a photo of the label fills in the rest. You can also drop a picture here.</p>
    <ul id="qa-hits" class="qa-hits" hidden></ul>
  </div>
  <ul id="qa-jobs" class="qa-jobs" aria-live="polite"></ul>
</div>
