---
import '../styles/global.css';
import { SITE_NAME } from '../lib/config';
import { en } from '../i18n/en';

// title: a translation key for the page title
// tasting: the page lives under /t/<slug>/ and gets the tasting's menu
interface Props { title?: keyof typeof en; hero?: boolean; tasting?: boolean }
const { title, hero = false, tasting = false } = Astro.props;
const pageTitle = title ? `${en[title]} – ${SITE_NAME}` : SITE_NAME;
const path = Astro.url.pathname;
const LOGO = `<svg class="logo" viewBox="0 0 100 100" width="30" height="30" aria-hidden="true"><defs><clipPath id="logo-bowl"><path transform="translate(4.3 4.3) rotate(-45 50 50)" d="M37 14 C30 21 27 30 27.5 37 C28.5 50 39 58 50 58 C61 58 71.5 50 72.5 37 C73 30 70 21 63 14 Z" /></clipPath></defs><rect width="100" height="100" rx="22" fill="#6e0f1f" /><g transform="translate(50 50) scale(0.84) translate(-50 -50)"><rect x="0" y="43" width="100" height="100" fill="#fff" clip-path="url(#logo-bowl)" /><g transform="translate(4.3 4.3) rotate(-45 50 50)" fill="none" stroke="#fff" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round"><path d="M37 14 C30 21 27 30 27.5 37 C28.5 50 39 58 50 58 C61 58 71.5 50 72.5 37 C73 30 70 21 63 14 Z" /><path d="M50 58 V79 M38 80 H62" /></g></g></svg>`;
---
<!doctype html>
<html lang="en" class="i18n-pending">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <!-- Hidden until the translations are applied; shown anyway after 2 s -->
    <style is:inline>html.i18n-pending body { visibility: hidden; }</style>
    <script is:inline>setTimeout(function () { document.documentElement.classList.remove('i18n-pending'); }, 2000);</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500&display=swap"
    />
  </head>
  <body class:list={{ 'has-hero': hero }} data-tasting={tasting ? '1' : undefined} data-title={title}>
    <header class="site-header">
      <div class="wrap header-inner">
      <div class="top-row">
        <div class="brand">
          <Fragment set:html={LOGO} />
          {tasting
            ? <a href="/tastings/" data-tpath="" class="mark" id="mark">{SITE_NAME}</a>
            : <a href="/" class="mark" id="mark">{SITE_NAME}</a>}
        </div>
        <div class="tools">
          <div class="lang-pick">
            <button id="lang-btn" class="lang-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="lang-menu" aria-label="Language" data-i18n-attr="aria-label=profile.language;title=profile.language" title="Language">
              <span id="lang-current" class="lang-current"></span>
              <svg class="chev" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 10l5 5 5-5" /></svg>
            </button>
            <ul id="lang-menu" class="lang-menu" hidden></ul>
          </div>
          {tasting && (
            <a href="/tastings/" data-tpath="cart/" id="nav-cart" class="icon-btn cart-link" aria-label="Cart" title="Cart" data-i18n-attr="aria-label=nav.cart;title=nav.cart" hidden={!path.startsWith('/tasting/cart')}>
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z" /><path d="M9 7V5.5a3 3 0 0 1 6 0V7" /></svg>
              <span id="nav-cart-count" class="badge" hidden></span>
            </a>
          )}
          <span id="user-in" class="user-in" hidden>
            <a href="/profile/" id="user-link" class:list={['user-name', { current: path.startsWith('/profile') }]} title="My profile" aria-label="My profile" data-i18n-attr="title=nav.profile;aria-label=nav.profile">
              <span id="user-name" class="user-name-text"></span>
              <svg class="user-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.5" /><path d="M5 20c1.2-3.6 3.8-5.5 7-5.5s5.8 1.9 7 5.5" /></svg>
            </a>
            <button id="logout" type="button" class="icon-btn" aria-label="Sign out" title="Sign out" data-i18n-attr="aria-label=nav.signOut;title=nav.signOut">
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4" /><path d="M10 8l-4 4 4 4" /><path d="M6 12h10" /></svg>
            </button>
          </span>
          <a id="user-out" href="/login/" class="icon-btn" aria-label="Sign in" title="Sign in" data-i18n-attr="aria-label=nav.signIn;title=nav.signIn" hidden>
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.5" /><path d="M5 20c1.2-3.6 3.8-5.5 7-5.5s5.8 1.9 7 5.5" /></svg>
          </a>
        </div>
      </div>
      {tasting && (
        <nav aria-label="Tasting menu" data-i18n-attr="aria-label=nav.tastingMenu">
          <a href="/tastings/" data-tpath="" class:list={{ current: path === '/tasting/' || path === '/tasting' }} data-i18n="nav.tasting">Tasting</a>
          <a href="/tastings/" data-tpath="wines/" class:list={{ current: path.startsWith('/tasting/wine') }} data-i18n="nav.wines">Wines</a>
          <a href="/tastings/" data-tpath="quiz/" class:list={{ current: path.startsWith('/tasting/quiz') }} data-i18n="nav.quiz">Quiz</a>
        </nav>
      )}
      </div>
    </header>
    <main>
      <slot />
    </main>
    <script>
      import { getCart, cartCount } from '../lib/cart';
      import { supabase } from '../lib/supabase';
      import { currentSlug, tastingUrl, resolveGuestCode, signOut, loadMe, cachedName } from '../lib/guest';
      import { i18nReady, LANGS, lang, setLang, t, formatWhen, type Key } from '../i18n';
      import { FLAGS } from '../i18n/flags';

      await i18nReady;
      const titleKey = document.body.dataset.title as Key | undefined;
      if (titleKey) document.title = `${t(titleKey)} – Winetastr`;

      // Language picker in the top right corner: the current flag opens a small list
      const langBtn = document.getElementById('lang-btn')!;
      const langMenu = document.getElementById('lang-menu')!;
      document.getElementById('lang-current')!.innerHTML = FLAGS[lang()];
      for (const l of LANGS) {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.lang = l.code;
        b.innerHTML = FLAGS[l.code];
        b.append(document.createTextNode(l.name));
        if (l.code === lang()) b.setAttribute('aria-current', 'true');
        b.addEventListener('click', () => { if (l.code !== lang()) setLang(l.code); else toggleLangs(false); });
        li.append(b);
        langMenu.append(li);
      }
      function toggleLangs(open: boolean) {
        langMenu.hidden = !open;
        langBtn.setAttribute('aria-expanded', String(open));
        if (open) (langMenu.querySelector('[aria-current]') as HTMLElement | null)?.focus();
      }
      langBtn.addEventListener('click', (e) => { e.stopPropagation(); toggleLangs(langMenu.hidden); });
      document.addEventListener('click', (e) => { if (!langMenu.hidden && !langMenu.contains(e.target as Node)) toggleLangs(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !langMenu.hidden) { toggleLangs(false); langBtn.focus(); } });

      const inTasting = document.body.dataset.tasting === '1';
      const slug = currentSlug();

      // Links inside a tasting point to /t/<slug>/...
      if (slug) {
        document.querySelectorAll<HTMLAnchorElement>('a[data-tpath]').forEach((a) => {
          a.href = tastingUrl(slug, a.dataset.tpath ?? '');
        });
      } else if (inTasting) {
        location.replace('/tastings/');
      }

      // Cart badge (tasting pages only)
      const cartLink = document.getElementById('nav-cart');
      const badge = document.getElementById('nav-cart-count');
      const sync = () => {
        if (!cartLink || !badge) return;
        const n = cartCount(getCart());
        badge.textContent = String(n);
        badge.hidden = n === 0;
        if (n > 0) cartLink.hidden = false;
      };
      window.addEventListener('cart-change', sync);
      sync();

      if (document.body.classList.contains('has-hero')) {
        const onScroll = () => document.body.classList.toggle('scrolled', window.scrollY > 24);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      const userIn = document.getElementById('user-in')!;
      const userOut = document.getElementById('user-out')!;
      const userName = document.getElementById('user-name')!;

      // Tasting title in the header, date and time in the footer
      async function showTasting(c: string) {
        const { data } = await supabase.rpc('get_tasting', { code: c });
        const info = (data ?? null) as { title?: string; starts_at?: string | null; place?: string | null } | null;
        if (!info) return;
        if (info.title) document.getElementById('mark')!.textContent = info.title;
        const when = document.getElementById('footer-when')!;
        // The tasting home shows date and place itself
        if (info.starts_at && !document.getElementById('t-when')) {
          when.textContent = formatWhen(info.starts_at, { year: true }) + (info.place ? ` · ${info.place}` : '');
        }
      }

      // The person's name is always shown top right and leads to the profile page
      function showName(name: string | null) {
        userName.textContent = name || t('nav.profile');
        // The icon on phones carries the name for screen readers
        document.getElementById('user-link')!.setAttribute('aria-label', name ? `${name} – ${t('nav.profile')}` : t('nav.profile'));
        userIn.hidden = false;
        userOut.hidden = true;
      }
      const early = cachedName();
      if (early) showName(early);

      async function initUser() {
        const me = loadMe();
        if (inTasting && slug) {
          const code = await resolveGuestCode();
          if (!code) { userIn.hidden = true; userOut.hidden = false; return; }
          const { data } = await supabase.rpc('get_invite', { code });
          const row = Array.isArray(data) ? data[0] : null;
          if (!row) { userIn.hidden = true; userOut.hidden = false; return; }
          const who = await me;
          showName(who?.signedIn && who.name ? who.name : row.name);
          showTasting(code);
          // Guests without an email must add one on the tasting page before continuing
          const home = tastingUrl(slug);
          if (!row.email && location.pathname !== home) location.replace(home);
          return;
        }
        // Outside a tasting: signed in if there is an email session or a stored invite code
        const who = await me;
        if (who) showName(who.name);
        else { userIn.hidden = true; userOut.hidden = false; }
      }
      initUser();

      document.getElementById('logout')!.addEventListener('click', () => {
        signOut();
        try {
          Object.keys(localStorage).filter((k) => k.startsWith('cart:')).forEach((k) => localStorage.removeItem(k));
        } catch {}
        location.href = '/';
      });
    </script>
    <footer class="site-footer wrap">
      <p id="footer-when"></p>
    </footer>
  </body>
</html>

<style>
  /* Header stays at the top while scrolling */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.96);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--lodge-3);
    transition: background-color 0.2s, border-color 0.2s;
  }
  /* Header spans the full width */
  .header-inner {
    padding-top: 0.6rem;
    padding-bottom: 0;
  }
  .top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .tools { display: flex; align-items: center; gap: 0.25rem; flex: 0 0 auto; }
  .tools [hidden] { display: none !important; }
  .icon-btn {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--paper);
    cursor: pointer;
    text-decoration: none;
  }
  .icon-btn svg { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .icon-btn:hover { color: var(--amber); }
  .user-in { display: inline-flex; align-items: center; gap: 0.1rem; min-width: 0; }
  .user-name {
    display: inline-flex;
    align-items: center;
    color: var(--muted);
    text-decoration: none;
    padding: 0.4rem 0.2rem;
    font-size: 0.88rem;
  }
  .user-name-text { white-space: nowrap; }
  .user-icon { display: none; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  /* Phones: a profile icon instead of the name */
  @media (max-width: 40rem) {
    .user-name { width: 2.75rem; height: 2.75rem; justify-content: center; padding: 0; color: var(--paper); }
    .user-name-text { display: none; }
    .user-icon { display: block; }
  }
  .user-name:hover, .user-name.current { color: var(--paper); text-decoration: underline; text-underline-offset: 0.2em; }
  nav { display: flex; flex-wrap: wrap; gap: 0 1.5rem; margin-top: 0.2rem; }
  .badge {
    position: absolute;
    top: 0.2rem;
    right: 0.05rem;
    min-width: 1.15rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--amber);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 500;
    text-align: center;
    line-height: 1.15rem;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 400;
    padding: 0.7rem 0;
  }
  nav a:hover { color: var(--paper); }
  nav a.current { color: var(--amber); font-weight: 500; box-shadow: inset 0 -2px 0 var(--amber); }
  .brand { flex: 1 1 auto; min-width: 0; display: flex; align-items: center; gap: 0.6rem; }
  .brand :global(.logo) { flex: none; display: block; }
  .mark {
    flex: 1 1 auto;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--body);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: 0.01em;
    color: var(--paper);
    text-decoration: none;
  }
  main { padding-bottom: 3rem; }
  .site-footer {
    color: var(--muted);
    font-size: 0.9rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--lodge-3);
  }
  /* Language picker (top right) */
  .lang-pick { position: relative; }
  .lang-btn {
    display: inline-flex; align-items: center; gap: 0.2rem; height: 2.75rem; padding: 0 0.45rem;
    background: none; border: 0; cursor: pointer; color: var(--muted); border-radius: 0.5rem;
  }
  .lang-btn:hover { color: var(--paper); }
  .lang-current { display: grid; }
  .lang-current :global(.flag) { width: 1.1rem; height: auto; aspect-ratio: 3 / 2; border-radius: 2px; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12); opacity: 0.85; }
  .lang-btn .chev { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .lang-menu {
    position: absolute; right: 0; top: calc(100% + 0.25rem); z-index: 30; min-width: 10.5rem;
    list-style: none; margin: 0; padding: 0.35rem; background: var(--lodge-2);
    border: 1px solid var(--lodge-3); border-radius: 0.6rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
  }
  .lang-menu[hidden] { display: none; }
  .lang-menu :global(button) {
    display: flex; align-items: center; gap: 0.6rem; width: 100%; padding: 0.5rem 0.6rem;
    background: none; border: 0; border-radius: 0.4rem; font: inherit; font-size: 0.92rem; color: var(--paper); cursor: pointer; text-align: left;
  }
  .lang-menu :global(button:hover), .lang-menu :global(button:focus-visible) { background: var(--lodge); outline: none; }
  .lang-menu :global(button[aria-current='true']) { font-weight: 600; }
  .lang-menu :global(.flag) { width: 1.1rem; height: auto; aspect-ratio: 3 / 2; border-radius: 2px; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12); flex-shrink: 0; }
</style>
