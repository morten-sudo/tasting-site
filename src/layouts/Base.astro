---
import '../styles/global.css';
import { SITE_NAME } from '../lib/config';
import { en } from '../i18n/en';

// title: a translation key for the page title
// tasting: the page lives under /t/<slug>/ and gets the tasting's menu
interface Props { title?: keyof typeof en; hero?: boolean; tasting?: boolean }
const { title, hero = false, tasting = false } = Astro.props;
const pageTitle = title ? `${en[title]} – ${SITE_NAME}` : SITE_NAME;
const path = Astro.url.pathname;
const LOGO = `<svg class="logo" viewBox="0 0 100 100" width="30" height="30" aria-hidden="true"><defs><clipPath id="logo-bowl"><path transform="translate(4.3 4.3) rotate(-45 50 50)" d="M37 14 C30 21 27 30 27.5 37 C28.5 50 39 58 50 58 C61 58 71.5 50 72.5 37 C73 30 70 21 63 14 Z" /></clipPath></defs><rect width="100" height="100" rx="22" fill="#6e0f1f" /><g transform="translate(50 50) scale(0.84) translate(-50 -50)"><rect x="0" y="43" width="100" height="100" fill="#fff" clip-path="url(#logo-bowl)" /><g transform="translate(4.3 4.3) rotate(-45 50 50)" fill="none" stroke="#fff" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round"><path d="M37 14 C30 21 27 30 27.5 37 C28.5 50 39 58 50 58 C61 58 71.5 50 72.5 37 C73 30 70 21 63 14 Z" /><path d="M50 58 V79 M38 80 H62" /></g></g></svg>`;
---
<!doctype html>
<html lang="en" class="i18n-pending">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <!-- Hidden until the translations are applied; shown anyway after 2 s -->
    <style is:inline>html.i18n-pending body { visibility: hidden; }</style>
    <script is:inline>setTimeout(function () { document.documentElement.classList.remove('i18n-pending'); }, 2000);</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500&display=swap"
    />
  </head>
  <body class:list={{ 'has-hero': hero }} data-tasting={tasting ? '1' : undefined} data-title={title}>
    <header class="site-header">
      <div class="wrap header-inner">
      <div class="top-row">
        <div class="brand">
          <Fragment set:html={LOGO} />
          <a href={tasting ? '/home/' : '/'} class="mark" id="mark">{SITE_NAME}</a>
        </div>
        <div class="tools">
          <div class="lang-pick">
            <button id="lang-btn" class="lang-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="lang-menu" aria-label="Language" data-i18n-attr="aria-label=profile.language;title=profile.language" title="Language">
              <span id="lang-current" class="lang-current"></span>
              <svg class="chev" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 10l5 5 5-5" /></svg>
            </button>
            <ul id="lang-menu" class="lang-menu" hidden></ul>
          </div>
          {tasting && (
            <a href="/home/" data-tpath="cart/" id="nav-cart" class="icon-btn cart-link" aria-label="Cart" title="Cart" data-i18n-attr="aria-label=nav.cart;title=nav.cart" hidden={!path.startsWith('/tasting/cart')}>
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z" /><path d="M9 7V5.5a3 3 0 0 1 6 0V7" /></svg>
              <span id="nav-cart-count" class="badge" hidden></span>
            </a>
          )}
          <!-- Signed in: the name opens a menu with the person's places, profile and sign-out -->
          <div id="user-in" class="user-in" hidden>
            <button id="user-btn" type="button" class:list={['user-name', { current: path.startsWith('/profile') }]} aria-haspopup="true" aria-expanded="false" aria-controls="user-menu" title="Account menu" data-i18n-attr="title=nav.userMenu">
              <span id="user-name" class="user-name-text"></span>
              <svg class="user-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.5" /><path d="M5 20c1.2-3.6 3.8-5.5 7-5.5s5.8 1.9 7 5.5" /></svg>
              <svg class="chev" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 10l5 5 5-5" /></svg>
            </button>
            <ul id="user-menu" class="pop-menu" hidden>
              <li><a href="/home/" data-i18n="nav.home">Home</a></li>
              <li id="um-admin" hidden><a href="/admin/" data-i18n="nav.admin">Admin</a></li>
              <li id="um-super" hidden><a href="/superadmin/" data-i18n="nav.superadmin">Superadmin</a></li>
              <li><a href="/profile/" data-i18n="nav.profile">My profile</a></li>
              <li class="sep"><button id="logout" type="button" data-i18n="nav.signOut">Sign out</button></li>
            </ul>
          </div>
          <a id="user-out" href="/login/" class="icon-btn" aria-label="Sign in" title="Sign in" data-i18n-attr="aria-label=nav.signIn;title=nav.signIn" hidden>
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.5" /><path d="M5 20c1.2-3.6 3.8-5.5 7-5.5s5.8 1.9 7 5.5" /></svg>
          </a>
        </div>
      </div>
      {tasting && (
        <div class="ctx">
          <!-- Tasting context: which tasting (with a switcher), its tabs, and Admin for its host -->
          <div class="ctx-bar">
            <button id="t-switch" type="button" class="t-switch" aria-haspopup="true" aria-expanded="false" aria-controls="t-menu" disabled>
              <span id="t-title" class="t-title"></span>
              <svg class="chev" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 10l5 5 5-5" /></svg>
            </button>
            <nav aria-label="Tasting menu" data-i18n-attr="aria-label=nav.tastingMenu">
              <a href="/home/" data-tpath="" class:list={{ current: path === '/tasting/' || path === '/tasting' }} data-i18n="nav.tasting">Tasting</a>
              <a href="/home/" data-tpath="wines/" class:list={{ current: path.startsWith('/tasting/wine') }} data-i18n="nav.wines">Wines</a>
              <a href="/home/" data-tpath="quiz/" class:list={{ current: path.startsWith('/tasting/quiz') }} data-i18n="nav.quiz">Quiz</a>
              <a href="/home/" data-tpath="chat/" class:list={{ current: path.startsWith('/tasting/chat') }} data-i18n="nav.chat">Chat</a>
            </nav>
            <a id="t-admin" class="t-admin" href="/admin/" data-tpath="admin/" title="Manage this tasting" data-i18n-attr="title=nav.adminThisTitle" hidden><span data-i18n="nav.adminThis">Admin</span> ↗</a>
          </div>
          <div id="t-backdrop" class="t-backdrop" hidden></div>
          <div id="t-menu" class="pop-menu t-menu" role="menu" hidden>
            <p class="t-menu-head" data-i18n="nav.switchTasting">Switch tasting</p>
            <ul id="t-list"></ul>
            <a class="t-all" href="/home/#my-tastings" data-i18n="nav.allMyTastings">All my tastings</a>
          </div>
        </div>
      )}
      </div>
    </header>
    <main>
      <slot />
    </main>
    <script>
      import { getCart, cartCount } from '../lib/cart';
      import { supabase } from '../lib/supabase';
      import { currentSlug, tastingUrl, resolveGuestCode, signOut, loadMe, cachedName } from '../lib/guest';
      import { loadAllMyTastings } from '../lib/my-tastings';
      import { i18nReady, LANGS, lang, setLang, t, formatWhen, type Key } from '../i18n';
      import { FLAGS } from '../i18n/flags';

      await i18nReady;
      const titleKey = document.body.dataset.title as Key | undefined;
      if (titleKey) document.title = `${t(titleKey)} – Winetastr`;

      // Language picker in the top right corner: the current flag opens a small list
      const langBtn = document.getElementById('lang-btn')!;
      const langMenu = document.getElementById('lang-menu')!;
      document.getElementById('lang-current')!.innerHTML = FLAGS[lang()];
      for (const l of LANGS) {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.lang = l.code;
        b.innerHTML = FLAGS[l.code];
        b.append(document.createTextNode(l.name));
        if (l.code === lang()) b.setAttribute('aria-current', 'true');
        b.addEventListener('click', () => { if (l.code !== lang()) setLang(l.code); else toggleLangs(false); });
        li.append(b);
        langMenu.append(li);
      }
      function toggleLangs(open: boolean) {
        langMenu.hidden = !open;
        langBtn.setAttribute('aria-expanded', String(open));
        if (open) (langMenu.querySelector('[aria-current]') as HTMLElement | null)?.focus();
      }
      langBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        // Only one menu open at a time
        document.querySelectorAll<HTMLElement>('.pop-menu, .t-backdrop').forEach((el) => { el.hidden = true; });
        document.body.classList.remove('sheet-open');
        toggleLangs(langMenu.hidden);
      });
      document.addEventListener('click', (e) => { if (!langMenu.hidden && !langMenu.contains(e.target as Node)) toggleLangs(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !langMenu.hidden) { toggleLangs(false); langBtn.focus(); } });

      const inTasting = document.body.dataset.tasting === '1';
      const slug = currentSlug();

      // Links inside a tasting point to /t/<slug>/...
      if (slug) {
        document.querySelectorAll<HTMLAnchorElement>('a[data-tpath]').forEach((a) => {
          a.href = tastingUrl(slug, a.dataset.tpath ?? '');
        });
      } else if (inTasting) {
        location.replace('/home/');
      }

      // Cart badge (tasting pages only)
      const cartLink = document.getElementById('nav-cart');
      const badge = document.getElementById('nav-cart-count');
      const sync = () => {
        if (!cartLink || !badge) return;
        const n = cartCount(getCart());
        badge.textContent = String(n);
        badge.hidden = n === 0;
        if (n > 0) cartLink.hidden = false;
      };
      window.addEventListener('cart-change', sync);
      sync();

      if (document.body.classList.contains('has-hero')) {
        const onScroll = () => document.body.classList.toggle('scrolled', window.scrollY > 24);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      const userIn = document.getElementById('user-in')!;
      const userOut = document.getElementById('user-out')!;
      const userName = document.getElementById('user-name')!;

      // Tasting title in the context bar, date and time in the footer
      async function showTasting(c: string) {
        const { data } = await supabase.rpc('get_tasting', { code: c });
        const info = (data ?? null) as { title?: string; starts_at?: string | null; place?: string | null } | null;
        if (!info) return;
        if (info.title) {
          document.getElementById('t-title')!.textContent = info.title;
          document.title = `${info.title} – ${document.title.split(' – ').pop()}`;
        }
        const when = document.getElementById('footer-when')!;
        // The tasting home shows date and place itself
        if (info.starts_at && !document.getElementById('h-when')) {
          when.textContent = formatWhen(info.starts_at, { year: true }) + (info.place ? ` · ${info.place}` : '');
        }
      }

      // ---------- Dropdown menus (user menu and tasting switcher) ----------
      type Menu = { btn: HTMLElement; menu: HTMLElement; backdrop?: HTMLElement };
      const menus: Menu[] = [];
      function setOpen(m: Menu, open: boolean) {
        m.menu.hidden = !open;
        if (m.backdrop) m.backdrop.hidden = !open;
        m.btn.setAttribute('aria-expanded', String(open));
        // Phones: the tasting switcher is a bottom sheet, so the page behind should not scroll
        if (m.backdrop) document.body.classList.toggle('sheet-open', open);
      }
      function addMenu(m: Menu) {
        menus.push(m);
        m.btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = m.menu.hidden;
          menus.forEach((o) => setOpen(o, false));
          document.getElementById('lang-menu')!.hidden = true;
          setOpen(m, open);
          if (open) m.menu.querySelector<HTMLElement>('a, button')?.focus({ preventScroll: true });
        });
        m.backdrop?.addEventListener('click', () => setOpen(m, false));
      }
      document.addEventListener('click', (e) => {
        menus.forEach((m) => { if (!m.menu.hidden && !m.menu.contains(e.target as Node)) setOpen(m, false); });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        menus.forEach((m) => { if (!m.menu.hidden) { setOpen(m, false); m.btn.focus(); } });
      });
      addMenu({ btn: document.getElementById('user-btn')!, menu: document.getElementById('user-menu')! });

      // Switch to another of my tastings, staying on the same tab
      async function initSwitcher() {
        const btn = document.getElementById('t-switch') as HTMLButtonElement | null;
        if (!btn || !slug) return;
        const { all, upcoming, past } = await loadAllMyTastings();
        if (all.length < 2) return;
        const tab = document.querySelector<HTMLAnchorElement>('.ctx nav a.current')?.dataset.tpath ?? '';
        const list = document.getElementById('t-list')!;
        list.replaceChildren(...[...upcoming, ...past].map((x) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = tastingUrl(x.slug, tab);
          a.setAttribute('role', 'menuitem');
          const name = document.createElement('span');
          name.className = 't-name';
          name.textContent = x.title;
          a.append(name);
          if (x.starts_at) {
            const when = document.createElement('span');
            when.className = 't-when';
            when.textContent = formatWhen(x.starts_at, { year: new Date(x.starts_at).getFullYear() !== new Date().getFullYear() });
            a.append(when);
          }
          if (x.slug === slug) a.setAttribute('aria-current', 'page');
          li.append(a);
          return li;
        }));
        btn.disabled = false;
        btn.classList.add('can-switch');
        btn.title = t('nav.switchTasting');
        addMenu({ btn, menu: document.getElementById('t-menu')!, backdrop: document.getElementById('t-backdrop')! });
      }

      // Admin links for hosts and administrators
      async function showRoles(signedIn: boolean, isHost: boolean) {
        if (!signedIn) return;
        document.getElementById('um-admin')!.hidden = !isHost;
        const [{ data: admin }, own] = await Promise.all([
          supabase.rpc('is_admin'),
          // Row-level security only returns the tasting to its host (or an administrator)
          inTasting && slug && isHost
            ? supabase.from('tastings').select('id').eq('slug', slug).maybeSingle()
            : Promise.resolve({ data: null }),
        ]);
        document.getElementById('um-super')!.hidden = admin !== true;
        if (admin === true) document.getElementById('um-admin')!.hidden = false;
        const tAdmin = document.getElementById('t-admin');
        if (tAdmin && own.data) tAdmin.hidden = false;
      }

      // The person's name is always shown top right and opens the account menu
      function showName(name: string | null) {
        userName.textContent = name || t('nav.profile');
        document.getElementById('user-btn')!.setAttribute('aria-label', name ? `${name} – ${t('nav.userMenu')}` : t('nav.userMenu'));
        userIn.hidden = false;
        userOut.hidden = true;
      }
      const early = cachedName();
      if (early) showName(early);

      async function initUser() {
        const me = loadMe();
        if (inTasting && slug) {
          const code = await resolveGuestCode();
          if (!code) { userIn.hidden = true; userOut.hidden = false; return; }
          const { data } = await supabase.rpc('get_invite', { code });
          const row = Array.isArray(data) ? data[0] : null;
          if (!row) { userIn.hidden = true; userOut.hidden = false; return; }
          showTasting(code);
          const who = await me;
          showName(who?.signedIn && who.name ? who.name : row.name);
          // Guests without an email must add one on the tasting page before continuing
          const home = tastingUrl(slug);
          if (!row.email && location.pathname !== home) { location.replace(home); return; }
          initSwitcher();
          showRoles(!!who?.signedIn, !!who?.isHost);
          return;
        }
        // Outside a tasting: signed in if there is an email session or a stored invite code
        const who = await me;
        if (who) {
          showName(who.name);
          // Signed in: the logo leads to the user's home
          (document.getElementById('mark') as HTMLAnchorElement).href = '/home/';
          showRoles(who.signedIn, who.isHost);
        } else { userIn.hidden = true; userOut.hidden = false; }
      }
      initUser();

      document.getElementById('logout')!.addEventListener('click', () => {
        signOut();
        try {
          Object.keys(localStorage).filter((k) => k.startsWith('cart:')).forEach((k) => localStorage.removeItem(k));
        } catch {}
        location.href = '/';
      });
    </script>
    <footer class="site-footer wrap">
      <p id="footer-when"></p>
    </footer>
  </body>
</html>

<style>
  /* Header stays at the top while scrolling */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.96);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--lodge-3);
    transition: background-color 0.2s, border-color 0.2s;
  }
  /* Header spans the full width */
  .header-inner {
    padding-top: 0.6rem;
    padding-bottom: 0;
  }
  .top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .tools { display: flex; align-items: center; gap: 0.25rem; flex: 0 0 auto; }
  .tools [hidden] { display: none !important; }
  .icon-btn {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--paper);
    cursor: pointer;
    text-decoration: none;
  }
  .icon-btn svg { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .icon-btn:hover { color: var(--amber); }
  .user-in { position: relative; display: inline-flex; align-items: center; min-width: 0; }
  .user-name {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    min-height: 2.75rem;
    color: var(--muted);
    background: none;
    border: 0;
    border-radius: 0.5rem;
    padding: 0 0.45rem;
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .user-name-text { white-space: nowrap; max-width: 12rem; overflow: hidden; text-overflow: ellipsis; }
  .user-icon { display: none; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .chev { flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  /* Phones: a profile icon instead of the name */
  @media (max-width: 40rem) {
    .user-name { padding: 0 0.2rem; color: var(--paper); }
    .user-name-text { display: none; }
    .user-icon { display: block; }
  }
  .user-name:hover, .user-name.current, .user-name[aria-expanded='true'] { color: var(--paper); }
  /* Dropdown menus */
  .pop-menu {
    position: absolute; right: 0; top: calc(100% + 0.25rem); z-index: 30; min-width: 12rem;
    list-style: none; margin: 0; padding: 0.35rem; background: var(--lodge-2);
    border: 1px solid var(--lodge-3); border-radius: 0.6rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
  }
  .pop-menu[hidden], .t-backdrop[hidden] { display: none; }
  .pop-menu ul { list-style: none; margin: 0; padding: 0; }
  .pop-menu a, .pop-menu button {
    display: flex; align-items: center; gap: 0.6rem; width: 100%; padding: 0.55rem 0.7rem;
    background: none; border: 0; border-radius: 0.4rem; font: inherit; font-size: 0.92rem;
    color: var(--paper); text-decoration: none; cursor: pointer; text-align: left;
  }
  .pop-menu a:hover, .pop-menu button:hover, .pop-menu a:focus-visible, .pop-menu button:focus-visible { background: var(--lodge); outline: none; }
  .pop-menu .sep { margin-top: 0.3rem; padding-top: 0.3rem; border-top: 1px solid var(--lodge-3); }
  .pop-menu #logout { color: var(--muted); }
  /* Tasting context bar under the top row */
  .header-inner { position: relative; }
  .ctx-bar {
    display: flex; align-items: center; gap: 1.5rem; margin-top: 0.35rem;
    border-top: 1px solid var(--lodge-3);
    overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .ctx-bar::-webkit-scrollbar { display: none; }
  .t-switch {
    flex: 0 1 auto; flex-shrink: 0; min-width: 0; display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.7rem 0; background: none; border: 0; font: inherit; font-size: 0.95rem; font-weight: 600;
    color: var(--paper); cursor: default;
  }
  .t-switch:disabled { opacity: 1; }
  .t-switch .chev { display: none; }
  .t-switch.can-switch { cursor: pointer; }
  .t-switch.can-switch .chev { display: block; color: var(--muted); }
  .t-switch.can-switch:hover .chev, .t-switch[aria-expanded='true'] .chev { color: var(--amber); }
  .t-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 16rem; }
  .t-title:empty::before { content: '…'; color: var(--muted); }
  nav { display: flex; gap: 0 1.5rem; flex: none; }
  .t-admin {
    margin-left: auto; flex: none; white-space: nowrap; font-size: 0.85rem; color: var(--amber);
    text-decoration: none; padding: 0.3rem 0.7rem; border: 1px solid var(--lodge-3); border-radius: 999px;
  }
  .t-admin:hover { border-color: var(--amber); }
  .t-admin[hidden] { display: none; }
  .t-menu { left: var(--gutter); right: auto; top: calc(100% - 0.2rem); min-width: 17rem; max-width: min(24rem, calc(100vw - 2rem)); padding: 0.35rem; }
  .t-menu-head { margin: 0.35rem 0.7rem 0.25rem; font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .t-menu ul { max-height: 50vh; overflow-y: auto; }
  .t-menu :global(a) { flex-direction: column; align-items: flex-start; gap: 0.05rem; }
  /* The list is built in the script, so its items need global selectors */
  .t-menu ul :global(a) {
    display: flex; width: 100%; padding: 0.55rem 0.7rem; border-radius: 0.4rem;
    color: var(--paper); text-decoration: none; font-size: 0.92rem;
  }
  .t-menu ul :global(a:hover), .t-menu ul :global(a:focus-visible) { background: var(--lodge); outline: none; }
  .t-menu :global(.t-when) { font-size: 0.8rem; color: var(--muted); }
  .t-menu :global(a[aria-current='page']) { background: var(--lodge); }
  .t-menu :global(a[aria-current='page'] .t-name) { font-weight: 600; color: var(--amber); }
