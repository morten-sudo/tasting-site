---
import '../styles/global.css';
import { EVENT } from '../lib/config';

interface Props { title?: string; hero?: boolean }
const { title, hero = false } = Astro.props;
const pageTitle = title ? `${title} – ${EVENT.title}` : EVENT.title;
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0b0908" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Stencil+Display:wght@600;800&family=Literata:opsz,wght@7..72,400;7..72,600&display=swap"
    />
  </head>
  <body class:list={{ 'has-hero': hero }}>
    <header class="site-header wrap">
      <div class="top-row">
        <a href="/" class="mark">Portvin 2026</a>
        <div class="user" id="user">
          <span id="user-in" hidden><span id="user-name"></span> · <button id="logout" type="button" class="user-btn">Log ud</button></span>
          <a id="user-out" href="/log-ind/" class="user-btn" hidden>Log ind</a>
        </div>
      </div>
      <nav aria-label="Hovedmenu">
        <a href="/vine/" class:list={{ current: Astro.url.pathname.startsWith('/vine') }}>Vinene</a>
        <a href="/quiz/" class:list={{ current: Astro.url.pathname.startsWith('/quiz') }}>Quiz</a>
        <a href="/invitation/" class:list={{ current: Astro.url.pathname.startsWith('/invitation') }}>Tilmelding</a>
        <a href="/kurv/" id="nav-cart" class:list={['cart-link', { current: Astro.url.pathname.startsWith('/kurv') }]} hidden={!Astro.url.pathname.startsWith('/kurv')}>
          Kurv <span id="nav-cart-count" class="badge" hidden></span>
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script>
      import { getCart, cartCount, clearCart } from '../lib/cart';
      import { supabase, forgetGuestCode } from '../lib/supabase';
      const link = document.getElementById('nav-cart')!;
      const badge = document.getElementById('nav-cart-count')!;
      const sync = () => {
        const n = cartCount(getCart());
        badge.textContent = String(n);
        badge.hidden = n === 0;
        if (n > 0) link.hidden = false;
      };
      window.addEventListener('cart-change', sync);
      sync();

      // Log ind/ud for gæster (baseret på invitationskoden)
      const userIn = document.getElementById('user-in')!;
      const userOut = document.getElementById('user-out')!;
      let code: string | null = null;
      try {
        code = new URLSearchParams(location.search).get('k') || localStorage.getItem('portvin_kode');
      } catch {}
      if (!code) {
        userOut.hidden = false;
      } else {
        supabase.rpc('get_invite', { code }).then(({ data }) => {
          const row = Array.isArray(data) ? data[0] : null;
          if (row) {
            document.getElementById('user-name')!.textContent = row.name;
            userIn.hidden = false;
          } else {
            userOut.hidden = false;
          }
        });
      }
      document.getElementById('logout')!.addEventListener('click', () => {
        forgetGuestCode();
        clearCart();
        location.href = '/';
      });
    </script>
    <footer class="site-footer wrap">
      <p>{EVENT.dateLong} {EVENT.time}</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    padding-top: 1.25rem;
    padding-bottom: 0.5rem;
  }
  .top-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .user { color: var(--muted); font-size: 0.88rem; text-align: right; min-width: 0; }
  #user-name {
    display: inline-block;
    max-width: 9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #user-in:not([hidden]) { display: inline-flex; align-items: baseline; gap: 0.35rem; }
  .user-btn {
    font: inherit;
    background: none;
    border: 0;
    padding: 0.3rem 0;
    color: var(--amber);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }
  .user [hidden] { display: none; }
  nav { display: flex; flex-wrap: wrap; gap: 0 1.1rem; margin-top: 0.35rem; }
  .cart-link { color: var(--amber); }
  .cart-link[hidden] { display: none; }
  .badge {
    display: inline-block;
    min-width: 1.35rem;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: var(--amber);
    color: var(--lodge);
    font-size: 0.8rem;
    font-weight: 600;
    text-align: center;
    line-height: 1.3;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.98rem;
    padding: 0.4rem 0;
  }
  nav a:hover, nav a.current { color: var(--paper); }
  nav a.current { box-shadow: inset 0 -2px 0 var(--amber); }
  .mark {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    color: var(--paper);
    text-decoration: none;
  }
  /* Forsiden: menuen ligger oven på kælderfotoet */
  body.has-hero .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
  }
  body.has-hero nav a { color: #d6c7b0; }
  body.has-hero nav a:hover { color: var(--paper); }
  main { padding-bottom: 3rem; }
  .site-footer {
    color: var(--muted);
    font-size: 0.9rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--lodge-3);
  }
</style>
