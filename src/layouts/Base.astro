---
import '../styles/global.css';
import { EVENT } from '../lib/config';

interface Props { title?: string; hero?: boolean }
const { title, hero = false } = Astro.props;
const pageTitle = title ? `${title} – ${EVENT.title}` : EVENT.title;
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0b0908" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500&display=swap"
    />
  </head>
  <body class:list={{ 'has-hero': hero }}>
    <header class="site-header">
      <div class="wrap header-inner">
      <div class="top-row">
        <a href="/" class="mark">Portvin 2026</a>
        <div class="tools">
          <a href="/kurv/" id="nav-cart" class="icon-btn cart-link" aria-label="Indkøbskurv" title="Indkøbskurv" hidden={!Astro.url.pathname.startsWith('/kurv')}>
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z" /><path d="M9 7V5.5a3 3 0 0 1 6 0V7" /></svg>
            <span id="nav-cart-count" class="badge" hidden></span>
          </a>
          <span id="user-in" class="user-in" hidden>
            <a href="/profil/" id="user-name" class:list={['user-name', { current: Astro.url.pathname.startsWith('/profil') }]} title="Din profil"></a>
            <button id="logout" type="button" class="icon-btn" aria-label="Log ud" title="Log ud">
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4" /><path d="M10 8l-4 4 4 4" /><path d="M6 12h10" /></svg>
            </button>
          </span>
          <a id="user-out" href="/log-ind/" class="icon-btn" aria-label="Log ind" title="Log ind" hidden>
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.5" /><path d="M5 20c1.2-3.6 3.8-5.5 7-5.5s5.8 1.9 7 5.5" /></svg>
          </a>
        </div>
      </div>
      <nav aria-label="Hovedmenu">
        <a href="/vine/" class:list={{ current: Astro.url.pathname.startsWith('/vin') }}>Vinene</a>
        <a href="/quiz/" class:list={{ current: Astro.url.pathname.startsWith('/quiz') }}>Quiz</a>
      </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <script>
      import { getCart, cartCount, clearCart } from '../lib/cart';
      import { supabase, forgetGuestCode } from '../lib/supabase';
      const link = document.getElementById('nav-cart')!;
      const badge = document.getElementById('nav-cart-count')!;
      const sync = () => {
        const n = cartCount(getCart());
        badge.textContent = String(n);
        badge.hidden = n === 0;
        if (n > 0) link.hidden = false;
      };
      window.addEventListener('cart-change', sync);
      sync();

      if (document.body.classList.contains('has-hero')) {
        const onScroll = () => document.body.classList.toggle('scrolled', window.scrollY > 24);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // Log ind/ud for gæster (baseret på invitationskoden)
      const userIn = document.getElementById('user-in')!;
      const userOut = document.getElementById('user-out')!;
      let code: string | null = null;
      try {
        code = new URLSearchParams(location.search).get('k') || localStorage.getItem('portvin_kode');
      } catch {}
      if (!code) {
        userOut.hidden = false;
      } else {
        supabase.rpc('get_invite', { code }).then(({ data }) => {
          const row = Array.isArray(data) ? data[0] : null;
          if (row) {
            document.getElementById('user-name')!.textContent = row.name;
            userIn.hidden = false;
            // Gæster uden e-mail skal angive den på profilen, før de går videre
            const free = ['/profil/', '/log-ind/', '/admin/', '/pointtavle/'];
            if (!row.email && !free.some((p) => location.pathname.startsWith(p))) {
              location.replace('/profil/');
            }
          } else {
            userOut.hidden = false;
          }
        });
      }
      document.getElementById('logout')!.addEventListener('click', () => {
        forgetGuestCode();
        clearCart();
        location.href = '/';
      });
    </script>
    <footer class="site-footer wrap">
      <p>{EVENT.dateLong} {EVENT.time}</p>
    </footer>
  </body>
</html>

<style>
  /* Menuen bliver stående øverst, når man scroller */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(11, 9, 8, 0.92);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--lodge-2);
    transition: background-color 0.2s, border-color 0.2s;
  }
  /* Menuen bruger hele bredden */
  .header-inner {
    padding-top: 1rem;
    padding-bottom: 0.3rem;
  }
  .top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .tools { display: flex; align-items: center; gap: 0.25rem; min-width: 0; }
  .tools [hidden] { display: none !important; }
  .icon-btn {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--paper);
    cursor: pointer;
    text-decoration: none;
  }
  .icon-btn svg { fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .icon-btn:hover { color: var(--amber); }
  .user-in { display: inline-flex; align-items: center; gap: 0.1rem; min-width: 0; }
  .user-name {
    color: var(--muted);
    text-decoration: none;
    padding: 0.4rem 0.2rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    max-width: 9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .user-name:hover, .user-name.current { color: var(--paper); text-decoration: underline; text-underline-offset: 0.2em; }
  nav { display: flex; flex-wrap: wrap; gap: 0 1.6rem; margin-top: 0.1rem; }
  .badge {
    position: absolute;
    top: 0.2rem;
    right: 0.05rem;
    min-width: 1.15rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--amber);
    color: var(--lodge);
    font-size: 0.72rem;
    font-weight: 500;
    text-align: center;
    line-height: 1.15rem;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0.6rem 0;
  }
  nav a:hover, nav a.current { color: var(--paper); }
  nav a.current { box-shadow: inset 0 -1px 0 var(--amber); }
  .mark {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.15rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--paper);
    text-decoration: none;
  }
  /* Forsiden: gennemsigtig over fotoet, mørk så snart man scroller */
  body.has-hero .site-header {
    position: fixed;
    left: 0;
    right: 0;
  }
  body.has-hero:not(.scrolled) .site-header {
    background: transparent;
    border-bottom-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  body.has-hero nav a { color: #d6c7b0; }
  body.has-hero nav a:hover { color: var(--paper); }
  main { padding-bottom: 3rem; }
  .site-footer {
    color: var(--muted);
    font-size: 0.9rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--lodge-3);
  }
</style>
