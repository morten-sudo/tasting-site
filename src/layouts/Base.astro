---
import '../styles/global.css';
import { EVENT } from '../lib/config';

interface Props { title?: string }
const { title } = Astro.props;
const pageTitle = title ? `${title} – ${EVENT.title}` : EVENT.title;
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#2b1517" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Stencil+Display:wght@600;800&family=Literata:opsz,wght@7..72,400;7..72,600&display=swap"
    />
  </head>
  <body>
    <header class="site-header wrap">
      <a href="/" class="mark">Portvin 2026</a>
      <nav aria-label="Hovedmenu">
        <a href="/vine/" class:list={{ current: Astro.url.pathname.startsWith('/vine') }}>Vinene</a>
        <a href="/quiz/" class:list={{ current: Astro.url.pathname.startsWith('/quiz') }}>Quiz</a>
        <a href="/invitation/" class:list={{ current: Astro.url.pathname.startsWith('/invitation') }}>Tilmelding</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>{EVENT.dateLong} {EVENT.time}</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    padding-top: 1.25rem;
    padding-bottom: 0.5rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  nav { display: flex; gap: 1.1rem; }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.98rem;
    padding: 0.4rem 0;
  }
  nav a:hover, nav a.current { color: var(--paper); }
  nav a.current { box-shadow: inset 0 -2px 0 var(--amber); }
  .mark {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    color: var(--paper);
    text-decoration: none;
  }
  main { padding-bottom: 3rem; }
  .site-footer {
    color: var(--muted);
    font-size: 0.9rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--lodge-3);
  }
</style>
