---
import Base from '../layouts/Base.astro';
import AdminNav from '../components/AdminNav.astro';
import '../styles/admin.css';
---
<Base title="page.superadmin">
  <section class="wrap admin-page super-page">
    <AdminNav active="super">
    <p class="eyebrow">Winetastr</p>
    <h1 class="title" data-i18n="page.superadmin">Superadmin</h1>
    <p id="loading" class="hint" data-i18n="common.loading">Loading …</p>
    <p id="denied" class="message error" hidden data-i18n="super.denied">This page is only for Winetastr administrators.</p>

    <div id="main" hidden>
      <!-- Totals across all hosts -->
      <div class="super-stats">
        <div class="stat"><span id="t-hosts" class="stat-n"></span><span class="stat-label" data-i18n="super.hosts">Hosts</span></div>
        <div class="stat"><span id="t-tastings" class="stat-n"></span><span class="stat-label" data-i18n="adminNav.tastings">Tastings</span><span id="t-upcoming" class="stat-sub"></span></div>
        <div class="stat"><span id="t-wines" class="stat-n"></span><span class="stat-label" data-i18n="adminNav.wines">Wines</span></div>
        <div class="stat"><span id="t-guests" class="stat-n"></span><span class="stat-label" data-i18n="adminNav.guests">Guests</span><span id="t-invited" class="stat-sub"></span></div>
        <div class="stat"><span id="t-orders" class="stat-n"></span><span class="stat-label" data-i18n="admin.orders">Orders</span><span id="t-amount" class="stat-sub"></span></div>
        <div class="stat"><span id="t-activity" class="stat-n"></span><span class="stat-label" data-i18n="super.active30">Active last 30 days</span></div>
      </div>

      <div class="guests-head">
        <h2 data-i18n="super.tenants">All hosts</h2>
        <input id="search" class="search" type="search" autocomplete="off" placeholder="Search" data-i18n-attr="placeholder=adminTasting.search" style="max-width:18rem;margin:0" />
      </div>
      <div class="table-wrap super-table">
        <table class="table">
          <thead>
            <tr>
              <th data-sort="name" data-i18n="super.host">Host</th>
              <th data-sort="created_at" data-i18n="super.created">Created</th>
              <th data-sort="tastings" class="num" data-i18n="adminNav.tastings">Tastings</th>
              <th data-sort="wines" class="num" data-i18n="adminNav.wines">Wines</th>
              <th data-sort="guests" class="num" data-i18n="adminNav.guests">Guests</th>
              <th data-sort="invited" class="num" data-i18n="super.invited">Invited</th>
              <th data-sort="orders" class="num" data-i18n="admin.orders">Orders</th>
              <th data-sort="ratings" class="num" data-i18n="super.ratings">Ratings</th>
              <th data-sort="chat_messages" class="num" data-i18n="page.chat">Chat</th>
              <th data-sort="last_activity" data-i18n="super.lastActive">Last active</th>
            </tr>
          </thead>
          <tbody id="rows"></tbody>
        </table>
      </div>

      <!-- Maps: which regions the wines come from, to decide which detailed maps to make next -->
      <section class="block maps-block">
        <h2 data-i18n="super.mapsTitle">Maps</h2>
        <p class="hint" data-i18n="super.mapsHint">The regions the wines in all tastings come from. Regions without a detailed map are shown on the overview map – the most used ones are the next candidates for a detailed map.</p>
        <div class="table-wrap">
          <table class="table">
            <thead><tr>
              <th data-i18n="super.mapRegion">Region</th>
              <th data-i18n="origin.country">Country</th>
              <th class="num" data-i18n="super.mapUpcoming">Upcoming tastings</th>
              <th class="num" data-i18n="adminNav.tastings">Tastings</th>
              <th class="num" data-i18n="adminNav.wines">Wines</th>
              <th class="num" data-i18n="super.hosts">Hosts</th>
              <th data-i18n="super.mapDetail">Detailed map</th>
            </tr></thead>
            <tbody id="map-rows"></tbody>
          </table>
        </div>
        <h3 data-i18n="super.guessesTitle">Places found by Cloudflare AI</h3>
        <p class="hint" data-i18n="super.guessesHint">Appellations that are not on the list, placed by Cloudflare AI and checked against the country. Check the place; delete a wrong one and it is looked up again the next time a host saves the wine.</p>
        <ul id="guess-rows" class="guess-list"></ul>
        <p id="guesses-none" class="hint" hidden data-i18n="super.guessesNone">None yet.</p>
      </section>

      <!-- GDPR: see and delete everything stored about one person -->
      <section class="block gdpr">
        <h2 data-i18n="super.gdprTitle">Delete personal data</h2>
        <p class="hint" data-i18n="super.gdprHint">When someone asks to be forgotten: look up their email, check what is stored, then delete it all – invitations with answers, ratings, orders and chat messages, guest-list entries, a host account with everything in it, and the sign-in account. This cannot be undone.</p>
        <form id="gdpr-form" class="inline-form" novalidate>
          <input id="gdpr-email" type="email" autocomplete="off" placeholder="name@example.com" aria-label="Email" data-i18n-attr="aria-label=common.email" />
          <button class="btn small ghost" type="submit" data-i18n="super.gdprLookup">Look up</button>
        </form>
        <div id="gdpr-result" hidden>
          <ul id="gdpr-list" class="gdpr-list"></ul>
          <button id="gdpr-delete" class="btn small danger-btn" type="button" data-i18n="super.gdprDelete">Delete everything</button>
        </div>
        <p id="gdpr-msg" class="message" hidden></p>
      </section>
    </div>
    </AdminNav>
  </section>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  import { i18nReady, t, money, locale } from '../i18n';
  import { initSide } from '../lib/admin-side';
  import { mapIdFor } from '../lib/region-map';
  import { countryName } from '../lib/origin';

  type Tenant = { id: string; name: string | null; email: string; plan: string; created_at: string;
    tastings: number; upcoming: number; wines: number; guests: number; invited: number; coming: number;
    orders: number; order_amount: number; ratings: number; chat_messages: number; last_activity: string };

  await i18nReady;
  const $ = (id: string) => document.getElementById(id)!;
  const date = new Intl.DateTimeFormat(locale(), { day: 'numeric', month: 'short', year: 'numeric' });
  let tenants: Tenant[] = [];
  let sortKey: keyof Tenant = 'last_activity';
  let desc = true;

  const { data: s } = await supabase.auth.getSession();
  if (!s.session) location.replace('/login/?next=' + encodeURIComponent('/superadmin/'));
  const { data, error } = await supabase.rpc('admin_tenants');
  $('loading').hidden = true;
  if (error || !data) {
    $('denied').hidden = false;
  } else {
    tenants = (data as Tenant[]).map((x) => ({ ...x,
      tastings: Number(x.tastings), upcoming: Number(x.upcoming), wines: Number(x.wines), guests: Number(x.guests),
      invited: Number(x.invited), coming: Number(x.coming), orders: Number(x.orders), order_amount: Number(x.order_amount),
      ratings: Number(x.ratings), chat_messages: Number(x.chat_messages) }));
    $('main').hidden = false;
    // The admin menu (a drawer behind the menu button on phones)
    const { data: me } = await supabase.auth.getUser();
    $('me').textContent = me.user?.email ?? '';
    const { data: hostId } = await supabase.rpc('current_host_id');
    initSide(hostId ?? '');
    $('side-logout').addEventListener('click', async () => { await supabase.auth.signOut(); location.href = '/'; });
    totals();
    render();
    loadMaps();
  }

  function totals() {
    const sum = (k: keyof Tenant) => tenants.reduce((n, x) => n + (x[k] as number), 0);
    $('t-hosts').textContent = String(tenants.length);
    $('t-tastings').textContent = String(sum('tastings'));
    $('t-upcoming').textContent = t('dash.upcoming', { n: sum('upcoming') });
    $('t-wines').textContent = String(sum('wines'));
    $('t-guests').textContent = String(sum('guests'));
    $('t-invited').textContent = t('super.invitedSub', { n: sum('invited'), coming: sum('coming') });
    $('t-orders').textContent = String(sum('orders'));
    $('t-amount').textContent = money(sum('order_amount'));
    const month = Date.now() - 30 * 86400000;
    $('t-activity').textContent = String(tenants.filter((x) => new Date(x.last_activity).getTime() >= month).length);
  }

  function cell(text: string, cls = '') {
    const td = document.createElement('td');
    td.textContent = text;
    if (cls) td.className = cls;
    return td;
  }

  function render() {
    const q = ($('search') as HTMLInputElement).value.trim().toLowerCase();
    const rows = tenants
      .filter((x) => !q || `${x.name ?? ''} ${x.email}`.toLowerCase().includes(q))
      .sort((a, b) => {
        const va = a[sortKey] ?? '', vb = b[sortKey] ?? '';
        const c = typeof va === 'number' && typeof vb === 'number' ? va - vb : String(va).localeCompare(String(vb));
        return desc ? -c : c;
      });
    $('rows').replaceChildren(...rows.map((x) => {
      const tr = document.createElement('tr');
      const who = document.createElement('td');
      const name = document.createElement('strong');
      name.textContent = x.name || '—';
      const mail = document.createElement('a');
      mail.href = `mailto:${x.email}`;
      mail.textContent = x.email;
      mail.className = 'super-mail';
      who.append(name, document.createElement('br'), mail);
      tr.append(who,
        cell(date.format(new Date(x.created_at))),
        cell(x.upcoming ? `${x.tastings} (${x.upcoming})` : String(x.tastings), 'num'),
        cell(String(x.wines), 'num'),
        cell(String(x.guests), 'num'),
        cell(x.invited ? `${x.invited} (${x.coming})` : '0', 'num'),
        cell(x.orders ? `${x.orders} · ${money(x.order_amount)}` : '0', 'num'),
        cell(String(x.ratings), 'num'),
        cell(String(x.chat_messages), 'num'),
        cell(date.format(new Date(x.last_activity))));
      return tr;
    }));
    document.querySelectorAll<HTMLElement>('th[data-sort]').forEach((th) => {
      th.setAttribute('aria-sort', th.dataset.sort === sortKey ? (desc ? 'descending' : 'ascending') : 'none');
    });
  }

  $('search').addEventListener('input', render);

  // ---------- GDPR ----------
  type Summary = { email: string; host: { name: string | null; tastings: number; wines: number; guests: number } | null;
    invitations: number; orders: number; ratings: number; chat_messages: number; library_entries: number; account: boolean; is_admin: boolean };
  let gdprEmail = '';
  const gdprMsg = (text: string, ok: boolean) => { const m = $('gdpr-msg'); m.textContent = text; m.className = 'message ' + (ok ? 'ok' : 'error'); m.hidden = !text; };

  $('gdpr-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    gdprMsg('', true);
    $('gdpr-result').hidden = true;
    gdprEmail = ($('gdpr-email') as HTMLInputElement).value.trim().toLowerCase();
    if (!gdprEmail) return;
    const { data, error } = await supabase.rpc('admin_person_summary', { e: gdprEmail });
    if (error || !data) { gdprMsg(t('admin.couldNotSave'), false); return; }
    const sum = data as Summary;
    const rows: string[] = [];
    if (sum.host) rows.push(t('super.gdprHost', { tastings: sum.host.tastings, wines: sum.host.wines, guests: sum.host.guests }));
    if (sum.invitations) rows.push(t('super.gdprInvites', { n: sum.invitations, orders: sum.orders, ratings: sum.ratings, chat: sum.chat_messages }));
    if (sum.library_entries) rows.push(t('super.gdprLibrary', { n: sum.library_entries }));
    if (sum.account) rows.push(t('super.gdprAccount'));
    if (!rows.length) { gdprMsg(t('super.gdprNothing'), true); return; }
    $('gdpr-list').replaceChildren(...rows.map((r) => { const li = document.createElement('li'); li.textContent = r; return li; }));
    const del = $('gdpr-delete') as HTMLButtonElement;
    del.hidden = sum.is_admin;
    del.textContent = t('super.gdprDelete');
    delete del.dataset.armed;
    if (sum.is_admin) gdprMsg(t('super.gdprAdmin'), false);
    $('gdpr-result').hidden = false;
  });

  $('gdpr-delete').addEventListener('click', async () => {
    const del = $('gdpr-delete') as HTMLButtonElement;
    if (!del.dataset.armed) { del.dataset.armed = '1'; del.textContent = t('super.gdprConfirm', { email: gdprEmail }); return; }
    del.disabled = true;
    const { error } = await supabase.rpc('admin_delete_person', { e: gdprEmail });
    del.disabled = false;
    if (error) { gdprMsg(t('admin.couldNotSave'), false); return; }
    $('gdpr-result').hidden = true;
    gdprMsg(t('super.gdprDone', { email: gdprEmail }), true);
    const { data } = await supabase.rpc('admin_tenants');
    if (Array.isArray(data)) { tenants = data as Tenant[]; totals(); render(); }
  });
  document.querySelectorAll<HTMLElement>('th[data-sort]').forEach((th) => {
    th.addEventListener('click', () => {
      const k = th.dataset.sort as keyof Tenant;
      if (k === sortKey) desc = !desc; else { sortKey = k; desc = k !== 'name'; }
      render();
    });
  });

  // ---------- Maps: demand for detailed maps, and places found by Cloudflare AI ----------
  async function loadMaps() {
    const [{ data: demand }, { data: guesses }] = await Promise.all([
      supabase.rpc('admin_map_demand'),
      supabase.from('appellation_guesses').select('key, name, country, lat, lon, created_at').order('created_at', { ascending: false }),
    ]);
    type D = { region: string; country: string | null; wines: number; tastings: number; upcoming: number; hosts: number };
    const rows = ((demand ?? []) as D[]).sort((a, b) => Number(!!mapIdFor(a.region)) - Number(!!mapIdFor(b.region)) || b.upcoming - a.upcoming || b.tastings - a.tastings);
    $('map-rows').replaceChildren(...rows.map((r) => {
      const tr = document.createElement('tr');
      const cell = (text: string, cls = '') => { const td = document.createElement('td'); td.textContent = text; if (cls) td.className = cls; return td; };
      const has = !!mapIdFor(r.region);
      const status = cell(has ? t('super.mapHas') : Number(r.upcoming) > 0 ? t('super.mapMissingSoon') : t('super.mapMissing'));
      status.className = has ? 'map-ok' : Number(r.upcoming) > 0 ? 'map-need' : 'map-missing';
      tr.append(cell(r.region), cell(countryName(r.country) ?? ''), cell(String(r.upcoming), 'num'), cell(String(r.tastings), 'num'),
        cell(String(r.wines), 'num'), cell(String(r.hosts), 'num'), status);
      return tr;
    }));
    type G = { key: string; name: string; country: string; lat: number; lon: number };
    const gs = (guesses ?? []) as G[];
    $('guesses-none').hidden = gs.length > 0;
    $('guess-rows').replaceChildren(...gs.map((g) => {
      const li = document.createElement('li');
      const text = document.createElement('span');
      text.textContent = `${g.name} · ${countryName(g.country)} · ${g.lat.toFixed(3)}, ${g.lon.toFixed(3)}`;
      const show = document.createElement('a');
      show.href = `https://www.google.com/maps?q=${g.lat},${g.lon}`;
      show.target = '_blank';
      show.rel = 'noopener';
      show.textContent = t('super.guessShow');
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'text-btn danger';
      del.textContent = t('super.guessDelete');
      del.addEventListener('click', async () => {
        const { error } = await supabase.rpc('admin_delete_place_guess', { k: g.key });
        if (!error) li.remove();
      });
      li.append(text, show, del);
      return li;
    }));
  }
</script>

<style is:global>
  .super-page .super-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0.75rem; margin: 0.5rem 0 2rem; }
  .super-page .stat { display: grid; gap: 0.1rem; padding: 0.9rem 1rem; background: var(--lodge-2); border: 1px solid var(--lodge-3); border-radius: 0.75rem; }
  .super-page th[data-sort] { cursor: pointer; user-select: none; white-space: nowrap; }
  .super-page th[aria-sort='ascending']::after { content: ' ▲'; font-size: 0.7em; }
  .super-page th[aria-sort='descending']::after { content: ' ▼'; font-size: 0.7em; }
  .super-page .super-table td { vertical-align: top; white-space: nowrap; }
  .super-page .super-mail { font-size: 0.85rem; color: var(--muted); }
  .super-page .table-wrap { overflow-x: auto; }
  .super-page .gdpr { margin-top: 3rem; max-width: 40rem; }
  .super-page .gdpr .inline-form { display: flex; gap: 0.5rem; }
  .super-page .gdpr input { flex: 1; min-width: 0; font: inherit; padding: 0.6rem 0.75rem; border: 1px solid var(--lodge-3); border-radius: var(--radius); background: var(--lodge-2); }
  .super-page .gdpr-list { margin: 1rem 0; padding-left: 1.2rem; }
  .super-page .danger-btn { background: var(--error); border-color: var(--error); color: #fff; }
  .maps-block h3 { font-family: var(--body); font-size: 1rem; margin: 1.5rem 0 0.3rem; }
  .map-ok, .map-need, .map-missing { white-space: nowrap; }
  .map-ok { color: var(--ok); }
  .map-need { color: var(--amber); font-weight: 600; }
  .map-missing { color: var(--muted); }
  .guess-list { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; gap: 0.4rem; }
  .guess-list li { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; align-items: center; font-size: 0.92rem; }
</style>
