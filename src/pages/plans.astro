---
// Features and plans – on the site (winetastr.com); "Get started" goes to the sign-up on the app's address. The site
// does not know about signing in (WIN-195), so it is the same for everyone.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import PlansAndFeatures from '../components/PlansAndFeatures.astro';
import { appUrl } from '../lib/hosts';
---
<Base title="page.plans">
  <section class="wrap plans-page">
    <PageHeader title="plans.title" lead="plans.lead" />
    <PlansAndFeatures cta={appUrl('/signup/')} />
  </section>
</Base>

<style>
  .plans-page { padding-top: 2.5rem; padding-bottom: 4rem; }
</style>
