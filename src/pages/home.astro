---
import Icon from '../components/ui/Icon.astro';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Loading from '../components/ui/Loading.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
---
<Base title="page.home">
  <section class="wrap page-pad home-page">
    <Loading />

    <div id="main" hidden>
      <PageHeader lead="home2.lead" leadId="home-lead"><Fragment slot="title"><span data-i18n="home2.hello">Hello</span><span id="hello-name"></span></Fragment></PageHeader>

      <!-- Workspaces: guest, host and (for administrators) superadmin -->
      <div id="ws-grid" class="ws-grid" hidden>
        <a id="ws-host" class="card ws-card" href="/admin/" hidden>
          <span class="ws-icon"><Icon name="gear" /></span>
          <span class="eyebrow" data-i18n="home2.host">As a host</span>
          <span class="ws-title" data-i18n="page.admin">Admin</span>
          <span id="ws-host-info" class="ws-info"></span>
          <Icon name="right" class="ws-go" />
        </a>

        <a id="ws-super" class="card ws-card" href="/superadmin/" hidden>
          <span class="ws-icon"><Icon name="verified" /></span>
          <span class="eyebrow">Winetastr</span>
          <span class="ws-title" data-i18n="page.superadmin">Superadmin</span>
          <span id="ws-super-info" class="ws-info"></span>
          <Icon name="right" class="ws-go" />
        </a>

        <a id="ws-become" class="card add ws-card ws-soft" href="/signup/" hidden>
          <span class="eyebrow" data-i18n="home2.hostToo">Host your own?</span>
          <span class="ws-title" data-i18n="page.signup">Sign up</span>
          <span class="ws-info" data-i18n="home2.hostTooText">Create a free host account and invite your own guests.</span>
          <Icon name="right" class="ws-go" />
        </a>
      </div>

      <!-- The guest's home (src/lib/guest-home.ts): the next tasting large, what is waiting, the wine book in short,
           where the wines come from, and the tastings they have been to -->
      <div id="my-tastings" class="guest-home">
        <!-- 1. The next tasting: the map of its wines behind, the countdown and the answer, one button -->
        <section id="next-block" class="card next-card has-map-bg" hidden>
          <div id="next-map" class="hero-bg" aria-hidden="true"></div>
          <SectionTitle level="eyebrow" as="h2" text="dash.next" />
          <div id="next-chips" class="chips"></div>
          <p class="next-title"><a id="next-open" href="/home/"><span id="next-title"></span></a></p>
          <ul class="hero-when">
            <li id="next-f-when" hidden><Icon name="calendar" /><span id="next-when"></span></li>
            <li id="next-f-place" hidden><Icon name="pin" /><span id="next-place"></span></li>
          </ul>
          <div class="actions"><a id="next-go" class="btn" href="/home/"></a></div>
        </section>

        <!-- 2. Waiting for you: only when something is -->
        <section id="waiting-block" class="home-section" hidden>
          <SectionTitle level="eyebrow" as="h2" text="home3.waiting" />
          <ul id="waiting-list" class="list"></ul>
        </section>

        <section id="other-block" class="home-section" hidden>
          <SectionTitle level="eyebrow" as="h2" text="home3.otherUpcoming" />
          <ul id="other-list" class="cards"></ul>
        </section>

        <!-- 3. The wine book in short -->
        <section id="book-block" class="home-section" hidden>
          <SectionTitle level="eyebrow" as="h2" text="book.title" />
          <ul class="stats">
            <li class="card stat"><b id="hs-wines" class="stat-n">0</b><span class="stat-label" data-i18n="book.statWines">wines tasted</span></li>
            <li class="card stat"><b id="hs-tastings" class="stat-n">0</b><span class="stat-label" data-i18n="book.statTastings">tastings</span></li>
            <li class="card stat"><b id="hs-bottles" class="stat-n">0</b><span class="stat-label" data-i18n="book.statBottles">bottles bought</span></li>
          </ul>
          <h3 id="fav-h" class="fav-h" data-i18n="home3.favourites" hidden>Your favourites</h3>
          <ul id="fav-list" class="cards"></ul>
          <p class="book-more"><a class="text-btn fwd" href="/my/"><span data-i18n="home3.allBook">See your whole wine book</span><Icon name="right" /></a></p>
        </section>

        <!-- 4. Where the wines come from -->
        <section id="map-block" class="home-section" hidden>
          <SectionTitle level="eyebrow" as="h2" text="home3.mapTitle" />
          <div id="home-map" class="map-box"></div>
          <p id="home-map-source" class="map-credit"></p>
        </section>

        <!-- 5. The tastings they have been to -->
        <section id="past-block" class="home-section" hidden>
          <SectionTitle level="eyebrow" as="h2" text="home3.memories" />
          <ul id="past-list" class="cards"></ul>
        </section>
      </div>

      <EmptyState id="none" icon="calendar" title="tastings.none" text="tastings.noneHint" hidden>
        <a class="btn small secondary" href="/login/?next=/home/" data-i18n="home.otherEmail">Sign in with another email</a>
      </EmptyState>
    </div>
  </section>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  import { storedWorkspace } from '../lib/workspace';
  import { loadMe, getCodes } from '../lib/guest';
  import { loadAllMyTastings } from '../lib/my-tastings';
  import { showGuestHome } from '../lib/guest-home';
  import { landingUrl } from '../lib/landing';
  import { i18nReady, t } from '../i18n';

  await i18nReady;
  import { $ } from '../lib/ui/dom';

  const { data: s } = await supabase.auth.getSession();
  if (!s.session && Object.keys(getCodes()).length === 0) location.replace('/login/');

  const [me, mine, host, admin] = await Promise.all([
    loadMe(),
    loadAllMyTastings(),
    // The account chosen last in the admin (the database falls back to the default one)
    s.session ? supabase.rpc('host_dashboard', { tn: storedWorkspace() }) : Promise.resolve({ data: null }),
    s.session ? supabase.rpc('is_admin') : Promise.resolve({ data: false }),
  ]);
  // Only one place to go (just a host, or a guest with one tasting): go there directly
  const isHostNow = !!(host.data && typeof host.data === 'object' && 'tastings' in host.data);
  const to = landingUrl(mine.all, isHostNow, admin.data === true);
  if (to && to !== '/home/') { location.replace(to); await new Promise(() => {}); }
  $('loading').hidden = true;
  $('main').hidden = false;

  const first = (me?.name ?? '').split(' ')[0];
  if (first) $('hello-name').textContent = `, ${first}`;

  // Guest: the home of their tastings (src/lib/guest-home.ts)
  const { all, upcoming, past } = mine;
  const guestHome = showGuestHome({ upcoming, past, signedIn: !!me?.signedIn });

  // Host
  type Dash = { tastings: number; upcoming: number; next: { title: string; starts_at: string | null; coming: number; invited: number } | null };
  const dash = host.data && typeof host.data === 'object' && 'tastings' in host.data ? (host.data as Dash) : null;
  if (dash) {
    $('ws-host').hidden = false;
    $('ws-host-info').textContent = dash.next
      ? `${dash.next.title} · ${t('tastingsAdmin.guests', { coming: dash.next.coming, n: dash.next.invited })}`
      : t('dash.upcoming', { n: dash.upcoming });
  } else if (s.session) {
    $('ws-become').hidden = false;
  }

  // Superadmin
  if (admin.data === true) {
    $('ws-super').hidden = false;
    const { data: tenants } = await supabase.rpc('admin_tenants');
    if (Array.isArray(tenants)) $('ws-super-info').textContent = t('home2.hosts', { n: tenants.length });
  }

  $('none').hidden = all.length > 0 || !!dash;
  // The places to go (host, superadmin, "host your own") only when there are any; the line over them with them
  const anyWs = ['ws-host', 'ws-super'].some((id) => !$(id).hidden);
  $('ws-grid').hidden = !anyWs;
  $('home-lead').hidden = !anyWs;
  // A guest who is no host: "Host your own?" goes last, after their tastings
  if (!anyWs && !$('ws-become').hidden) {
    const end = Object.assign(document.createElement('section'), { className: 'home-section become-end' });
    end.append($('ws-become'));
    $('my-tastings').after(end);
  }
  await guestHome;
</script>

<style is:global>
  .home-page { max-width: 56rem; }
  .ws-grid { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .ws-card { position: relative; display: grid; align-content: start; gap: 0.25rem; padding: 1.3rem 1.3rem 1.2rem; }
  .ws-icon { width: 2.6rem; height: 2.6rem; border-radius: var(--radius); display: grid; place-items: center; background: var(--lodge); color: var(--amber); margin-bottom: 0.6rem; }
  .ws-icon svg.i { width: 1.45rem; height: 1.45rem; }
  .ws-icon svg[viewBox='0 0 100 100'] { width: 1.6rem; height: 1.6rem; }
  .ws-card .eyebrow { margin: 0; }
  .ws-title { font-family: var(--display); font-size: 1.7rem; line-height: 1.1; }
  .ws-info { font-size: 0.92rem; color: var(--muted); margin-top: 0.2rem; }
  .ws-go { position: absolute; top: 1.2rem; right: 1.2rem; color: var(--amber); }
  .ws-soft { place-items: stretch; text-align: left; font-weight: 400; color: var(--paper); }
  #my-tastings { scroll-margin-top: 5rem; }
  .book-more { margin: 1rem 0 0; }
  .home-section { margin-top: 2.5rem; }
  .home-section > .eyebrow { margin-bottom: 0.8rem; }
  .ws-grid[hidden] { display: none; }
  .ws-grid:not([hidden]) + .guest-home { margin-top: 2.5rem; }
  /* The next tasting: large, the map of its wines faint in the corner */
  .next-card { display: grid; gap: 0.7rem; justify-items: start; padding: 1.4rem 1.4rem 1.5rem; }
  .next-card > .eyebrow { margin: 0; }
  .next-card .chips { margin: 0; }
  .next-title { margin: 0; font-family: var(--display); font-size: clamp(2rem, 7vw, 2.8rem); line-height: 1.05; }
  .next-title a { color: var(--paper); text-decoration: none; }
  .next-title a:hover { color: var(--amber); }
  .next-card .actions { margin-top: 0.3rem; }
  .waiting-row .laside .btn { white-space: nowrap; }
  .fav-h { margin: 1.4rem 0 0.7rem; font-size: 1rem; font-weight: 600; }
  .lmeta.memory { color: var(--amber); }
  .become-end > .ws-card { max-width: 26rem; }
</style>
