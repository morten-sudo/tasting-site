---
import Base from '../layouts/Base.astro';
---
<Base hero>
  <!-- Hero: what Winetastr is, with the two ways in -->
  <section class="hero">
    <picture>
      <source type="image/webp" srcset="/img/cellar-800.webp 800w, /img/cellar-1200.webp 1200w" sizes="100vw" />
      <img
        src="/img/cellar-1200.jpg"
        srcset="/img/cellar-800.jpg 800w, /img/cellar-1200.jpg 1200w"
        sizes="100vw" width="1200" height="800"
        alt="Rows of wine barrels in a dark cellar" data-i18n-attr="alt=home.heroAlt"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-text wrap">
      <p class="eyebrow" data-i18n="home.eyebrow">Wine tastings</p>
      <h1 data-i18n="landing.title">Host wine tastings your guests remember</h1>
      <p class="hero-lead" data-i18n="landing.lead">Invitations, the wines, orders, ratings and a quiz – all on your guests' phones. Free to get started.</p>
      <!-- Signed out: start or sign in. Signed in: go home -->
      <div id="cta-out" class="hero-ctas">
        <a class="btn hero-btn" href="/signup/" data-i18n="signup.formTitle">Create your free account</a>
        <a class="btn ghost-light hero-btn" href="/login/" data-i18n="nav.signIn">Sign in</a>
      </div>
      <div id="cta-in" class="hero-ctas" hidden>
        <a class="btn hero-btn" href="/home/"><span data-i18n="landing.goHome">Go to your home</span> →</a>
      </div>
      <p id="invited-note" class="hero-note"><span data-i18n="landing.invited">Invited to a tasting?</span> <a href="/login/" data-i18n="home.signInHere">Sign in here</a> – <span data-i18n="landing.invitedText">or open the link in your invitation.</span></p>
    </div>
  </section>

  <!-- How it works -->
  <section class="wrap ld-section">
    <h2 class="ld-h2" data-i18n="landing.howTitle">How it works</h2>
    <ol class="ld-steps">
      <li>
        <span class="ld-num">1</span>
        <h3 data-i18n="landing.s1">Create the tasting</h3>
        <p data-i18n="landing.s1Text">Date, place and an introduction. Add the wines with a photo of the label or a link from the shop.</p>
      </li>
      <li>
        <span class="ld-num">2</span>
        <h3 data-i18n="landing.s2">Invite your guests</h3>
        <p data-i18n="landing.s2Text">Each guest gets a personal link. You follow who is coming – no app, no passwords.</p>
      </li>
      <li>
        <span class="ld-num">3</span>
        <h3 data-i18n="landing.s3">Enjoy the evening</h3>
        <p data-i18n="landing.s3Text">Guests see the wines, rate them, order bottles, chat and play the quiz while the standings run on the TV.</p>
      </li>
    </ol>
  </section>

  <!-- Highlights -->
  <section class="wrap ld-section">
    <h2 class="ld-h2" data-i18n="signup.featuresTitle">Everything for the evening</h2>
    <ul class="ld-features">
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.5-2.5h7L17 8h3v11H4z" /><circle cx="12" cy="13.5" r="3.5" /></svg>
        <div><h3 data-i18n="signup.f2Title">The wines on every phone</h3><p data-i18n="signup.f2Text">Photos, descriptions and prices. Snap the label or paste a shop link, and the details fill themselves in.</p></div>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z" /><path d="M9 7V5.5a3 3 0 0 1 6 0V7" /></svg>
        <div><h3 data-i18n="signup.f3Title">Orders and payment</h3><p data-i18n="signup.f3Text">Guests order bottles during the evening – with quantity prices – and pay with MobilePay. You get the shopping list.</p></div>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8M12 16v4M7 12V9M11 12V7M15 12v-2" /></svg>
        <div><h3 data-i18n="signup.f5Title">Quiz with a live leaderboard</h3><p data-i18n="signup.f5Text">Write your own questions and show the standings on the TV while the answers come in.</p></div>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M3.5 12h17M12 3.5c2.4 2.4 3.5 5.3 3.5 8.5s-1.1 6.1-3.5 8.5c-2.4-2.4-3.5-5.3-3.5-8.5S9.6 5.9 12 3.5z" /></svg>
        <div><h3 data-i18n="signup.f6Title">In your guests' language</h3><p data-i18n="signup.f6Text">Nine languages. Each tasting has its own, and every guest can switch for themselves.</p></div>
      </li>
    </ul>
    <p class="ld-more"><a href="/signup/" data-i18n="landing.more">All features and plans →</a></p>
  </section>

  <!-- Closing call to action -->
  <section class="wrap ld-final">
    <h2 class="ld-h2" data-i18n="signup.finalTitle">Ready for your next tasting?</h2>
    <p data-i18n="landing.finalText">It takes two minutes to create an account and your first tasting.</p>
    <div class="ld-final-ctas">
      <a class="btn" href="/signup/" data-i18n="signup.formTitle">Create your free account</a>
      <a class="ld-link" href="/login/" data-i18n="landing.haveAccount">I already have an account</a>
    </div>
  </section>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  import { getCodes } from '../lib/guest';
  import { i18nReady } from '../i18n';

  await i18nReady;
  const { data } = await supabase.auth.getSession();
  // Signed in (or with an invitation on this device): one button home instead of sign-up / sign-in
  if (data.session || Object.keys(getCodes()).length > 0) {
    document.getElementById('cta-out')!.hidden = true;
    document.getElementById('cta-in')!.hidden = false;
    document.getElementById('invited-note')!.hidden = true;
  }
</script>

<style>
  .hero { position: relative; min-height: min(78vh, 40rem); display: flex; align-items: flex-end; overflow: hidden; background: #241014; }
  .hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 52% 50%; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(36, 10, 16, 0.93) 0%, rgba(36, 10, 16, 0.6) 45%, rgba(36, 10, 16, 0.15) 100%); }
  .hero-text { position: relative; z-index: 1; padding-top: 6rem; padding-bottom: 2.5rem; color: #fff; }
  .hero-text .eyebrow { margin: 0 0 0.6rem 0.1rem; color: #fff; opacity: 0.85; }
  h1 {
    font-family: var(--display); font-weight: 500; font-size: clamp(2.6rem, 7.5vw, 5rem);
    line-height: 1; margin: 0; max-width: 17ch; color: #fff;
  }
  .hero-lead { font-size: clamp(1.05rem, 2.6vw, 1.25rem); line-height: 1.5; max-width: 34rem; margin: 1.1rem 0 1.6rem; opacity: 0.92; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero-ctas[hidden] { display: none; }
  .hero-btn { min-height: 3.2rem; padding: 0 1.6rem; font-size: 1rem; }
  .ghost-light { background: transparent; color: #fff; border: 1px solid rgba(255, 255, 255, 0.7); }
  .ghost-light:hover { background: rgba(255, 255, 255, 0.12); color: #fff; }
  .hero-note { margin: 1.2rem 0 0; font-size: 0.92rem; opacity: 0.9; }
  .hero-note[hidden] { display: none; }
  .hero-note a { color: #fff; text-decoration: underline; text-underline-offset: 0.2em; }

  .ld-section { margin-top: 4.5rem; }
  .ld-h2 { font-size: clamp(1.9rem, 5vw, 2.6rem); margin: 0 0 1.6rem; }
  .ld-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .ld-num {
    display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%;
    background: var(--amber); color: #fff; font-weight: 600; margin-bottom: 0.8rem;
  }
  .ld-steps h3, .ld-features h3 { margin: 0 0 0.35rem; font-family: var(--body); font-size: 1.08rem; font-weight: 600; }
  .ld-steps p, .ld-features p { margin: 0; color: var(--muted); line-height: 1.55; }
  .ld-features { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 48rem) { .ld-features { grid-template-columns: 1fr 1fr; } }
  .ld-features li { display: flex; gap: 1rem; padding: 1.2rem; background: var(--lodge-2); border: 1px solid var(--lodge-3); border-radius: 0.8rem; }
  .ld-features svg { width: 1.8rem; height: 1.8rem; flex-shrink: 0; fill: none; stroke: var(--amber); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .ld-more { margin: 1.2rem 0 0; }
  .ld-more a { color: var(--amber); font-weight: 500; text-decoration: none; }
  .ld-final {
    margin-top: 4.5rem; margin-bottom: 3.5rem; padding-top: 2.5rem; padding-bottom: 2.5rem; text-align: center;
    background: var(--lodge-2); border-top: 1px solid var(--lodge-3); border-bottom: 1px solid var(--lodge-3);
  }
  .ld-final .ld-h2 { margin-bottom: 0.6rem; }
  .ld-final p { color: var(--muted); margin: 0 auto 1.4rem; max-width: 34rem; }
  .ld-final-ctas { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; justify-content: center; align-items: center; }
  .ld-link { color: var(--amber); }
</style>
