---
import Base from '../layouts/Base.astro';
import { EVENT } from '../lib/config';
---
<Base hero>
  <section class="hero">
    <picture>
      <source type="image/webp" srcset="/img/kaelder-800.webp 800w, /img/kaelder-1200.webp 1200w" sizes="100vw" />
      <img
        src="/img/kaelder-1200.jpg"
        srcset="/img/kaelder-800.jpg 800w, /img/kaelder-1200.jpg 1200w"
        sizes="100vw"
        width="1200"
        height="800"
        alt="Portvinsfade i lange rækker i en mørk kælder i Vila Nova de Gaia"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-text wrap">
      <h1>Portvin</h1>
    </div>
  </section>

  <section class="wrap when-block">
    <p class="when">{EVENT.dateLong}</p>
    <p class="time">{EVENT.time}</p>
    {EVENT.place && <p class="where">{EVENT.place}</p>}
  </section>

  <section class="wrap intro">
    <p>
      En aften med portvin fra Douro og et smut forbi Rivesaltes. Vi smager os
      gennem stilarterne, hører historien bag og slutter af med en quiz, hvor
      pointtavlen følger med hele vejen.
    </p>
    <a class="btn-ghost" href="/vine/">Se vinene</a>
  </section>

  <section class="wrap rsvp">
    <h2>Tilmelding</h2>
    <div id="rsvp-known" hidden>
      <p>Du har allerede åbnet din invitation på denne telefon eller computer.</p>
      <a class="btn" href="/invitation/">Se eller ret din tilmelding</a>
    </div>
    <p id="rsvp-unknown">
      Du tilmelder dig via det personlige link i din invitation. Har du ikke fået
      et, så skriv til værten.
    </p>
  </section>
</Base>

<script>
  let known = false;
  try { known = !!localStorage.getItem('portvin_kode'); } catch {}
  if (known) {
    document.getElementById('rsvp-known')!.hidden = false;
    document.getElementById('rsvp-unknown')!.hidden = true;
  }
</script>

<style>
  .hero {
    position: relative;
    height: min(64vh, 34rem);
    min-height: 24rem;
    overflow: hidden;
    background: var(--lodge);
  }
  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 50%;
  }
  /* Mørkt øverst til menuen, glider ned i siden forneden */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(11, 9, 8, 0.85) 0%,
      rgba(11, 9, 8, 0) 22%,
      rgba(11, 9, 8, 0) 55%,
      var(--lodge) 100%
    );
  }
  .hero-text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.4rem;
    z-index: 1;
  }
  h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(5.5rem, 27vw, 10.5rem);
    line-height: 0.85;
    letter-spacing: 0.01em;
    margin: 0;
    color: var(--paper);
  }
  .when-block { padding-top: 1rem; }
  .when {
    font-size: 1.3rem;
    line-height: 1.35;
    margin: 0;
  }
  .time {
    margin: 0.15rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .where { color: var(--muted); margin-top: 0.4rem; }
  .intro { margin-top: 1.5rem; }
  .intro p { max-width: 34rem; }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.25rem;
    border-radius: 0.6rem;
    border: 1px solid var(--lodge-3);
    color: var(--paper);
    text-decoration: none;
  }
  .btn-ghost:hover { border-color: var(--amber); color: var(--paper); }
  .rsvp { margin-top: 2.5rem; }
</style>
