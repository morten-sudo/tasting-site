---
import Base from '../layouts/Base.astro';
---
<Base hero>
  <section class="hero">
    <picture>
      <source type="image/webp" srcset="/img/cellar-800.webp 800w, /img/cellar-1200.webp 1200w" sizes="100vw" />
      <img
        src="/img/cellar-1200.jpg"
        srcset="/img/cellar-800.jpg 800w, /img/cellar-1200.jpg 1200w"
        sizes="100vw"
        width="1200"
        height="800"
        alt="Rows of wine barrels in a dark cellar" data-i18n-attr="alt=home.heroAlt"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-text wrap">
      <p class="eyebrow" data-i18n="home.eyebrow">Wine tastings</p>
      <h1>Winetastr</h1>
    </div>
  </section>

  <section class="wrap intro">
    <p class="lead" data-i18n="home.lead">
      Invite your guests, show them the wines, take orders and finish with a quiz
      with a live leaderboard all evening.
    </p>
  </section>

  <section class="wrap choices">
    <!-- Not signed in: sign in. Signed in: the upcoming tastings -->
    <div id="signed-out" class="choice">
      <a class="btn" href="/login/" data-i18n="home.signInHere">Sign in here</a>
    </div>
    <div id="signed-in" class="choice" hidden>
      <h2 id="upcoming-title" data-i18n="home.upcomingMany">Upcoming tastings</h2>
      <ul id="upcoming" class="tasting-list"></ul>
      <p id="no-upcoming" class="hint" hidden><span data-i18n="home.noUpcoming">No upcoming tastings.</span> <a href="/tastings/" data-i18n="nav.myTastings">My tastings</a></p>
    </div>
    <div class="choice">
      <h2 data-i18n="home.hostTitle">Hosting a tasting?</h2>
      <p data-i18n="home.hostText">It is free to get started.</p>
      <a class="btn-ghost" href="/become-host/" data-i18n="home.becomeHost">Become a host</a>
    </div>
  </section>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  import { getCodes } from '../lib/guest';
  import { loadAllMyTastings, tastingCard } from '../lib/my-tastings';
  import { i18nReady, t } from '../i18n';

  await i18nReady;
  const $ = (id: string) => document.getElementById(id)!;
  const { data } = await supabase.auth.getSession();
  if (data.session || Object.keys(getCodes()).length > 0) {
    $('signed-out').hidden = true;
    $('signed-in').hidden = false;
    const { upcoming } = await loadAllMyTastings();
    $('upcoming-title').textContent = t(upcoming.length === 1 ? 'home.upcomingOne' : 'home.upcomingMany');
    $('upcoming').replaceChildren(...upcoming.map(tastingCard));
    $('no-upcoming').hidden = upcoming.length > 0;
  }
</script>

<style>
  .hero {
    position: relative;
    height: min(52vh, 30rem);
    min-height: 18rem;
    overflow: hidden;
    background: var(--lodge);
  }
  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 50%;
  }
  /* Dark at the bottom so the white title reads on the photo */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(36, 10, 16, 0.78) 0%, rgba(36, 10, 16, 0) 60%);
  }
  .hero-text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.25rem;
    z-index: 1;
  }
  h1 {
    font-family: var(--display);
    font-weight: 400;
    font-weight: 300;
    font-weight: 500;
    font-size: clamp(3.5rem, 16vw, 8rem);
    line-height: 0.95;
    letter-spacing: 0.01em;
    margin: 0;
    color: #ffffff;
  }
  .hero-text .eyebrow { margin: 0 0 0.4rem 0.15rem; color: #ffffff; opacity: 0.9; }
  .when-block { padding-top: 1rem; }
  .when {
    font-family: var(--display);
    font-size: 1.6rem;
    font-style: italic;
    line-height: 1.3;
    margin: 0;
  }
  .time {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .where { color: var(--muted); margin-top: 0.4rem; }
  .intro { margin-top: 1.5rem; }
  .intro p { max-width: 34rem; }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.75rem;
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: var(--radius);
    border: 1px solid var(--amber);
    color: var(--amber);
    background: #ffffff;
    text-decoration: none;
  }
  .btn-ghost:hover { border-color: var(--amber); color: var(--paper); }
  .lead { font-size: 1.1rem; }
  .choices {
    display: grid; gap: 2rem; margin: 2.5rem 0 3rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .choice h2 { font-size: 1.7rem; }
  #signed-in { grid-column: 1 / -1; }
</style>
