---
import Base from '../layouts/Base.astro';
---
<Base hero>
  <section class="hero">
    <picture>
      <source type="image/webp" srcset="/img/cellar-800.webp 800w, /img/cellar-1200.webp 1200w" sizes="100vw" />
      <img
        src="/img/cellar-1200.jpg"
        srcset="/img/cellar-800.jpg 800w, /img/cellar-1200.jpg 1200w"
        sizes="100vw"
        width="1200"
        height="800"
        alt="Vinfade i lange rækker i en mørk kælder"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-text wrap">
      <p class="eyebrow">Vinsmagninger</p>
      <h1>Winetastr</h1>
    </div>
  </section>

  <section class="wrap intro">
    <p class="lead">
      Inviter dine gæster, vis dem vinene, tag imod bestillinger og slut af med en
      quiz, hvor pointtavlen følger med hele aftenen.
    </p>
  </section>

  <section class="wrap choices">
    <div class="choice">
      <h2>Er du inviteret?</h2>
      <p id="guest-known" hidden>Du er logget ind på denne enhed.</p>
      <p id="guest-unknown">Log ind med din e-mail eller med linket i din invitation.</p>
      <a id="guest-btn" class="btn" href="/login/">Log ind</a>
    </div>
    <div class="choice">
      <h2>Vil du holde en smagning?</h2>
      <p>Det er gratis at komme i gang.</p>
      <a class="btn-ghost" href="/become-host/">Bliv vært</a>
    </div>
  </section>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  import { getCodes } from '../lib/guest';

  const { data } = await supabase.auth.getSession();
  if (data.session || Object.keys(getCodes()).length > 0) {
    document.getElementById('guest-known')!.hidden = false;
    document.getElementById('guest-unknown')!.hidden = true;
    const btn = document.getElementById('guest-btn') as HTMLAnchorElement;
    btn.href = '/tastings/';
    btn.textContent = 'Mine smagninger';
  }
</script>

<style>
  .hero {
    position: relative;
    height: min(64vh, 34rem);
    min-height: 24rem;
    overflow: hidden;
    background: var(--lodge);
  }
  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 50%;
  }
  /* Dark at the top behind the header, fading into the page at the bottom */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(11, 9, 8, 0.85) 0%,
      rgba(11, 9, 8, 0) 22%,
      rgba(11, 9, 8, 0) 55%,
      var(--lodge) 100%
    );
  }
  .hero-text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.4rem;
    z-index: 1;
  }
  h1 {
    font-family: var(--display);
    font-weight: 400;
    font-weight: 300;
    font-size: clamp(4.75rem, 22vw, 10rem);
    line-height: 0.9;
    letter-spacing: 0.01em;
    margin: 0;
    color: var(--paper);
  }
  .hero-text .eyebrow { margin: 0 0 0.6rem 0.2rem; color: #d8cdbd; }
  .when-block { padding-top: 1rem; }
  .when {
    font-family: var(--display);
    font-size: 1.6rem;
    font-style: italic;
    line-height: 1.3;
    margin: 0;
  }
  .time {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .where { color: var(--muted); margin-top: 0.4rem; }
  .intro { margin-top: 1.5rem; }
  .intro p { max-width: 34rem; }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.75rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-radius: var(--radius);
    border: 1px solid var(--lodge-3);
    color: var(--paper);
    text-decoration: none;
  }
  .btn-ghost:hover { border-color: var(--amber); color: var(--paper); }
  .lead { font-size: 1.1rem; }
  .choices {
    display: grid; gap: 2rem; margin: 2.5rem 0 3rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .choice h2 { font-size: 1.7rem; }
</style>
