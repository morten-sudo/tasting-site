---
import Base from '../layouts/Base.astro';
---
<Base title="Vinene">
  <section class="wrap vine-page">
    <h1 class="title">Vinene</h1>
    <p id="intro" class="lead">Det her skænker vi i aften.</p>

    <p id="order-status" class="message" hidden></p>

    <p id="loading" class="hint">Henter vinene …</p>
    <p id="load-error" class="message error" hidden>
      Vinene kunne ikke hentes. Tjek din forbindelse, og genindlæs siden.
    </p>

    <nav id="style-chips" class="chips" aria-label="Spring til en stilart" hidden></nav>

    <div id="wine-list" class="carousel" role="region" aria-roledescription="karrusel" aria-label="Vinene" tabindex="0"></div>

    <div id="carousel-nav" class="carousel-nav" hidden>
      <button type="button" id="prev" class="nav-btn" aria-label="Forrige vin">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <p id="counter" class="counter" aria-live="polite"></p>
      <button type="button" id="next" class="nav-btn" aria-label="Næste vin">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </section>

  <a id="basket" class="basket" href="/kurv/" hidden>
    <div class="wrap basket-inner">
      <div>
        <span id="basket-count"></span>
        <strong id="basket-total"></strong>
      </div>
      <span class="basket-go">Gå til kurven</span>
    </div>
  </a>
</Base>

<script>
  import { supabase, getGuestCode } from '../lib/supabase';
  import { getCart, addToCart, cartCount } from '../lib/cart';

  type Wine = {
    id: number; sort_order: number; name: string; producer: string | null;
    style: string | null; vintage: string | null; abv: number | null;
    price_dkk: number | null; description: string | null; orderable: boolean;
    image_url: string | null; details: string | null; retail_price_dkk: number | null;
  };

  const STYLE_LABELS: Record<string, string> = {
    Vintage: 'Vintage',
    Tawny: 'Tawny',
    Rivesaltes: 'Rivesaltes Ambré',
    White: 'Hvid portvin',
    Aguardente: 'Druebrændevin',
  };

  // Farven på stilartens mærke: portvinens skala fra ruby til gammel ravfarve
  const STYLE_TONES: Record<string, string> = {
    Vintage: '#a3213a',
    Tawny: '#b8742e',
    Rivesaltes: '#9c4a2c',
    White: '#e0c27a',
    Aguardente: '#dba65a',
  };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const kr = new Intl.NumberFormat('da-DK', { style: 'currency', currency: 'DKK' });
  const $ = (id: string) => document.getElementById(id)!;

  const code = getGuestCode();
  let wines: Wine[] = [];
  let ordering = false;

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }

  function renderBasket() {
    if (!ordering) return;
    const cart = getCart();
    let total = 0;
    for (const w of wines) total += (cart[w.id] ?? 0) * (w.price_dkk ?? 0);
    const bottles = cartCount(cart);
    $('basket').hidden = bottles === 0;
    $('basket-count').textContent = `${bottles} ${bottles === 1 ? 'flaske' : 'flasker'} i kurven, `;
    $('basket-total').textContent = kr.format(total);
  }

  function addButton(w: Wine) {
    const btn = el('button', 'add');
    btn.type = 'button';
    const sync = () => {
      const n = getCart()[w.id] ?? 0;
      btn.textContent = n ? `Læg i kurv (${n} i kurven)` : 'Læg i kurv';
      btn.classList.toggle('in-cart', n > 0);
    };
    btn.addEventListener('click', () => {
      addToCart(w.id);
      sync();
      btn.classList.remove('pop');
      void btn.offsetWidth;
      btn.classList.add('pop');
    });
    window.addEventListener('cart-change', sync);
    sync();
    return btn;
  }

  function wineCard(w: Wine, index: number, total: number) {
    const li = el('li', 'card');
    li.dataset.style = w.style ?? 'Øvrige';
    li.setAttribute('aria-roledescription', 'vin');
    li.setAttribute('aria-label', `${index + 1} af ${total}: ${w.name}`);

    const pic = el('div', 'pic');
    if (w.image_url) {
      const img = el('img');
      img.src = w.image_url;
      img.alt = '';
      img.loading = index < 2 ? 'eager' : 'lazy';
      img.decoding = 'async';
      img.referrerPolicy = 'no-referrer';
      img.addEventListener('error', () => pic.classList.add('empty'));
      pic.append(img);
    } else {
      pic.classList.add('empty');
    }
    const no = el('span', 'no', String(index + 1).padStart(2, '0'));
    no.setAttribute('aria-hidden', 'true');
    pic.append(no);
    li.append(pic);

    const info = el('div', 'info');
    const tag = el('p', 'style-tag', STYLE_LABELS[w.style ?? ''] ?? w.style ?? '');
    tag.style.setProperty('--tone', STYLE_TONES[w.style ?? ''] ?? 'var(--amber)');
    info.append(tag);
    info.append(el('h3', 'name', w.name));
    const meta = [w.producer, w.abv ? `${w.abv.toString().replace('.', ',')} %` : null]
      .filter(Boolean).join(', ');
    if (meta) info.append(el('p', 'meta', meta));
    if (w.description) info.append(el('p', 'desc', w.description));
    if (w.details) {
      const more = el('details', 'more');
      more.append(el('summary', '', 'Læs mere'));
      const dl = el('dl');
      for (const line of w.details.split('\n')) {
        const i = line.indexOf(':');
        if (i > 0 && i < 30) {
          dl.append(el('dt', '', line.slice(0, i)), el('dd', '', line.slice(i + 1).trim()));
        } else if (line.trim()) {
          dl.append(el('dd', '', line.trim()));
        }
      }
      more.append(dl);
      info.append(more);
    }

    const buy = el('div', 'buy');
    if (w.price_dkk != null) {
      const price = el('p', 'price');
      price.append(el('span', 'ours', kr.format(w.price_dkk)));
      if (w.retail_price_dkk != null && w.retail_price_dkk > w.price_dkk) {
        const normal = el('span', 'normal');
        normal.append('Normalpris ', el('s', '', kr.format(w.retail_price_dkk)));
        price.append(normal);
      }
      buy.append(price);
    }
    if (ordering && w.orderable) buy.append(addButton(w));
    info.append(buy);

    li.append(info);
    return li;
  }

  let cards: HTMLElement[] = [];
  let current = 0;

  function scrollToCard(i: number) {
    const track = $('wine-list').querySelector('.track') as HTMLElement;
    const card = cards[Math.max(0, Math.min(cards.length - 1, i))];
    if (!track || !card) return;
    const pad = parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0;
    track.scrollTo({ left: card.offsetLeft - track.offsetLeft - pad, behavior: reduceMotion ? 'auto' : 'smooth' });
  }

  function setCurrent(i: number) {
    current = i;
    $('counter').textContent = `${i + 1} af ${cards.length}`;
    ($('prev') as HTMLButtonElement).disabled = i === 0;
    ($('next') as HTMLButtonElement).disabled = i === cards.length - 1;
    const style = cards[i]?.dataset.style;
    for (const chip of $('style-chips').querySelectorAll<HTMLButtonElement>('button')) {
      const on = chip.dataset.style === style;
      chip.classList.toggle('on', on);
      chip.setAttribute('aria-pressed', String(on));
    }
    cards.forEach((c, n) => c.classList.toggle('is-current', n === i));
  }

  function render() {
    const list = $('wine-list');
    list.replaceChildren();
    const track = el('ul', 'track');
    cards = wines.map((w, i) => wineCard(w, i, wines.length));
    track.append(...cards);
    list.append(track);

    // Stilarter som genveje, i den rækkefølge de skænkes
    const chips = $('style-chips');
    chips.replaceChildren();
    const seen = new Set<string>();
    wines.forEach((w, i) => {
      const style = w.style ?? 'Øvrige';
      if (seen.has(style)) return;
      seen.add(style);
      const b = el('button', 'chip', STYLE_LABELS[style] ?? style);
      b.type = 'button';
      b.dataset.style = style;
      b.style.setProperty('--tone', STYLE_TONES[style] ?? 'var(--amber)');
      b.addEventListener('click', () => scrollToCard(i));
      chips.append(b);
    });
    chips.hidden = seen.size < 2;
    $('carousel-nav').hidden = cards.length < 2;

    let ticking = false;
    track.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const x = track.scrollLeft;
        let best = 0, dist = Infinity;
        cards.forEach((c, n) => {
          const d = Math.abs(c.offsetLeft - track.offsetLeft - (parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0) - x);
          if (d < dist) { dist = d; best = n; }
        });
        if (best !== current) setCurrent(best);
      });
    }, { passive: true });

    list.addEventListener('keydown', (e) => {
      if (e.target !== list) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); scrollToCard(current + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); scrollToCard(current - 1); }
    });

    setCurrent(0);
    renderBasket();
  }

  $('prev').addEventListener('click', () => scrollToCard(current - 1));
  $('next').addEventListener('click', () => scrollToCard(current + 1));

  async function load() {
    const [winesRes, settingsRes] = await Promise.all([
      supabase.from('wines').select('*').order('sort_order'),
      supabase.from('settings').select('key, value'),
    ]);
    $('loading').hidden = true;
    if (winesRes.error) { $('load-error').hidden = false; return; }
    wines = winesRes.data as Wine[];

    const settings = Object.fromEntries((settingsRes.data ?? []).map((s) => [s.key, s.value]));
    const status = $('order-status');

    if (settings.orders_open === true) {
      if (code) {
        ordering = true;
        $('intro').textContent = 'Læg de vine, du vil have, i kurven. Du sender bestillingen fra kurven.';
        window.addEventListener('cart-change', renderBasket);
      } else {
        status.textContent = 'Bestillingen er åben. Brug linket fra din invitation for at bestille.';
        status.hidden = false;
      }
    } else {
      status.textContent = 'Du kan bestille vin på selve aftenen og ugen efter. Priserne er pr. flaske.';
      status.hidden = false;
    }
    render();
  }

  load();
</script>

<style is:global>
  .vine-page { padding-top: 2.5rem; padding-bottom: 5rem; }
  .vine-page .title {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(3rem, 16vw, 5rem);
    line-height: 0.9;
    margin-bottom: 1rem;
  }
  .vine-page .lead { font-size: 1.1rem; }
  .vine-page #order-status { margin: 1.25rem 0 0.5rem; }

  /* Stilarter som genveje */
  .chips {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin: 1.75rem -1rem 0;
    padding: 0 1rem 0.25rem;
  }
  .chips::-webkit-scrollbar { display: none; }
  .chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid var(--lodge-3);
    background: none;
    color: var(--muted);
    font: 0.95rem/1 var(--body);
    cursor: pointer;
    white-space: nowrap;
  }
  .chip::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--tone);
  }
  .chip:hover { color: var(--paper); }
  .chip.on { color: var(--paper); border-color: var(--tone); background: var(--lodge-2); }

  /* Karrusellen: én vin ad gangen, næste kigger frem i kanten */
  .carousel { margin: 1rem -1rem 0; outline-offset: -2px; }
  .carousel .track {
    list-style: none;
    margin: 0;
    padding: 0.25rem 1rem 0.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(84%, 22rem);
    gap: 0.9rem;
    align-items: start;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 1rem;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .carousel .track::-webkit-scrollbar { display: none; }
  .carousel .card {
    scroll-snap-align: start;
    background: var(--lodge-2);
    border-radius: 1rem;
    overflow: hidden;
    transition: opacity 0.25s;
    opacity: 0.55;
  }
  .carousel .card.is-current { opacity: 1; }
  .carousel .pic {
    position: relative;
    height: 16rem;
    background: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }
  .carousel .pic img { max-width: 100%; max-height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .carousel .pic.empty { background: linear-gradient(180deg, var(--ruby), var(--tawny)); }
  .carousel .pic.empty img { display: none; }
  .carousel .no {
    position: absolute;
    top: 0.6rem;
    left: 0.85rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--lodge);
    opacity: 0.55;
  }
  .carousel .info { padding: 1.1rem 1.1rem 1.25rem; }
  .carousel .style-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .carousel .style-tag::before {
    content: '';
    width: 1.5rem;
    height: 3px;
    border-radius: 2px;
    background: var(--tone);
  }

  .carousel-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .counter { margin: 0; min-width: 5.5rem; text-align: center; color: var(--muted); font-variant-numeric: tabular-nums; }
  .nav-btn {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--lodge-3);
    background: none;
    color: var(--paper);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .nav-btn:hover:not(:disabled) { border-color: var(--amber); color: var(--amber); }
  .nav-btn:disabled { opacity: 0.3; cursor: default; }

  .carousel .info { min-width: 0; }
  .carousel .name {
    font-family: var(--body);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 0.2rem;
  }
  .carousel .meta, .carousel .desc { margin: 0; color: var(--muted); font-size: 0.92rem; }
  .carousel .desc { margin-top: 0.4rem; color: var(--paper); line-height: 1.5; }
  .carousel .more { margin-top: 0.5rem; }
  .carousel .more summary {
    cursor: pointer;
    color: var(--amber);
    font-size: 0.92rem;
    padding: 0.35rem 0;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .carousel .more summary::-webkit-details-marker { display: none; }
  .carousel .more summary::after {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.15s;
  }
  .carousel .more[open] summary::after { transform: rotate(-135deg) translateY(-1px); }
  .carousel .more[open] summary { color: var(--paper); }
  .carousel .more dl {
    margin: 0.4rem 0 0;
    padding: 0.8rem 0.9rem;
    background: var(--lodge-2);
    border-radius: 0.5rem;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .carousel .more dt { color: var(--muted); font-size: 0.85rem; }
  .carousel .more dd { margin: 0 0 0.55rem; }
  .carousel .more dd:last-child { margin-bottom: 0; }
  .carousel .buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .carousel .price {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    line-height: 1.3;
  }
  .carousel .price .ours { font-weight: 600; font-size: 1.05rem; }
  .carousel .price .normal { color: var(--muted); font-size: 0.85rem; }
  .carousel .paid { margin: 0; color: var(--ok); font-size: 0.9rem; }

  .carousel .add {
    font: 600 0.95rem/1 var(--body);
    color: var(--lodge);
    background: var(--amber);
    border: 0;
    border-radius: 999px;
    padding: 0.8rem 1.1rem;
    min-height: 2.75rem;
    cursor: pointer;
  }
  .carousel .add:hover { background: var(--paper); }
  .carousel .add.in-cart {
    background: none;
    color: var(--amber);
    box-shadow: inset 0 0 0 1px var(--amber);
  }
  .carousel .add.pop { animation: pop 0.25s ease-out; }
  @keyframes pop { 50% { transform: scale(1.06); } }

  .basket {
    display: block;
    color: var(--paper);
    text-decoration: none;
    position: fixed;
    left: 0; right: 0; bottom: 0;
    background: var(--lodge-2);
    border-top: 2px solid var(--amber);
    padding: 0.9rem 0 calc(0.9rem + env(safe-area-inset-bottom));
  }
  .basket-inner { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  #basket-total { font-size: 1.15rem; }
  .basket-go { color: var(--amber); font-weight: 600; white-space: nowrap; }
  .basket:hover .basket-go { color: var(--paper); }
</style>
