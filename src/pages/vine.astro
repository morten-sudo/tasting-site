---
import Base from '../layouts/Base.astro';
---
<Base title="Vinene">
  <section class="wrap vine-page">
    <h1 class="title">Vinene</h1>
    <p id="intro" class="lead">Det her skænker vi i aften.</p>

    <p id="order-status" class="message" hidden></p>

    <div id="need-login" class="message need-login" hidden>
      <p><strong>Log ind for at se vinene.</strong></p>
      <p>Brug linket fra din invitation, eller log ind med din e-mail.</p>
      <a class="btn" href="/log-ind/">Log ind</a>
    </div>
    <p id="loading" class="hint">Henter vinene …</p>
    <p id="load-error" class="message error" hidden>
      Vinene kunne ikke hentes. Tjek din forbindelse, og genindlæs siden.
    </p>

    <div id="wine-list" class="carousel" role="region" aria-roledescription="karrusel" aria-label="Vinene" tabindex="0"></div>

    <div id="carousel-nav" class="carousel-nav" hidden>
      <button type="button" id="prev" class="nav-btn" aria-label="Forrige vin">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <p id="counter" class="counter" aria-live="polite"></p>
      <button type="button" id="next" class="nav-btn" aria-label="Næste vin">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </section>

  <a id="basket" class="basket" href="/kurv/" hidden>
    <div class="wrap basket-inner">
      <div>
        <span id="basket-count"></span>
        <strong id="basket-total"></strong>
      </div>
      <span class="basket-go">Gå til kurven</span>
    </div>
  </a>
</Base>

<script>
  import { supabase, getGuestCode } from '../lib/supabase';
  import { getCart, cartCount } from '../lib/cart';

  import { type Wine, styleLabel, styleTone, vintageLabel, kr } from '../lib/wines';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const kr = new Intl.NumberFormat('da-DK', { style: 'currency', currency: 'DKK' });
  const $ = (id: string) => document.getElementById(id)!;

  const code = getGuestCode();
  let wines: Wine[] = [];
  let ordering = false;

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }

  function renderBasket() {
    if (!ordering) return;
    const cart = getCart();
    let total = 0;
    for (const w of wines) total += (cart[w.id] ?? 0) * (w.price_dkk ?? 0);
    const bottles = cartCount(cart);
    $('basket').hidden = bottles === 0;
    $('basket-count').textContent = `${bottles} ${bottles === 1 ? 'flaske' : 'flasker'} i kurven, `;
    $('basket-total').textContent = kr.format(total);
  }

  function wineCard(w: Wine, index: number, total: number) {
    const li = el('li', 'card');
    li.dataset.style = w.style ?? 'Øvrige';
    li.setAttribute('aria-roledescription', 'vin');
    li.setAttribute('aria-label', `${index + 1} af ${total}`);

    const link = el('a', 'card-link');
    link.href = `/vin/?id=${w.id}`;

    const pic = el('div', 'pic');
    if (w.image_url) {
      const img = el('img');
      img.src = w.image_url;
      img.alt = '';
      img.loading = index < 2 ? 'eager' : 'lazy';
      img.decoding = 'async';
      img.referrerPolicy = 'no-referrer';
      img.addEventListener('error', () => pic.classList.add('empty'));
      pic.append(img);
    } else {
      pic.classList.add('empty');
    }
    const no = el('span', 'no', String(index + 1).padStart(2, '0'));
    no.setAttribute('aria-hidden', 'true');
    pic.append(no);
    link.append(pic);

    const info = el('div', 'info');
    const tag = el('p', 'style-tag', styleLabel(w));
    tag.style.setProperty('--tone', styleTone(w));
    info.append(tag);
    info.append(el('h3', 'name', w.name));
    const vin = vintageLabel(w);
    if (vin) info.append(el('p', 'meta', vin));

    const foot = el('div', 'foot');
    if (w.price_dkk != null) {
      const price = el('p', 'price');
      price.append(el('span', 'ours', kr.format(w.price_dkk)));
      if (w.retail_price_dkk != null && w.retail_price_dkk > w.price_dkk) {
        const normal = el('span', 'normal');
        normal.append('Normalpris ', el('s', '', kr.format(w.retail_price_dkk)));
        price.append(normal);
      }
      foot.append(price);
    }
    const go = el('span', 'go', 'Læs mere');
    go.setAttribute('aria-hidden', 'true');
    foot.append(go);
    info.append(foot);

    link.append(info);
    li.append(link);
    return li;
  }

  let cards: HTMLElement[] = [];
  let current = 0;

  function scrollToCard(i: number) {
    const track = $('wine-list').querySelector('.track') as HTMLElement;
    const card = cards[Math.max(0, Math.min(cards.length - 1, i))];
    if (!track || !card) return;
    const pad = parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0;
    track.scrollTo({ left: card.offsetLeft - track.offsetLeft - pad, behavior: reduceMotion ? 'auto' : 'smooth' });
  }

  function setCurrent(i: number) {
    current = i;
    $('counter').textContent = `${i + 1} af ${cards.length}`;
    ($('prev') as HTMLButtonElement).disabled = i === 0;
    ($('next') as HTMLButtonElement).disabled = i === cards.length - 1;
    cards.forEach((c, n) => c.classList.toggle('is-current', n === i));
  }

  function render() {
    const list = $('wine-list');
    list.replaceChildren();
    const track = el('ul', 'track');
    cards = wines.map((w, i) => wineCard(w, i, wines.length));
    track.append(...cards);
    list.append(track);

    $('carousel-nav').hidden = cards.length < 2;

    let ticking = false;
    track.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const x = track.scrollLeft;
        let best = 0, dist = Infinity;
        cards.forEach((c, n) => {
          const d = Math.abs(c.offsetLeft - track.offsetLeft - (parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0) - x);
          if (d < dist) { dist = d; best = n; }
        });
        if (best !== current) setCurrent(best);
      });
    }, { passive: true });

    list.addEventListener('keydown', (e) => {
      if (e.target !== list) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); scrollToCard(current + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); scrollToCard(current - 1); }
    });

    setCurrent(0);
    renderBasket();
  }

  $('prev').addEventListener('click', () => scrollToCard(current - 1));
  $('next').addEventListener('click', () => scrollToCard(current + 1));

  async function load() {
    if (!code) {
      $('loading').hidden = true;
      $('need-login').hidden = false;
      return;
    }
    const [winesRes, settingsRes] = await Promise.all([
      supabase.rpc('get_wines', { code }),
      supabase.from('settings').select('key, value'),
    ]);
    $('loading').hidden = true;
    if (winesRes.error) { $('load-error').hidden = false; return; }
    if (!winesRes.data?.length) { $('need-login').hidden = false; return; }
    wines = winesRes.data as Wine[];

    const settings = Object.fromEntries((settingsRes.data ?? []).map((s) => [s.key, s.value]));
    const status = $('order-status');

    if (settings.orders_open === true) {
      if (code) {
        ordering = true;
        $('intro').textContent = 'Tryk på en vin for at læse mere og lægge den i kurven. Du sender bestillingen fra kurven.';
        window.addEventListener('cart-change', renderBasket);
      } else {
        status.textContent = 'Bestillingen er åben. Brug linket fra din invitation for at bestille.';
        status.hidden = false;
      }
    }
    render();
  }

  load();
</script>

<style is:global>
  /* Vinsiden bruger hele skærmens bredde */
  .vine-page { padding-top: 2.5rem; padding-bottom: 5rem; }
  .vine-page .title {
    font-family: var(--display);
    font-weight: 400;
    font-weight: 300;
    font-size: clamp(3.25rem, 14vw, 5.5rem);
    line-height: 0.95;
    margin-bottom: 0.75rem;
  }
  .vine-page .lead { font-family: var(--display); font-style: italic; font-size: 1.35rem; color: var(--muted); }
  .vine-page #order-status { margin: 1.25rem 0 0.5rem; }

  /* Karrusellen: én vin ad gangen, næste kigger frem i kanten */
  /* Hele karrusellen ligger på et hvidt bånd i fuld bredde */
  .carousel {
    margin: 1.75rem calc(-1 * var(--gutter)) 0;
    padding-top: 1.75rem;
    background: #fff;
    outline-offset: -2px;
  }
  .carousel .track {
    list-style: none;
    margin: 0;
    padding: 0.25rem var(--gutter) 0.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(84%, 22rem);
    gap: 0.9rem;
    align-items: start;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .carousel .track::-webkit-scrollbar { display: none; }
  .carousel .card {
    scroll-snap-align: start;
    background: #fff;
    color: #1c1714;
    border: 1px solid #ece6dc;
    border-radius: var(--radius);
    overflow: hidden;
    transition: opacity 0.3s;
    opacity: 0.45;
  }
  .carousel .card.is-current { opacity: 1; }
  /* Store skærme: flere vine ad gangen, alle i fuld styrke */
  @media (min-width: 640px) {
    .carousel .card { opacity: 1; }
  }
  .carousel .pic {
    position: relative;
    height: 18rem;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }
  .carousel .pic img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .carousel .pic.empty { background: linear-gradient(180deg, var(--ruby), var(--tawny)); }
  .carousel .pic.empty img { display: none; }
  .carousel .no {
    position: absolute;
    top: 0.6rem;
    left: 0.85rem;
    font-family: var(--display);
    font-weight: 400;
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1;
    color: #8a7f72;
  }
  .carousel .style-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    color: #6f655a;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .carousel .style-tag::before {
    content: '';
    width: 1.5rem;
    height: 3px;
    border-radius: 2px;
    background: var(--tone);
  }

  .carousel-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 0 calc(-1 * var(--gutter));
    padding: 0.75rem var(--gutter) 1.75rem;
    background: #fff;
  }
  .counter { margin: 0; min-width: 5.5rem; text-align: center; color: #6f655a; font-size: 0.85rem; letter-spacing: 0.08em; font-variant-numeric: tabular-nums; }
  .nav-btn {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid #ddd5ca;
    background: none;
    color: #1c1714;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .nav-btn:hover:not(:disabled) { border-color: #876631; color: #876631; }
  .nav-btn:disabled { opacity: 0.3; cursor: default; }

  .carousel .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .carousel .card-link:focus-visible { outline-offset: -3px; border-radius: var(--radius); }
  /* Teksten står i samme hvide boks som flasken */
  .carousel .info { min-width: 0; padding: 0.4rem 1.25rem 1.3rem; }
  .carousel .name {
    font-family: var(--display);
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 0.3rem;
  }
  .carousel .meta { margin: 0; color: #6f655a; font-size: 0.9rem; }
  .carousel .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.9rem;
  }
  .carousel .price {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    line-height: 1.3;
  }
  .carousel .price .ours { font-weight: 400; font-size: 1rem; letter-spacing: 0.02em; }
  .carousel .price .normal { color: #6f655a; font-size: 0.85rem; }
  .carousel .go {
    color: #876631;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }
  .carousel .go::after {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-top: 2px solid currentColor;
    transform: rotate(45deg);
  }
  .carousel .card-link:hover .go { color: #1c1714; }
  .carousel .card-link:focus-visible { outline-color: var(--amber); outline-offset: 3px; }

  .basket {
    display: block;
    color: var(--paper);
    text-decoration: none;
    position: fixed;
    left: 0; right: 0; bottom: 0;
    background: var(--lodge-2);
    border-top: 2px solid var(--amber);
    padding: 0.9rem 0 calc(0.9rem + env(safe-area-inset-bottom));
  }
  .basket-inner { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  #basket-total { font-size: 1.15rem; }
  .basket-go { color: var(--amber); font-weight: 500; white-space: nowrap; }
  .basket:hover .basket-go { color: var(--paper); }
  /* Ingen vine at vise (ikke logget ind) → intet tomt bånd */
  .vine-page .carousel:empty { display: none; }
</style>
