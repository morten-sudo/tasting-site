---
import Base from '../layouts/Base.astro';
---
<Base title="Admin">
  <section class="wrap admin-page">
    <h1 class="title">Admin</h1>

    <!-- New password after a password-reset email -->
    <form id="reset" class="login" hidden>
      <p>Vælg en ny adgangskode.</p>
      <label for="reset-pw">Ny adgangskode (mindst 8 tegn)</label>
      <input id="reset-pw" type="password" autocomplete="new-password" minlength="8" required />
      <button class="btn" type="submit">Gem og log ind</button>
      <p id="reset-msg" class="message" hidden></p>
    </form>

    <p id="not-admin" class="message error" hidden>
      Du er logget ind, men er ikke oprettet som vært. <a href="/become-host/">Bliv vært</a> ·
      <button id="logout2" class="link-btn" type="button">Log ud</button>
    </p>

    <div id="panel" hidden>
      <p class="hint who">Logget ind som <span id="me"></span> · <button id="logout" class="link-btn" type="button">Log ud</button></p>

      <!-- Tasting picker -->
      <section id="tasting-bar" class="block tasting-bar" hidden>
        <label for="tasting-select">Smagning</label>
        <div class="inline-form">
          <select id="tasting-select"></select>
          <button id="new-tasting-toggle" class="btn small ghost" type="button">Ny smagning</button>
        </div>
      </section>

      <!-- New tasting -->
      <form id="new-tasting" class="add-form tasting-form" novalidate hidden>
        <h2 id="nt-heading">Ny smagning</h2>
        <p id="nt-intro" class="hint" hidden>Velkommen som vært. Start med at oprette din første smagning – du kan rette det hele bagefter.</p>
        <label for="nt-title">Titel</label>
        <input id="nt-title" type="text" placeholder="Fx Portvin 2026" required />
        <label for="nt-when">Dato og tid</label>
        <input id="nt-when" type="datetime-local" />
        <label for="nt-place">Sted</label>
        <input id="nt-place" type="text" autocomplete="street-address" />
        <label for="nt-mobilepay">MobilePay-nummer <span class="hint">(valgfrit)</span></label>
        <input id="nt-mobilepay" type="tel" inputmode="numeric" />
        <p id="nt-msg" class="message error" hidden></p>
        <div class="row-actions">
          <button id="nt-save" class="btn small" type="submit">Opret smagning</button>
          <button id="nt-cancel" class="text-btn" type="button">Annullér</button>
        </div>
      </form>

      <div id="tasting-panel" hidden>
      <!-- Tasting details -->
      <section class="block">
        <h2>Smagningen</h2>
        <form id="details" class="add-form tasting-form" novalidate>
          <label for="d-title">Titel</label>
          <input id="d-title" type="text" required />
          <label for="d-when">Dato og tid</label>
          <input id="d-when" type="datetime-local" />
          <label for="d-place">Sted</label>
          <input id="d-place" type="text" autocomplete="street-address" />
          <label for="d-mobilepay">MobilePay-nummer <span class="hint">(valgfrit)</span></label>
          <input id="d-mobilepay" type="tel" inputmode="numeric" />
          <div class="row-actions">
            <button id="d-save" class="btn small" type="submit">Gem</button>
            <span id="d-msg" class="hint" aria-live="polite"></span>
          </div>
        </form>
        <p class="hint">Smagningens side: <a id="tasting-link" href="/" target="_blank"></a><br />
          Gæsterne får hver deres personlige link under Deltagere.</p>
      </section>

      <!-- Controls -->
      <section class="block">
        <h2>Styring</h2>
        <div class="toggles">
          <label class="toggle"><input type="checkbox" data-key="signup_open" /> <span>Tilmelding åben</span></label>
          <label class="toggle"><input type="checkbox" data-key="orders_open" /> <span>Bestilling åben</span></label>
          <label class="toggle"><input type="checkbox" data-key="quiz_open" /> <span>Quiz åben for svar</span></label>
          <label class="toggle"><input type="checkbox" data-key="quiz_finished" /> <span>Quiz afsluttet (vis facit)</span></label>
        </div>
        <p class="hint">Pointtavle til tv'et: <a id="tv-link" href="/" target="_blank"></a></p>
      </section>

      <!-- Tasting fee -->
      <section class="block">
        <h2>Betaling for smagningen</h2>
        <div class="fee-grid">
          <label for="fee-total">Samlet udgift (kr.)</label>
          <input id="fee-total" type="number" min="0" step="1" inputmode="decimal" />
          <p id="fee-suggest" class="hint"></p>
          <label for="fee-amount">Pris pr. person (kr.)</label>
          <div class="inline-form">
            <input id="fee-amount" type="number" min="0" step="1" inputmode="decimal" />
            <button id="fee-save" class="btn small" type="button">Gem</button>
          </div>
          <p id="fee-msg" class="hint" aria-live="polite"></p>
        </div>
        <label class="toggle"><input type="checkbox" data-key="tasting_fee_open" /> <span>Vis betaling for gæster, der kommer</span></label>
        <p id="fee-summary" class="hint fee-summary"></p>
      </section>

      <!-- Wines -->
      <section class="block wines-admin">
        <div class="guests-head">
          <h2>Vine</h2>
          <button id="wine-add-toggle" class="btn small ghost" type="button">Tilføj vin</button>
        </div>

        <form id="wine-form" class="add-form wine-form" novalidate hidden>
          <h3 id="wf-title">Ny vin</h3>
          <label for="wf-name">Navn</label>
          <input id="wf-name" type="text" required />
          <label for="wf-image">Billede <span class="hint">(fx et foto af flasken)</span></label>
          <div class="wf-image">
            <img id="wf-preview" alt="" hidden />
            <input id="wf-image" type="file" accept="image/*" />
            <button id="wf-image-remove" class="text-btn" type="button" hidden>Fjern billede</button>
          </div>
          <label for="wf-producer">Producent</label>
          <input id="wf-producer" type="text" />
          <div class="wf-pair">
            <div>
              <label for="wf-style">Type</label>
              <select id="wf-style"></select>
            </div>
            <div>
              <label for="wf-vintage">Årgang</label>
              <input id="wf-vintage" type="text" placeholder="Fx 2019 eller 10 år" />
            </div>
          </div>
          <div class="wf-pair">
            <div>
              <label for="wf-price">Pris for gæster (kr.)</label>
              <input id="wf-price" type="text" inputmode="decimal" />
            </div>
            <div>
              <label for="wf-retail">Normalpris (kr.)</label>
              <input id="wf-retail" type="text" inputmode="decimal" />
            </div>
          </div>
          <label for="wf-abv">Alkohol (%)</label>
          <input id="wf-abv" type="text" inputmode="decimal" class="short" />
          <label for="wf-description">Beskrivelse</label>
          <textarea id="wf-description" rows="3"></textarea>
          <label for="wf-details">Mere om vinen <span class="hint">(én linje pr. punkt, fx "Druer: Touriga Nacional")</span></label>
          <textarea id="wf-details" rows="3"></textarea>
          <label class="toggle"><input id="wf-orderable" type="checkbox" checked /> <span>Kan bestilles</span></label>
          <label class="toggle"><input id="wf-revealed" type="checkbox" checked /> <span>Vis for gæster</span></label>
          <p id="wf-msg" class="message error" hidden></p>
          <div class="row-actions">
            <button id="wf-save" class="btn small" type="submit">Gem</button>
            <button id="wf-cancel" class="text-btn" type="button">Annullér</button>
            <button id="wf-delete" class="text-btn danger" type="button" hidden>Slet vin</button>
          </div>
        </form>

        <ul id="wine-admin-list" class="wine-admin-list"></ul>
        <p id="wine-empty" class="hint" hidden>Ingen vine endnu. Tilføj den første.</p>
      </section>

      <!-- Guests -->
      <section class="block guests">
        <div class="guests-head">
          <h2>Deltagere</h2>
          <button id="add-toggle" class="btn small ghost" type="button">Tilføj gæst</button>
        </div>

        <form id="add-p" class="add-form" hidden>
          <label for="new-name">Navn</label>
          <input id="new-name" type="text" autocomplete="off" required />
          <label for="new-email">E-mail <span class="hint">(valgfri)</span></label>
          <input id="new-email" type="email" autocomplete="off" />
          <div class="row-actions">
            <button class="btn small" type="submit">Tilføj</button>
            <button id="add-cancel" class="text-btn" type="button">Annullér</button>
          </div>
        </form>

        <div class="filters" role="tablist" aria-label="Vis deltagere">
          <button type="button" role="tab" data-filter="all" aria-selected="true">Alle <span></span></button>
          <button type="button" role="tab" data-filter="yes">Kommer <span></span></button>
          <button type="button" role="tab" data-filter="invited">Ikke svaret <span></span></button>
          <button type="button" role="tab" data-filter="no">Meldt fra <span></span></button>
          <button type="button" role="tab" data-filter="noemail">Mangler e-mail <span></span></button>
        </div>
        <label for="guest-search" class="sr">Søg efter gæst</label>
        <input id="guest-search" class="search" type="search" placeholder="Søg efter navn" autocomplete="off" />

        <ul id="guest-list" class="guest-list"></ul>
        <p id="guest-empty" class="hint" hidden>Ingen gæster matcher.</p>
      </section>

      <!-- Orders -->
      <section class="block">
        <h2>Bestillinger</h2>
        <div id="orders-by-guest"></div>
        <h3>Samlet indkøb</h3>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Vin</th><th class="num">Flasker</th><th class="num">Beløb</th></tr></thead>
            <tbody id="orders-by-wine"></tbody>
          </table>
        </div>
        <button id="csv" class="btn small ghost" type="button">Hent bestillinger som CSV</button>
      </section>

      <!-- Quiz -->
      <section class="block">
        <h2>Quiz</h2>
        <ol id="board" class="board"></ol>
      </section>
      </div>

      <!-- Password -->
      <details class="block pw-box">
        <summary>Sæt eller skift adgangskode</summary>
        <form id="pw-form" class="login">
          <label for="new-pw">Ny adgangskode (mindst 8 tegn)</label>
          <input id="new-pw" type="password" autocomplete="new-password" minlength="8" required />
          <button class="btn small" type="submit">Gem adgangskode</button>
          <p id="pw-msg" class="message" hidden></p>
        </form>
      </details>
    </div>
  </section>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  import { fetchLeaderboard, renderLeaderboard } from '../lib/leaderboard';
  import { initWineAdmin } from '../lib/admin-wines';

  const $ = (id: string) => document.getElementById(id)!;
  const kr = new Intl.NumberFormat('da-DK', { style: 'currency', currency: 'DKK' });
  const STATUS: Record<string, string> = { yes: 'Kommer', no: 'Meldt fra', invited: 'Ikke svaret' };

  type P = { id: string; name: string; email: string | null; status: string; diet: string | null; note: string | null; invite_code: string; tasting_paid: boolean };
  type W = { id: number; name: string; price_dkk: number | null; sort_order: number };
  type OLine = { wine_id: number; quantity: number; unit_price: number };
  type O = { id: number; participant_id: string; paid: boolean; created_at: string; order_lines: OLine[] };
  const ORDER_SELECT = 'id, participant_id, paid, created_at, order_lines(wine_id, quantity, unit_price)';
  const when = new Intl.DateTimeFormat('da-DK', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

  let participants: P[] = [];
  let wines: W[] = [];
  let orders: O[] = [];

  function cell(text: string, cls?: string) {
    const td = document.createElement('td');
    td.textContent = text;
    if (cls) td.className = cls;
    return td;
  }

  // ---------- Sign-in happens on /login/ with a one-time code ----------
  // Returning from a password-reset email
  let recovering = false;
  $('reset').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = $('reset-pw') as HTMLInputElement;
    const msg = $('reset-msg');
    const { error } = await supabase.auth.updateUser({ password: input.value });
    if (error) {
      msg.hidden = false;
      msg.className = 'message error';
      msg.textContent = 'Adgangskoden blev ikke gemt. Brug mindst 8 tegn, og prøv igen.';
      return;
    }
    recovering = false;
    $('reset').hidden = true;
    history.replaceState(null, '', '/admin/');
    init();
  });

  $('pw-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = $('new-pw') as HTMLInputElement;
    const msg = $('pw-msg');
    const { error } = await supabase.auth.updateUser({ password: input.value });
    msg.hidden = false;
    msg.className = 'message ' + (error ? 'error' : 'ok');
    msg.textContent = error
      ? (error.message.toLowerCase().includes('weak') || error.message.includes('characters')
          ? 'Adgangskoden er for svag. Brug mindst 8 tegn.'
          : 'Adgangskoden blev ikke gemt. Prøv igen.')
      : 'Adgangskoden er gemt. Du kan nu også logge ind med e-mail og adgangskode.';
    if (!error) input.value = '';
  });

  async function logout() {
    await supabase.auth.signOut();
    location.reload();
  }
  $('logout').addEventListener('click', logout);
  $('logout2').addEventListener('click', logout);

  // ---------- Controls (stored on the tasting) ----------
  type T = { id: string; slug: string; title: string; quiz_count?: number } & Record<string, unknown>;
  let tasting: T | null = null;
  let quizTotal = 13;
  let feeTotal = 0;
  let feeAmount = 0;

  let tastings: T[] = [];
  const LAST_TASTING_KEY = 'admin_last_tasting';

  // datetime-local works in the browser's local time
  function toLocalInput(iso: unknown) {
    if (typeof iso !== 'string' || !iso) return '';
    const d = new Date(iso);
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }
  const fromLocalInput = (v: string) => (v ? new Date(v).toISOString() : null);
  const cleanPhone = (v: string) => v.replace(/\s/g, '') || null;
  const dateLabel = new Intl.DateTimeFormat('da-DK', { day: 'numeric', month: 'short', year: 'numeric' });

  async function loadTasting() {
    const { data } = await supabase.from('tastings').select('*')
      .order('starts_at', { ascending: false, nullsFirst: true });
    tastings = (data ?? []) as T[];
    let last: string | null = null;
    try { last = localStorage.getItem(LAST_TASTING_KEY); } catch {}
    const wanted = new URLSearchParams(location.search).get('t') ?? last;
    tasting = tastings.find((t) => t.slug === wanted) ?? tastings[0] ?? null;
    if (!tasting) return;
    $('mark').textContent = tasting.title;
    try { localStorage.setItem(LAST_TASTING_KEY, tasting.slug); } catch {}

    const select = $('tasting-select') as HTMLSelectElement;
    select.replaceChildren(...tastings.map((t) => {
      const when = typeof t.starts_at === 'string' ? ` · ${dateLabel.format(new Date(t.starts_at))}` : '';
      return new Option(t.title + when, t.slug, false, t.slug === tasting!.slug);
    }));

    ($('d-title') as HTMLInputElement).value = tasting.title;
    ($('d-when') as HTMLInputElement).value = toLocalInput(tasting.starts_at);
    ($('d-place') as HTMLInputElement).value = (tasting.place as string) ?? '';
    ($('d-mobilepay') as HTMLInputElement).value = (tasting.mobilepay as string) ?? '';

    const { count } = await supabase.from('quiz_questions').select('id', { count: 'exact', head: true }).eq('tasting_id', tasting.id);
    quizTotal = count || 13;
    const tv = $('tv-link') as HTMLAnchorElement;
    tv.href = `/t/${tasting.slug}/leaderboard/`;
    tv.textContent = `${location.host}/t/${tasting.slug}/leaderboard/`;
    const pub = $('tasting-link') as HTMLAnchorElement;
    pub.href = `/t/${tasting.slug}/`;
    pub.textContent = `${location.host}/t/${tasting.slug}/`;
  }

  // ---------- Pick, create and edit tastings ----------
  ($('tasting-select') as HTMLSelectElement).addEventListener('change', (e) => {
    location.search = '?t=' + encodeURIComponent((e.target as HTMLSelectElement).value);
  });

  function showNewTasting(first: boolean) {
    const form = $('new-tasting') as HTMLFormElement;
    form.reset();
    $('nt-msg').hidden = true;
    $('nt-heading').textContent = first ? 'Opret din første smagning' : 'Ny smagning';
    $('nt-intro').hidden = !first;
    $('nt-cancel').hidden = first;
    form.hidden = false;
    ($('nt-title') as HTMLInputElement).focus();
  }
  $('new-tasting-toggle').addEventListener('click', () => showNewTasting(false));
  $('nt-cancel').addEventListener('click', () => { ($('new-tasting') as HTMLFormElement).hidden = true; });

  $('new-tasting').addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('nt-msg');
    const title = ($('nt-title') as HTMLInputElement).value.trim();
    if (!title) { msg.textContent = 'Giv smagningen en titel.'; msg.hidden = false; return; }
    const btn = $('nt-save') as HTMLButtonElement;
    btn.disabled = true;
    const { data, error } = await supabase.rpc('create_tasting', {
      title,
      starts_at: fromLocalInput(($('nt-when') as HTMLInputElement).value),
      place: ($('nt-place') as HTMLInputElement).value,
      mobilepay: ($('nt-mobilepay') as HTMLInputElement).value,
    });
    btn.disabled = false;
    if (error || !data) { msg.textContent = 'Smagningen blev ikke oprettet. Prøv igen.'; msg.hidden = false; return; }
    location.search = '?t=' + encodeURIComponent((data as T).slug);
  });

  $('details').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!tasting) return;
    const msg = $('d-msg');
    const title = ($('d-title') as HTMLInputElement).value.trim();
    if (!title) { msg.textContent = 'Titlen må ikke være tom.'; return; }
    const patch = {
      title,
      starts_at: fromLocalInput(($('d-when') as HTMLInputElement).value),
      place: ($('d-place') as HTMLInputElement).value.trim() || null,
      mobilepay: cleanPhone(($('d-mobilepay') as HTMLInputElement).value),
    };
    const { error } = await supabase.from('tastings').update(patch).eq('id', tasting.id);
    msg.textContent = error ? 'Ændringerne blev ikke gemt.' : 'Gemt';
    if (!error) {
      Object.assign(tasting, patch);
      const opt = ($('tasting-select') as HTMLSelectElement).selectedOptions[0];
      if (opt) opt.textContent = title + (patch.starts_at ? ` · ${dateLabel.format(new Date(patch.starts_at))}` : '');
      setTimeout(() => (msg.textContent = ''), 2000);
    }
  });

  function loadSettings() {
    if (!tasting) return;
    feeTotal = Number(tasting.tasting_total) || 0;
    feeAmount = Number(tasting.tasting_fee) || 0;
    ($('fee-total') as HTMLInputElement).value = feeTotal ? String(feeTotal) : '';
    ($('fee-amount') as HTMLInputElement).value = feeAmount ? String(feeAmount) : '';
    document.querySelectorAll<HTMLInputElement>('input[data-key]').forEach((box) => {
      box.checked = tasting![box.dataset.key!] === true;
    });
  }
  document.querySelectorAll<HTMLInputElement>('input[data-key]').forEach((box) => {
    box.addEventListener('change', async () => {
      if (!tasting) return;
      const { error } = await supabase.from('tastings')
        .update({ [box.dataset.key!]: box.checked }).eq('id', tasting.id);
      if (error) { box.checked = !box.checked; alert('Ændringen blev ikke gemt.'); return; }
      tasting[box.dataset.key!] = box.checked;
    });
  });

  // ---------- Tasting fee ----------
  function renderFee() {
    const coming = participants.filter((p) => p.status === 'yes');
    const total = Number(($('fee-total') as HTMLInputElement).value) || 0;
    $('fee-suggest').textContent = total && coming.length
      ? `${coming.length} kommer, så det giver ${kr.format(Math.ceil(total / coming.length))} pr. person (rundet op).`
      : `${coming.length} kommer.`;
    const paid = coming.filter((p) => p.tasting_paid);
    $('fee-summary').textContent = feeAmount
      ? `${paid.length} af ${coming.length} har betalt (${kr.format(paid.length * feeAmount)} af ${kr.format(coming.length * feeAmount)}).`
      : 'Ingen pris sat endnu.';
  }

  $('fee-total').addEventListener('input', renderFee);

  $('fee-save').addEventListener('click', async () => {
    const total = Number(($('fee-total') as HTMLInputElement).value) || 0;
    let amount = Number(($('fee-amount') as HTMLInputElement).value) || 0;
    const coming = participants.filter((p) => p.status === 'yes').length;
    if (!amount && total && coming) {
      amount = Math.ceil(total / coming);
      ($('fee-amount') as HTMLInputElement).value = String(amount);
    }
    if (!tasting) return;
    const { error } = await supabase.from('tastings')
      .update({ tasting_total: total, tasting_fee: amount }).eq('id', tasting.id);
    if (error) { $('fee-msg').textContent = 'Kunne ikke gemme. Prøv igen.'; return; }
    feeTotal = total;
    feeAmount = amount;
    $('fee-msg').textContent = `Gemt: ${kr.format(amount)} pr. person.`;
    renderParticipants();
  });

  // ---------- Guests ----------
  const STATUS_ORDER: Record<string, number> = { yes: 0, invited: 1, no: 2 };
  let guestFilter = 'all';
  let guestQuery = '';
  let editingId: string | null = null;

  function mk<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }

  function matches(p: P) {
    if (guestQuery && !p.name.toLowerCase().includes(guestQuery)) return false;
    if (guestFilter === 'all') return true;
    if (guestFilter === 'noemail') return !p.email;
    return p.status === guestFilter;
  }

  async function saveGuest(p: P, patch: Partial<P>) {
    const { error } = await supabase.from('participants').update(patch).eq('id', p.id);
    if (error) {
      alert(error.code === '23505' ? 'Den e-mail bruges allerede af en anden gæst.' : 'Ændringen blev ikke gemt. Prøv igen.');
      return false;
    }
    Object.assign(p, patch);
    return true;
  }

  function guestCard(p: P) {
    const li = mk('li', 'guest status-' + p.status);

    const top = mk('div', 'guest-top');
    top.append(mk('span', 'guest-name', p.name), mk('span', 'pill pill-' + p.status, STATUS[p.status] ?? p.status));
    li.append(top);

    li.append(p.email ? mk('p', 'guest-email', p.email) : mk('p', 'guest-email missing', 'Ingen e-mail'));
    if (p.note) li.append(mk('p', 'guest-note', p.note));

    const actions = mk('div', 'guest-actions');
    if (p.status === 'yes' && feeAmount > 0) {
      const paid = mk('button', 'paid-toggle' + (p.tasting_paid ? ' on' : ''), p.tasting_paid ? 'Smagning betalt' : 'Smagning ikke betalt');
      paid.type = 'button';
      paid.setAttribute('aria-pressed', String(p.tasting_paid));
      paid.addEventListener('click', async () => {
        if (await saveGuest(p, { tasting_paid: !p.tasting_paid })) { renderParticipants(); renderFee(); }
      });
      actions.append(paid);
    }
    const copy = mk('button', 'text-btn', 'Kopiér link');
    copy.type = 'button';
    copy.addEventListener('click', async () => {
      const url = `${location.origin}/t/${tasting!.slug}/?k=${p.invite_code}`;
      try { await navigator.clipboard.writeText(url); copy.textContent = 'Link kopieret'; }
      catch { prompt('Kopiér linket:', url); }
      setTimeout(() => (copy.textContent = 'Kopiér link'), 1500);
    });
    const edit = mk('button', 'text-btn', editingId === p.id ? 'Luk' : 'Rediger');
    edit.type = 'button';
    edit.setAttribute('aria-expanded', String(editingId === p.id));
    edit.addEventListener('click', () => {
      editingId = editingId === p.id ? null : p.id;
      renderParticipants();
    });
    actions.append(copy, edit);
    li.append(actions);

    if (editingId === p.id) li.append(editPanel(p));
    return li;
  }

  function editPanel(p: P) {
    const form = mk('form', 'edit-panel');
    let status = p.status;

    form.append(mk('p', 'edit-label', 'Status'));
    const seg = mk('div', 'segmented');
    for (const [v, label] of Object.entries(STATUS)) {
      const b = mk('button', '', label);
      b.type = 'button';
      b.setAttribute('aria-pressed', String(v === status));
      b.addEventListener('click', () => {
        status = v;
        seg.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      });
      seg.append(b);
    }
    form.append(seg);

    const lab = mk('label', 'edit-label', 'E-mail');
    const id = 'em-' + p.id;
    lab.htmlFor = id;
    const em = mk('input');
    em.type = 'email';
    em.id = id;
    em.value = p.email ?? '';
    em.autocomplete = 'off';
    form.append(lab, em);

    const row = mk('div', 'row-actions');
    const save = mk('button', 'btn small', 'Gem');
    save.type = 'submit';
    const cancel = mk('button', 'text-btn', 'Annullér');
    cancel.type = 'button';
    cancel.addEventListener('click', () => { editingId = null; renderParticipants(); });
    row.append(save, cancel);
    form.append(row);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = em.value.trim().toLowerCase() || null;
      if (email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { alert('E-mailen ser ikke rigtig ud.'); return; }
      save.disabled = true;
      if (await saveGuest(p, { status, email })) { editingId = null; renderParticipants(); }
      save.disabled = false;
    });
    setTimeout(() => em.focus(), 0);
    return form;
  }

  function renderParticipants() {
    const list = $('guest-list');
    list.replaceChildren();
    const sorted = [...participants]
      .sort((a, b) => (STATUS_ORDER[a.status] - STATUS_ORDER[b.status]) || a.name.localeCompare(b.name, 'da'))
      .filter(matches);
    for (const p of sorted) list.append(guestCard(p));
    $('guest-empty').hidden = sorted.length > 0;
    renderSummary();
  }

  function renderSummary() {
    const count: Record<string, number> = {
      all: participants.length,
      yes: participants.filter((p) => p.status === 'yes').length,
      invited: participants.filter((p) => p.status === 'invited').length,
      no: participants.filter((p) => p.status === 'no').length,
      noemail: participants.filter((p) => !p.email).length,
    };
    document.querySelectorAll<HTMLButtonElement>('.filters button').forEach((b) => {
      b.querySelector('span')!.textContent = String(count[b.dataset.filter!]);
      b.setAttribute('aria-selected', String(b.dataset.filter === guestFilter));
    });
    renderFee();
  }

  document.querySelectorAll<HTMLButtonElement>('.filters button').forEach((b) => {
    b.addEventListener('click', () => { guestFilter = b.dataset.filter!; renderParticipants(); });
  });
  $('guest-search').addEventListener('input', (e) => {
    guestQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    renderParticipants();
  });

  $('add-toggle').addEventListener('click', () => {
    $('add-p').hidden = false;
    $('add-toggle').hidden = true;
    ($('new-name') as HTMLInputElement).focus();
  });
  $('add-cancel').addEventListener('click', () => {
    $('add-p').hidden = true;
    $('add-toggle').hidden = false;
  });
  $('add-p').addEventListener('submit', async (e) => {
    e.preventDefault();
    const nameEl = $('new-name') as HTMLInputElement;
    const emailEl = $('new-email') as HTMLInputElement;
    const name = nameEl.value.trim();
    const email = emailEl.value.trim().toLowerCase() || null;
    if (!name) { nameEl.focus(); return; }
    const { data, error } = await supabase.from('participants').insert({ name, email, tasting_id: tasting!.id }).select().single();
    if (error) { alert(error.code === '23505' ? 'Den e-mail bruges allerede.' : 'Gæsten blev ikke tilføjet.'); return; }
    participants.push(data as P);
    nameEl.value = '';
    emailEl.value = '';
    $('add-p').hidden = true;
    $('add-toggle').hidden = false;
    renderParticipants();
  });

  // ---------- Orders ----------
  const orderTotal = (o: O) => o.order_lines.reduce((t, l) => t + l.quantity * Number(l.unit_price), 0);

  function renderOrders() {
    const byGuest = $('orders-by-guest');
    byGuest.replaceChildren();
    const wineById = new Map(wines.map((w) => [w.id, w]));
    const pById = new Map(participants.map((p) => [p.id, p]));

    if (orders.length === 0) {
      const p = document.createElement('p');
      p.className = 'hint';
      p.textContent = 'Ingen bestillinger endnu.';
      byGuest.append(p);
    }

    const sorted = [...orders].sort((a, b) => b.created_at.localeCompare(a.created_at));
    const unpaid = sorted.filter((o) => !o.paid);
    if (orders.length) {
      const p = document.createElement('p');
      p.className = 'hint';
      p.textContent = `${orders.length} bestillinger, ${unpaid.length} afventer betaling (${kr.format(unpaid.reduce((t, o) => t + orderTotal(o), 0))}).`;
      byGuest.append(p);
    }

    for (const o of sorted) {
      const box = document.createElement('div');
      box.className = 'order-card' + (o.paid ? ' paid' : '');
      const head = document.createElement('div');
      head.className = 'order-head';
      const h = document.createElement('strong');
      h.textContent = `${pById.get(o.participant_id)?.name ?? 'Ukendt gæst'}`;
      const sum = document.createElement('span');
      sum.textContent = kr.format(orderTotal(o));
      head.append(h, sum);
      const sub = document.createElement('p');
      sub.className = 'hint order-sub';
      sub.textContent = `Bestilling ${o.id}, ${when.format(new Date(o.created_at))}`;
      box.append(head, sub);

      const ul = document.createElement('ul');
      for (const l of o.order_lines) {
        const li = document.createElement('li');
        li.textContent = `${l.quantity} × ${wineById.get(l.wine_id)?.name ?? 'Ukendt vin'} à ${kr.format(Number(l.unit_price))}`;
        ul.append(li);
      }
      box.append(ul);

      const label = document.createElement('label');
      label.className = 'toggle';
      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.checked = o.paid;
      cb.addEventListener('change', async () => {
        const { error } = await supabase.from('orders').update({ paid: cb.checked }).eq('id', o.id);
        if (error) { cb.checked = !cb.checked; alert('Betaling blev ikke gemt.'); return; }
        o.paid = cb.checked;
        renderOrders();
      });
      const span = document.createElement('span');
      span.textContent = 'Betalt (MobilePay modtaget)';
      label.append(cb, span);
      box.append(label);
      byGuest.append(box);
    }

    const tbody = $('orders-by-wine');
    tbody.replaceChildren();
    let bottles = 0, amount = 0;
    for (const w of [...wines].sort((a, b) => a.sort_order - b.sort_order)) {
      let n = 0, sum = 0;
      for (const o of orders) for (const l of o.order_lines) {
        if (l.wine_id === w.id) { n += l.quantity; sum += l.quantity * Number(l.unit_price); }
      }
      if (!n) continue;
      bottles += n;
      amount += sum;
      const tr = document.createElement('tr');
      tr.append(cell(w.name), cell(String(n), 'num'), cell(kr.format(sum), 'num'));
      tbody.append(tr);
    }
    const tr = document.createElement('tr');
    tr.className = 'total';
    tr.append(cell('I alt'), cell(String(bottles), 'num'), cell(kr.format(amount), 'num'));
    tbody.append(tr);
  }

  $('csv').addEventListener('click', () => {
    const wineById = new Map(wines.map((w) => [w.id, w]));
    const pById = new Map(participants.map((p) => [p.id, p]));
    const rows = [['Bestilling', 'Tidspunkt', 'Gæst', 'Vin', 'Antal', 'Pris pr. flaske', 'Beløb', 'Betalt']];
    for (const o of [...orders].sort((a, b) => a.id - b.id)) {
      for (const l of o.order_lines) {
        const price = Number(l.unit_price);
        rows.push([
          String(o.id), new Date(o.created_at).toLocaleString('da-DK'),
          pById.get(o.participant_id)?.name ?? '', wineById.get(l.wine_id)?.name ?? '',
          String(l.quantity), String(price).replace('.', ','),
          String(price * l.quantity).replace('.', ','), o.paid ? 'ja' : 'nej',
        ]);
      }
    }
    const csv = rows.map((r) => r.map((v) => `"${v.replace(/"/g, '""')}"`).join(';')).join('\r\n');
    const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'portvin-bestillinger.csv';
    a.click();
  });

  // ---------- Startup ----------
  async function loadAll() {
    await loadTasting();
    if (!tasting) { showNewTasting(true); return; }
    $('tasting-bar').hidden = false;
    $('tasting-panel').hidden = false;
    const [p, o] = await Promise.all([
      supabase.from('participants').select('id, name, email, status, diet, note, invite_code, tasting_paid').eq('tasting_id', tasting.id),
      supabase.from('orders').select(ORDER_SELECT).eq('tasting_id', tasting.id),
    ]);
    participants = (p.data ?? []) as P[];
    orders = (o.data ?? []) as O[];
    await initWineAdmin(tasting.id, (list) => { wines = list; renderOrders(); }).load();
    renderParticipants();
    renderOrders();
    loadSettings();
    renderParticipants();
    const rows = await fetchLeaderboard({ slug: tasting.slug });
    if (rows) renderLeaderboard($('board') as HTMLOListElement, rows, quizTotal);
  }

  async function init() {
    if (recovering || location.hash.includes('type=recovery')) return;
    const { data } = await supabase.auth.getSession();
    const session = data.session;
    if (!session) { location.replace('/login/?next=' + encodeURIComponent(location.pathname + location.search)); return; }
    const { data: hostId } = await supabase.rpc('current_host_id');
    const { data: ok } = await supabase.rpc('is_admin');
    if (!ok && !hostId) { $('not-admin').hidden = false; return; }
    $('me').textContent = session.user.email ?? '';
    $('panel').hidden = false;
    await loadAll();
    setInterval(async () => {
      if (!tasting) return;
      const [o, rows] = await Promise.all([
        supabase.from('orders').select(ORDER_SELECT).eq('tasting_id', tasting!.id),
        fetchLeaderboard({ slug: tasting!.slug }),
      ]);
      if (o.data) { orders = o.data as O[]; renderOrders(); }
      if (rows) renderLeaderboard($('board') as HTMLOListElement, rows, quizTotal);
    }, 15000);
  }

  supabase.auth.onAuthStateChange((event) => {
    if (event === 'PASSWORD_RECOVERY') {
      recovering = true;
      $('panel').hidden = true;
      $('reset').hidden = false;
      return;
    }
    if (event === 'SIGNED_IN' && !recovering && $('panel').hidden && $('not-admin').hidden) {
      init();
    }
  });
  init();
</script>

