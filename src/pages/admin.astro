---
import Base from '../layouts/Base.astro';
---
<Base title="Admin">
  <section class="wrap admin-page">
    <h1 class="title">Admin</h1>

    <!-- Login -->
    <form id="login" class="login" hidden>
      <label for="email">E-mail</label>
      <input id="email" type="email" autocomplete="username" required />
      <label for="password">Adgangskode</label>
      <input id="password" type="password" autocomplete="current-password" />
      <button class="btn" type="submit">Log ind</button>
      <p id="login-msg" class="message" hidden></p>
      <p class="hint">
        <button id="forgot" class="link-btn" type="button">Glemt adgangskode?</button>
      </p>
    </form>

    <!-- Ny adgangskode efter "glemt adgangskode"-mail -->
    <form id="reset" class="login" hidden>
      <p>Vælg en ny adgangskode.</p>
      <label for="reset-pw">Ny adgangskode (mindst 8 tegn)</label>
      <input id="reset-pw" type="password" autocomplete="new-password" minlength="8" required />
      <button class="btn" type="submit">Gem og log ind</button>
      <p id="reset-msg" class="message" hidden></p>
    </form>

    <p id="not-admin" class="message error" hidden>
      Du er logget ind, men e-mailen har ikke admin-adgang.
      <button id="logout2" class="link-btn" type="button">Log ud</button>
    </p>

    <div id="panel" hidden>
      <p class="hint who">Logget ind som <span id="me"></span> · <button id="logout" class="link-btn" type="button">Log ud</button></p>

      <!-- Adgangskode -->
      <details class="block pw-box">
        <summary>Sæt eller skift adgangskode</summary>
        <form id="pw-form" class="login">
          <label for="new-pw">Ny adgangskode (mindst 8 tegn)</label>
          <input id="new-pw" type="password" autocomplete="new-password" minlength="8" required />
          <button class="btn small" type="submit">Gem adgangskode</button>
          <p id="pw-msg" class="message" hidden></p>
        </form>
      </details>

      <!-- Knapper -->
      <section class="block">
        <h2>Styring</h2>
        <div class="toggles">
          <label class="toggle"><input type="checkbox" data-key="signup_open" /> <span>Tilmelding åben</span></label>
          <label class="toggle"><input type="checkbox" data-key="orders_open" /> <span>Bestilling åben</span></label>
          <label class="toggle"><input type="checkbox" data-key="quiz_open" /> <span>Quiz åben for svar</span></label>
          <label class="toggle"><input type="checkbox" data-key="quiz_finished" /> <span>Quiz afsluttet (vis facit)</span></label>
        </div>
        <p class="hint">Pointtavle til tv'et: <a href="/pointtavle/" target="_blank">/pointtavle/</a></p>
      </section>

      <!-- Betaling for smagningen -->
      <section class="block">
        <h2>Betaling for smagningen</h2>
        <div class="fee-grid">
          <label for="fee-total">Samlet udgift (kr.)</label>
          <input id="fee-total" type="number" min="0" step="1" inputmode="decimal" />
          <p id="fee-suggest" class="hint"></p>
          <label for="fee-amount">Pris pr. person (kr.)</label>
          <div class="inline-form">
            <input id="fee-amount" type="number" min="0" step="1" inputmode="decimal" />
            <button id="fee-save" class="btn small" type="button">Gem</button>
          </div>
          <p id="fee-msg" class="hint" aria-live="polite"></p>
        </div>
        <label class="toggle"><input type="checkbox" data-key="tasting_fee_open" /> <span>Vis betaling for gæster, der kommer</span></label>
        <p id="fee-summary" class="hint fee-summary"></p>
      </section>

      <!-- Deltagere -->
      <section class="block">
        <h2>Deltagere</h2>
        <p id="p-summary" class="hint"></p>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Navn og e-mail</th><th>Status</th><th>Smagning betalt</th><th>Besked</th><th>Link</th></tr></thead>
            <tbody id="participants"></tbody>
          </table>
        </div>
        <form id="add-p" class="inline-form">
          <label for="new-name" class="sr">Navn på ny gæst</label>
          <input id="new-name" type="text" placeholder="Navn på ny gæst" required />
          <button class="btn small" type="submit">Tilføj gæst</button>
        </form>
      </section>

      <!-- Bestillinger -->
      <section class="block">
        <h2>Bestillinger</h2>
        <div id="orders-by-guest"></div>
        <h3>Samlet indkøb</h3>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Vin</th><th class="num">Flasker</th><th class="num">Beløb</th></tr></thead>
            <tbody id="orders-by-wine"></tbody>
          </table>
        </div>
        <button id="csv" class="btn small ghost" type="button">Hent bestillinger som CSV</button>
      </section>

      <!-- Quiz -->
      <section class="block">
        <h2>Quiz</h2>
        <ol id="board" class="board"></ol>
      </section>
    </div>
  </section>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  import { fetchLeaderboard, renderLeaderboard } from '../lib/leaderboard';

  const $ = (id: string) => document.getElementById(id)!;
  const kr = new Intl.NumberFormat('da-DK', { style: 'currency', currency: 'DKK' });
  const STATUS: Record<string, string> = { yes: 'Kommer', no: 'Meldt fra', invited: 'Ikke svaret' };

  type P = { id: string; name: string; email: string | null; status: string; diet: string | null; note: string | null; invite_code: string; tasting_paid: boolean };
  type W = { id: number; name: string; price_dkk: number | null; sort_order: number };
  type OLine = { wine_id: number; quantity: number; unit_price: number };
  type O = { id: number; participant_id: string; paid: boolean; created_at: string; order_lines: OLine[] };
  const ORDER_SELECT = 'id, participant_id, paid, created_at, order_lines(wine_id, quantity, unit_price)';
  const when = new Intl.DateTimeFormat('da-DK', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

  let participants: P[] = [];
  let wines: W[] = [];
  let orders: O[] = [];

  function cell(text: string, cls?: string) {
    const td = document.createElement('td');
    td.textContent = text;
    if (cls) td.className = cls;
    return td;
  }

  // ---------- Login ----------
  function loginMsg(text: string, ok: boolean) {
    const msg = $('login-msg');
    msg.hidden = false;
    msg.className = 'message ' + (ok ? 'ok' : 'error');
    msg.textContent = text;
  }

  $('login').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = ($('email') as HTMLInputElement).value.trim();
    const password = ($('password') as HTMLInputElement).value;
    if (!password) { loginMsg('Skriv din adgangskode, eller få et login-link tilsendt.', false); return; }
    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) loginMsg('Forkert e-mail eller adgangskode.', false);
  });

  $('forgot').addEventListener('click', async () => {
    const email = ($('email') as HTMLInputElement).value.trim();
    if (!email) { loginMsg('Skriv din e-mail i feltet ovenfor, og tryk igen.', false); return; }
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: location.origin + '/admin/',
    });
    if (!error) loginMsg(`Hvis ${email} har adgang, er der sendt en mail med et link til at vælge en ny adgangskode.`, true);
    else if (error.status === 429) loginMsg('Der er sendt for mange mails på kort tid. Vent lidt, og prøv igen.', false);
    else loginMsg('Mailen kunne ikke sendes. Prøv igen om lidt.', false);
  });

  // Når man kommer tilbage fra "glemt adgangskode"-mailen
  let recovering = false;
  $('reset').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = $('reset-pw') as HTMLInputElement;
    const msg = $('reset-msg');
    const { error } = await supabase.auth.updateUser({ password: input.value });
    if (error) {
      msg.hidden = false;
      msg.className = 'message error';
      msg.textContent = 'Adgangskoden blev ikke gemt. Brug mindst 8 tegn, og prøv igen.';
      return;
    }
    recovering = false;
    $('reset').hidden = true;
    history.replaceState(null, '', '/admin/');
    init();
  });

  $('pw-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = $('new-pw') as HTMLInputElement;
    const msg = $('pw-msg');
    const { error } = await supabase.auth.updateUser({ password: input.value });
    msg.hidden = false;
    msg.className = 'message ' + (error ? 'error' : 'ok');
    msg.textContent = error
      ? (error.message.toLowerCase().includes('weak') || error.message.includes('characters')
          ? 'Adgangskoden er for svag. Brug mindst 8 tegn.'
          : 'Adgangskoden blev ikke gemt. Prøv igen.')
      : 'Adgangskoden er gemt. Næste gang logger du ind med e-mail og adgangskode.';
    if (!error) input.value = '';
  });

  async function logout() {
    await supabase.auth.signOut();
    location.reload();
  }
  $('logout').addEventListener('click', logout);
  $('logout2').addEventListener('click', logout);

  // ---------- Styring ----------
  let feeTotal = 0;
  let feeAmount = 0;

  async function loadSettings() {
    const { data } = await supabase.from('settings').select('key, value');
    for (const r of data ?? []) {
      if (r.key === 'tasting_total') { feeTotal = Number(r.value) || 0; ($('fee-total') as HTMLInputElement).value = feeTotal ? String(feeTotal) : ''; }
      if (r.key === 'tasting_fee') { feeAmount = Number(r.value) || 0; ($('fee-amount') as HTMLInputElement).value = feeAmount ? String(feeAmount) : ''; }
      const box = document.querySelector<HTMLInputElement>(`input[data-key="${r.key}"]`);
      if (box) box.checked = r.value === true;
    }
  }
  document.querySelectorAll<HTMLInputElement>('input[data-key]').forEach((box) => {
    box.addEventListener('change', async () => {
      const { error } = await supabase.from('settings')
        .update({ value: box.checked }).eq('key', box.dataset.key!);
      if (error) { box.checked = !box.checked; alert('Ændringen blev ikke gemt.'); }
    });
  });

  // ---------- Betaling for smagningen ----------
  function renderFee() {
    const coming = participants.filter((p) => p.status === 'yes');
    const total = Number(($('fee-total') as HTMLInputElement).value) || 0;
    $('fee-suggest').textContent = total && coming.length
      ? `${coming.length} kommer, så det giver ${kr.format(Math.ceil(total / coming.length))} pr. person (rundet op).`
      : `${coming.length} kommer.`;
    const paid = coming.filter((p) => p.tasting_paid);
    $('fee-summary').textContent = feeAmount
      ? `${paid.length} af ${coming.length} har betalt (${kr.format(paid.length * feeAmount)} af ${kr.format(coming.length * feeAmount)}).`
      : 'Ingen pris sat endnu.';
  }

  $('fee-total').addEventListener('input', renderFee);

  $('fee-save').addEventListener('click', async () => {
    const total = Number(($('fee-total') as HTMLInputElement).value) || 0;
    let amount = Number(($('fee-amount') as HTMLInputElement).value) || 0;
    const coming = participants.filter((p) => p.status === 'yes').length;
    if (!amount && total && coming) {
      amount = Math.ceil(total / coming);
      ($('fee-amount') as HTMLInputElement).value = String(amount);
    }
    const [a, b] = await Promise.all([
      supabase.from('settings').update({ value: total }).eq('key', 'tasting_total'),
      supabase.from('settings').update({ value: amount }).eq('key', 'tasting_fee'),
    ]);
    if (a.error || b.error) { $('fee-msg').textContent = 'Kunne ikke gemme. Prøv igen.'; return; }
    feeTotal = total;
    feeAmount = amount;
    $('fee-msg').textContent = `Gemt: ${kr.format(amount)} pr. person.`;
    renderFee();
  });

  // ---------- Deltagere ----------
  function renderParticipants() {
    const tbody = $('participants');
    tbody.replaceChildren();
    const order = { yes: 0, invited: 1, no: 2 } as Record<string, number>;
    const sorted = [...participants].sort((a, b) =>
      (order[a.status] - order[b.status]) || a.name.localeCompare(b.name, 'da'));
    for (const p of sorted) {
      const tr = document.createElement('tr');
      const nameTd = document.createElement('td');
      const nm = document.createElement('div');
      nm.textContent = p.name;
      const em = document.createElement('input');
      em.type = 'email';
      em.className = 'email-input';
      em.placeholder = 'e-mail';
      em.value = p.email ?? '';
      em.setAttribute('aria-label', `E-mail for ${p.name}`);
      em.addEventListener('change', async () => {
        const v = em.value.trim().toLowerCase() || null;
        const { error } = await supabase.from('participants').update({ email: v }).eq('id', p.id);
        if (error) {
          em.value = p.email ?? '';
          alert(error.code === '23505' ? 'Den e-mail bruges allerede af en anden gæst.' : 'E-mailen blev ikke gemt.');
          return;
        }
        p.email = v;
        em.classList.add('saved');
        setTimeout(() => em.classList.remove('saved'), 1200);
      });
      nameTd.append(nm, em);
      tr.append(nameTd);

      const st = document.createElement('td');
      const sel = document.createElement('select');
      for (const [v, label] of Object.entries(STATUS)) {
        const o = document.createElement('option');
        o.value = v; o.textContent = label; o.selected = p.status === v;
        sel.append(o);
      }
      sel.addEventListener('change', async () => {
        const { error } = await supabase.from('participants').update({ status: sel.value }).eq('id', p.id);
        if (error) { sel.value = p.status; alert('Status blev ikke gemt.'); return; }
        p.status = sel.value;
        renderParticipants();
      });
      st.append(sel);
      tr.append(st);

      const feeTd = document.createElement('td');
      if (p.status === 'yes') {
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.className = 'fee-cb';
        cb.checked = p.tasting_paid;
        cb.setAttribute('aria-label', `${p.name} har betalt for smagningen`);
        cb.addEventListener('change', async () => {
          const { error } = await supabase.from('participants').update({ tasting_paid: cb.checked }).eq('id', p.id);
          if (error) { cb.checked = !cb.checked; alert('Betaling blev ikke gemt.'); return; }
          p.tasting_paid = cb.checked;
          renderFee();
        });
        feeTd.append(cb);
      } else {
        feeTd.textContent = '–';
        feeTd.className = 'small';
      }
      tr.append(feeTd);

      tr.append(cell(p.note || '–', 'small'));

      const linkTd = document.createElement('td');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'link-btn';
      btn.textContent = 'Kopiér link';
      btn.addEventListener('click', async () => {
        const url = `${location.origin}/profil/?k=${p.invite_code}`;
        try { await navigator.clipboard.writeText(url); btn.textContent = 'Kopieret'; }
        catch { prompt('Kopiér linket:', url); }
        setTimeout(() => (btn.textContent = 'Kopiér link'), 1500);
      });
      linkTd.append(btn);
      tr.append(linkTd);
      tbody.append(tr);
    }
    renderSummary();
  }

  function renderSummary() {
    const c = (s: string) => participants.filter((p) => p.status === s).length;
    $('p-summary').textContent = `${c('yes')} kommer, ${c('invited')} har ikke svaret, ${c('no')} har meldt fra.`;
    renderFee();
  }

  $('add-p').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = $('new-name') as HTMLInputElement;
    const name = input.value.trim();
    if (!name) return;
    const { data, error } = await supabase.from('participants').insert({ name }).select().single();
    if (error) { alert('Gæsten blev ikke tilføjet.'); return; }
    participants.push(data as P);
    input.value = '';
    renderParticipants();
  });

  // ---------- Bestillinger ----------
  const orderTotal = (o: O) => o.order_lines.reduce((t, l) => t + l.quantity * Number(l.unit_price), 0);

  function renderOrders() {
    const byGuest = $('orders-by-guest');
    byGuest.replaceChildren();
    const wineById = new Map(wines.map((w) => [w.id, w]));
    const pById = new Map(participants.map((p) => [p.id, p]));

    if (orders.length === 0) {
      const p = document.createElement('p');
      p.className = 'hint';
      p.textContent = 'Ingen bestillinger endnu.';
      byGuest.append(p);
    }

    const sorted = [...orders].sort((a, b) => b.created_at.localeCompare(a.created_at));
    const unpaid = sorted.filter((o) => !o.paid);
    if (orders.length) {
      const p = document.createElement('p');
      p.className = 'hint';
      p.textContent = `${orders.length} bestillinger, ${unpaid.length} afventer betaling (${kr.format(unpaid.reduce((t, o) => t + orderTotal(o), 0))}).`;
      byGuest.append(p);
    }

    for (const o of sorted) {
      const box = document.createElement('div');
      box.className = 'order-card' + (o.paid ? ' paid' : '');
      const head = document.createElement('div');
      head.className = 'order-head';
      const h = document.createElement('strong');
      h.textContent = `${pById.get(o.participant_id)?.name ?? 'Ukendt gæst'}`;
      const sum = document.createElement('span');
      sum.textContent = kr.format(orderTotal(o));
      head.append(h, sum);
      const sub = document.createElement('p');
      sub.className = 'hint order-sub';
      sub.textContent = `Bestilling ${o.id}, ${when.format(new Date(o.created_at))}`;
      box.append(head, sub);

      const ul = document.createElement('ul');
      for (const l of o.order_lines) {
        const li = document.createElement('li');
        li.textContent = `${l.quantity} × ${wineById.get(l.wine_id)?.name ?? 'Ukendt vin'} à ${kr.format(Number(l.unit_price))}`;
        ul.append(li);
      }
      box.append(ul);

      const label = document.createElement('label');
      label.className = 'toggle';
      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.checked = o.paid;
      cb.addEventListener('change', async () => {
        const { error } = await supabase.from('orders').update({ paid: cb.checked }).eq('id', o.id);
        if (error) { cb.checked = !cb.checked; alert('Betaling blev ikke gemt.'); return; }
        o.paid = cb.checked;
        renderOrders();
      });
      const span = document.createElement('span');
      span.textContent = 'Betalt (MobilePay modtaget)';
      label.append(cb, span);
      box.append(label);
      byGuest.append(box);
    }

    const tbody = $('orders-by-wine');
    tbody.replaceChildren();
    let bottles = 0, amount = 0;
    for (const w of [...wines].sort((a, b) => a.sort_order - b.sort_order)) {
      let n = 0, sum = 0;
      for (const o of orders) for (const l of o.order_lines) {
        if (l.wine_id === w.id) { n += l.quantity; sum += l.quantity * Number(l.unit_price); }
      }
      if (!n) continue;
      bottles += n;
      amount += sum;
      const tr = document.createElement('tr');
      tr.append(cell(w.name), cell(String(n), 'num'), cell(kr.format(sum), 'num'));
      tbody.append(tr);
    }
    const tr = document.createElement('tr');
    tr.className = 'total';
    tr.append(cell('I alt'), cell(String(bottles), 'num'), cell(kr.format(amount), 'num'));
    tbody.append(tr);
  }

  $('csv').addEventListener('click', () => {
    const wineById = new Map(wines.map((w) => [w.id, w]));
    const pById = new Map(participants.map((p) => [p.id, p]));
    const rows = [['Bestilling', 'Tidspunkt', 'Gæst', 'Vin', 'Antal', 'Pris pr. flaske', 'Beløb', 'Betalt']];
    for (const o of [...orders].sort((a, b) => a.id - b.id)) {
      for (const l of o.order_lines) {
        const price = Number(l.unit_price);
        rows.push([
          String(o.id), new Date(o.created_at).toLocaleString('da-DK'),
          pById.get(o.participant_id)?.name ?? '', wineById.get(l.wine_id)?.name ?? '',
          String(l.quantity), String(price).replace('.', ','),
          String(price * l.quantity).replace('.', ','), o.paid ? 'ja' : 'nej',
        ]);
      }
    }
    const csv = rows.map((r) => r.map((v) => `"${v.replace(/"/g, '""')}"`).join(';')).join('\r\n');
    const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'portvin-bestillinger.csv';
    a.click();
  });

  // ---------- Opstart ----------
  async function loadAll() {
    const [p, w, o] = await Promise.all([
      supabase.from('participants').select('id, name, email, status, diet, note, invite_code, tasting_paid'),
      supabase.from('wines').select('id, name, price_dkk, sort_order'),
      supabase.from('orders').select(ORDER_SELECT),
    ]);
    participants = (p.data ?? []) as P[];
    wines = (w.data ?? []) as W[];
    orders = (o.data ?? []) as O[];
    renderParticipants();
    renderOrders();
    await loadSettings();
    renderFee();
    const rows = await fetchLeaderboard();
    if (rows) renderLeaderboard($('board') as HTMLOListElement, rows, 13);
  }

  async function init() {
    if (recovering || location.hash.includes('type=recovery')) return;
    const { data } = await supabase.auth.getSession();
    const session = data.session;
    if (!session) { $('login').hidden = false; return; }
    const { data: ok } = await supabase.rpc('is_admin');
    if (!ok) { $('not-admin').hidden = false; return; }
    $('me').textContent = session.user.email ?? '';
    $('panel').hidden = false;
    await loadAll();
    setInterval(async () => {
      const [o, rows] = await Promise.all([
        supabase.from('orders').select(ORDER_SELECT),
        fetchLeaderboard(),
      ]);
      if (o.data) { orders = o.data as O[]; renderOrders(); }
      if (rows) renderLeaderboard($('board') as HTMLOListElement, rows, 13);
    }, 15000);
  }

  supabase.auth.onAuthStateChange((event) => {
    if (event === 'PASSWORD_RECOVERY') {
      recovering = true;
      $('login').hidden = true;
      $('panel').hidden = true;
      $('reset').hidden = false;
      return;
    }
    if (event === 'SIGNED_IN' && !recovering && $('panel').hidden && $('not-admin').hidden) {
      $('login').hidden = true;
      init();
    }
  });
  init();
</script>

<style is:global>
  .admin-page { padding-top: 2.5rem; padding-bottom: 3rem; }
  .admin-page .title {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(3rem, 16vw, 5rem);
    line-height: 0.9;
    margin-bottom: 1.25rem;
  }
  .admin-page .login { display: grid; gap: 0.6rem; max-width: 26rem; }
  .admin-page input[type='email'], .admin-page input[type='password'] {
    width: 100%;
    font: inherit;
    color: var(--paper);
    background: var(--lodge-2);
    border: 1px solid var(--lodge-3);
    border-radius: 0.5rem;
    padding: 0.7rem 0.8rem;
  }
  .admin-page .who { margin-bottom: 1rem; }
  .admin-page .login .btn { margin-top: 0.4rem; justify-self: start; }
  .admin-page .pw-box summary { cursor: pointer; color: var(--amber); }
  .admin-page .pw-box .login { margin-top: 0.8rem; }
  .admin-page .block { margin-top: 2.25rem; }
  .admin-page h3 { font-size: 1.05rem; margin-top: 1.5rem; }

  .admin-page .toggles { display: grid; gap: 0.5rem; margin-bottom: 0.75rem; }
