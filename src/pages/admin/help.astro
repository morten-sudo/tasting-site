---
// Help for hosts: every feature, step by step. Only shown to signed-in hosts (in the admin menu).
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import '../../styles/admin.css';
---
<Base title="adminNav.help">
  <section class="wrap admin-page">
    <AdminNav active="help">
    <div id="admin-main" hidden>
      <h1 class="title" data-i18n="adminNav.help">Help</h1>
      <p class="hint" data-i18n="help.intro">Everything Winetastr can do, and how. Search, or open a topic.</p>
      <label for="help-search" class="sr" data-i18n="help.search">Search the help</label>
      <input id="help-search" class="search" type="search" autocomplete="off" placeholder="Search the help" data-i18n-attr="placeholder=help.search" />
      <p id="help-target" class="help-target" hidden>
        <label for="help-tasting" data-i18n="help.linksTo">Links to a tasting go to</label>
        <select id="help-tasting"></select>
      </p>
      <nav id="help-toc" class="help-toc" aria-label="Topics" data-i18n-attr="aria-label=help.topics"></nav>
      <div id="help-list" class="help-list"></div>
      <p id="help-none" class="hint" hidden data-i18n="help.noMatch">Nothing found. Try another word.</p>
    </div>
    </AdminNav>
  </section>
</Base>

<script>
  import { supabase } from '../../lib/supabase';
  import { requireHost, $ } from '../../lib/admin-common';
  import { HELP, pick } from '../../lib/help-content';
  import { formatWhen } from '../../i18n';

  // Links in the help: "t:guests/" is that part of a tasting's admin, "g:wines/" its guest page.
  // They go to the tasting chosen at the top – by default the next one – or, without tastings, to creating one.
  type T = { id: string; slug: string; title: string; starts_at: string | null };
  let tastings: T[] = [];
  let slug: string | null = null;
  const KEY = 'wt-help-tasting';

  async function loadTastings() {
    const { data: roles } = await supabase.rpc('my_tasting_roles');
    const ids = ((roles ?? []) as { tasting_id: string }[]).map((r) => r.tasting_id);
    if (!ids.length) return;
    const { data } = await supabase.from('tastings').select('id, slug, title, starts_at').in('id', ids);
    const soon = Date.now() - 12 * 3600e3;
    const time = (x: T) => (x.starts_at ? Date.parse(x.starts_at) : 0);
    // Upcoming first (soonest on top), then past ones (latest on top)
    tastings = ((data ?? []) as T[]).sort((a, b) => {
      const ua = time(a) >= soon, ub = time(b) >= soon;
      if (ua !== ub) return ua ? -1 : 1;
      return ua ? time(a) - time(b) : time(b) - time(a);
    });
    let saved: string | null = null;
    try { saved = localStorage.getItem(KEY); } catch { /* private mode */ }
    slug = tastings.find((x) => x.slug === saved)?.slug ?? tastings[0]?.slug ?? null;
    const sel = $('help-tasting') as HTMLSelectElement;
    sel.replaceChildren(...tastings.map((x) => {
      const o = document.createElement('option');
      o.value = x.slug;
      o.textContent = x.starts_at ? `${x.title} · ${formatWhen(x.starts_at)}` : x.title;
      return o;
    }));
    if (slug) sel.value = slug;
    $('help-target').hidden = tastings.length < 2;
    sel.addEventListener('change', () => {
      slug = sel.value;
      try { localStorage.setItem(KEY, slug); } catch { /* private mode */ }
      resolveLinks();
    });
  }

  function resolveLinks() {
    document.querySelectorAll<HTMLAnchorElement>('.help-body a[data-to]').forEach((a) => {
      const to = a.dataset.to!;
      const rest = to.slice(2);
      a.href = !slug ? '/admin/tastings/?new=1'
        : to.startsWith('t:') ? `/t/${slug}/admin/${rest}` : `/t/${slug}/${rest}`;
      // The guest page opens beside the admin
      if (to.startsWith('g:')) { a.target = '_blank'; a.rel = 'noopener'; }
    });
  }

  const host = await requireHost();
  if (host) {
    $('admin-main').hidden = false;
    render();
    await loadTastings();
    resolveLinks();
    openFromHash();
  }

  function render() {
    $('help-toc').replaceChildren(...HELP.map((s) => {
      const a = document.createElement('a');
      a.href = `#${s.id}`;
      a.textContent = pick(s.title);
      return a;
    }));
    $('help-list').replaceChildren(...HELP.map((s) => {
      const d = document.createElement('details');
      d.className = 'help-topic';
      d.id = s.id;
      const sum = document.createElement('summary');
      sum.textContent = pick(s.title);
      const body = document.createElement('div');
      body.className = 'help-body';
      body.innerHTML = pick(s.body);
      // Remember where tasting links point; they get their address from the chosen tasting
      body.querySelectorAll<HTMLAnchorElement>('a[href^="t:"], a[href^="g:"]').forEach((a) => {
        a.dataset.to = a.getAttribute('href')!;
        a.setAttribute('href', '/admin/tastings/');
      });
      d.append(sum, body);
      return d;
    }));
  }

  // /admin/help/#max-guests opens the topic (or the topic holding that heading) and scrolls to it
  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    const topic = target?.closest('details') as HTMLDetailsElement | null;
    if (!target || !topic) return;
    topic.open = true;
    requestAnimationFrame(() => target.scrollIntoView({ behavior: 'smooth', block: 'start' }));
  }
  window.addEventListener('hashchange', openFromHash);

  // Search: topics whose text matches open; the rest are hidden
  $('help-search').addEventListener('input', () => {
    const q = ($('help-search') as HTMLInputElement).value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLDetailsElement>('.help-topic').forEach((d) => {
      const hit = !q || d.textContent!.toLowerCase().includes(q);
      d.hidden = !hit;
      d.open = !!q && hit;
      if (hit) shown++;
    });
    $('help-toc').hidden = !!q;
    $('help-none').hidden = shown > 0;
  });
</script>
