---
import Icon from '../../components/ui/Icon.astro';
import Dropdown from '../../components/ui/Dropdown.astro';
import SearchField from '../../components/ui/SearchField.astro';
import Sheet from '../../components/ui/Sheet.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import AdminNav from '../../components/AdminNav.astro';
import WineQuickAdd from '../../components/WineQuickAdd.astro';
import '../../styles/admin.css';
---
<Base title="adminNav.wines">
  <section class="wrap admin-page">
    <AdminNav active="wines">
    <div id="admin-main" hidden>
      <!-- One wine: /admin/wines/<id>/ (the same page, shown instead of the list) -->
      <section id="wine-detail" class="wine-detail" hidden>
        <a class="text-btn back wd-back" href="/admin/wines/"><Icon name="left" /><span data-i18n="wineAdmin.back">All wines</span></a>
        <EmptyState id="wd-missing" icon="search" title="wineAdmin.notFound" hidden>
          <a class="btn small" href="/admin/wines/" data-i18n="wineAdmin.back">All wines</a>
        </EmptyState>
        <div id="wd-main">
          <div class="wd-head">
            <div id="wd-pic" class="wd-pic"></div>
            <PageHeader id="wd-name" class="wd-ph">
              <p id="wd-meta" class="wd-meta"></p>
              <p id="wd-overall" class="wd-overall" hidden></p>
              <button slot="actions" id="wd-edit" class="btn small secondary" type="button" data-i18n="admin.edit">Edit</button>
            </PageHeader>
          </div>
          <!-- A wine with only a name: a way forward -->
          <EmptyState id="wd-empty" icon="glass" title="wineAdmin.emptyTitle" text="wineAdmin.emptyText" hidden>
            <button id="wd-empty-fill" class="btn small" type="button" data-i18n="wineAdmin.emptyFill">Fetch from a link or photo</button>
            <button id="wd-empty-edit" class="btn small secondary" type="button" data-i18n="wineAdmin.emptyEdit">Fill in yourself</button>
          </EmptyState>
          <div class="wd-grid">
            <div>
              <p id="wd-description" class="wd-description" hidden></p>
              <div id="wd-facts-strip"></div>
              <section id="wd-notes-block" class="wd-block" hidden>
                <SectionTitle level="eyebrow" as="h2" text="wineAdmin.notes" />
                <dl id="wd-notes" class="facts ruled card"></dl>
              </section>
              <section id="wd-facts-block" class="wd-block" hidden>
                <SectionTitle level="eyebrow" as="h2" text="wineAdmin.facts" />
                <dl id="wd-facts" class="facts ruled card"></dl>
              </section>
              <section class="wd-block">
                <SectionTitle level="eyebrow" as="h2" text="wineAdmin.tastings" />
                <ul id="wd-tastings" class="card list flush wd-tastings"></ul>
                <EmptyState id="wd-tastings-empty" icon="glass" title="wineLib.unused" text="wineAdmin.unusedHelp" hidden />
              </section>
            </div>
            <section id="wd-origin" class="wd-block" hidden>
              <SectionTitle level="eyebrow" as="h2" text="wineAdmin.origin" />
              <p id="wd-origin-text" class="wd-origin-text"></p>
              <div id="wd-map" class="map-box" hidden></div>
            </section>
          </div>
        </div>
      </section>

      <div id="wine-list-view">
      <PageHeader title="adminNav.wines" lead="wineLib.intro">
        <Fragment slot="actions">
          <button id="wine-add-toggle" class="btn small" type="button"><Icon name="plus" /><span data-i18n="wineLib.newWineBtn">New wine</span></button><span id="wine-add-help" data-help="new-wine"></span>
        </Fragment>
      </PageHeader>

      <section class="wines-admin">
        <SearchField id="wine-search" label="adminTasting.search" class="list-search" />

        <!-- Filters: country → region (linked), type, tasting – drop-downs with checkboxes, made in admin-wines.ts -->
        <div id="wine-filters" class="wine-filters" hidden>
          <span id="wl-count" class="wl-count" aria-live="polite"></span>
          <button id="wl-clear" class="text-btn" type="button" hidden data-i18n="wineLib.clearFilters">Clear filters</button>
        </div>

        <!-- New wine: a new row that slides in at the top of the list (name, link or photo) -->
        <WineQuickAdd />
        <ul id="wine-admin-list" class="list"></ul>
        <EmptyState id="wine-empty" icon="glass" title="wineLib.emptyTitle" text="wineLib.emptyText" hidden>
          <button id="wine-empty-add" class="btn small" type="button"><Icon name="plus" /><span data-i18n="wineLib.newWineBtn">New wine</span></button>
        </EmptyState>
        <EmptyState id="wine-no-match" icon="filter" title="wineLib.noMatch" hidden>
          <button id="wine-no-match-clear" class="btn small secondary" type="button" data-i18n="wineLib.showAll">Show all wines</button>
        </EmptyState>
      </section>
      </div>
      <!-- Outside the list, so it also opens on a wine's own page (where the list is hidden) -->
        <!-- Editing a wine: the side panel from the right (bottom sheet on phones). New wines come in through the line above the list. -->
        <Sheet id="wine-panel" title="admin.editWine" titleId="wf-title" wide form="wine-form" formClass="wine-form">
          <!-- 1. Source: a link to the wine (fetches it again) -->
          <section class="wf-step" data-step="0">
          <div id="wf-link-box" class="wf-link-box">
          <label for="wf-link"><span data-i18n="link.label">Link to the wine</span> <span class="opt" data-i18n="link.hint">(e.g. from a web shop – fills in the form)</span></label>
          <div class="inline-form link-row">
            <input class="input" id="wf-link" type="url" inputmode="url" placeholder="https://…" autocomplete="off" />
            <button id="wf-read-link" class="btn small secondary" type="button" data-i18n="link.fetch">Fetch</button>
          </div>
          <p id="wf-link-status" class="status" hidden aria-live="polite"></p>
          </div>
          </section>

          <!-- 2. The wine -->
          <section class="wf-step" data-step="1">
          <!-- Where the wine's data came from, with a button that fetches it again -->
          <div id="wf-source" class="card tight wf-source" hidden>
            <div class="wf-source-row">
              <span class="wf-source-text"><span data-i18n="source.from">Fetched from</span> <a id="wf-source-link" href="#" target="_blank" rel="noopener"></a> <span id="wf-source-when" class="source-when"></span></span>
              <button id="wf-source-refresh" class="icon-act" type="button" data-tip="Update" aria-label="Update" data-i18n-attr="data-tip=source.refresh;aria-label=source.refresh"><Icon name="refresh" /></button>
            </div>
            <button id="wf-source-other" class="text-btn" type="button" data-i18n="source.other">Use another link</button>
            <p id="wf-source-status" class="status" hidden aria-live="polite"></p>
          </div>
          <p class="hint wf-required-note"><span class="req" aria-hidden="true">*</span> <span data-i18n="wineCheck.onlyName">Only the name is needed – the rest you can fill in now or later.</span></p>
          <label for="wf-name"><span data-i18n="admin.name">Name</span> <span class="req" aria-hidden="true">*</span></label>
          <input class="input" id="wf-name" type="text" required aria-required="true" autocomplete="off" />
          <!-- Wines already in the library with a name like this one -->
          <div id="wf-similar" class="wf-similar" hidden aria-live="polite"></div>
          <p class="flabel" data-i18n="admin.image">Image</p>
          <div class="wf-image" id="wf-image-box">
            <!-- The one image picker (src/lib/ui/image-picker.ts): choose, drop or paste; with a picture: "Change" and the trash -->
            <div id="wf-pick"></div>
            <button id="wf-read-label" class="text-btn" type="button" hidden data-i18n="label.read">Fill in from the label</button>
            <p id="wf-label-status" class="status" hidden aria-live="polite"></p>
            <!-- An official picture from the producer's website: the host picks the right one -->
            <button id="wf-find-image" class="text-btn find-image" type="button" data-i18n="image.findOfficial">Find an official picture</button>
            <p id="wf-image-status" class="status" hidden aria-live="polite"></p>
            <div id="wf-image-options" class="image-options" hidden></div>
          </div>
          <label for="wf-producer" data-i18n="admin.producer">Producer</label>
          <input class="input" id="wf-producer" type="text" />
          <!-- The producer's website and address are looked up as soon as the producer is known; shown in step 3 -->
          <p id="wf-producer-busy" class="status" hidden aria-live="polite"></p>
          <div class="wf-pair">
            <div>
              <label for="wf-style-btn" data-i18n="admin.style">Type</label>
              <Dropdown id="wf-style" placeholder="admin.choose" />
            </div>
            <div>
              <label for="wf-vintage" data-i18n="admin.vintage">Vintage</label>
              <div class="inline-form">
                <input class="input" id="wf-vintage" type="text" placeholder="E.g. 2019 or 10 years" data-i18n-attr="placeholder=admin.vintagePlaceholder" />
                <button id="wf-nv" class="btn small secondary" type="button" data-tip-text="Non Vintage" data-i18n-attr="data-tip-text=wine.nv">NV</button>
              </div>
            </div>
          </div>
          <label for="wf-abv" data-i18n="admin.abvLabel">Alcohol</label>
          <div class="affix w-num">
            <input id="wf-abv" type="text" inputmode="decimal" class="input" placeholder="13,5" />
            <span class="unit" aria-hidden="true">%</span>
          </div>
          </section>

          <!-- 3. Origin and the producer -->
          <section class="wf-step" data-step="2">
          <!-- Origin: country → region → appellation; each list narrows the next, and a known appellation fills in the rest -->
          <div class="wf-pair">
            <div>
              <label for="wf-country-btn" data-i18n="origin.country">Country</label>
              <Dropdown id="wf-country" placeholder="admin.choose" search />
            </div>
            <div>
              <label for="wf-region" data-i18n="origin.region">Region</label>
              <input class="input" id="wf-region" type="text" autocomplete="off" />
            </div>
          </div>
          <label for="wf-appellation"><span data-i18n="origin.appellation">Appellation</span> <span class="opt" data-i18n="origin.appellationHint">(e.g. Saint-Émilion Grand Cru, Porto, Barolo)</span></label>
          <input class="input" id="wf-appellation" type="text" autocomplete="off" />
          <p id="wf-app-status" class="status" hidden aria-live="polite"></p>
          <div id="wf-map" class="wf-map" hidden>
            <div class="wf-map-col"><div id="wf-map-svg" class="map-box"></div></div>
            <p id="wf-map-note" class="hint"></p>
          </div>
          <!-- The producer's website and address: found as soon as the producer is known (link, label or typed), or typed here -->
          <label for="wf-producer-website"><span data-i18n="producer.website">Producer's website</span> <span class="opt" data-i18n="producer.websiteHint">(found automatically from the producer)</span></label>
          <input class="input" id="wf-producer-website" type="url" inputmode="url" placeholder="https://…" autocomplete="off" />
          <p id="wf-producer-status" class="status" hidden aria-live="polite"></p>
          <label for="wf-producer-address" data-i18n="producer.address">Producer's address</label>
          <input class="input" id="wf-producer-address" type="text" autocomplete="off" />
          <p id="wf-address-status" class="status" hidden aria-live="polite"></p>
          </section>

          <!-- 4. Price and description; a new wine can go straight into a tasting -->
          <section class="wf-step" data-step="3">
          <p class="hint wf-prices-note" data-i18n="wineLib.pricesNote">The shop's prices – what the wine costs to buy. When you put the wine in a tasting, they become the guest price and quantity price, which you can change under the tasting's wines.</p>
          <label for="wf-retail"><span data-i18n="twe.shopPriceLabel">Shop price</span> <span class="opt" data-i18n="unit.perBottleParen">(per bottle)</span></label>
          <div class="affix w-num"><input class="input" id="wf-retail" type="text" inputmode="decimal" /><span class="unit" data-i18n="unit.kr">kr.</span></div>
          <label for="wf-offer-price"><span data-i18n="wineLib.offer">Shop offer</span> <span class="opt" data-i18n="wineLib.offerHint">(optional – becomes the quantity price when you add the wine to a tasting)</span></label>
          <div class="field-row offer-row">
            <div class="affix w-num"><input class="input" id="wf-offer-price" type="text" inputmode="decimal" aria-label="Offer price per bottle" data-i18n-attr="aria-label=wineLib.offerPrice" /><span class="unit" data-i18n="unit.kr">kr.</span></div>
            <span data-i18n="wineLib.offerWhen">when buying</span>
            <div class="affix w-num w-qty"><input class="input" id="wf-offer-qty" type="text" inputmode="numeric" placeholder="6" aria-label="Number of bottles" data-i18n-attr="aria-label=adminTasting.bulkQty" /></div>
            <span data-i18n="adminTasting.bulkBottles">bottles</span>
          </div>
          <!-- The guest price belongs to each tasting: shown here, changed in the tasting -->
          <div id="wf-in-tastings" class="wf-in-tastings" hidden>
            <p class="flabel" data-i18n="wineLib.inTastings">Guest price in your tastings</p>
            <ul id="wf-in-tastings-list"></ul>
            <p class="hint" data-i18n="wineLib.inTastingsHint">Set for each tasting – separate from the shop's price above.</p>
          </div>
          <label for="wf-description" data-i18n="admin.description">Description</label>
          <textarea class="input" id="wf-description" rows="3"></textarea>
          <label for="wf-grapes"><span data-i18n="label.grapes">Grapes</span> <span class="opt" data-i18n="wineFields.grapesHint">(e.g. 85 % Merlot, 15 % Cabernet Franc)</span></label>
          <input class="input" id="wf-grapes" type="text" maxlength="300" autocomplete="off" />
          <label for="wf-food"><span data-i18n="wineFields.food">Goes with</span> <span class="opt" data-i18n="wineFields.foodHint">(e.g. grilled fish, salads, cheese)</span></label>
          <input class="input" id="wf-food" type="text" maxlength="400" autocomplete="off" />
          <label for="wf-serving"><span data-i18n="wineFields.serving">Serving</span> <span class="opt" data-i18n="wineFields.servingHint">(e.g. 14–16 °C, decant an hour before)</span></label>
          <input class="input" id="wf-serving" type="text" maxlength="300" autocomplete="off" />
          <label for="wf-details"><span data-i18n="admin.details">More about the wine</span> <span class="opt" data-i18n="admin.detailsHint">(one line per item, e.g. "Grapes: Touriga Nacional")</span></label>
          <textarea class="input" id="wf-details" rows="3"></textarea>
          </section>
          <button slot="quiet" id="wf-delete" class="btn small quiet-danger" type="button"><Icon name="trash" /><span data-i18n="admin.deleteWine">Delete wine</span></button>
          <button slot="foot" id="wf-save" class="btn" type="submit" data-i18n="common.save">Save</button>
        </Sheet>
    </div>
    </AdminNav>
  </section>
</Base>

<script>
  import { initHelpTips, followHelpLink } from '../../lib/help-tip';
  initHelpTips();
  import { requireHost, $ } from '../../lib/admin-common';
  import { initWineAdmin } from '../../lib/admin-wines';
  import { winePaths, wineIdFromPath, onWinePage, showWinePage } from '../../lib/admin-wine-page';
  import { initQuickAdd } from '../../lib/wine-quick-add';
  import { toast } from '../../lib/toast';
  import { t } from '../../i18n';

  const host = await requireHost();
  if (host) {
    $('admin-main').hidden = false;
    // A wine's own page lives on the same page: /admin/wines/<country>/<region>/…/<name>/<vintage>/
    let wineId: number | null = null;
    const show = async () => {
      // The address follows the wine (also after a rename or an old numeric link)
      const path = admin.paths().get(wineId!);
      if (path && path !== location.pathname) history.replaceState(null, '', path);
      await showWinePage(wineId!, { edit: () => admin.edit(wineId!), refresh: () => admin.edit(wineId!, true),
        // The panel opens at the link field (a photo can be chosen right under it)
        fill: () => { admin.edit(wineId!); document.getElementById('wf-link')?.focus(); } });
    };
    const admin = initWineAdmin(host.id, host.tenant_id, onWinePage()
      ? { onSaved: () => { show(); }, onDeleted: (id) => { location.href = `/admin/wines/?deleted=${id}`; } } : {});
    await admin.load();
    followHelpLink();
    const params = new URLSearchParams(location.search);
    // Deleted on the wine's own page: hidden here with "Undo" before it is deleted for real
    const deleted = Number(params.get('deleted'));
    if (deleted) {
      params.delete('deleted');
      history.replaceState(null, '', location.pathname + (params.size ? `?${params}` : ''));
      admin.deleteLater(deleted);
    }
    // New wine: the line above the list. Opened by "+ New wine", by ?new (help links) and when the library is empty.
    const quick = initQuickAdd({
      hostId: host.id,
      toggle: $('wine-add-toggle'),
      library: () => admin.wines(),
      href: (w) => admin.paths().get(w.id) ?? '/admin/wines/',
      done: async (id, name) => {
        await admin.load();
        const shown = admin.highlight(id);
        toast(t('wineLib.createdToast', { name }), {
          kind: 'ok',
          action: shown ? { label: t('admin.edit'), run: () => admin.edit(id) } : { label: t('wineLib.open'), href: admin.paths().get(id) ?? '/admin/wines/' },
        });
      },
    });
    if (params.has('new')) {
      params.delete('new'); params.delete('back');
      history.replaceState(null, '', location.pathname + (params.size ? `?${params}` : ''));
      quick.open();
    } else if (!onWinePage() && !admin.wines().length) quick.open();
    // The empty library's button puts the cursor in the new-wine line
    $('wine-empty-add').addEventListener('click', () => quick.open());
    if (onWinePage()) {
      wineId = wineIdFromPath(admin.paths());
      await show();
    }
  }
</script>
