---
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import '../../styles/admin.css';
---
<Base title="page.admin">
  <section class="wrap admin-page">
    <AdminNav active="wines">
    <div id="admin-main" hidden>
      <!-- One wine: /admin/wines/<id>/ (the same page, shown instead of the list) -->
      <section id="wine-detail" class="wine-detail" hidden>
        <a class="wd-back" href="/admin/wines/">← <span data-i18n="wineAdmin.back">All wines</span></a>
        <p id="wd-missing" class="hint" hidden data-i18n="wineAdmin.notFound">The wine was not found.</p>
        <div id="wd-main">
          <div class="wd-head">
            <div id="wd-pic" class="wd-pic" hidden></div>
            <div class="wd-head-text">
              <h1 id="wd-name" class="title"></h1>
              <p id="wd-meta" class="wd-meta"></p>
              <p id="wd-overall" class="wd-overall" hidden></p>
            </div>
            <button id="wd-edit" class="btn small ghost" type="button" data-i18n="admin.edit">Edit</button>
          </div>
          <div class="wd-grid">
            <div>
              <p id="wd-description" class="wd-description" hidden></p>
              <section id="wd-facts-block" class="wd-block" hidden>
                <h2 data-i18n="wineAdmin.facts">Details</h2>
                <dl id="wd-facts" class="wd-facts"></dl>
              </section>
              <section class="wd-block">
                <h2 data-i18n="wineAdmin.tastings">Tastings</h2>
                <ul id="wd-tastings" class="wd-tastings"></ul>
                <p id="wd-tastings-empty" class="hint" hidden data-i18n="wineLib.unused">Not in any tasting</p>
              </section>
            </div>
            <section id="wd-origin" class="wd-block" hidden>
              <h2 data-i18n="wineAdmin.origin">Origin</h2>
              <p id="wd-origin-text" class="wd-origin-text"></p>
              <div id="wd-map" class="wd-map" hidden></div>
            </section>
          </div>
        </div>
      </section>

      <div id="wine-list-view">
      <h1 class="title" data-i18n="adminNav.wines">Wines</h1>
      <p class="hint" data-i18n="wineLib.intro">All your wines. Add them here, then choose them for each tasting – where you also set the guest price.</p>

      <section class="block wines-admin">
        <div class="guests-head">
          <input id="wine-search" class="search" type="search" autocomplete="off" placeholder="Search" data-i18n-attr="placeholder=adminTasting.search" style="max-width:20rem;margin:0" />
          <button id="wine-add-toggle" class="btn small ghost" type="button" data-i18n="admin.addWine">Add wine</button>
        </div>

        <!-- New / edit wine: side panel on larger screens, bottom sheet on phones -->
        <dialog id="wine-panel" class="sheet wide" aria-labelledby="wf-title">
        <div class="sheet-head">
          <h2 id="wf-title" data-i18n="admin.newWine">New wine</h2>
          <button id="wf-close" class="sheet-close" type="button" aria-label="Close" data-i18n-attr="aria-label=admin.close">×</button>
        </div>
        <form id="wine-form" class="add-form wine-form" novalidate>
          <!-- Two ways to fill in the form automatically (new wines) -->
          <div id="wf-start" class="wf-start">
            <div class="start-tiles">
              <label class="start-tile" for="wf-camera">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.5-2.5h7L17 8h3v11H4z" /><circle cx="12" cy="13.5" r="3.5" /></svg>
                <b data-i18n="start.photo">Photo of the label</b>
                <span id="wf-photo-text" data-i18n="start.photoText">Take a picture – we read the label</span>
              </label>
              <input id="wf-camera" class="visually-hidden" type="file" accept="image/*" tabindex="-1" />
              <button id="wf-start-link" class="start-tile" type="button" aria-controls="wf-link-box" aria-expanded="false">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1.2 1.2" /><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1.2-1.2" /></svg>
                <b data-i18n="start.link">Link to the wine</b>
                <span data-i18n="start.linkText">Paste a link from a web shop</span>
              </button>
            </div>
            <p id="wf-start-status" class="label-status" hidden aria-live="polite"></p>
            <p class="hint start-or" data-i18n="start.orManual">… or fill in the fields yourself.</p>
          </div>
          <div id="wf-link-box" class="wf-link-box">
          <label for="wf-link"><span data-i18n="link.label">Link to the wine</span> <span class="hint" data-i18n="link.hint">(e.g. from a web shop – fills in the form)</span></label>
          <div class="inline-form link-row">
            <input id="wf-link" type="url" inputmode="url" placeholder="https://…" autocomplete="off" />
            <button id="wf-read-link" class="btn small ghost" type="button" data-i18n="link.fetch">Fetch</button>
          </div>
          <p id="wf-link-status" class="label-status" hidden aria-live="polite"></p>
          </div>
          <!-- Where the wine's data came from, with a button that fetches it again -->
          <div id="wf-source" class="wf-source" hidden>
            <div class="wf-source-row">
              <span class="wf-source-text"><span data-i18n="source.from">Fetched from</span> <a id="wf-source-link" href="#" target="_blank" rel="noopener"></a></span>
              <button id="wf-source-refresh" class="btn small ghost" type="button" data-i18n="source.refresh">Update</button>
            </div>
            <button id="wf-source-other" class="text-btn" type="button" data-i18n="source.other">Use another link</button>
            <p id="wf-source-status" class="label-status" hidden aria-live="polite"></p>
          </div>
          <label for="wf-name" data-i18n="admin.name">Name</label>
          <input id="wf-name" type="text" required />
          <label for="wf-image"><span data-i18n="admin.image">Image</span> <span class="hint" data-i18n="admin.imageHint">(a photo of the label fills in the form)</span></label>
          <div class="wf-image" id="wf-image-box">
            <img id="wf-preview" alt="" hidden />
            <input id="wf-image" type="file" accept="image/*" />
            <button id="wf-image-remove" class="text-btn" type="button" hidden data-i18n="admin.removeImage">Remove image</button>
            <button id="wf-read-label" class="text-btn" type="button" hidden data-i18n="label.read">Fill in from the label</button>
            <p id="wf-label-status" class="label-status" hidden aria-live="polite"></p>
          </div>
          <label for="wf-producer" data-i18n="admin.producer">Producer</label>
          <input id="wf-producer" type="text" />
          <div class="wf-pair">
            <div>
              <label for="wf-style" data-i18n="admin.style">Type</label>
              <select id="wf-style"></select>
            </div>
            <div>
              <label for="wf-vintage" data-i18n="admin.vintage">Vintage</label>
              <div class="inline-form">
                <input id="wf-vintage" type="text" placeholder="E.g. 2019 or 10 years" data-i18n-attr="placeholder=admin.vintagePlaceholder" />
                <button id="wf-nv" class="btn small ghost" type="button" title="Non Vintage" data-i18n-attr="title=wine.nv">NV</button>
              </div>
            </div>
          </div>
          <!-- Origin: country → region → appellation; each list narrows the next, and a known appellation fills in the rest -->
          <div class="wf-pair">
            <div>
              <label for="wf-country" data-i18n="origin.country">Country</label>
              <select id="wf-country"></select>
            </div>
            <div>
              <label for="wf-region" data-i18n="origin.region">Region</label>
              <input id="wf-region" type="text" list="wf-regions" autocomplete="off" />
              <datalist id="wf-regions"></datalist>
            </div>
          </div>
          <label for="wf-appellation"><span data-i18n="origin.appellation">Appellation</span> <span class="hint" data-i18n="origin.appellationHint">(e.g. Saint-Émilion Grand Cru, Porto, Barolo)</span></label>
          <input id="wf-appellation" type="text" list="wf-appellations" autocomplete="off" />
          <datalist id="wf-appellations"></datalist>
          <p id="wf-app-status" class="app-status" hidden aria-live="polite"></p>
          <div id="wf-map" class="wf-map" hidden>
            <div id="wf-map-svg" class="wf-map-svg"></div>
            <p id="wf-map-note" class="hint"></p>
          </div>
          <label for="wf-retail" data-i18n="admin.retail">Regular price (DKK)</label>
          <input id="wf-retail" type="text" inputmode="decimal" />
          <label for="wf-offer-price"><span data-i18n="wineLib.offer">Shop offer</span> <span class="hint" data-i18n="wineLib.offerHint">(optional – becomes the quantity price when you add the wine to a tasting)</span></label>
          <div class="inline-form offer-row">
            <input id="wf-offer-price" type="text" inputmode="decimal" placeholder="kr." aria-label="Offer price per bottle" data-i18n-attr="aria-label=wineLib.offerPrice" />
            <span data-i18n="wineLib.offerWhen">when buying</span>
            <input id="wf-offer-qty" type="text" inputmode="numeric" placeholder="6" aria-label="Number of bottles" data-i18n-attr="aria-label=adminTasting.bulkQty" />
            <span data-i18n="adminTasting.bulkBottles">bottles</span>
          </div>
          <label for="wf-abv" data-i18n="admin.abv">Alcohol (%)</label>
          <input id="wf-abv" type="text" inputmode="decimal" class="short" />
          <label for="wf-description" data-i18n="admin.description">Description</label>
          <textarea id="wf-description" rows="3"></textarea>
          <label for="wf-details"><span data-i18n="admin.details">More about the wine</span> <span class="hint" data-i18n="admin.detailsHint">(one line per item, e.g. "Grapes: Touriga Nacional")</span></label>
          <textarea id="wf-details" rows="3"></textarea>
          <p id="wf-msg" class="message error" hidden></p>
          <div class="row-actions">
            <button id="wf-save" class="btn small" type="submit" data-i18n="common.save">Save</button>
            <button id="wf-cancel" class="text-btn" type="button" data-i18n="common.cancel">Cancel</button>
            <button id="wf-delete" class="text-btn danger" type="button" hidden data-i18n="admin.deleteWine">Delete wine</button>
          </div>
        </form>
        </dialog>

        <ul id="wine-admin-list" class="wine-admin-list"></ul>
        <p id="wine-empty" class="hint" hidden data-i18n="admin.noWines">No wines yet. Add the first one.</p>
      </section>
      </div>
    </div>
    </AdminNav>
  </section>
</Base>

<script>
  import { requireHost, $ } from '../../lib/admin-common';
  import { initWineAdmin } from '../../lib/admin-wines';
  import { wineIdFromPath, showWinePage } from '../../lib/admin-wine-page';

  const host = await requireHost();
  if (host) {
    $('admin-main').hidden = false;
    const wineId = wineIdFromPath();
    // On a wine's own page: saving reloads the page's facts, deleting goes back to the list
    const show = () => showWinePage(wineId!, { edit: () => admin.edit(wineId!), refresh: () => admin.edit(wineId!, true) });
    const admin = initWineAdmin(host.id, host.tenant_id, wineId ? { onSaved: show, onDeleted: () => { location.href = '/admin/wines/'; } } : {});
    await admin.load();
    if (wineId) await show();
    // Search the list
    $('wine-search').addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      document.querySelectorAll<HTMLElement>('#wine-admin-list > li').forEach((li) => {
        li.hidden = !!q && !li.textContent!.toLowerCase().includes(q);
      });
    });
  }
</script>
