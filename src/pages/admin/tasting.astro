---
import Icon from '../../components/ui/Icon.astro';
import SearchField from '../../components/ui/SearchField.astro';
import CloseButton from '../../components/ui/CloseButton.astro';
import Switch from '../../components/ui/Switch.astro';
import ChoiceCards from '../../components/ui/ChoiceCards.astro';
import Checkbox from '../../components/ui/Checkbox.astro';
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import AddressFields from '../../components/AddressFields.astro';
import DateTimeFields from '../../components/DateTimeFields.astro';
import ChatBox from '../../components/ChatBox.astro';
import WineQuickAdd from '../../components/WineQuickAdd.astro';
import '../../styles/admin.css';
import { en } from '../../i18n/en';
// The parts of a tasting's admin (as SECTIONS in src/lib/admin-side.ts), shown as the page's sub-menu
const TABS: { id: string; path: string; key: keyof typeof en }[] = [
  { id: 'overview', path: '', key: 'section.overview' },
  { id: 'wines', path: 'wines/', key: 'page.wines' },
  { id: 'guests', path: 'guests/', key: 'admin.guests' },
  { id: 'orders', path: 'orders/', key: 'admin.orders' },
  { id: 'quiz', path: 'quiz/', key: 'page.quiz' },
  { id: 'chat', path: 'chat/', key: 'page.chat' },
  { id: 'settings', path: 'settings/', key: 'section.settings' },
];
---
<Base title="page.admin" adminTasting>
  <section class="wrap admin-page">
    <AdminNav>
    <p id="not-found" class="message error" hidden><span data-i18n="adminTasting.notFound">This tasting was not found.</span> <a href="/admin/tastings/" data-i18n="adminTasting.back">All tastings</a></p>

    <div id="admin-main" hidden>
      <!-- The tasting's name, the way to its guest page, and its sub-menu -->
      <header class="ta-head">
        <div class="ta-top">
          <h1 id="ta-title" class="title"></h1>
          <a id="t-guestpage" class="btn small secondary" href="/home/" target="_blank" rel="noopener" title="See the tasting as your guests do" data-i18n-attr="title=nav.guestPageTitle"><span data-i18n="nav.guestPage">Guest page</span><Icon name="ext" /></a>
        </div>
        <nav id="admin-tabs" class="ta-tabs" aria-label="Tasting admin" data-i18n-attr="aria-label=adminBar.label">
          {TABS.map((tab) => <a href="/admin/" data-apath={tab.path} data-section={tab.id} data-i18n={tab.key}>{en[tab.key]}</a>)}
        </nav>
      </header>
      <div id="tasting-panel">
      <!-- Tasting details -->
      <section class="block" data-section="overview">
        <!-- Get started: wines, guests, payment – each with the button that does it. Gone when wines and guests are in. -->
        <div id="setup-card" class="card setup-card start-card" hidden>
          <div class="start-head">
            <p class="setup-title" data-i18n="getStarted.title">Get started</p>
            <span class="start-head-right">
              <span id="start-progress" class="start-progress"></span>
              <button id="start-hide" class="text-btn" type="button" data-i18n="getStarted.hide">Hide</button>
            </span>
          </div>
          <div class="start-bar" aria-hidden="true"><i id="start-bar"></i></div>
          <!-- One row per step: ✓ when done, its number when not; only the next step has a (red) button -->
          <ol class="start-steps">
            <li id="start-wines">
              <span class="start-ic" aria-hidden="true">1</span>
              <span class="start-label"><b data-i18n="getStarted.winesTitle">The wines</b><small id="start-wines-info"></small></span>
              <button id="start-wines-btn" class="text-btn" type="button" data-go="wines" data-open="tw-add-toggle"></button>
            </li>
            <li id="start-guests">
              <span class="start-ic" aria-hidden="true">2</span>
              <span class="start-label"><b data-i18n="getStarted.guests">Invite the guests</b><small id="start-guests-info"></small></span>
              <button id="start-guests-btn" class="text-btn" type="button" data-go="guests" data-open="g-invite-toggle"></button>
            </li>
            <li id="start-setup">
              <span class="start-ic" aria-hidden="true">3</span>
              <span class="start-label"><b data-i18n="getStarted.setup">Payment and ordering</b><small id="start-setup-info"></small></span>
              <button id="start-setup-btn" class="text-btn" type="button" data-go="settings" data-i18n="getStarted.settings">Settings</button>
            </li>
          </ol>
        </div>
        <div class="guests-head">
          <h2 data-i18n="section.details">Details</h2>
          <button id="details-edit" class="text-btn" type="button" data-i18n="admin.edit">Edit</button>
        </div>
        <!-- Read-only; changed in the side panel ("Edit") -->
        <dl id="details-view" class="details-view">
          <dt data-i18n="admin.title">Title</dt><dd id="v-title"></dd>
          <dt data-i18n="admin.when">Date and time</dt><dd id="v-when"></dd>
          <dt data-i18n="admin.place">Place</dt><dd id="v-place"></dd>
          <dt data-i18n="admin.intro">Introduction</dt><dd id="v-intro" class="v-intro"></dd>
        </dl>

        <!-- Who hosts the tasting -->
        <div class="guests-head ov-hosts-head">
          <h2 data-i18n="hosts.title">Hosts</h2>
          <a id="ov-hosts-manage" class="text-btn" href="settings/" data-section="settings" hidden data-i18n="hosts.manage">Manage hosts</a>
        </div>
        <ul id="ov-hosts" class="tw-list guest-list hosts-rows"></ul>

        <dialog id="details-panel" class="sheet wide" aria-labelledby="details-panel-title">
          <div class="sheet-head">
            <h2 id="details-panel-title" data-i18n="section.details">Details</h2>
            <CloseButton data-close />
          </div>
        <form id="details" class="add-form tasting-form" novalidate>
          <label for="d-title" data-i18n="admin.title">Title</label>
          <input class="input" id="d-title" type="text" required />
          <label for="d-intro"><span data-i18n="admin.intro">Introduction</span> <span class="opt" data-i18n="admin.introHint">(what is going to happen – shown to your guests)</span></label>
          <textarea class="input" id="d-intro" rows="5" maxlength="4000" placeholder="E.g. We start with a glass of white port…" data-i18n-attr="placeholder=admin.introPlaceholder"></textarea>
          <!-- A draft from Cloudflare AI: shown beside the host's own text, never written over it without asking -->
          <div class="ai-intro" data-help="ai-intro">
            <button id="ai-write" class="text-btn" type="button"><span aria-hidden="true">✦</span> <span data-i18n="aiIntro.write">Write a draft with AI</span></button>
            <button id="ai-undo" class="text-btn" type="button" hidden data-i18n="aiIntro.undo">Undo – bring back my text</button>
            <p id="ai-status" class="hint" aria-live="polite" hidden></p>
            <div id="ai-draft" class="ai-draft" hidden>
              <p class="ai-draft-label" data-i18n="aiIntro.label">Draft from AI – check it before you use it</p>
              <div id="ai-text" class="ai-text"></div>
              <div class="row-actions">
                <button id="ai-use" class="btn small" type="button" data-i18n="aiIntro.use">Use the draft</button>
                <button id="ai-again" class="text-btn" type="button" data-i18n="aiIntro.again">Try again</button>
                <button id="ai-discard" class="text-btn" type="button" data-i18n="aiIntro.discard">Discard</button>
              </div>
            </div>
          </div>
          <DateTimeFields prefix="d" />
          <AddressFields prefix="d" />
          <div class="row-actions">
            <button id="d-save" class="btn small" type="submit" data-i18n="common.save">Save</button>
            <button id="d-cancel" class="text-btn" type="button" data-i18n="common.cancel">Cancel</button>
          </div>
        </form>
        </dialog>
        <p class="hint ov-link-note"><span data-i18n="admin.tastingPage">Tasting page:</span> <a id="tasting-link" href="/" target="_blank"></a><br />
          <span data-i18n="admin.personalLinks">Each guest gets a personal link under Guests.</span></p>
      </section>

      <!-- Controls -->
      <!-- Settings: switches that save straight away; values with an "Edit" that opens the side panel -->
      <section id="controls" class="block set-card" data-section="settings">
        <h2 data-i18n="set.guestsCan">The guests can</h2>
        <Switch title="wizard.signupTitle" hint="wizard.signupHint" data-key="signup_open" />
        <Switch title="set.quizOpen" hint="set.quizOpenHint" help="quiz" data-key="quiz_open" />
        <Switch title="set.quizDone" hint="set.quizDoneHint" data-key="quiz_finished" />
      </section>

      <section class="block set-card" data-section="settings">
        <h2 data-i18n="set.tasting">The tasting</h2>
        <Switch title="wizard.blindTitle" hint="wizard.blindHint" help="blind" data-key="blind" />
        <div id="max-guests-row" class="set-row">
          <span><b><span data-i18n="wizard.maxGuests">Max. number of guests</span><span data-help="max-guests"></span></b><small id="max-guests-view"></small></span>
          <button id="max-guests-edit" class="btn small secondary" type="button" data-i18n="admin.edit">Edit</button>
        </div>
        <div class="set-row">
          <span><b data-i18n="set.tv">Leaderboard for the TV</b><small><a id="tv-link" href="/" target="_blank"></a></small></span>
          <button id="tv-copy" class="btn small secondary" type="button" data-i18n="hosts.copy">Copy</button>
        </div>
      </section>

      <!-- Hosts: the owner gives others the host role for this tasting -->
      <section id="hosts" class="block set-card" data-section="settings">
        <div class="guests-head">
          <h2 data-i18n="hosts.title">Hosts</h2>
          <button id="host-open" class="btn small secondary" type="button" hidden data-i18n="hosts.add">Add host</button>
        </div>
        <p class="hint" data-i18n="hosts.intro">Co-hosts can do everything in this tasting – except delete it and manage the hosts.</p>
        <ul id="hosts-list" class="tw-list guest-list hosts-rows"></ul>
      </section>

      <!-- Tasting fee -->
      <section id="fee" class="block set-card" data-section="settings">
        <h2><span data-i18n="guest.feeTitle">Tasting fee</span><span data-help="fee"></span></h2>
        <div class="set-row">
          <span><b id="fee-view"></b><small id="fee-summary"></small></span>
          <button id="fee-edit" class="btn small secondary" type="button" data-i18n="admin.edit">Edit</button>
        </div>
      </section>

      <!-- Side panels for the settings above -->
      <dialog id="mg-panel" class="sheet" aria-labelledby="mg-title">
        <div class="sheet-head"><h2 id="mg-title" data-i18n="wizard.maxGuests">Max. number of guests</h2><CloseButton data-close /></div>
        <form id="mg-form" class="add-form" novalidate>
          <label for="max-guests" data-i18n="wizard.maxGuests">Max. number of guests</label>
          <div class="affix w-num u-long"><input id="max-guests" class="input" type="text" inputmode="numeric" autocomplete="off" /><span class="unit" data-i18n="set.guestsUnit">guests</span></div>
          <p class="hint" data-i18n="set.maxHint">Leave it empty for no limit. When it is full, guests who say yes go on a waiting list – and move up by themselves when someone says no.</p>
          <div class="row-actions"><button class="btn small" type="submit" data-i18n="common.save">Save</button><button class="text-btn" type="button" data-close data-i18n="common.cancel">Cancel</button></div>
        </form>
      </dialog>

      <dialog id="fee-panel" class="sheet" aria-labelledby="fee-title">
        <div class="sheet-head"><h2 id="fee-title" data-i18n="guest.feeTitle">Tasting fee</h2><CloseButton data-close /></div>
        <form id="fee-form" class="add-form" novalidate>
          <label for="fee-total" data-i18n="set.feeTotal">What the tasting costs in all</label>
          <div class="affix w-num"><input id="fee-total" class="input" type="text" inputmode="decimal" autocomplete="off" /><span class="unit" data-i18n="unit.kr">kr.</span></div>
          <p id="fee-suggest" class="hint"></p>
          <label for="fee-amount" data-i18n="set.feePer">Each guest pays</label>
          <div class="field-row"><div class="affix w-num"><input id="fee-amount" class="input" type="text" inputmode="decimal" autocomplete="off" /><span class="unit" data-i18n="unit.kr">kr.</span></div><span data-i18n="unit.perPerson">per person</span></div>
          <p class="hint" data-i18n="set.feePerHint">Leave it empty to use the suggestion above.</p>
          <Switch title="wizard.feeShowTitle" hint="wizard.feeShowHint" id="fee-open" />
          <div class="row-actions"><button class="btn small" type="submit" data-i18n="common.save">Save</button><button class="text-btn" type="button" data-close data-i18n="common.cancel">Cancel</button></div>
        </form>
      </dialog>

      <dialog id="host-panel" class="sheet" aria-labelledby="host-title">
        <div class="sheet-head"><h2 id="host-title" data-i18n="hosts.add">Add host</h2><CloseButton data-close /></div>
        <p class="hint" data-i18n="hosts.intro">Co-hosts can do everything in this tasting – except delete it and manage the hosts.</p>
        <form id="host-add" class="add-form host-add" novalidate>
          <label for="host-email" data-i18n="common.email">Email</label>
          <input class="input" id="host-email" type="email" inputmode="email" autocomplete="off" />
          <label for="host-name"><span data-i18n="admin.name">Name</span> <span class="opt" data-i18n="dt.optional">(optional)</span></label>
          <input class="input" id="host-name" type="text" autocomplete="off" maxlength="80" />
          <div class="row-actions"><button id="host-add-btn" class="btn small" type="submit" data-i18n="hosts.add">Add host</button></div>
        </form>
        <div id="host-confirm" class="host-confirm" role="alertdialog" aria-live="polite" hidden></div>
        <p id="host-msg" class="message" hidden></p>
        <div id="host-link" class="host-link" hidden>
          <p id="host-link-text" class="hint"></p>
          <div class="inline-form">
            <input class="input" id="host-link-url" type="text" readonly />
            <button id="host-link-copy" class="btn small secondary" type="button" data-i18n="hosts.copy">Copy</button>
          </div>
        </div>
      </dialog>

      <section class="block quiet-zone" data-section="settings">
      <div id="delete-tasting" hidden>
        <h3 data-i18n="tastingDelete.title">Delete the tasting</h3>
        <p class="hint" data-i18n="tastingDelete.hint">Removes the tasting with its guest list, answers, orders, quiz and chat. The wines stay in your library. It cannot be undone.</p>
        <button id="td-ask" class="btn small quiet-danger" type="button"><Icon name="trash" /><span data-i18n="tastingDelete.button">Delete tasting …</span></button>
      </div>
      <!-- The question, in a small window -->
      <dialog id="td-confirm" class="confirm-modal" aria-labelledby="td-q">
        <p id="td-q" class="td-q"></p>
        <p class="hint" data-i18n="tastingDelete.keepWines">The wines stay in your library. It cannot be undone.</p>
        <p id="td-msg" class="message error" hidden></p>
        <div class="row-actions">
          <button id="td-no" class="btn small secondary" type="button" data-i18n="common.cancel">Cancel</button>
          <button id="td-yes" class="btn small danger" type="button" data-i18n="tastingDelete.yes">Yes, delete it</button>
        </div>
      </dialog>
      </section>

      <!-- Wines in this tasting (from the wine library) -->
      <section class="block wines-admin" data-section="wines">
        <div class="guests-head">
          <h2 data-i18n="page.wines">Wines</h2>
          <button id="tw-add-toggle" class="btn small" type="button"><Icon name="plus" /><span data-i18n="adminTasting.addWineBtn">Add wine</span></button>
        </div>
        <!-- Add a wine: a new row that slides in at the top of the list – search the library, paste a link or add a photo -->
        <WineQuickAdd lead />
        <!-- The list shows each wine; "Edit" opens the side panel with its settings for this tasting -->
        <ol id="tw-list" class="tw-list"></ol>
        <p id="tw-move-help" class="sr" aria-live="polite"></p>
        <p id="tw-empty" class="hint" hidden data-i18n="adminTasting.noWines">No wines in this tasting yet.</p>

        <dialog id="tw-edit" class="sheet" aria-labelledby="twe-title">
          <div class="sheet-head">
            <h2 id="twe-title"></h2>
            <CloseButton data-close />
          </div>
          <form id="twe-form" class="add-form twe-form" novalidate>
            <div class="twe-wine">
              <div id="twe-thumb" class="wine-thumb"></div>
              <p id="twe-meta" class="lib-meta"></p>
            </div>

            <!-- The guest price (this tasting) next to the shop's price (the wine in the library, all tastings) -->
            <div class="twe-prices">
              <div>
                <label for="twe-price"><span data-i18n="adminTasting.guestPrice">Guest price</span> <span class="opt" data-i18n="unit.perBottleParen">(per bottle)</span></label>
                <div class="affix w-num"><input id="twe-price" class="input" type="text" inputmode="decimal" autocomplete="off" /><span class="unit" data-i18n="unit.kr">kr.</span></div>
              </div>
              <div>
                <label for="twe-retail-in"><span data-i18n="twe.shopPriceLabel">Shop price</span> <span class="opt" data-i18n="unit.perBottleParen">(per bottle)</span></label>
                <div class="affix w-num"><input id="twe-retail-in" class="input" type="text" inputmode="decimal" autocomplete="off" /><span class="unit" data-i18n="unit.kr">kr.</span></div>
              </div>
            </div>
            <p class="hint twe-prices-hint" data-i18n="twe.shopPriceHint">The shop's price is saved on the wine in your library, so it follows the wine into other tastings.</p>

            <fieldset class="twe-group">
              <legend data-i18n="twe.tiersTitle">Quantity prices</legend>
              <p class="hint" data-i18n="twe.tiersHint">A lower price per bottle when a guest buys several.</p>
              <div id="twe-tiers" class="twe-tiers"></div>
              <button id="twe-add-tier" class="text-btn" type="button"><Icon name="plus" /><span data-i18n="twe.addTier">Add quantity price</span></button>
            </fieldset>

            <!-- What the guests see: the choice cards (component 10) -->
            <ChoiceCards name="twe-vis" legend="blind.guestsSee" class="twe-group" options={[
              { value: 'shown', label: 'blind.shown', hint: 'twe.shownHint' },
              { value: 'blind', label: 'blind.blind', hint: 'twe.blindHint' },
              { value: 'hidden', label: 'twe.hidden', hint: 'twe.hiddenHint' }]}><span slot="legend" data-help="guests-see"></span></ChoiceCards>

            <Switch title="admin.orderable" hint="twe.orderableHint" id="twe-orderable" class="twe-switch" />

            <p id="twe-msg" class="message error" hidden></p>
            <div class="row-actions">
              <button id="twe-save" class="btn small" type="submit" data-i18n="common.save">Save</button>
              <button id="twe-cancel" class="text-btn" type="button" data-i18n="common.cancel">Cancel</button>
            </div>
            <div class="twe-danger">
              <button id="twe-remove" class="btn small quiet-danger" type="button"><Icon name="trash" /><span data-i18n="twe.remove">Remove from the tasting</span></button>
              <p class="hint" data-i18n="twe.removeHint">The wine stays in your library.</p>
            </div>
          </form>
        </dialog>
      </section>

      <!-- Guests -->
      <section class="block guests" data-section="guests">
        <div class="guests-head">
          <h2 data-i18n="admin.guests">Guests</h2>
          <div class="head-actions">
            <!-- Who is shown: the one filter menu (src/lib/filter-dd.ts), made in the script -->
            <div id="g-filter-slot" class="filter-slot"></div>
            <button id="g-invite-toggle" class="btn small" type="button"><Icon name="plus" /><span data-i18n="guestLib.addBtn">Add guest</span></button>
          </div>
        </div>
        <!-- Guests are invited to wines: at least one wine in the tasting first -->
        <p id="g-needs-wine" class="message" hidden><span data-i18n="adminTasting.needsWine">Add at least one wine to the tasting before you invite guests.</span> <a href="wines/" data-section="wines" data-i18n="adminTasting.toWines">Go to Wines</a></p>


        <SearchField id="guest-search" label="admin.searchGuest" placeholder="admin.searchPlaceholder" class="list-search" />

        <!-- Invite a guest: a new row that slides in at the top of the list – name (searches your guest list) and email -->
        <div class="qa qa-guest">
          <div id="gi-bar" class="qa-slide" inert>
            <div class="qa-slide-in">
              <div class="qa-item qa-new gi-row">
                <span class="guest-av gi-av" aria-hidden="true">+</span>
                <div class="qa-body">
                  <div id="gi-fields" class="gi-fields">
                    <div id="gi-field" class="input qa-field gi-name">
                      <label for="gi-input" class="visually-hidden" data-i18n="admin.name">Name</label>
                      <input id="gi-input" type="text" autocomplete="off" enterkeyhint="go" placeholder="Name" data-i18n-attr="placeholder=guestInvite.namePh" />
                    </div>
                    <div id="gi-email-field" class="input qa-field gi-email">
                      <label for="gi-email" class="visually-hidden" data-i18n="common.email">Email</label>
                      <input id="gi-email" type="email" inputmode="email" autocomplete="off" enterkeyhint="go" placeholder="Email (optional)" data-i18n-attr="placeholder=guestInvite.emailPh" />
                    </div>
                  </div>
                  <Checkbox label="inviteMail.sendOnInvite" id="g-send-mail" checked small class="gi-mail" help="invite-mail" />
                </div>
                <div class="qa-actions">
                  <button id="gi-go" class="btn small" type="button" data-i18n="admin.add">Add</button>
                  <CloseButton id="gi-close" />
                </div>
                <!-- Matches from the library: across the row, from the field to the right edge -->
                <ul id="gi-hits" class="qa-hits menu static" hidden></ul>
              </div>
            </div>
          </div>
        </div>
        <ul id="guest-list" class="tw-list guest-list"></ul>
        <!-- Edit one guest of the tasting: side panel -->
        <dialog id="p-panel" class="sheet" aria-labelledby="p-panel-title">
          <div class="sheet-head">
            <h2 id="p-panel-title"></h2>
            <CloseButton data-close />
          </div>
          <div id="p-panel-body"></div>
        </dialog>
        <p id="guest-empty" class="hint" hidden data-i18n="admin.noMatch">No guests match.</p>
      </section>

      <!-- Orders -->
      <section class="block" data-section="orders">
        <h2 data-i18n="admin.orders">Orders</h2>
        <!-- Ordering: the switch and, when a wine has a quantity price, who counts towards it -->
        <Switch title="wizard.ordersTitle" hint="wizard.ordersHint" help="orders-open" data-key="orders_open" class="tab-switch" />
        <!-- Quantity prices: only when a wine in the tasting has one – who counts towards it (the host decides) -->
        <div id="bulk-mode" class="bulk-choice" hidden>
          <!-- The same choice cards as everywhere else (radio, name, what it means); the script fills the question and examples -->
          <ChoiceCards name="bulk-mode" legendId="bulk-q" options={[
            { value: 'guest', label: 'bulk.segGuest', hintId: 'bulk-ex-guest' },
            { value: 'pooled', label: 'bulk.segPooled', hintId: 'bulk-ex-pooled' }]} />
          <p id="bulk-example" class="bulk-example"></p>
          <p id="bulk-msg" class="hint" aria-live="polite"></p>
        </div>
        <div id="orders-by-guest"></div>
        <div id="orders-total">
        <h3 data-i18n="admin.totalPurchase">Total purchase</h3>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th data-i18n="page.wine">Wine</th><th class="num" data-i18n="admin.bottles">Bottles</th><th class="num" data-i18n="pay.amount">Amount</th></tr></thead>
            <tbody id="orders-by-wine"></tbody>
          </table>
        </div>
        <button id="csv" class="btn small secondary" type="button" data-i18n="admin.csv">Download orders as CSV</button>
        </div>
      </section>

      <!-- Event chat -->
      <section class="block" data-section="chat">
        <h2 data-i18n="page.chat">Chat</h2>
        <p class="hint" data-i18n="chat.hostIntro">The guests' chat for this tasting. You write as the host and can remove messages.</p>
        <ChatBox prefix="h" />
      </section>

      <!-- Quiz -->
      <section class="block quiz-admin" data-section="quiz">
        <div class="guests-head">
          <h2 data-i18n="page.quiz">Quiz</h2>
          <button id="q-add-toggle" class="btn small secondary" type="button" data-i18n="aq.add">Add question</button>
        </div>
        <div class="tab-switches">
          <Switch title="set.quizOpen" hint="set.quizOpenHint" help="quiz" data-key="quiz_open" class="tab-switch" />
          <Switch title="set.quizDone" hint="set.quizDoneHint" data-key="quiz_finished" class="tab-switch" />
        </div>
        <p id="q-open-note" class="hint" hidden data-i18n="aq.openNote">The quiz is open – changes reach the guests right away.</p>

        <!-- Suggestions from AI: shown here, added one by one only when the host chooses -->
        <div class="ai-quiz">
          <div class="ai-quiz-bar" data-help="ai-quiz">
            <ChoiceCards name="q-ai-level" legend="aiQuiz.level" srLegend compact class="ai-level" options={[
              { value: 'easy', label: 'aiQuiz.easy' }, { value: 'medium', label: 'aiQuiz.medium', checked: true }, { value: 'expert', label: 'aiQuiz.expert' }]} />
            <button id="q-ai" class="btn small secondary" type="button"><span aria-hidden="true">✦</span> <span data-i18n="aiQuiz.suggest">Suggestions from AI</span></button>
          </div>
          <p id="q-ai-status" class="hint" aria-live="polite" hidden></p>
          <p id="q-ai-warn" class="ai-warn" hidden><span data-i18n="aiQuiz.warn">AI can be wrong – especially on Expert. Always check the marked answer before you press Add.</span></p>
          <ol id="q-ai-list" class="ai-suggestions" hidden></ol>
          <button id="q-ai-more" class="text-btn" type="button" hidden data-i18n="aiQuiz.more">More suggestions</button>
        </div>

        <!-- New / edit question: side panel -->
        <dialog id="q-panel" class="sheet wide" aria-labelledby="qf-title">
        <div class="sheet-head">
          <h2 id="qf-title" data-i18n="aq.newQuestion">New question</h2>
          <CloseButton data-close />
        </div>
        <form id="q-form" class="add-form quiz-form" novalidate>
          <label for="qf-question" data-i18n="aq.question">Question</label>
          <textarea class="input" id="qf-question" rows="2" maxlength="500"></textarea>
          <fieldset class="qf-fieldset">
            <legend data-i18n="aq.answersLegend">Answers – mark the right one</legend>
            <div id="qf-options" class="qf-options"></div>
            <button id="qf-add-option" class="text-btn" type="button"><Icon name="plus" /><span data-i18n="aq.addAnswer">Add answer</span></button>
          </fieldset>
          <label for="qf-explanation"><span data-i18n="aq.explanation">Explanation</span> <span class="opt" data-i18n="aq.explanationHint">(shown when the quiz is finished)</span></label>
          <textarea class="input" id="qf-explanation" rows="2" maxlength="1000"></textarea>
          <p id="qf-msg" class="message error" hidden></p>
          <div class="row-actions">
            <button id="qf-save" class="btn small" type="submit" data-i18n="common.save">Save</button>
            <button id="qf-cancel" class="text-btn" type="button" data-i18n="common.cancel">Cancel</button>
            <button id="qf-delete" class="text-btn danger" type="button" hidden data-i18n="aq.deleteQuestion">Delete question</button>
          </div>
        </form>
        </dialog>

        <ol id="q-admin-list" class="q-admin-list"></ol>
        <p id="q-empty" class="hint" hidden data-i18n="aq.empty">No questions yet. Add the first one.</p>

        <!-- Standings only once the quiz has questions -->
        <div id="board-block" hidden>
          <h3 data-i18n="quiz.standings">Standings</h3>
          <ol id="board" class="board"></ol>
        </div>
      </section>
      </div>

    </div>
    </AdminNav>
  </section>
</Base>

<script>
  import { setLoading } from '../../lib/ui/button';
  import { bindSwitch, switchRow } from '../../lib/ui/switch';
  import { choiceCards } from '../../lib/ui/choice-cards';
  import { filterDropdown, NONE } from '../../lib/filter-dd';
  import { iconSvg } from '../../lib/ui/icons';
  import { initHelpTips, followHelpLink } from '../../lib/help-tip';
  initHelpTips();
  import { supabase } from '../../lib/supabase';
  import { currentSlug, tastingUrl } from '../../lib/guest';
  import { initHosts } from '../../lib/admin-hosts';
  import { fetchLeaderboard, renderLeaderboard } from '../../lib/leaderboard';
  import { initTastingWines } from '../../lib/admin-tasting-wines';
  let tastingWines: ReturnType<typeof initTastingWines> | null = null;
  import { requireHost, mk as mkEl, sheetPanel, toNumber, iconButton, type Host } from '../../lib/admin-common';
  import { personRow, initials, type PersonChip } from '../../lib/ui/person-row';
  import { menuGroup, menuHit } from '../../lib/ui/menu';
  import { STATUS as STATUSES, guestStatus } from '../../lib/ui/status';
  import { initQuizAdmin } from '../../lib/admin-quiz';
  import { initAddress, readAddress, writeAddress } from '../../lib/address';
  import { SECTIONS, adminUrl, currentAdmin, markSection } from '../../lib/admin-side';
  import { initWhen, readWhen, readEnd, writeWhen, checkWhen } from '../../lib/datetime';
  import { fieldError, focusField } from '../../lib/field-error';
  import { toast } from '../../lib/toast';
  import { confirmModal } from '../../lib/confirm';
  import { SUPABASE_URL, SUPABASE_KEY } from '../../lib/config';
  import { amountText } from '../../lib/wine-validate';
  import { initChat, type ChatMessage } from '../../lib/chat';
  import { i18nReady, t, lang, locale, money, formatWhen, type Key } from '../../i18n';

  await i18nReady;

  const $ = (id: string) => document.getElementById(id)!;
  const kr = { format: money };
  const STATUS: Record<string, string> = { yes: t('admin.fYes'), waitlist: t('status.waitlist'), no: t('status.no'), invited: t('status.invited') };

  type P = { id: string; name: string; email: string | null; status: string; diet: string | null; note: string | null; invite_code: string; tasting_paid: boolean; waitlisted_at?: string | null; invite_mailed_at?: string | null };
  type W = { id: number; name: string; price_dkk: number | null; sort_order: number; tiers: { qty: number; price: number }[] };
  type OLine = { wine_id: number; quantity: number; unit_price: number };
  type O = { id: number; participant_id: string; paid: boolean; created_at: string; order_lines: OLine[] };
  const ORDER_SELECT = 'id, participant_id, paid, created_at, order_lines(wine_id, quantity, unit_price)';
  const when = new Intl.DateTimeFormat(locale(), { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

  let participants: P[] = [];
  let wines: W[] = [];
  let orders: O[] = [];

  function cell(text: string, cls?: string) {
    const td = document.createElement('td');
    td.textContent = text;
    if (cls) td.className = cls;
    return td;
  }

  // ---------- Controls (stored on the tasting) ----------
  type T = { id: string; slug: string; title: string; quiz_count?: number } & Record<string, unknown>;
  let tasting: T | null = null;
  let quizTotal = 13;
  let feeTotal = 0;
  let feeAmount = 0;


  // The tasting comes from the address /t/<slug>/admin/
  async function loadTasting(host: Host) {
    const slug = currentSlug();
    if (!slug) return;
    // Row-level security returns the tasting to its owner and its co-hosts
    const { data } = await supabase.from('tastings').select('*').eq('slug', slug).maybeSingle();
    tasting = (data ?? null) as T | null;
    if (!tasting) return;
    // Hosts are managed by whoever created the tasting and by the account's owner – who can also delete it
    const manages = tasting.host_id === host.id || (host.tenant_owner && tasting.tenant_id === host.tenant_id);
    initHosts(tasting.id, slug, manages);
    $('delete-tasting').hidden = !manages;
    document.title = `${tasting.title} – Winetastr`;
    $('ta-title').textContent = tasting.title;
    ($('t-guestpage') as HTMLAnchorElement).href = tastingUrl(slug);
    document.querySelectorAll<HTMLAnchorElement>('#admin-tabs a[data-apath]').forEach((a) => { a.href = `/t/${slug}/admin/${a.dataset.apath}`; });

    renderDetails();
    loadOverviewHosts(slug, tasting.host_id === host.id || (host.tenant_owner && tasting.tenant_id === host.tenant_id));

    const tv = $('tv-link') as HTMLAnchorElement;
    tv.href = `/t/${tasting.slug}/leaderboard/`;
    tv.textContent = `${location.host}/t/${tasting.slug}/leaderboard/`;
    const pub = $('tasting-link') as HTMLAnchorElement;
    pub.href = `/t/${tasting.slug}/`;
    pub.textContent = `${location.host}/t/${tasting.slug}/`;
  }

  // ---------- Details: shown read-only, edited in the side panel ----------
  function fillDetailsForm() {
    if (!tasting) return;
    ($('d-title') as HTMLInputElement).value = tasting.title;
    writeWhen('d', tasting.starts_at as string | null, tasting.ends_at as string | null);
    writeAddress('d', tasting as Record<string, string | null>);
    ($('d-intro') as HTMLTextAreaElement).value = (tasting.intro as string) ?? '';
    resetAiIntro();
  }

  // ---------- Introduction drafted by AI ----------
  // The draft is shown under the host's text; "Use" puts it in the field (with Undo); nothing is saved before Save.
  let aiDraft = '';
  let beforeAi: string | null = null;
  function resetAiIntro() {
    aiDraft = '';
    beforeAi = null;
    $('ai-draft').hidden = true;
    $('ai-undo').hidden = true;
    $('ai-status').hidden = true;
  }
  async function writeAiIntro() {
    if (!tasting) return;
    const status = $('ai-status');
    status.textContent = t('aiIntro.writing');
    status.classList.add('ai-busy');
    status.hidden = false;
    ($('ai-write') as HTMLButtonElement).disabled = true;
    ($('ai-again') as HTMLButtonElement).disabled = true;
    try {
      const { data: s } = await supabase.auth.getSession();
      const res = await fetch('/api/describe-tasting', {
        method: 'POST',
        headers: { 'content-type': 'application/json', authorization: `Bearer ${s.session?.access_token ?? ''}` },
        body: JSON.stringify({ tasting_id: tasting.id, lang: (tasting.language as string | null) ?? lang() }),
      });
      const out = (await res.json().catch(() => ({}))) as { text?: string; error?: string };
      if (!res.ok || !out.text) {
        status.textContent = t(out.error === 'no_wines' ? 'aiIntro.noWines' : 'aiIntro.failed');
        return;
      }
      aiDraft = out.text.trim();
      $('ai-text').replaceChildren(...aiDraft.split(/\n\s*\n/).map((para) => Object.assign(document.createElement('p'), { textContent: para.trim() })));
      $('ai-draft').hidden = false;
      status.hidden = true;
    } catch {
      status.textContent = t('aiIntro.failed');
    } finally {
      status.classList.remove('ai-busy');
      ($('ai-write') as HTMLButtonElement).disabled = false;
      ($('ai-again') as HTMLButtonElement).disabled = false;
    }
  }
  $('ai-write').addEventListener('click', writeAiIntro);
  $('ai-again').addEventListener('click', writeAiIntro);
  $('ai-discard').addEventListener('click', () => { $('ai-draft').hidden = true; aiDraft = ''; });
  $('ai-use').addEventListener('click', () => {
    const field = $('d-intro') as HTMLTextAreaElement;
    beforeAi = field.value;
    field.value = aiDraft;
    $('ai-draft').hidden = true;
    $('ai-undo').hidden = false;
    field.focus();
  });
  $('ai-undo').addEventListener('click', () => {
    if (beforeAi === null) return;
    ($('d-intro') as HTMLTextAreaElement).value = beforeAi;
    beforeAi = null;
    $('ai-undo').hidden = true;
  });
  function renderDetails() {
    if (!tasting) return;
    const dash = '—';
    $('v-title').textContent = tasting.title;
    $('v-when').textContent = tasting.starts_at ? formatWhen(tasting.starts_at as string, { year: true, end: tasting.ends_at as string | null }) : dash;
    $('v-place').textContent = (tasting.place as string) || dash;
    $('v-intro').textContent = (tasting.intro as string) || dash;
  }
  const detailsPanel = sheetPanel($('details-panel') as HTMLDialogElement);
  $('details-edit').addEventListener('click', () => {
    fillDetailsForm();
    detailsPanel.open();
  });
  $('d-cancel').addEventListener('click', () => detailsPanel.close());

  // ---------- Hosts on the overview ----------
  async function loadOverviewHosts(slug: string, canManage: boolean) {
    if (!tasting) return;
    const { data } = await supabase.rpc('tasting_cohosts', { t_id: tasting.id });
    type H = { email: string; name: string | null; owner: boolean; pending: boolean; me: boolean };
    // The same rows as the guests (read-only here; hosts are managed under Settings)
    $('ov-hosts').replaceChildren(...((data ?? []) as H[]).map((h) => personRow({
      name: h.name || h.email, you: h.me ? t('hosts.you') : null, meta: h.name ? [h.email] : [],
      chips: [h.owner ? { text: t('hosts.owner'), tone: 'strong' } : h.pending ? { text: t('hosts.pending'), tone: 'wait' } : { text: t('hosts.cohost') }],
    })));
    const manage = $('ov-hosts-manage') as HTMLAnchorElement;
    manage.href = `/t/${slug}/admin/settings/`;
    manage.hidden = !canManage;
  }

  initAddress('d');
  initWhen('d');
  $('details').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!tasting) return;
    const title = ($('d-title') as HTMLInputElement).value.trim();
    if (!title) { fieldError($('d-title'), t('admin.titleEmpty')); focusField($('d-title')); return; }
    if (!checkWhen('d', false)) { const bad = document.querySelector<HTMLElement>('#details [aria-invalid]'); if (bad) focusField(bad); return; }
    const patch = {
      title,
      starts_at: readWhen('d'),
      ends_at: readEnd('d'),
      intro: ($('d-intro') as HTMLTextAreaElement).value.trim() || null,
      ...readAddress('d'),
    };
    const { error } = await supabase.from('tastings').update(patch).eq('id', tasting.id);
    // A toast says how it went (the panel closes when it is saved)
    if (error) toast(t('admin.changesNotSaved'), { kind: 'error' });
    else {
      // Read it back: the database composes the place line from the address
      const { data: fresh } = await supabase.from('tastings').select('*').eq('id', tasting.id).maybeSingle();
      Object.assign(tasting, fresh ?? patch);
      $('ta-title').textContent = title;
      renderDetails();
      detailsPanel.close();
      toast(t('common.saved'), { kind: 'ok' });
    }
  });

  /** The guest list again (someone may have moved up from the waiting list). */
  async function reloadParticipants() {
    if (!tasting) return;
    const { data } = await supabase.from('participants').select('id, name, email, status, diet, note, invite_code, tasting_paid, guest_id, waitlisted_at, invite_mailed_at').eq('tasting_id', tasting.id);
    if (data) participants = data as P[];
    renderParticipants();
    renderFee();
  }

  // ---------- Settings: side panels for max guests and the fee ----------
  const mgPanel = sheetPanel($('mg-panel') as HTMLDialogElement);
  const feePanel = sheetPanel($('fee-panel') as HTMLDialogElement);
  document.querySelectorAll<HTMLButtonElement>('#mg-panel [data-close], #fee-panel [data-close]').forEach((b) =>
    b.addEventListener('click', () => (b.closest('dialog') as HTMLDialogElement).close()));
  function renderMaxGuests() {
    if (!tasting) return;
    const max = tasting.max_guests as number | null;
    $('max-guests-view').textContent = max ? t('set.maxView', { n: max }) : t('set.noLimit');
  }
  $('max-guests-edit').addEventListener('click', () => {
    if (!tasting) return;
    const el = $('max-guests') as HTMLInputElement;
    el.value = tasting.max_guests ? String(tasting.max_guests) : '';
    fieldError(el, null);
    mgPanel.open();
  });
  // A higher limit moves guests up from the waiting list (in the database)
  $('mg-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!tasting) return;
    const el = $('max-guests') as HTMLInputElement;
    const v = el.value.trim();
    if (v && !(/^\d+$/.test(v) && Number(v) >= 1 && Number(v) <= 10000)) { fieldError(el, t('wizard.maxBad')); el.focus(); return; }
    const max = v ? Number(v) : null;
    const { error } = await supabase.from('tastings').update({ max_guests: max }).eq('id', tasting.id);
    if (error) { toast(t('admin.changeNotSaved'), { kind: 'error' }); return; }
    tasting.max_guests = max;
    mgPanel.close();
    renderMaxGuests();
    toast(t('common.saved'), { kind: 'ok' });
    await reloadParticipants();
  });
  $('tv-copy').addEventListener('click', async () => {
    const url = ($('tv-link') as HTMLAnchorElement).href;
    try { await navigator.clipboard.writeText(url); toast(t('hosts.copied'), { kind: 'ok' }); } catch { /* the link is there to select */ }
  });

  function loadSettings() {
    if (!tasting) return;
    renderMaxGuests();
    feeTotal = Number(tasting.tasting_total) || 0;
    feeAmount = Number(tasting.tasting_fee) || 0;
    document.querySelectorAll<HTMLInputElement>('input[data-key]').forEach((box) => {
      box.checked = tasting![box.dataset.key!] === true;
    });
    document.querySelectorAll<HTMLInputElement>('input[name="bulk-mode"]').forEach((r) => (r.checked = r.value === tasting!.bulk_mode));
  }
  // The switches save straight away (the one switch, src/lib/ui/switch.ts: spinner, put back on an error, toast)
  document.querySelectorAll<HTMLInputElement>('input[data-key]').forEach((box) => bindSwitch(box, {
    save: async (on) => {
      if (!tasting) return false;
      const { error } = await supabase.from('tastings').update({ [box.dataset.key!]: on }).eq('id', tasting.id);
      if (error) {
        // Ordering with quantity prices needs the host's choice first
        if (!error.message.includes('bulk_mode_needed')) return false;
        // The choice is right under the switch on this tab: show it, say so, and point to it
        renderBulk();
        $('bulk-mode').hidden = false;
        $('bulk-msg').textContent = t('bulk.chooseFirst');
        $('bulk-mode').classList.add('help-flash');
        $('bulk-mode').scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => $('bulk-mode').classList.remove('help-flash'), 2400);
        return '';
      }
      tasting[box.dataset.key!] = on;
      // The same switch on another tab follows
      document.querySelectorAll<HTMLInputElement>(`input[data-key="${box.dataset.key}"]`).forEach((b) => (b.checked = on));
      $('q-open-note').hidden = !(tasting.quiz_open === true && tasting.quiz_finished !== true);
      // Blind tasting changes every wine in it: show them again
      if (box.dataset.key === 'blind') await tastingWines?.load();
      return true;
    },
  }));

  /** Quantity prices: shown only when a wine has one, with an example that follows the choice. */
  function renderBulk() {
    if (!tasting) return;
    const withTiers = wines.filter((w) => w.tiers?.length);
    $('bulk-mode').hidden = withTiers.length === 0;
    if (!withTiers.length) return;
    $('bulk-q').textContent = t('bulk.question', { n: withTiers.length });
    const n = Math.min(...withTiers.flatMap((w) => w.tiers.map((x) => x.qty)));
    const mode = tasting.bulk_mode as string | null;
    // Each choice says what it means; nothing chosen yet: say that a choice is needed
    $('bulk-ex-guest').textContent = t('bulk.exGuest', { n });
    $('bulk-ex-pooled').textContent = t('bulk.exPooled', { n });
    $('bulk-example').textContent = mode ? '' : t('bulk.exNone');
    $('bulk-example').hidden = !!mode;
    $('bulk-example').classList.toggle('needed', !mode);
  }
  // Quantity prices: guest or pooled (saved right away; prices of unpaid orders follow in the database)
  document.querySelectorAll<HTMLInputElement>('input[name="bulk-mode"]').forEach((r) => {
    r.addEventListener('change', async () => {
      if (!tasting) return;
      const { error } = await supabase.from('tastings').update({ bulk_mode: r.value }).eq('id', tasting.id);
      if (error) {
        // Put the choice back and say so
        document.querySelectorAll<HTMLInputElement>('input[name="bulk-mode"]').forEach((x) => (x.checked = x.value === tasting!.bulk_mode));
        toast(t('admin.changeNotSaved'), { kind: 'error' });
        return;
      }
      $('bulk-msg').textContent = '';
      tasting.bulk_mode = r.value; renderBulk(); toast(t('common.saved'), { kind: 'ok', ms: 2000 });
    });
  });

  // ---------- Tasting fee: shown on the page, edited in the side panel ----------
  function renderFee() {
    const coming = participants.filter((p) => p.status === 'yes');
    const total = toNumber(($('fee-total') as HTMLInputElement).value) ?? 0;
    $('fee-suggest').textContent = total && coming.length
      ? t('admin.feeSuggest', { n: coming.length, price: kr.format(Math.ceil(total / coming.length)) })
      : t('admin.feeComing', { n: coming.length });
    const paid = coming.filter((p) => p.tasting_paid);
    $('fee-view').textContent = feeAmount ? t('set.feeView', { price: kr.format(feeAmount) }) : t('set.noFee');
    $('fee-summary').textContent = feeAmount
      ? [t('admin.feePaidSummary', { paid: paid.length, n: coming.length, got: kr.format(paid.length * feeAmount), all: kr.format(coming.length * feeAmount) }),
         tasting?.tasting_fee_open ? t('set.feeShown') : t('set.feeNotShown')].join(' · ')
      : t('set.feeNone');
  }
  $('fee-total').addEventListener('input', renderFee);
  $('fee-edit').addEventListener('click', () => {
    if (!tasting) return;
    ($('fee-total') as HTMLInputElement).value = feeTotal ? amountText(feeTotal, locale()) : '';
    ($('fee-amount') as HTMLInputElement).value = feeAmount ? amountText(feeAmount, locale()) : '';
    ($('fee-open') as HTMLInputElement).checked = tasting.tasting_fee_open === true;
    for (const id of ['fee-total', 'fee-amount']) fieldError($(id), null);
    renderFee();
    feePanel.open();
  });
  $('fee-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!tasting) return;
    const totalEl = $('fee-total') as HTMLInputElement, amountEl = $('fee-amount') as HTMLInputElement;
    const total = toNumber(totalEl.value), amountTyped = toNumber(amountEl.value);
    let bad = false;
    if (totalEl.value.trim() && (total == null || total < 0)) { fieldError(totalEl, t('wizard.feeBad')); bad = true; }
    if (amountEl.value.trim() && (amountTyped == null || amountTyped < 0)) { fieldError(amountEl, t('wizard.feeBad')); bad = true; }
    if (bad) return;
    // No amount typed: the suggestion (the total shared among those coming, rounded up)
    const coming = participants.filter((p) => p.status === 'yes').length;
    const amount = amountTyped ?? (total && coming ? Math.ceil(total / coming) : 0);
    const open = ($('fee-open') as HTMLInputElement).checked;
    const { error } = await supabase.from('tastings')
      .update({ tasting_total: total ?? 0, tasting_fee: amount, tasting_fee_open: open && amount > 0 }).eq('id', tasting.id);
    if (error) { toast(t('admin.couldNotSave'), { kind: 'error' }); return; }
    feeTotal = total ?? 0;
    feeAmount = amount;
    tasting.tasting_fee = amount;
    tasting.tasting_fee_open = open && amount > 0;
    feePanel.close();
    renderFee();
    renderParticipants();
    toast(t('common.saved'), { kind: 'ok' });
  });

  // ---------- Guests ----------
  const STATUS_ORDER: Record<string, number> = { yes: 0, waitlist: 1, invited: 2, no: 3 };
  // Which guests are shown: the ticked statuses ("All" ticks them all) and, if ticked, only those missing an email
  const ALL_STATUSES = ['yes', 'waitlist', 'invited', 'no'];
  const guestStatuses = new Set<string>(ALL_STATUSES);
  let onlyNoEmail = false;
  let guestQuery = '';
  // Editing a guest of the tasting happens in a side panel
  const guestPanel = sheetPanel($('p-panel') as HTMLDialogElement);
  function openGuestPanel(p: P) {
    $('p-panel-title').textContent = p.name;
    $('p-panel-body').replaceChildren(editPanel(p));
    guestPanel.open();
  }

  function mk<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }

  function matches(p: P) {
    if (guestQuery && !p.name.toLowerCase().includes(guestQuery)) return false;
    return matchesFilter(p);
  }
  function matchesFilter(p: P) {
    if (onlyNoEmail && p.email) return false;
    return guestStatuses.has(p.status);
  }

  async function saveGuest(p: P, patch: Partial<P>) {
    const { error } = await supabase.from('participants').update(patch).eq('id', p.id);
    if (error) {
      toast(error.code === '23505' ? t('guest.emailTaken') : t('admin.changeNotSaved'), { kind: 'error', ms: 7000 });
      return false;
    }
    Object.assign(p, patch);
    return true;
  }

  /** "28 Oct" – when the invitation was mailed */
  const mailedWhen = (iso: string) => new Date(iso).toLocaleString(locale(), { day: 'numeric', month: 'short' });
  /** Bottles a guest has ordered in this tasting */
  const bottlesOf = (p: P) => orders.filter((o) => o.participant_id === p.id).reduce((n, o) => n + o.order_lines.reduce((m, l) => m + l.quantity, 0), 0);
  /** The guest's link to their invitation */
  const inviteUrl = (p: P) => `${location.origin}/t/${tasting!.slug}/?k=${p.invite_code}`;
  async function copyInvite(p: P) {
    try { await navigator.clipboard.writeText(inviteUrl(p)); toast(t('admin.linkCopiedFor', { name: p.name }), { kind: 'ok' }); }
    catch { prompt(t('admin.copyLinkPrompt'), inviteUrl(p)); }
  }
  async function sendInvite(p: P, btn: HTMLButtonElement) {
    setLoading(btn, true);
    const ok = await mailInvite(p);
    setLoading(btn, false);
    toast(t(ok ? 'inviteMail.sentTo' : 'guestRow.mailFailed', { name: p.name }), { kind: ok ? 'ok' : 'error' });
    if (ok) renderParticipants();
    return ok;
  }

  // One row per guest, the same as the wines: a "picture" (initials), name, a line with email and invitation,
  // status as small chips, what they ordered on the right – and "Edit". The rest is in the side panel.
  function guestCard(p: P) {
    // On the waiting list: its number in the queue
    const place = p.status === 'waitlist'
      ? participants.filter((x) => x.status === 'waitlist' && (x.waitlisted_at ?? '') <= (p.waitlisted_at ?? '')).length : 0;
    const st = STATUSES[guestStatus(p.status)];
    const chips: PersonChip[] = [{ text: place ? `${STATUS[p.status]} ${place}` : STATUS[p.status] ?? p.status, tone: st.tone, dashed: (st as { dashed?: boolean }).dashed }];
    if (p.status === 'yes' && feeAmount > 0) chips.push(p.tasting_paid ? { text: t('guestRow.paid'), tone: 'ok' } : { text: t('guestRow.unpaid'), tone: 'err' });
    if (p.diet) chips.push({ text: p.diet });
    if (p.note) chips.push({ text: t('guestRow.note'), title: p.note });
    const n = bottlesOf(p);
    const actions: HTMLElement[] = [];
    // Never invited: its one action in the row (as "Reveal" by a blind wine) – the rest is in the panel
    if (!p.invite_mailed_at && p.status === 'invited') {
      const b = iconButton(p.email ? 'mail' : 'link', t(p.email ? 'inviteMail.send' : 'admin.copyLink'), { strong: true });
      b.addEventListener('click', () => (p.email ? sendInvite(p, b) : copyInvite(p)));
      actions.push(b);
    }
    const edit = iconButton('edit', `${t('admin.edit')}: ${p.name}`);
    edit.dataset.tip = t('admin.edit');
    edit.addEventListener('click', () => openGuestPanel(p));
    // Remove from the tasting: a quiet trash icon, asked about first, with Undo
    const del = iconButton('trash', `${t('adminTasting.removeGuest')}: ${p.name}`, { quiet: true });
    del.dataset.tip = t('adminTasting.removeGuest');
    del.addEventListener('click', () => removeGuest(p));
    actions.push(edit, del);
    const li = personRow({
      name: p.name, onOpen: () => openGuestPanel(p),
      meta: [p.email ?? mk('span', 'guest-missing', t('admin.noEmail')),
        p.invite_mailed_at ? t('guestRow.mailed', { when: mailedWhen(p.invite_mailed_at) }) : t('guestRow.notMailed')],
      chips, side: n ? mk('b', '', t('guestRow.bottles', { n })) : null, actions,
    });
    li.dataset.guest = p.id;
    return li;
  }

  // Removing a guest from the tasting (the guest stays in the guest list): asked about first, then gone from the
  // list with "Undo" for a while – removed in the database when the message goes (or the page is left)
  const pendingRemove = new Map<string, { p: P; token: string }>();
  async function removeGuest(p: P): Promise<boolean> {
    if (orders.some((o) => o.participant_id === p.id)) { toast(t('adminTasting.guestHasOrders'), { kind: 'error', ms: 7000 }); return false; }
    if (!(await confirmModal(t('guestRow.removeQ', { name: p.name }), t('adminTasting.removeGuest'), t('guestRow.removeNote')))) return false;
    const { data: sess } = await supabase.auth.getSession();
    pendingRemove.set(p.id, { p, token: sess.session?.access_token ?? '' });
    participants = participants.filter((x) => x.id !== p.id);
    renderParticipants();
    renderFee();
    toast(t('guestRow.removed', { name: p.name }), {
      ms: 8000,
      action: { label: t('wineLib.undo'), run: () => {
        pendingRemove.delete(p.id);
        participants.push(p);
        renderParticipants();
        renderFee();
        toast(t('guestRow.restored', { name: p.name }), { kind: 'ok' });
      } },
      onTimeout: async () => {
        if (!pendingRemove.has(p.id)) return;
        pendingRemove.delete(p.id);
        const { error } = await supabase.from('participants').delete().eq('id', p.id);
        if (error) { participants.push(p); renderParticipants(); renderFee(); toast(t('admin.changeNotSaved'), { kind: 'error', ms: 7000 }); }
      },
    });
    return true;
  }
  addEventListener('pagehide', () => {
    for (const [id, { token }] of pendingRemove) {
      fetch(`${SUPABASE_URL}/rest/v1/participants?id=eq.${id}`, { method: 'DELETE', keepalive: true,
        headers: { apikey: SUPABASE_KEY, authorization: `Bearer ${token || SUPABASE_KEY}` } });
    }
    pendingRemove.clear();
  });

  // The side panel for one guest: the invitation, status, fee paid, email – and removing them from the tasting
  function editPanel(p: P) {
    const form = mk('form', 'edit-panel');
    let status = p.status;

    // The invitation: send (again) and copy the link
    form.append(mk('p', 'flabel', t('guestRow.invitation')));
    form.append(mk('p', 'hint guest-inv-when', p.invite_mailed_at ? t('guestRow.mailedLong', { when: new Date(p.invite_mailed_at).toLocaleString(locale(), { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }) }) : t('guestRow.notMailedLong')));
    const inv = mk('div', 'row-actions guest-inv');
    if (p.email) {
      const send = mk('button', 'btn small secondary', t(p.invite_mailed_at ? 'inviteMail.again' : 'inviteMail.send'));
      send.type = 'button';
      send.addEventListener('click', async () => { if (await sendInvite(p, send)) guestPanel.close(); });
      inv.append(send);
    }
    const copy = mk('button', 'btn small secondary', t('admin.copyLink'));
    copy.type = 'button';
    copy.addEventListener('click', () => copyInvite(p));
    inv.append(copy);
    form.append(inv);

    // Status: the choice cards (radio, name, what it means)
    const cards = choiceCards({
      name: `st-${p.id}`, legend: t('admin.status'), value: status,
      options: ['yes', 'waitlist', 'invited', 'no'].map((v) => ({ value: v, label: STATUS[v], hint: t(`guestStatus.${v}Hint` as Key) })),
      onChange: (v) => { status = v; paid.el.hidden = !(feeAmount > 0 && status === 'yes'); },
    });
    form.append(cards.el);

    // The fee: paid or not (only for guests who come, when there is a fee) – saved with the panel
    const paid = switchRow({ title: t('guestRow.feePaid'), hint: t('guestRow.feePaidHint', { amount: money(feeAmount) }), checked: p.tasting_paid });
    paid.el.classList.add('guest-paid');
    paid.el.hidden = !(feeAmount > 0 && status === 'yes');
    form.append(paid.el);

    const lab = mk('label', '', t('common.email'));
    const id = 'em-' + p.id;
    lab.htmlFor = id;
    const em = mk('input', 'input');
    em.type = 'email';
    em.id = id;
    em.value = p.email ?? '';
    em.autocomplete = 'off';
    form.append(lab, em);

    const row = mk('div', 'row-actions');
    const save = mk('button', 'btn small', t('common.save'));
    save.type = 'submit';
    const cancel = mk('button', 'text-btn', t('common.cancel'));
    cancel.type = 'button';
    cancel.addEventListener('click', () => guestPanel.close());
    row.append(save, cancel);
    form.append(row);

    // Remove from this tasting (the guest stays in the guest list): quiet, and asked about first
    const quiet = mk('div', 'guest-remove');
    const remove = mk('button', 'btn small quiet-danger');
    remove.type = 'button';
    remove.innerHTML = iconSvg('trash');
    remove.append(t('adminTasting.removeGuest'));
    remove.addEventListener('click', async () => { if (await removeGuest(p)) guestPanel.close(); });
    quiet.append(remove);
    form.append(quiet);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = em.value.trim().toLowerCase() || null;
      if (email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { fieldError(em, t('guest.emailBad')); em.focus(); return; }
      save.disabled = true;
      const patch: Partial<P> = { status, email };
      if (feeAmount > 0 && status === 'yes') patch.tasting_paid = paid.input.checked;
      const ok = await saveGuest(p, patch);
      save.disabled = false;
      if (!ok) return;
      guestPanel.close();
      await reloadParticipants();
      renderFee();
      toast(t('guestRow.saved', { name: p.name }), { kind: 'ok' });
      const li = document.querySelector<HTMLElement>(`[data-guest="${p.id}"]`);
      if (li) { li.classList.add('just-saved'); setTimeout(() => li.classList.remove('just-saved'), 2600); }
    });
    return form;
  }

  function renderParticipants() {
    const list = $('guest-list');
    list.replaceChildren();
    const sorted = [...participants]
      .sort((a, b) => (STATUS_ORDER[a.status] - STATUS_ORDER[b.status])
        || (a.status === 'waitlist' ? (a.waitlisted_at ?? '').localeCompare(b.waitlisted_at ?? '') : 0)
        || a.name.localeCompare(b.name, 'da'))
      .filter(matches);
    for (const p of sorted) list.append(guestCard(p));
    $('guest-empty').hidden = sorted.length > 0;
    // No guests at all is not "none match": say how to start
    $('guest-empty').textContent = t(participants.length ? 'admin.noMatch' : 'admin.noGuestsYet');
    renderSetup();
    renderSummary();
  }

  function renderSummary() {
    const count: Record<string, number> = {
      all: participants.length,
      yes: participants.filter((p) => p.status === 'yes').length,
      invited: participants.filter((p) => p.status === 'invited').length,
      waitlist: participants.filter((p) => p.status === 'waitlist').length,
      no: participants.filter((p) => p.status === 'no').length,
      noemail: participants.filter((p) => !p.email).length,
    };
    // The one filter menu: the statuses ("All" ticks them all) and "Missing email", which narrows them
    const all = ALL_STATUSES.every((v) => guestStatuses.has(v));
    guestFilter.render(
      [...ALL_STATUSES.map((v) => ({ value: v, label: v === 'yes' ? t('admin.fYes') : STATUS[v], n: count[v] })),
        { value: 'noemail', label: t('admin.fNoEmail'), n: count.noemail, extra: true }],
      all ? new Set() : guestStatuses.size ? new Set(guestStatuses) : new Set([NONE]), count.all,
      { extras: onlyNoEmail ? new Set(['noemail']) : new Set(), shown: participants.filter(matchesFilter).length });
    renderFee();
  }

  const guestFilter = filterDropdown({ name: t('admin.guests'), allLabel: t('admin.fAll'), onChange: (chosen, extras) => {
    guestStatuses.clear();
    if (!chosen.size) ALL_STATUSES.forEach((v) => guestStatuses.add(v));
    else chosen.forEach((v) => { if (v !== NONE) guestStatuses.add(v); });
    onlyNoEmail = extras.has('noemail');
    renderParticipants();
  } });
  guestFilter.el.id = 'g-filter-dd';
  $('g-filter-slot').replaceWith(guestFilter.el);

  $('guest-search').addEventListener('input', (e) => {
    guestQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    renderParticipants();
  });

  // ---------- Invitation by email ----------
  /** Emails the guest their invitation; true when it was sent */
  async function mailInvite(p: P): Promise<boolean> {
    try {
      const { data: s } = await supabase.auth.getSession();
      const res = await fetch('/api/invite-guest', {
        method: 'POST',
        headers: { 'content-type': 'application/json', authorization: `Bearer ${s.session?.access_token ?? ''}` },
        body: JSON.stringify({ participant_id: p.id, lang: lang() }),
      });
      const out = (await res.json().catch(() => ({}))) as { sent?: boolean; at?: string };
      if (res.ok && out.sent) { p.invite_mailed_at = out.at ?? new Date().toISOString(); return true; }
    } catch { /* below */ }
    return false;
  }
  // ---------- Orders ----------
  const orderTotal = (o: O) => o.order_lines.reduce((t, l) => t + l.quantity * Number(l.unit_price), 0);

  /** "3 orders, 1 not paid (367,50 kr.)" – again when one is marked paid */
  function ordersSummary() {
    const p = document.getElementById('orders-summary');
    if (!p) return;
    const unpaid = orders.filter((o) => !o.paid);
    p.textContent = t('admin.ordersSummary', { n: orders.length, unpaid: unpaid.length, amount: kr.format(unpaid.reduce((sum, o) => sum + orderTotal(o), 0)) });
  }

  function renderOrders() {
    const byGuest = $('orders-by-guest');
    byGuest.replaceChildren();
    const wineById = new Map(wines.map((w) => [w.id, w]));
    const pById = new Map(participants.map((p) => [p.id, p]));

    // No orders: no empty table or CSV button
    $('orders-total').hidden = orders.length === 0;
    if (orders.length === 0) {
      const p = document.createElement('p');
      p.className = 'hint';
      p.textContent = t('admin.noOrders');
      byGuest.append(p);
    }

    const sorted = [...orders].sort((a, b) => b.created_at.localeCompare(a.created_at));
    if (orders.length) {
      const p = document.createElement('p');
      p.className = 'hint';
      p.id = 'orders-summary';
      byGuest.append(p);
      ordersSummary();
    }

    for (const o of sorted) {
      const box = document.createElement('div');
      box.className = 'card order-card' + (o.paid ? ' paid' : '');
      const head = document.createElement('div');
      head.className = 'order-head';
      const h = document.createElement('strong');
      h.textContent = `${pById.get(o.participant_id)?.name ?? t('admin.unknownGuest')}`;
      const sum = document.createElement('span');
      sum.textContent = kr.format(orderTotal(o));
      head.append(h, sum);
      const sub = document.createElement('p');
      sub.className = 'hint order-sub';
      sub.textContent = `${t('pay.orderComment', { id: o.id })}, ${when.format(new Date(o.created_at))}`;
      box.append(head, sub);

      const ul = document.createElement('ul');
      for (const l of o.order_lines) {
        const li = document.createElement('li');
        li.textContent = t('admin.orderLine', { qty: l.quantity, wine: wineById.get(l.wine_id)?.name ?? t('admin.unknownWine'), price: kr.format(Number(l.unit_price)) });
        ul.append(li);
      }
      box.append(ul);

      // Paid or not: the one switch, saved straight away
      const paid = switchRow({
        title: t('admin.paidMobilepay'), checked: o.paid, plain: true,
        save: async (on) => {
          const { error } = await supabase.from('orders').update({ paid: on }).eq('id', o.id);
          if (error) return t('admin.paymentNotSaved');
          o.paid = on;
          box.classList.toggle('paid', on);
          ordersSummary();
          return true;
        },
      });
      box.append(paid.el);
      byGuest.append(box);
    }

    const tbody = $('orders-by-wine');
    tbody.replaceChildren();
    let bottles = 0, amount = 0;
    for (const w of [...wines].sort((a, b) => a.sort_order - b.sort_order)) {
      let n = 0, sum = 0;
      for (const o of orders) for (const l of o.order_lines) {
        if (l.wine_id === w.id) { n += l.quantity; sum += l.quantity * Number(l.unit_price); }
      }
      if (!n) continue;
      bottles += n;
      amount += sum;
      const tr = document.createElement('tr');
      tr.append(cell(w.name), cell(String(n), 'num'), cell(kr.format(sum), 'num'));
      tbody.append(tr);
    }
    const tr = document.createElement('tr');
    tr.className = 'total';
    tr.append(cell(t('cart.total')), cell(String(bottles), 'num'), cell(kr.format(amount), 'num'));
    tbody.append(tr);
  }

  $('csv').addEventListener('click', () => {
    const wineById = new Map(wines.map((w) => [w.id, w]));
    const pById = new Map(participants.map((p) => [p.id, p]));
    const rows = [(['csv.order', 'csv.time', 'csv.guest', 'csv.wine', 'csv.qty', 'csv.unit', 'csv.amount', 'csv.paid'] as Key[]).map((k) => t(k))];
    for (const o of [...orders].sort((a, b) => a.id - b.id)) {
      for (const l of o.order_lines) {
        const price = Number(l.unit_price);
        rows.push([
          String(o.id), new Date(o.created_at).toLocaleString(locale()),
          pById.get(o.participant_id)?.name ?? '', wineById.get(l.wine_id)?.name ?? '',
          String(l.quantity), String(price).replace('.', ','),
          String(price * l.quantity).replace('.', ','), o.paid ? t('common.yes') : t('common.no'),
        ]);
      }
    }
    const csv = rows.map((r) => r.map((v) => `"${v.replace(/"/g, '""')}"`).join(';')).join('\r\n');
    const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'portvin-bestillinger.csv';
    a.click();
  });

  // ---------- Startup ----------
  // ---------- Invite from the guest library ----------
  type G = { id: string; name: string; email: string | null };
  let library: G[] = [];

  // ---------- Invite a guest: a new row that slides in at the top of the guest list ----------
  // Name (it searches your guest list) and email (optional); Enter or "Invite" invites.
  const giBar = $('gi-bar');
  const giInput = $('gi-input') as HTMLInputElement;
  const giEmail = $('gi-email') as HTMLInputElement;
  const giHits = $('gi-hits');
  const giToggle = $('g-invite-toggle') as HTMLButtonElement;
  const giOpen = () => giBar.classList.contains('open');
  const normName = (x: string) => x.trim().toLowerCase().replace(/\s+/g, ' ');
  const typedGuest = () => ({ name: giInput.value.replace(/\s+/g, ' ').trim(), email: giEmail.value.trim().toLowerCase() || null });
  const invitedIds = () => new Set(participants.map((p) => (p as P & { guest_id?: string }).guest_id));

  function openInvite(focus = true) {
    if (!wines.length) return;
    giBar.classList.add('open');
    giBar.inert = false;
    giToggle.disabled = true;
    giToggle.setAttribute('aria-expanded', 'true');
    if (focus && matchMedia('(min-width: 48rem)').matches) giInput.focus({ preventScroll: true });
    if (focus) giBar.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }
  function closeInvite() {
    giBar.classList.remove('open');
    giBar.inert = true;
    giToggle.setAttribute('aria-expanded', 'false');
    gateInvite();
    giInput.value = '';
    giEmail.value = '';
    fieldError(giInput, null);
    fieldError(giEmail, null);
    renderGuestHits();
    giToggle.focus();
  }
  giToggle.setAttribute('aria-controls', 'gi-bar');
  giToggle.setAttribute('aria-expanded', 'false');
  giToggle.addEventListener('click', () => openInvite());
  $('gi-close').addEventListener('click', closeInvite);

  /** Your guest list's matches for what is typed (name or email) */
  function guestMatches() {
    const { name, email } = typedGuest();
    const q = normName(name);
    const e = email && email.length >= 3 ? email : null;
    if (!e && q.length < 2) return [];
    return library.filter((g) => (e && g.email?.toLowerCase().includes(e)) || (q.length >= 2 && normName(`${g.name} ${g.email ?? ''}`).includes(q)))
      .sort((a, b) => a.name.localeCompare(b.name, locale())).slice(0, 5);
  }
  function renderGuestHits(list?: G[], head?: string) {
    const found = list ?? guestMatches();
    giHits.replaceChildren();
    giHits.hidden = !found.length;
    if (!found.length) return;
    // The one menu's look: a heading, then a row per guest with the same button as the row's ("Add" / "Add and invite")
    giHits.append(menuGroup(head ?? t('guestInvite.fromList'), 'li'));
    const invited = invitedIds();
    for (const g of found) {
      const b = mkEl('button', 'btn small secondary');
      b.type = 'button';
      // Disabled ("✓ Added") when the guest is already in the tasting
      if (invited.has(g.id)) { b.disabled = true; b.innerHTML = iconSvg('check'); b.append(t('guestInvite.already')); }
      else { b.textContent = addLabel(!!g.email); b.addEventListener('click', () => inviteGuest(g, b)); }
      giHits.append(menuHit(mkEl('span', 'guest-av small', initials(g.name)), g.name, g.email ?? t('admin.noEmail'), b));
    }
  }
  for (const el of [giInput, giEmail]) {
    el.addEventListener('input', () => renderGuestHits());
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); submitInvite(); }
      else if (e.key === 'Escape') { e.preventDefault(); if (giInput.value || giEmail.value) { giInput.value = ''; giEmail.value = ''; renderGuestHits(); giInput.focus(); } else closeInvite(); }
      else if (e.key === 'ArrowDown') { const b = giHits.querySelector<HTMLElement>('button'); if (b) { e.preventDefault(); b.focus(); } }
    });
  }
  $('gi-go').addEventListener('click', () => submitInvite());
  // The button says what happens: "Add and invite" when the invitation is mailed (the box is ticked and there is an
  // email), else "Add"
  const mailOn = () => ($('g-send-mail') as HTMLInputElement).checked;
  const addLabel = (hasEmail: boolean) => t(mailOn() && hasEmail ? 'guestInvite.addInvite' : 'admin.add');
  function syncInviteLabels() {
    $('gi-go').textContent = addLabel(!!giEmail.value.trim());
    renderGuestHits();
  }
  $('g-send-mail').addEventListener('change', syncInviteLabels);
  giEmail.addEventListener('input', () => { $('gi-go').textContent = addLabel(!!giEmail.value.trim()); });

  async function submitInvite() {
    const { name, email } = typedGuest();
    if (email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { fieldError(giEmail, t('guest.emailBad'), $('gi-fields')); giEmail.focus(); return; }
    // Already in your guest list (same email, or exactly the same name): invite that guest – never a second copy
    const same = library.filter((g) => (email && g.email?.toLowerCase() === email) || (!email && normName(g.name) === normName(name)));
    if (same.length) {
      const free = same.filter((g) => !invitedIds().has(g.id));
      if (free.length === 1 && same.length === 1) { await inviteGuest(free[0], $('gi-go') as HTMLButtonElement); return; }
      renderGuestHits(same, t(free.length ? 'guestInvite.pick' : 'guestInvite.alreadyAll'));
      return;
    }
    if (!name) { fieldError(giInput, t('guestInvite.nameMissing'), $('gi-fields')); giInput.focus(); return; }
    const btn = $('gi-go') as HTMLButtonElement;
    setLoading(btn, true);
    try {
      // A new guest goes into the guest list too
      const { data: g, error: ge } = await supabase.from('guests').insert({ host_id: host!.id, name, email }).select('id, name, email').single();
      if (ge || !g) { toast(t('admin.guestNotAdded'), { kind: 'error' }); return; }
      library.push(g as G);
      await inviteGuest(g as G);
    } finally { setLoading(btn, false); }
  }

  /** Puts a guest from the guest list into the tasting – and mails the invitation when chosen */
  async function inviteGuest(g: G, btn?: HTMLButtonElement) {
    if (btn) setLoading(btn, true);
    const { data, error } = await supabase.from('participants')
      .insert({ name: g.name, email: g.email, tasting_id: tasting!.id, guest_id: g.id }).select().single();
    if (btn) setLoading(btn, false);
    if (error || !data) { toast(error?.code === '23505' ? t('guest.emailTaken') : t('admin.guestNotAdded'), { kind: 'error', ms: 7000 }); return; }
    const p = data as P;
    participants.push(p);
    giInput.value = '';
    giEmail.value = '';
    syncInviteLabels();
    // Show the new guest: the filter that hides them is reset
    if (!matches(p)) { ALL_STATUSES.forEach((v) => guestStatuses.add(v)); onlyNoEmail = false; guestQuery = ''; ($('guest-search') as HTMLInputElement).value = ''; }
    renderParticipants();
    const li = document.querySelector<HTMLElement>(`[data-guest="${p.id}"]`);
    if (li) { li.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); li.classList.add('just-saved'); setTimeout(() => li.classList.remove('just-saved'), 2600); }
    if (matchMedia('(min-width: 48rem)').matches) giInput.focus({ preventScroll: true });
    if (p.email && ($('g-send-mail') as HTMLInputElement).checked) {
      toast(t('guestInvite.mailing', { name: p.name }), { ms: 2500 });
      const ok = await mailInvite(p);
      toast(t(ok ? 'guestInvite.mailed' : 'guestInvite.mailFailed', { name: p.name }), { kind: ok ? 'ok' : 'error', ms: ok ? 4000 : 8000 });
      renderParticipants();
    } else {
      toast(t(p.email ? 'guestInvite.added' : 'guestInvite.addedNoMail', { name: p.name }), { kind: 'ok' });
    }
  }

  // No inviting before the tasting has a wine; while the row is open the button waits
  function gateInvite() {
    const none = wines.length === 0;
    giToggle.disabled = none || giOpen();
    $('g-needs-wine').hidden = !none;
    if (none && giOpen()) closeInvite();
  }

  // ---------- Sections: each part of the tasting has its own address /t/<slug>/admin/<section>/ ----------
  function showSection(id: string) {
    document.querySelectorAll<HTMLElement>('#tasting-panel [data-section]').forEach((el) => { el.hidden = el.dataset.section !== id; });
    // The page's sub-menu
    document.querySelectorAll<HTMLAnchorElement>('#admin-tabs a').forEach((a) => {
      const on = a.dataset.section === id;
      a.classList.toggle('current', on);
      if (on) { a.setAttribute('aria-current', 'page'); a.scrollIntoView({ block: 'nearest', inline: 'nearest' }); }
      else a.removeAttribute('aria-current');
    });
    markSection(id);
    if (id === 'chat') startChat();
  }

  // The chat only polls once the host opens it
  let chatStarted = false;
  function startChat() {
    if (chatStarted || !tasting) return;
    chatStarted = true;
    const tId = tasting.id;
    initChat({
      prefix: 'h',
      load: async (after) => {
        const { data, error } = await supabase.rpc('host_chat', { t_id: tId, after_id: after });
        return error ? null : (data as ChatMessage[]);
      },
      send: async (body) => ((await supabase.rpc('host_post_chat', { t_id: tId, body })).error ? 'error' : 'ok'),
      remove: async (msgId) => !(await supabase.from('chat_messages').delete().eq('id', msgId)).error,
    }).start();
  }
  const startSlug = currentSlug() ?? '';
  // Switch section without reloading the page (menu and tabs)
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-section]');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey || !a.pathname.startsWith(`/t/${startSlug}/admin/`)) return;
    e.preventDefault();
    if (a.pathname !== location.pathname) history.pushState(null, '', a.pathname);
    showSection(a.dataset.section!);
    window.scrollTo({ top: 0 });
  });
  window.addEventListener('popstate', () => showSection(currentAdmin()?.section ?? 'overview'));
  showSection(currentAdmin()?.section ?? 'overview');

  // ---------- Set-up status (the same four steps as the guide for a new tasting) ----------
  /** "Get started": what is done is ticked; the card goes when wines and guests are in, or when hidden. */
  const hideKey = () => `wt-start-hidden-${tasting?.id}`;
  function renderSetup() {
    if (!tasting) return;
    const done = { wines: wines.length > 0, guests: participants.length > 0,
      setup: Number(tasting.tasting_fee) > 0 || tasting.orders_open === true };
    let hidden = false;
    try { hidden = localStorage.getItem(hideKey()) === '1'; } catch {}
    $('setup-card').hidden = hidden || (done.wines && done.guests);
    // The next step is the first one not done; it alone gets the red button and a soft background
    const order = ['wines', 'guests', 'setup'] as const;
    const next = order.find((k) => !done[k]) ?? null;
    const n = order.filter((k) => done[k]).length;
    $('start-progress').textContent = t('getStarted.progress', { n, total: order.length });
    $('start-bar').style.width = `${(n / order.length) * 100}%`;
    order.forEach((k, i) => {
      const li = $(`start-${k}`);
      li.classList.toggle('done', done[k]);
      li.classList.toggle('now', k === next);
      li.querySelector('.start-ic')!.textContent = done[k] ? '✓' : String(i + 1);
      $(`start-${k}-btn`).className = k === next ? 'btn small' : 'text-btn';
    });
    $('start-wines-info').textContent = done.wines ? t('tastingsAdmin.wines', { n: wines.length }) : t('getStarted.winesHint');
    $('start-guests-info').textContent = done.guests ? t('getStarted.guestsInfo', { n: participants.length }) : t('getStarted.guestsHint');
    $('start-setup-info').textContent = t(done.setup ? 'getStarted.setupDone' : 'getStarted.setupHint');
    $('start-wines-btn').textContent = t(done.wines ? 'getStarted.addMore' : 'adminTasting.addWineBtn');
    $('start-guests-btn').textContent = t(done.guests ? 'getStarted.inviteMore' : 'getStarted.invite');
  }
  $('start-hide').addEventListener('click', () => {
    try { localStorage.setItem(hideKey(), '1'); } catch {}
    $('setup-card').hidden = true;
  });
  // A step's button: to its tab, and open the panel there
  document.querySelectorAll<HTMLButtonElement>('#setup-card [data-go]').forEach((b) => b.addEventListener('click', () => {
    if (!tasting) return;
    const path = `/t/${tasting.slug}/admin/${b.dataset.go}/`;
    if (location.pathname !== path) history.pushState(null, '', path);
    showSection(b.dataset.go!);
    window.scrollTo({ top: 0 });
    if (b.dataset.open) requestAnimationFrame(() => document.getElementById(b.dataset.open!)?.click());
  }));

  // ---------- Delete the tasting ----------
  $('td-ask').addEventListener('click', () => {
    if (!tasting) return;
    const n = participants.length;
    $('td-q').textContent = t(n ? 'tastingDelete.qGuests' : 'tastingDelete.q', { title: tasting.title, n });
    $('td-msg').hidden = true;
    ($('td-confirm') as HTMLDialogElement).showModal();
    $('td-no').focus();
  });
  $('td-no').addEventListener('click', () => ($('td-confirm') as HTMLDialogElement).close());
  $('td-yes').addEventListener('click', async () => {
    if (!tasting) return;
    const btn = $('td-yes') as HTMLButtonElement;
    btn.disabled = true;
    const { error, count } = await supabase.from('tastings').delete({ count: 'exact' }).eq('id', tasting.id);
    btn.disabled = false;
    if (error || !count) { $('td-msg').textContent = t('tastingDelete.failed'); $('td-msg').hidden = false; return; }
    location.href = `/admin/tastings/?deleted=${encodeURIComponent(tasting.title)}`;
  });

  // ---------- Startup ----------
  let host: Host | null = null;

  async function loadAll() {
    await loadTasting(host!);
    if (!tasting) { $('not-found').hidden = false; return; }
    $('admin-main').hidden = false;
    const [p, o, g, q] = await Promise.all([
      supabase.from('participants').select('id, name, email, status, diet, note, invite_code, tasting_paid, guest_id, waitlisted_at, invite_mailed_at').eq('tasting_id', tasting.id),
      supabase.from('orders').select(ORDER_SELECT).eq('tasting_id', tasting.id),
      supabase.from('guests').select('id, name, email').eq('tenant_id', host!.tenant_id).order('name'),
      supabase.from('quiz_questions').select('id', { count: 'exact', head: true }).eq('tasting_id', tasting.id),
    ]);
    participants = (p.data ?? []) as P[];
    orders = (o.data ?? []) as O[];
    library = (g.data ?? []) as G[];
    quizTotal = q.count || 1;
    tastingWines = initTastingWines(tasting.id, host!.id, host!.tenant_id, (list) => { wines = list; renderOrders(); gateInvite(); renderSetup(); renderBulk(); });
    $('q-open-note').hidden = !(tasting.quiz_open === true && tasting.quiz_finished !== true);
    // The wines and the quiz at the same time, not one after the other
    await Promise.all([
      tastingWines.load(),
      initQuizAdmin(tasting.id, (list) => { quizTotal = list.length || 1; $('board-block').hidden = list.length === 0; },
        () => (tasting?.language as string | null) ?? lang()).load(),
    ]);
    // Settings first: the guest rows show whether the fee is paid
    loadSettings();
    renderParticipants();
    renderOrders();
    renderSetup();
    followHelpLink();
    const rows = await fetchLeaderboard({ slug: tasting.slug });
    if (rows) renderLeaderboard($('board') as HTMLOListElement, rows, quizTotal);
  }

  host = await requireHost();
  if (host) {
    await loadAll();
    if (currentAdmin()?.section === 'chat') startChat();
    setInterval(async () => {
      if (!tasting) return;
      const [o, rows] = await Promise.all([
        supabase.from('orders').select(ORDER_SELECT).eq('tasting_id', tasting!.id),
        fetchLeaderboard({ slug: tasting!.slug }),
      ]);
      if (o.data) { orders = o.data as O[]; renderOrders(); }
      if (rows) renderLeaderboard($('board') as HTMLOListElement, rows, quizTotal);
    }, 15000);
  }
</script>
