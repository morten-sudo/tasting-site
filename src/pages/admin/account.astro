---
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import '../../styles/admin.css';
---
<Base title="page.admin">
  <section class="wrap admin-page">
    <AdminNav active="account">
    <div id="admin-main" hidden>
      <h1 class="title" data-i18n="adminNav.account">Account</h1>
      
      <section class="block pw-box">
        <h2 data-i18n="admin.setPassword">Set or change password</h2>
        <p class="hint" data-i18n="account.pwHint">You can always sign in with a code by email. A password is optional.</p>
        <form id="pw-form" class="login">
          <label for="new-pw" data-i18n="admin.newPassword">New password (at least 8 characters)</label>
          <input id="new-pw" type="password" autocomplete="new-password" minlength="8" required />
          <button class="btn small" type="submit" data-i18n="admin.savePassword">Save password</button>
          <p id="pw-msg" class="message" hidden></p>
        </form>
      </section>
    </div>
    </AdminNav>
  </section>
</Base>

<script>
  import { supabase } from '../../lib/supabase';
  import { requireHost, $ } from '../../lib/admin-common';
  import { t } from '../../i18n';

  // ---------- Password ----------
  $('pw-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = $<HTMLInputElement>('new-pw');
    const msg = $('pw-msg');
    const { error } = await supabase.auth.updateUser({ password: input.value });
    msg.hidden = false;
    msg.className = 'message ' + (error ? 'error' : 'ok');
    msg.textContent = error
      ? (error.message.toLowerCase().includes('weak') || error.message.includes('characters') ? t('admin.pwWeak') : t('admin.pwNotSaved'))
      : t('admin.pwSaved');
    if (!error) input.value = '';
  });


  const host = await requireHost();
  if (host) $('admin-main').hidden = false;
</script>
