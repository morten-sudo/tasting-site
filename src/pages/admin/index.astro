---
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import AddressFields from '../../components/AddressFields.astro';
import '../../styles/admin.css';
---
<Base title="page.admin">
  <section class="wrap admin-page">
    <AdminNav active="tastings" />

    <div id="admin-main" hidden>
      <h1 class="title" data-i18n="adminNav.tastings">Tastings</h1>
      <p id="intro" class="hint" hidden data-i18n="admin.welcomeHost">Welcome as a host. Start by creating your first tasting – you can change everything afterwards.</p>

      <div class="guests-head" style="justify-content:flex-end">
        <button id="new-toggle" class="btn small ghost" type="button" data-i18n="admin.newTasting">New tasting</button>
      </div>

      <form id="new-tasting" class="add-form tasting-form" novalidate hidden>
        <h3 data-i18n="admin.newTasting">New tasting</h3>
        <label for="nt-title" data-i18n="admin.title">Title</label>
        <input id="nt-title" type="text" placeholder="E.g. Port wine evening" data-i18n-attr="placeholder=admin.titlePlaceholder" required />
        <label for="nt-when" data-i18n="admin.when">Date and time</label>
        <input id="nt-when" type="datetime-local" />
        <AddressFields prefix="nt" />
        <label for="nt-language" data-i18n="admin.guestLanguage">Language for guests</label>
        <select id="nt-language"><option value="da">Dansk</option><option value="en">English</option><option value="is">Íslenska</option></select>
        <p id="nt-msg" class="message error" hidden></p>
        <div class="row-actions">
          <button id="nt-save" class="btn small" type="submit" data-i18n="admin.createTasting">Create tasting</button>
          <button id="nt-cancel" class="text-btn" type="button" data-i18n="common.cancel">Cancel</button>
        </div>
      </form>

      <section>
        <h3 id="upcoming-h" data-i18n="tastings.upcoming" hidden>Upcoming</h3>
        <ul id="upcoming" class="tasting-cards"></ul>
        <h3 id="past-h" data-i18n="tastings.past" hidden>Past</h3>
        <ul id="past" class="tasting-cards"></ul>
      </section>

      <!-- Account -->
      <details class="block pw-box">
        <summary data-i18n="admin.setPassword">Set or change password</summary>
        <form id="pw-form" class="login">
          <label for="new-pw" data-i18n="admin.newPassword">New password (at least 8 characters)</label>
          <input id="new-pw" type="password" autocomplete="new-password" minlength="8" required />
          <button class="btn small" type="submit" data-i18n="admin.savePassword">Save password</button>
          <p id="pw-msg" class="message" hidden></p>
        </form>
      </details>
    </div>
  </section>
</Base>

<script>
  import { supabase } from '../../lib/supabase';
  import { requireHost, $, mk } from '../../lib/admin-common';
  import { t, lang, formatWhen } from '../../i18n';
  import { initAddress, readAddress } from '../../lib/address';

  type Row = { id: string; slug: string; title: string; starts_at: string | null; place: string | null;
    participants: { status: string }[]; tasting_wines: { count: number }[] };

  let host: Awaited<ReturnType<typeof requireHost>> = null;

  const adminUrl = (slug: string) => `/t/${slug}/admin/`;

  function card(r: Row) {
    const li = mk('li');
    const a = mk('a', 'tasting-card');
    a.href = adminUrl(r.slug);
    a.append(mk('span', 'card-title', r.title));
    const meta = [r.starts_at ? formatWhen(r.starts_at, { year: true }) : null, r.place].filter(Boolean).join(' · ');
    if (meta) a.append(mk('span', 'card-meta', meta));
    const stats = mk('span', 'card-stats');
    const coming = r.participants.filter((p) => p.status === 'yes').length;
    stats.append(
      mk('span', '', t('tastingsAdmin.guests', { coming, n: r.participants.length })),
      mk('span', '', t('tastingsAdmin.wines', { n: r.tasting_wines[0]?.count ?? 0 })),
    );
    a.append(stats);
    li.append(a);
    return li;
  }

  async function load() {
    const { data } = await supabase.from('tastings')
      .select('id, slug, title, starts_at, place, participants(status), tasting_wines(count)')
      .eq('host_id', host!.id)
      .order('starts_at', { ascending: true, nullsFirst: false });
    const rows = (data ?? []) as Row[];
    const cutoff = Date.now() - 24 * 3600 * 1000;
    const upcoming = rows.filter((r) => !r.starts_at || new Date(r.starts_at).getTime() >= cutoff);
    const past = rows.filter((r) => r.starts_at && new Date(r.starts_at).getTime() < cutoff).reverse();
    $('upcoming').replaceChildren(...upcoming.map(card));
    $('past').replaceChildren(...past.map(card));
    $('upcoming-h').hidden = upcoming.length === 0 || past.length === 0;
    $('past-h').hidden = past.length === 0;
    if (rows.length === 0) { $('intro').hidden = false; openNew(); }
  }

  // ---------- New tasting ----------
  function openNew() {
    const form = $<HTMLFormElement>('new-tasting');
    form.reset();
    $<HTMLSelectElement>('nt-language').value = host?.language && ['da', 'en', 'is'].includes(host.language) ? host.language : lang();
    $('nt-msg').hidden = true;
    form.hidden = false;
    $('new-toggle').hidden = true;
    $<HTMLInputElement>('nt-title').focus();
  }
  initAddress('nt');
  $('new-toggle').addEventListener('click', openNew);
  $('nt-cancel').addEventListener('click', () => { $('new-tasting').hidden = true; $('new-toggle').hidden = false; });

  $('new-tasting').addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('nt-msg');
    const title = $<HTMLInputElement>('nt-title').value.trim();
    if (!title) { msg.textContent = t('admin.titleMissing'); msg.hidden = false; return; }
    const when = $<HTMLInputElement>('nt-when').value;
    const btn = $<HTMLButtonElement>('nt-save');
    btn.disabled = true;
    const { data, error } = await supabase.rpc('create_tasting', {
      title,
      starts_at: when ? new Date(when).toISOString() : null,
      place: null,
      mobilepay: null,
      language: $<HTMLSelectElement>('nt-language').value,
      ...readAddress('nt'),
    });
    btn.disabled = false;
    if (error || !data) { msg.textContent = t('admin.createFailed'); msg.hidden = false; return; }
    location.href = adminUrl((data as { slug: string }).slug);
  });

  // ---------- Password ----------
  $('pw-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = $<HTMLInputElement>('new-pw');
    const msg = $('pw-msg');
    const { error } = await supabase.auth.updateUser({ password: input.value });
    msg.hidden = false;
    msg.className = 'message ' + (error ? 'error' : 'ok');
    msg.textContent = error
      ? (error.message.toLowerCase().includes('weak') || error.message.includes('characters') ? t('admin.pwWeak') : t('admin.pwNotSaved'))
      : t('admin.pwSaved');
    if (!error) input.value = '';
  });

  // ---------- Startup (after everything above is defined) ----------
  host = await requireHost();
  if (host) {
    $('admin-main').hidden = false;
    await load();
  }
</script>
