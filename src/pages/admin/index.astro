---
import Icon from '../../components/ui/Icon.astro';
import Base from '../../layouts/Base.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import AdminNav from '../../components/AdminNav.astro';
import TastingWizard from '../../components/TastingWizard.astro';
import '../../styles/admin.css';
---
<Base title="adminNav.overview">
  <section class="wrap admin-page">
    <AdminNav active="overview">
    <div id="admin-main" hidden>
      <div class="dash-head">
        <h1 class="title" data-i18n="adminNav.overview">Overview</h1>
        <div class="dash-actions">
          <a class="btn small secondary" href="/admin/wines/?new"><Icon name="plus" /><span data-i18n="admin.newWine">New wine</span></a>
          <button id="new-toggle" class="btn small" type="button"><Icon name="plus" /><span data-i18n="admin.newTasting">New tasting</span></button>
        </div>
      </div>
      <!-- No tastings yet: how to start -->
      <EmptyState id="intro" icon="calendar" title="admin.noTastingsTitle" text="admin.welcomeHost" hidden>
        <button id="intro-new" class="btn small" type="button"><Icon name="plus" /><span data-i18n="admin.newTasting">New tasting</span></button>
      </EmptyState>

      <!-- Counts -->
      <div class="dash-stats">
        <a class="card stat" href="/admin/tastings/"><svg class="stat-icon" viewBox="0 0 100 100" aria-hidden="true"><defs><clipPath id="stat-bowl"><path transform="translate(4.3 4.3) rotate(-45 50 50)" d="M37 14 C30 21 27 30 27.5 37 C28.5 50 39 58 50 58 C61 58 71.5 50 72.5 37 C73 30 70 21 63 14 Z" /></clipPath></defs><rect x="0" y="43" width="100" height="100" fill="currentColor" stroke="none" clip-path="url(#stat-bowl)" /><g transform="translate(4.3 4.3) rotate(-45 50 50)" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"><path d="M37 14 C30 21 27 30 27.5 37 C28.5 50 39 58 50 58 C61 58 71.5 50 72.5 37 C73 30 70 21 63 14 Z" /><path d="M50 58 V79 M38 80 H62" /></g></svg><span id="s-tastings" class="stat-n">–</span><span class="stat-label" data-i18n="adminNav.tastings">Tastings</span><span id="s-upcoming" class="stat-sub"></span></a>
        <a class="card stat" href="/admin/guests/"><svg class="stat-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.2" /><path d="M3 19.5c.8-3.3 3.1-5 6-5s5.2 1.7 6 5" /><circle cx="17" cy="9" r="2.5" /><path d="M16.2 14.2c2.4.1 4 1.6 4.8 4.3" /></svg><span id="s-guests" class="stat-n">–</span><span class="stat-label" data-i18n="adminNav.guests">Guests</span><span class="stat-sub" data-i18n="dash.inLibrary">in your library</span></a>
        <a class="card stat" href="/admin/wines/"><svg class="stat-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 2.5h4v4.2c0 .6.3 1.1.7 1.5 1 .9 1.6 2.2 1.6 3.6V20a1.5 1.5 0 0 1-1.5 1.5H9.2A1.5 1.5 0 0 1 7.7 20v-8.2c0-1.4.6-2.7 1.6-3.6.4-.4.7-.9.7-1.5z" /><path d="M7.7 13h8.6v4.5H7.7z" /></svg><span id="s-wines" class="stat-n">–</span><span class="stat-label" data-i18n="adminNav.wines">Wines</span><span class="stat-sub" data-i18n="dash.inLibrary">in your library</span></a>
      </div>

      <div class="dash-grid">
        <!-- Next tasting -->
        <section class="card dash-card">
          <h2 data-i18n="dash.next">Next tasting</h2>
          <div id="next"></div>
        </section>

        <!-- The tastings I host myself (the account may have many more) -->
        <section id="mine-card" class="card dash-card mine-card" hidden>
          <h2 data-i18n="roles.mineTitle">Tastings you host</h2>
          <ul id="mine" class="list flush"></ul>
          <EmptyState id="mine-none" icon="calendar" title="roles.mineNone" hidden />
          <a id="mine-all" class="text-btn fwd" href="/admin/tastings/" hidden></a>
        </section>

        <!-- Needs paying -->
        <section id="unpaid-card" class="card dash-card" hidden>
          <h2 data-i18n="dash.unpaid">Awaiting payment</h2>
          <ul id="unpaid" class="list flush"></ul>
        </section>

        <!-- Latest activity -->
        <section class="card dash-card dash-wide">
          <h2 data-i18n="dash.latest">Latest activity</h2>
          <ul id="activity" class="list flush"></ul>
        </section>
      </div>
      <TastingWizard />
    </div>
    </AdminNav>
  </section>
</Base>

<script>
  import { emptyState } from '../../lib/ui/empty';
  import { listRow } from '../../lib/ui/list-row';
  import { starsRo } from '../../lib/ui/stars';
  import { iconSvg } from '../../lib/ui/icons';
  import { supabase } from '../../lib/supabase';
  import { requireHost, $, mk } from '../../lib/admin-common';
  import { t, money, locale, formatWhen, type Key } from '../../i18n';
  import { initWizard } from '../../lib/tasting-wizard';
  import { tastingRoles } from '../../lib/admin-side';

  type Dash = {
    tastings: number; upcoming: number; guests: number; wines: number;
    next: { slug: string; title: string; starts_at: string | null; place: string | null; invited: number; coming: number; no_reply: number; wines: number } | null;
    latest_signup: { name: string; status: string; at: string; tasting: string; slug: string } | null;
    latest_order: { id: number; name: string; at: string; paid: boolean; tasting: string; slug: string; bottles: number; amount: number } | null;
    latest_rating: { wine: string; rating: number; at: string; tasting: string; slug: string } | null;
    unpaid_orders: { count: number; amount: number };
    unpaid_fees: { count: number; amount: number };
  };

  const adminUrl = (slug: string, section = '') => `/t/${slug}/admin/${section}`;

  /** "2 hours ago", "yesterday" … in the active language */
  function ago(iso: string) {
    const rtf = new Intl.RelativeTimeFormat(locale(), { numeric: 'auto' });
    const s = (new Date(iso).getTime() - Date.now()) / 1000;
    const steps: [Intl.RelativeTimeFormatUnit, number][] = [['minute', 60], ['hour', 3600], ['day', 86400], ['week', 604800], ['month', 2629800]];
    if (Math.abs(s) < 60) return rtf.format(0, 'minute');
    let unit: Intl.RelativeTimeFormatUnit = 'minute';
    let div = 60;
    for (const [u, d] of steps) if (Math.abs(s) >= d) { unit = u; div = d; }
    return rtf.format(Math.round(s / div), unit);
  }

  // One line of the dashboard (the one list row): an icon in a circle, what happened (the link), and what kind and when
  function activity(icon: string, label: Key, text: string | Node[], meta: string, href: string | null) {
    const pic = mk('span', 'av dash-icon', icon);
    pic.setAttribute('aria-hidden', 'true');
    const title = document.createDocumentFragment();
    title.append(...(typeof text === 'string' ? [text] : text));
    return listRow({ pic, title, href: href ?? undefined, meta: [[t(label), meta]] });
  }

  /** Awaiting payment, one line per tasting, each going straight to that tasting's orders or guests. */
  async function showUnpaidByTasting() {
    type O = { tasting_id: string; tastings: { slug: string; title: string } | null; order_lines: { quantity: number; unit_price: number }[] };
    type P = { tasting_id: string; tastings: { slug: string; title: string; tasting_fee: number; tasting_fee_open: boolean } | null };
    const [o, p] = await Promise.all([
      supabase.from('orders').select('tasting_id, tastings(slug, title), order_lines(quantity, unit_price)').eq('paid', false),
      supabase.from('participants').select('tasting_id, tastings(slug, title, tasting_fee, tasting_fee_open)').eq('status', 'yes').eq('tasting_paid', false),
    ]);
    if (o.error || p.error) return; // the totals above stay
    const rows: HTMLElement[] = [];
    const orders = new Map<string, { slug: string; title: string; n: number; amount: number }>();
    for (const x of (o.data ?? []) as unknown as O[]) {
      if (!x.tastings) continue;
      const g = orders.get(x.tasting_id) ?? { ...x.tastings, n: 0, amount: 0 };
      g.n++;
      g.amount += x.order_lines.reduce((s, l) => s + l.quantity * Number(l.unit_price), 0);
      orders.set(x.tasting_id, g);
    }
    for (const g of orders.values()) rows.push(activity('🧾', 'admin.orders', t('dash.unpaidOrders', { n: g.n, amount: money(g.amount) }), g.title, adminUrl(g.slug, 'orders/')));
    const fees = new Map<string, { slug: string; title: string; n: number; amount: number }>();
    for (const x of (p.data ?? []) as unknown as P[]) {
      const tt = x.tastings;
      if (!tt || !tt.tasting_fee_open || !(Number(tt.tasting_fee) > 0)) continue;
      const g = fees.get(x.tasting_id) ?? { slug: tt.slug, title: tt.title, n: 0, amount: 0 };
      g.n++;
      g.amount += Number(tt.tasting_fee);
      fees.set(x.tasting_id, g);
    }
    for (const g of fees.values()) rows.push(activity('🍷', 'guest.feeTitle', t('dash.unpaidFees', { n: g.n, amount: money(g.amount) }), g.title, adminUrl(g.slug, 'guests/')));
    if (rows.length) $('unpaid').replaceChildren(...rows);
  }

  function render(d: Dash) {
    $('s-tastings').textContent = String(d.tastings);
    $('s-upcoming').textContent = t('dash.upcoming', { n: d.upcoming });
    $('s-guests').textContent = String(d.guests);
    $('s-wines').textContent = String(d.wines);
    $('intro').hidden = d.tastings > 0;

    // Next tasting
    const next = $('next');
    if (d.next) {
      const n = d.next;
      const ul = mk('ul', 'list flush');
      ul.append(listRow({
        title: n.title, href: adminUrl(n.slug), cls: 'big',
        meta: [[n.starts_at ? formatWhen(n.starts_at) : null, n.place]],
        chips: [{ text: t('tastingsAdmin.guests', { coming: n.coming, n: n.invited }), tone: 'ok' },
          ...(n.no_reply ? [{ text: t('dash.noReply', { n: n.no_reply }), tone: 'wait' as const }] : []),
          { text: t('tastingsAdmin.wines', { n: n.wines }) }],
      }));
      next.replaceChildren(ul);
    } else {
      next.replaceChildren(emptyState({ icon: 'calendar', title: t('dash.noNext'), action: { label: t('admin.newTasting'), icon: 'plus', secondary: true, onClick: () => $('new-toggle').click() } }));
    }

    // Awaiting payment
    const unpaid = $('unpaid');
    unpaid.replaceChildren();
    if (d.unpaid_orders?.count) unpaid.append(activity('🧾', 'admin.orders', t('dash.unpaidOrders', { n: d.unpaid_orders.count, amount: money(Number(d.unpaid_orders.amount)) }), '', '/admin/tastings/'));
    if (d.unpaid_fees?.count) unpaid.append(activity('🍷', 'guest.feeTitle', t('dash.unpaidFees', { n: d.unpaid_fees.count, amount: money(Number(d.unpaid_fees.amount)) }), '', '/admin/tastings/'));
    $('unpaid-card').hidden = !unpaid.children.length;
    if (unpaid.children.length) showUnpaidByTasting();

    // Latest sign-up, order and rating
    const list = $('activity');
    list.replaceChildren();
    const s = d.latest_signup;
    list.append(s
      ? activity(s.status === 'yes' ? '✓' : '✕', 'dash.latestSignup',
          t(s.status === 'yes' ? 'dash.signedUp' : 'dash.declined', { name: s.name, tasting: s.tasting }), ago(s.at), adminUrl(s.slug, 'guests/'))
      : activity('✓', 'dash.latestSignup', t('dash.none'), '', null));
    const o = d.latest_order;
    list.append(o
      ? activity('🛒', 'dash.latestOrder',
          t('dash.ordered', { name: o.name, n: o.bottles, amount: money(Number(o.amount)) }),
          [o.tasting, o.paid ? t('cart.paid') : t('cart.awaiting'), ago(o.at)].join(' · '), adminUrl(o.slug, 'orders/'))
      : activity('🛒', 'dash.latestOrder', t('dash.none'), '', null));
    const r = d.latest_rating;
    list.append(r
      ? activity('★', 'dash.latestRating', [starsRo(r.rating), ' ' + r.wine], [r.tasting, ago(r.at)].join(' · '), adminUrl(r.slug, 'wines/'))
      : activity('★', 'dash.latestRating', t('dash.none'), '', null));
  }

  // ---------- The tastings I host ----------
  const MINE_SHOWN = 2;
  async function showMine() {
    const roles = await tastingRoles();
    if (!roles.length) return;
    const hosting = new Set(roles.filter((x) => x.hosting).map((x) => x.tasting_id));
    const { data } = await supabase.from('tastings')
      .select('id, slug, title, starts_at, participants(status)')
      .in('id', [...hosting]).order('starts_at', { ascending: true, nullsFirst: false });
    type R = { id: string; slug: string; title: string; starts_at: string | null; participants: { status: string }[] };
    const cutoff = Date.now() - 24 * 3600 * 1000;
    const upcoming = ((data ?? []) as R[]).filter((x) => !x.starts_at || new Date(x.starts_at).getTime() >= cutoff);
    // The nearest few, so the card keeps the height of the next-tasting card beside it
    $('mine').replaceChildren(...upcoming.slice(0, MINE_SHOWN).map((x) => {
      const coming = x.participants.filter((p) => p.status === 'yes').length;
      return listRow({ title: x.title, href: adminUrl(x.slug), cls: 'big',
        meta: [[x.starts_at ? formatWhen(x.starts_at, { year: true }) : null, t('tastingsAdmin.guests', { coming, n: x.participants.length })]] });
    }));
    $('mine-none').hidden = upcoming.length > 0;
    // More of my own than shown → all of mine; otherwise, tastings others host on the account
    const others = roles.length - hosting.size;
    const more = upcoming.length > MINE_SHOWN;
    $('mine-all').hidden = !more && others === 0;
    $('mine-all').innerHTML = '';
    $('mine-all').append(Object.assign(document.createElement('span'), { textContent: more ? t('roles.seeAllLink', { n: roles.length }) : t('roles.othersLink', { n: others }) }));
    $('mine-all').insertAdjacentHTML('beforeend', iconSvg('right'));
    $('mine-card').hidden = false;
  }

  // ---------- Startup ----------
  const host = await requireHost();
  if (host) {
    $('admin-main').hidden = false;
    const wizard = initWizard(host, (slug) => { if (slug) location.href = adminUrl(slug); });
    $('new-toggle').addEventListener('click', () => wizard.openNew());
    $('intro-new').addEventListener('click', () => wizard.openNew());
    document.querySelector('.side-new')?.addEventListener('click', (e) => { e.preventDefault(); wizard.openNew(); });
    showMine();
    const { data } = await supabase.rpc('host_dashboard');
    if (data && typeof data === 'object' && 'tastings' in data) render(data as Dash);
  }
</script>
