---
import Icon from '../../components/ui/Icon.astro';
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import TastingWizard from '../../components/TastingWizard.astro';
import '../../styles/admin.css';
---
<Base title="adminNav.tastings">
  <section class="wrap admin-page">
    <AdminNav active="tastings">

    <div id="admin-main" hidden>
      <h1 class="title" data-i18n="adminNav.tastings">Tastings</h1>
      <p id="intro" class="hint" hidden data-i18n="admin.welcomeHost">Welcome as a host. Start by creating your first tasting – you can change everything afterwards.</p>

      <div class="guests-head">
        <h2 class="sr" data-i18n="adminNav.tastings">Tastings</h2>
        <!-- Mine: the tastings I host myself; All: everything on the account – the one filter menu (made in the script) -->
        <div class="head-actions">
          <div id="t-filter" hidden></div>
        <button id="new-toggle" class="btn small" type="button"><Icon name="plus" /><span data-i18n="admin.newTasting">New tasting</span></button>
        </div>
      </div>


      <section>
        <h3 id="upcoming-h" data-i18n="tastings.upcoming" hidden>Upcoming</h3>
        <ul id="upcoming" class="tasting-cards"></ul>
        <h3 id="past-h" data-i18n="tastings.past" hidden>Past</h3>
        <ul id="past" class="tasting-cards"></ul>
      </section>

    </div>
      <TastingWizard />
    </AdminNav>
  </section>
</Base>

<script>
  import { chip } from '../../lib/ui/status';
  import { filterDropdown } from '../../lib/filter-dd';
  import { supabase } from '../../lib/supabase';
  import { requireHost, $, mk } from '../../lib/admin-common';
  import { t, formatWhen } from '../../i18n';
  import { initWizard } from '../../lib/tasting-wizard';
  import { toast } from '../../lib/toast';
  import { tastingRoles } from '../../lib/admin-side';

  type Row = { id: string; slug: string; title: string; starts_at: string | null; place: string | null;
    participants: { status: string }[]; tasting_wines: { count: number }[] };

  let host: Awaited<ReturnType<typeof requireHost>> = null;
  let hosting = new Set<string>();
  let rows: Row[] = [];
  let filter: 'mine' | 'all' = 'mine';

  const adminUrl = (slug: string) => `/t/${slug}/admin/`;

  function card(r: Row) {
    const li = mk('li');
    const a = mk('a', 'card tasting-card');
    a.href = adminUrl(r.slug);
    // "You host" as a chip beside the title
    const head = mk('span', 'card-head');
    head.append(mk('span', 'card-title', r.title));
    if (hosting.has(r.id)) head.append(chip(t('roles.youHost'), 'strong'));
    a.append(head);
    const meta = [r.starts_at ? formatWhen(r.starts_at, { year: true }) : null, r.place].filter(Boolean).join(' · ');
    if (meta) a.append(mk('span', 'card-meta', meta));
    const stats = mk('span', 'card-stats');
    const coming = r.participants.filter((p) => p.status === 'yes').length;
    stats.append(
      mk('span', '', t('tastingsAdmin.guests', { coming, n: r.participants.length })),
      mk('span', '', t('tastingsAdmin.wines', { n: r.tasting_wines[0]?.count ?? 0 })),
    );
    a.append(stats);
    li.append(a);
    return li;
  }

  async function load() {
    const roles = await tastingRoles();
    hosting = new Set(roles.filter((x) => x.hosting).map((x) => x.tasting_id));
    const { data } = await supabase.from('tastings')
      .select('id, slug, title, starts_at, place, participants(status), tasting_wines(count)')
      .in('id', roles.map((x) => x.tasting_id))
      .order('starts_at', { ascending: true, nullsFirst: false });
    rows = (data ?? []) as Row[];
    // The filter only matters when the account has tastings I do not host
    const mine = rows.filter((r) => hosting.has(r.id)).length;
    $('t-filter').hidden = mine === rows.length;
    filter = mine > 0 ? 'mine' : 'all';
    counts = { mine, all: rows.length };
    render();
  }

  function render() {
    whose.render([{ value: 'mine', label: t('roles.mine'), n: counts.mine }, { value: 'all', label: t('roles.all'), n: counts.all }], new Set([filter]), counts.all);
    const shown = rows.filter((r) => filter === 'all' || hosting.has(r.id));
    const cutoff = Date.now() - 24 * 3600 * 1000;
    const upcoming = shown.filter((r) => !r.starts_at || new Date(r.starts_at).getTime() >= cutoff);
    const past = shown.filter((r) => r.starts_at && new Date(r.starts_at).getTime() < cutoff).reverse();
    $('upcoming').replaceChildren(...upcoming.map(card));
    $('past').replaceChildren(...past.map(card));
    $('upcoming-h').hidden = upcoming.length === 0 || past.length === 0;
    $('past-h').hidden = past.length === 0;
    $('intro').hidden = rows.length > 0;
  }

  // "I host · 3" / "All · 5": the one filter menu, one choice
  let counts = { mine: 0, all: 0 };
  const whose = filterDropdown({ name: t('adminNav.tastings'), single: true, onChange: (v) => { filter = [...v][0] as 'mine' | 'all'; render(); } });
  $('t-filter').append(whose.el);

  // ---------- New tasting: the four-step guide ----------
  let wizard: ReturnType<typeof initWizard> | null = null;
  const openNew = () => wizard?.openNew();
  $('new-toggle').addEventListener('click', openNew);
  // "+ New tasting" in the menu opens the guide right here
  document.querySelector('.side-new')?.addEventListener('click', (e) => { e.preventDefault(); openNew(); });

  // ---------- Startup (after everything above is defined) ----------
  host = await requireHost();
  if (host) {
    $('admin-main').hidden = false;
    wizard = initWizard(host, (slug) => { if (slug) location.href = adminUrl(slug); });
    await load();
    // "+ New tasting" in the menu links here with ?new=1
    if (new URLSearchParams(location.search).has('new')) { openNew(); history.replaceState(null, '', '/admin/tastings/'); }
    // Just deleted on its own page: say so here
    const deleted = new URLSearchParams(location.search).get('deleted');
    if (deleted) { history.replaceState(null, '', '/admin/tastings/'); toast(t('tastingDelete.done', { title: deleted }), { kind: 'ok' }); }
  }
</script>
