---
// /dev/components/ – every shared component (src/components/ui/* and the src/lib/ui/* builders) in its states, built
// with the REAL components and the REAL stylesheet, grouped A–G as in the approved spec. For developers: hosts only
// (signed in like the admin pages), noindex (Base.astro), not linked from any menu. A missing component is added to
// src/components/ui or src/lib/ui first and shown here (CLAUDE.md "Components").
// Hover and focus are shown by forcing them: the page's script copies every :hover / :focus-visible rule of the
// stylesheets to .is-hover / .is-focus, so the forced states are exactly the real ones.
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import Icon from '../../components/ui/Icon.astro';
import CloseButton from '../../components/ui/CloseButton.astro';
import SearchField from '../../components/ui/SearchField.astro';
import Dropdown from '../../components/ui/Dropdown.astro';
import ChoiceCards from '../../components/ui/ChoiceCards.astro';
import Switch from '../../components/ui/Switch.astro';
import Checkbox from '../../components/ui/Checkbox.astro';
import DateTimeFields from '../../components/DateTimeFields.astro';
import AddressFields from '../../components/AddressFields.astro';
import Badge from '../../components/ui/Badge.astro';
import Facts from '../../components/ui/Facts.astro';
import AddRow from '../../components/ui/AddRow.astro';
import Sheet from '../../components/ui/Sheet.astro';
import Notice from '../../components/ui/Notice.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Loading from '../../components/ui/Loading.astro';
import Disclosure from '../../components/ui/Disclosure.astro';
import Progress from '../../components/ui/Progress.astro';
import Steps from '../../components/ui/Steps.astro';
import Tabs from '../../components/ui/Tabs.astro';
import MapBackground from '../../components/ui/MapBackground.astro';
import Hero from '../../components/ui/Hero.astro';
import Actions from '../../components/ui/Actions.astro';
import Sr from '../../components/ui/Sr.astro';
import SideSwitch from '../../components/ui/SideSwitch.astro';
import ChatBox from '../../components/ChatBox.astro';
import CartBar from '../../components/ui/CartBar.astro';
import Ribbon from '../../components/ui/Ribbon.astro';
import '../../styles/admin.css';

const opts = [
  { value: 'red', label: 'Red wine' }, { value: 'white', label: 'White wine' }, { value: 'port', label: 'Port' },
  { value: 'sparkling', label: 'Sparkling' },
];
---
<Base title="page.admin">
  <section class="wrap admin-page">
    <AdminNav>
    <div id="admin-main" class="dv" hidden>
      <PageHeader title="Components" lead="Every shared component in its states – the real components and the real stylesheet. A missing one is added to src/components/ui or src/lib/ui first and shown here." />
      <nav class="dv-toc" aria-label="Groups">
        <a href="#g-a">A. Basics</a><a href="#g-b">B. Choices</a><a href="#g-c">C. Display</a><a href="#g-d">D. Lists and rows</a>
        <a href="#g-e">E. Panels, messages and states</a><a href="#g-f">F. Page structure</a><a href="#g-g">G. Guest parts</a>
      </nav>

      <!-- ======================= A ======================= -->
      <section id="g-a" class="dv-group">
        <SectionTitle text="A. Basics" />

        <section id="c1" class="dv-comp">
          <SectionTitle level="h3" text="1 Button" />
          <p class="help">.btn · button() and setLoading() in src/lib/ui/button.ts</p>
          <div class="dv-states">
            <span class="dv-lab">Primary</span>
            <div class="dv-row"><button class="btn" type="button">Save</button><button class="btn is-hover" type="button">Hover</button><button class="btn is-focus" type="button">Focus</button><button class="btn" type="button" disabled>Disabled</button><span id="b-load"></span><button class="btn" type="button"><Icon name="plus" />With icon</button></div>
            <span class="dv-lab">Secondary</span>
            <div class="dv-row"><button class="btn secondary" type="button">Cancel</button><button class="btn secondary is-hover" type="button">Hover</button><button class="btn secondary is-focus" type="button">Focus</button><button class="btn secondary" type="button" disabled>Disabled</button><span id="b-load2"></span><button class="btn secondary grey" type="button">Grey</button></div>
            <span class="dv-lab">Danger</span>
            <div class="dv-row"><button class="btn danger" type="button">Delete the tasting</button><button class="btn danger is-hover" type="button">Hover</button><button class="btn quiet-danger" type="button"><Icon name="trash" />Delete</button><button class="btn quiet-danger is-hover" type="button"><Icon name="trash" />Hover</button><button class="btn quiet-danger" type="button" disabled>Disabled</button></div>
            <span class="dv-lab">Small</span>
            <div class="dv-row"><button class="btn small" type="button">Save</button><button class="btn small secondary" type="button">Cancel</button><button class="btn small quiet-danger" type="button">Remove</button><span id="b-load3"></span></div>
            <span class="dv-lab">Block (phones)</span>
            <div class="dv-row dv-narrow"><button class="btn block" type="button">Open MobilePay</button></div>
            <span class="dv-lab">On a photo</span>
            <p class="help">.btn.on-photo and .on-photo-2 – shown on the photo under 44 Hero</p>
          </div>
        </section>

        <section id="c2" class="dv-comp">
          <SectionTitle level="h3" text="2 Text button / text link" />
          <p class="help">.text-btn · textButton() in src/lib/ui/text-button.ts · links in running text keep their underline</p>
          <div class="dv-states">
            <span class="dv-lab">States</span>
            <div class="dv-row" id="tb-row"><button class="text-btn" type="button">Change</button><button class="text-btn is-hover" type="button">Hover</button><button class="text-btn is-focus" type="button">Focus</button><button class="text-btn" type="button" disabled>Disabled</button><button class="text-btn danger" type="button">Remove</button><button class="text-btn small" type="button">Small</button><button class="text-btn loading" type="button" disabled><span class="spin"></span>Sending again …</button></div>
            <span class="dv-lab">Built in TS</span>
            <div class="dv-row" id="tb-ts"></div>
            <span class="dv-lab">In running text</span>
            <p class="dv-row">The guest page is at <a href="#c2">winetastr.com/t/portvin-2026/</a> – share it with your guests.</p>
          </div>
        </section>

        <section id="c3" class="dv-comp">
          <SectionTitle level="h3" text="3 Icon button" />
          <p class="help">.icon-act · iconButton(), closeButton(), setIconLoading() in src/lib/ui/icon-button.ts · CloseButton.astro</p>
          <div class="dv-states">
            <span class="dv-lab">Small (rows)</span><div class="dv-row" id="ib-small"></div>
            <span class="dv-lab">Hover / focus (tip)</span><div class="dv-row dv-tips" id="ib-forced"></div>
            <span class="dv-lab">Normal, large, close</span><div class="dv-row" id="ib-sizes"><CloseButton /><CloseButton size="small" /></div>
          </div>
        </section>

        <section id="c4" class="dv-comp">
          <SectionTitle level="h3" text="4 Text field" />
          <p class="help">.field, label, .input, .help · fieldError() in src/lib/field-error.ts</p>
          <div class="dv-grid">
            <div class="field"><label for="f-1">Name</label><input class="input" id="f-1" value="Portvin 2026" /></div>
            <div class="field"><label for="f-2">Hover</label><input class="input is-hover" id="f-2" placeholder="Placeholder" /></div>
            <div class="field"><label for="f-3">Focus</label><input class="input is-focus" id="f-3" value="Focused" /></div>
            <div class="field"><label for="f-4">Disabled</label><input class="input" id="f-4" value="Not now" disabled /></div>
            <div class="field"><label for="f-5">Read-only</label><input class="input" id="f-5" value="From the label" readonly /></div>
            <div class="field"><label for="f-6">Email <span class="req" aria-hidden="true">*</span></label><input class="input" id="f-6" value="morten@" /></div>
            <div class="field"><label for="f-7">Note <span class="opt">(optional)</span></label><textarea class="input" id="f-7">Bring something sweet for the end.</textarea><p class="help">Only the hosts see it.</p></div>
            <div class="field"><label for="f-8">Code</label><input class="input code" id="f-8" placeholder="······" maxlength="6" /></div>
            <div class="field"><label for="f-9">Small</label><input class="input small" id="f-9" value="In a row" /></div>
          </div>
        </section>

        <section id="c5" class="dv-comp">
          <SectionTitle level="h3" text="5 Number and price field" />
          <p class="help">.affix.w-num with .unit · .field-row</p>
          <div class="dv-states">
            <span class="dv-lab">Price</span><div class="dv-row"><span class="affix w-num"><input class="input" value="149,95" aria-label="Price" /><span class="unit">kr.</span></span><span class="affix w-num u-long"><input class="input" value="13,5" aria-label="Alcohol" /><span class="unit">% vol.</span></span><span class="affix w-num w-qty"><input class="input" value="6" aria-label="Bottles" /></span><span class="affix w-num small"><input class="input" value="99" aria-label="Small" /><span class="unit">kr.</span></span></div>
            <span class="dv-lab">Error</span><div class="dv-row"><span class="affix w-num"><input class="input" id="f-num-err" value="abc" aria-label="Price" /><span class="unit">kr.</span></span></div>
            <span class="dv-lab">Field row</span><div class="field-row"><span>From</span><span class="affix w-num w-qty"><input class="input" value="6" aria-label="Bottles" /></span><span>bottles</span><span class="affix w-num"><input class="input" value="109,95" aria-label="Price" /><span class="unit">kr.</span></span><span>each</span></div>
          </div>
        </section>

        <section id="c6" class="dv-comp">
          <SectionTitle level="h3" text="6 Search field" />
          <p class="help">SearchField.astro</p>
          <div class="dv-states">
            <span class="dv-lab">Normal</span><div><SearchField id="dv-search" label="admin.searchGuest" placeholder="admin.searchPlaceholder" /></div>
            <span class="dv-lab">Focus</span><div><SearchField id="dv-search2" label="admin.searchGuest" placeholder="admin.searchPlaceholder" class="dv-focus-inner" /></div>
          </div>
        </section>
      </section>

      <!-- ======================= B ======================= -->
      <section id="g-b" class="dv-group">
        <SectionTitle text="B. Choices" />

        <section id="c7" class="dv-comp">
          <SectionTitle level="h3" text="7 Dropdown, one choice" />
          <p class="help">Dropdown.astro · dropdown() / getDropdown() in src/lib/ui/dropdown.ts · the menu is src/lib/ui/menu.ts</p>
          <div class="dv-grid">
            <div class="field"><label for="dd-1-btn">Type</label><Dropdown id="dd-1" options={opts} value="port" /></div>
            <div class="field"><label for="dd-2-btn">Nothing chosen</label><Dropdown id="dd-2" options={opts} /></div>
            <div class="field"><label for="dd-3-btn">Disabled</label><Dropdown id="dd-3" options={opts} value="red" /></div>
            <div class="field"><label for="dd-4-btn">Error</label><Dropdown id="dd-4" options={opts} /></div>
            <div class="field"><span class="flabel">Small and built in TS (with search)</span><div id="dd-ts"></div></div>
            <div class="field"><span class="flabel">Bare (the header's menus)</span><div id="dd-bare"></div></div>
          </div>
          <div class="dv-states">
            <span class="dv-lab">Open menu</span><div id="menu-open" class="dv-menu"></div>
          </div>
        </section>

        <section id="c8" class="dv-comp">
          <SectionTitle level="h3" text="8 Filter, several choices" />
          <p class="help">filterDropdown() in src/lib/filter-dd.ts</p>
          <div class="dv-row" id="filter-row"></div>
        </section>

        <section id="c9" class="dv-comp">
          <SectionTitle level="h3" text="9 Combobox (type and choose)" />
          <p class="help">combo() in src/lib/combo.ts – type "d" to see the suggestions</p>
          <div class="field dv-narrow"><label for="combo-in">Region</label><div class="combo"><input class="input" id="combo-in" autocomplete="off" value="Do" /></div></div>
        </section>

        <section id="c10" class="dv-comp">
          <SectionTitle level="h3" text="10 Choice cards" />
          <p class="help">ChoiceCards.astro · choiceCards() in src/lib/ui/choice-cards.ts</p>
          <div class="dv-grid">
            <div id="cc-1"></div>
            <div id="cc-2"></div>
            <div id="cc-3"></div>
            <div id="cc-4"></div>
            <div id="cc-5"></div>
          </div>
        </section>

        <section id="c11" class="dv-comp">
          <SectionTitle level="h3" text="11 Switch" />
          <p class="help">Switch.astro · switchRow() / bindSwitch() in src/lib/ui/switch.ts – saves straight away</p>
          <div class="dv-narrow">
            <Switch title="admin.orderable" hint="twe.orderableHint" id="sw-1" checked />
            <Switch title="admin.orderable" hint="twe.orderableHint" id="sw-2" />
            <Switch title="admin.orderable" hint="twe.orderableHint" id="sw-3" disabled class="dv-label-focus" />
            <div id="sw-ts"></div>
          </div>
        </section>

        <section id="c12" class="dv-comp">
          <SectionTitle level="h3" text="12 Checkbox" />
          <p class="help">Checkbox.astro · checkbox() in src/lib/ui/checkbox.ts – choose several, and consent</p>
          <div class="dv-states">
            <span class="dv-lab">States</span>
            <div class="dv-col" id="ck-col"><Checkbox label="login.remember" id="ck-1" checked /><Checkbox label="login.remember" id="ck-2" /><Checkbox label="login.remember" id="ck-3" disabled /><Checkbox label="login.remember" id="ck-4" small /></div>
          </div>
        </section>

        <section id="c13" class="dv-comp">
          <SectionTitle level="h3" text="13 Date and time" />
          <p class="help">DateTimeFields.astro · initWhen() in src/lib/datetime.ts</p>
          <div class="dv-narrow"><DateTimeFields prefix="dv" /></div>
        </section>

        <section id="c14" class="dv-comp">
          <SectionTitle level="h3" text="14 Address" />
          <p class="help">AddressFields.astro · initAddress() in src/lib/address.ts</p>
          <div class="dv-narrow"><AddressFields prefix="dva" /></div>
        </section>

        <section id="c15" class="dv-comp">
          <SectionTitle level="h3" text="15 Image picker" />
          <p class="help">imagePicker(), pickButton() in src/lib/ui/image-picker.ts</p>
          <div class="dv-col dv-narrow" id="pick-grid"></div>
        </section>

        <section id="c16" class="dv-comp">
          <SectionTitle level="h3" text="16 Stars" />
          <p class="help">starsInput(), starsRo() in src/lib/ui/stars.ts</p>
          <div class="dv-states" id="stars-states"></div>
        </section>

        <section id="c17" class="dv-comp">
          <SectionTitle level="h3" text="17 Stepper" />
          <p class="help">stepper() in src/lib/ui/stepper.ts</p>
          <div class="dv-row" id="stepper-row"></div>
        </section>
      </section>

      <!-- ======================= C ======================= -->
      <section id="g-c" class="dv-group">
        <SectionTitle text="C. Display" />

        <section id="c18" class="dv-comp">
          <SectionTitle level="h3" text="18 Chip / status" />
          <p class="help">chip(), statusChip() and STATUS in src/lib/ui/status.ts – one word and one tone per status</p>
          <div class="dv-states">
            <span class="dv-lab">Tones</span><div class="chips" id="chip-tones"></div>
            <span class="dv-lab">Every status</span><div class="chips" id="chip-status"></div>
          </div>
          <p class="help">Ribbon.astro – a corner band on a card (class "has-ribbon")</p>
          <div class="card has-ribbon dv-ribbon"><Ribbon text="Beta" /><b>Free</b><span class="help">A plan card with the ribbon</span></div>
        </section>

        <section id="c19" class="dv-comp">
          <SectionTitle level="h3" text="19 Badge" />
          <p class="help">Badge.astro · badge(), setBadge() in src/lib/ui/badge.ts</p>
          <div class="dv-row">
            <span class="dv-badge-host"><Icon name="cart" /><Badge count={3} /></span>
            <span class="dv-badge-host"><Icon name="cart" /><Badge count="99+" /></span>
            <span class="dv-badge-host"><Icon name="chat" /><Badge kind="dot" /></span>
            <span>Waiting list<Badge kind="inline" count={4} /></span>
            <span>Guests<Badge kind="neutral" count={22} /></span>
          </div>
        </section>

        <section id="c20" class="dv-comp">
          <SectionTitle level="h3" text="20 Avatar and wine thumbnail" />
          <p class="help">avatar(), wineThumb() in src/lib/ui/thumb.ts</p>
          <div class="dv-row" id="thumbs"></div>
        </section>

        <section id="c21" class="dv-comp">
          <SectionTitle level="h3" text="21 Price" />
          <p class="help">price() in src/lib/ui/price.ts · every amount by formatKr() in src/lib/ui/kr.ts</p>
          <div class="dv-row dv-top" id="prices"></div>
        </section>

        <section id="c22" class="dv-comp">
          <SectionTitle level="h3" text="22 Facts" />
          <p class="help">Facts.astro + setFact() · facts() in src/lib/ui/facts.ts – an empty value is left out</p>
          <div class="dv-grid">
            <Facts id="facts-static" items={[{ label: 'admin.date', id: 'fs-1', icon: 'calendar' }, { label: 'nav.wines', id: 'fs-2', icon: 'glass' }, { label: 'nav.quiz', id: 'fs-3' }]} />
            <div id="facts-ts"></div>
          </div>
          <p class="help">.ruled – a hairline between the pairs, for long values (a wine's notes); on phones the label goes above its value</p>
          <div id="facts-ruled"></div>
          <p class="help">A wine's details: each heading gets its icon from its words (detailIcon()), the info icon when none fits</p>
          <div id="facts-icons"></div>
        </section>

        <section id="c23" class="dv-comp">
          <SectionTitle level="h3" text="23 Map with flag and credit" />
          <p class="help">drawMap() in src/lib/region-map.ts · .map-box (normal, mini), .map-credit, .map-legend, .flag</p>
          <div class="dv-grid dv-top">
            <div><div id="map-normal" class="map-box"></div><p class="map-credit">Natural Earth · OpenStreetMap</p></div>
            <div><div id="map-mini" class="map-box"></div><p class="map-credit">Natural Earth</p><ul class="map-legend"><li><span class="no">3</span><span><b>Douro</b><span class="sub">Wines 1–3</span></span></li><li class="whole"><span class="no">1</span><span><b>Portugal</b><span class="sub">The whole country</span></span></li><li class="other"><span class="no">2</span><span><b>Other places</b><span class="sub">Not on this map</span></span></li></ul><p id="flag-line" class="tb-flag dv-flags"></p></div>
          </div>
        </section>

        <section id="c24" class="dv-comp">
          <SectionTitle level="h3" text="24 Table" />
          <p class="help">table() in src/lib/ui/table.ts – sortable, numbers right, a card per row on phones; empty: the empty state</p>
          <div id="tbl"></div>
          <div class="dv-gap"></div>
          <div id="tbl-empty"></div>
        </section>
      </section>

      <!-- ======================= D ======================= -->
      <section id="g-d" class="dv-group">
        <SectionTitle text="D. Lists and rows" />

        <section id="c25" class="dv-comp">
          <SectionTitle level="h3" text="25 List row and card" />
          <p class="help">listRow(), personRow() in src/lib/ui/list-row.ts – a list shows, the side panel edits</p>
          <ul class="list" id="rows"></ul>
          <SectionTitle level="eyebrow" text="Activity rows – activityRow()" class="dv-sub" />
          <ul class="list" id="act-rows"></ul>
          <SectionTitle level="eyebrow" text="Card variant" class="dv-sub" />
          <ul class="cards" id="row-cards"></ul>
        </section>

        <section id="c26" class="dv-comp">
          <SectionTitle level="h3" text="26 Add row" />
          <p class="help">AddRow.astro · addRow() in src/lib/ui/add-row.ts – the new row slides in at the top of the list</p>
          <div class="ph sec"><div class="ph-text"><h3>Wines</h3></div><div class="ph-act"><button id="dv-add-toggle" class="btn small" type="button"><Icon name="plus" />Add wine</button></div></div>
          <AddRow id="dv-ar" lead>
            <div class="ar-fields"><input id="dv-ar-name" class="input" placeholder="Name, or paste a link" aria-label="Wine" /></div>
            <p class="help">Enter adds it. Esc closes.</p>
            <Fragment slot="actions"><button id="dv-ar-go" class="btn" type="button">Add</button></Fragment>
          </AddRow>
          <ul class="list" id="ar-list"></ul>
        </section>

        <section id="c27" class="dv-comp">
          <SectionTitle level="h3" text="27 Highlight after saving" />
          <p class="help">highlight() in src/lib/ui/highlight.ts</p>
          <ul class="list" id="hl-list"></ul>
          <Actions tight><button id="hl-go" class="btn small secondary" type="button">Highlight the row</button></Actions>
        </section>

        <section id="c28" class="dv-comp">
          <SectionTitle level="h3" text="28 Delete with Undo" />
          <p class="help">deleteWithUndo() in src/lib/ui/delete-undo.ts – ask first, then a toast with Undo</p>
          <ul class="list" id="del-list"></ul>
        </section>

        <section id="c29" class="dv-comp">
          <SectionTitle level="h3" text="29 Reorder" />
          <p class="help">reorder() in src/lib/ui/reorder.ts – drag the grip, or focus it and press ↑/↓</p>
          <ul class="list" id="ro-list"></ul>
        </section>
      </section>

      <!-- ======================= E ======================= -->
      <section id="g-e" class="dv-group">
        <SectionTitle text="E. Panels, messages and states" />

        <section id="c30" class="dv-comp">
          <SectionTitle level="h3" text="30 Side panel" />
          <p class="help">Sheet.astro + sheetPanel() · sheet() in src/lib/ui/sheet.ts – from the right, a bottom sheet on phones</p>
          <Actions tight><button id="sheet-open" class="btn small secondary" type="button">Open the side panel</button><button id="sheet-ts-open" class="btn small secondary" type="button">Open one built in TS</button></Actions>
          <Sheet id="dv-sheet" title="section.details" form="dv-sheet-form">
            <div class="field"><label for="dv-s-name">Name</label><input class="input" id="dv-s-name" value="Portvin 2026" /></div>
            <div class="field"><label for="dv-s-place">Place <span class="opt">(optional)</span></label><input class="input" id="dv-s-place" /></div>
            <Switch title="admin.orderable" hint="twe.orderableHint" id="dv-s-sw" />
            <Fragment slot="quiet"><button class="btn small quiet-danger" type="button"><Icon name="trash" />Delete the wine</button></Fragment>
            <Fragment slot="foot"><button class="btn" type="submit">Save</button></Fragment>
          </Sheet>
        </section>

        <section id="c31" class="dv-comp">
          <SectionTitle level="h3" text="31 Confirmation" />
          <p class="help">confirmModal() in src/lib/ui/confirm.ts – the only way the site asks first</p>
          <Actions tight><button id="cf-open" class="btn small secondary" type="button">Ask (danger)</button><button id="cf-open2" class="btn small secondary" type="button">Ask (normal)</button></Actions>
        </section>

        <section id="c32" class="dv-comp">
          <SectionTitle level="h3" text="32 Toast" />
          <p class="help">toast() in src/lib/ui/toast.ts – after saving, deleting or copying</p>
          <Actions tight><button id="t-ok" class="btn small secondary" type="button">Saved</button><button id="t-undo" class="btn small secondary" type="button">With Undo</button><button id="t-err" class="btn small secondary" type="button">Error</button></Actions>
        </section>

        <section id="c33" class="dv-comp">
          <SectionTitle level="h3" text="33 Notice and status line" />
          <p class="help">Notice.astro · notice(), setNotice() in src/lib/ui/notice.ts · setStatus() in src/lib/ui/status-line.ts</p>
          <Notice><p>Guests see the wines when you reveal them.</p></Notice>
          <Notice tone="warn"><p>Two wines have no price yet.</p></Notice>
          <Notice tone="error"><p>The changes could not be saved. Try again.</p></Notice>
          <Notice tone="ok"><p>The invitations are sent.</p></Notice>
          <div id="notice-ts"></div>
          <div id="status-lines"></div>
        </section>

