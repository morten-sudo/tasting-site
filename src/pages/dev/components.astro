  import { setPayee, payBox } from '../../lib/pay';
  import { renderLeaderboard } from '../../lib/leaderboard';
  import { FLAGS } from '../../i18n/flags';

  // Forced states: every :hover / :focus-visible / :focus-within rule of the site's stylesheets, again for .is-hover /
  // .is-focus – so the states shown are exactly the real ones (no copies of the component CSS on this page)
  function forceStates() {
    const out: string[] = [];
    const conv = (sel: string) => sel.replace(/:hover/g, '.is-hover').replace(/:focus-visible|:focus-within/g, '.is-focus');
    const walk = (rules: CSSRuleList, wrap: (r: string) => string) => {
      for (const r of [...rules]) {
        if (r instanceof CSSStyleRule && /:hover|:focus-visible|:focus-within/.test(r.selectorText)) out.push(wrap(`${conv(r.selectorText)} { ${r.style.cssText} }`));
        else if (r instanceof CSSMediaRule && !/hover:\s*none/.test(r.conditionText)) walk(r.cssRules, (x) => wrap(`@media ${r.conditionText} { ${x} }`));
      }
    };
    for (const s of [...document.styleSheets]) { try { walk(s.cssRules, (x) => x); } catch { /* another origin (fonts) */ } }
    const st = document.createElement('style');
    st.textContent = out.join('\n');
    document.head.append(st);
  }

  const host = await requireHost();
  if (host) {
    $('admin-main').hidden = false;
    forceStates();
    build();
  }

  function build() {
    // ---------- A ----------
    for (const [id, variant, label] of [['b-load', 'primary', 'Saving …'], ['b-load2', 'secondary', 'Sending …'], ['b-load3', 'primary', 'Saving …']] as const) {
      const b = button('Save', { variant: variant === 'primary' ? undefined : 'secondary', small: id === 'b-load3' });
      $(id).replaceWith(b);
      setLoading(b, true, label);
    }
    $('tb-ts').append(textButton('All wines', { arrow: 'forward' }), textButton('Back', { arrow: 'back' }), textButton('Remove', { danger: true }), textButton('Help', { href: '/admin/help/' }));
    const loadingIcon = iconButton('mail', 'Sending');
    setIconLoading(loadingIcon, true);
    const disabledIcon = iconButton('edit', 'Edit');
    disabledIcon.disabled = true;
    $('ib-small').append(iconButton('edit', 'Edit'), iconButton('mail', 'Invite', { strong: true }), iconButton('reveal', 'Reveal'), iconButton('trash', 'Remove', { quiet: true }), disabledIcon, loadingIcon);
    const h = iconButton('edit', 'Edit (hover)'); h.classList.add('is-hover');
    const f = iconButton('mail', 'Invite (focus)', { strong: true }); f.classList.add('is-focus');
    const q = iconButton('trash', 'Remove (hover)', { quiet: true }); q.classList.add('is-hover');
    const s = iconButton('mail', 'Strong (hover)', { strong: true }); s.classList.add('is-hover');
    $('ib-forced').append(h, f, s, q);
    $('ib-sizes').prepend(iconButton('edit', 'Edit', { size: 'normal' }), iconButton('right', 'Next', { size: 'large' }), closeButton());
    fieldError($('f-6'), 'Write the whole email address, e.g. name@example.dk');
    fieldError($('f-num-err'), 'Write an amount, e.g. 149,95');
    $('dv-search2').classList.add('is-focus');

    // 43: the account choice at the top of the side menu
    const accounts = [{ value: 'a', label: 'Din konto', hint: 'Ejer' }, { value: 'b', label: 'Holte Vinklub', hint: 'Vært' }, { value: 'c', label: 'Anna Holms konto', hint: 'Vært' }];
    sideSwitcher(accounts, 'b', () => {}, 'dv-switch');
    sideSwitcher([{ value: 'x', label: 'Vinklubben for Nordsjællands Portvinsvenner', hint: 'Vært' }, ...accounts], 'x', () => {}, 'dv-switch3');

    // ---------- B ----------
    getDropdown('dd-1'); getDropdown('dd-2');
    const d3 = getDropdown('dd-3'); d3.disabled = true;
    const d4 = getDropdown('dd-4'); d4.button.setAttribute('aria-invalid', 'true'); fieldError(d4.button, 'Choose a type');
    const countries = ['Portugal', 'Spain', 'France', 'Italy', 'Germany', 'Austria', 'Hungary', 'Greece', 'Chile', 'Argentina', 'South Africa', 'Australia', 'New Zealand', 'USA']
      .map((c) => ({ value: c, label: c }));
    $('dd-ts').append(dropdown({ options: countries, value: 'Portugal', small: true, ariaLabel: 'Country' }).el);
    const bare = dropdown({ options: [{ value: 'da', label: 'Dansk' }, { value: 'en', label: 'English' }], value: 'da', ariaLabel: 'Language' });
    bare.button.classList.add('bare');
    $('dd-bare').append(bare.el);
    const menu = mk('div', 'menu static');
    menu.setAttribute('role', 'listbox');
    const active = menuItem('White wine', { role: 'option', check: true });
    active.dataset.active = '';
    menu.append(menuGroup('Wines'), menuItem('Red wine', { role: 'option', check: true, selected: true, small: '6' }), active,
      menuItem('Port', { role: 'option', check: true, small: '3', sub: 'Fortified' }), mk('hr'), menuItem('New tasting', { cls: 'act', lead: iconSvg('plus') }));
    $('menu-open').append(menu);
    const fGuests = filterDropdown({ name: 'Guests', onChange: () => {} });
    fGuests.render([{ value: 'yes', label: 'Coming', n: 14 }, { value: 'wait', label: 'Waiting list', n: 2 }, { value: 'no', label: 'Not coming', n: 3 }, { value: 'inv', label: 'Invited', n: 3 }], new Set(), 22);
    const fType = filterDropdown({ name: 'Types', single: true, onChange: () => {} });
    fType.render([{ value: 'red', label: 'Red wine', n: 6 }, { value: 'port', label: 'Port', n: 5 }], new Set(['port']), 11);
    $('filter-row').append(fGuests.el, fType.el);
    const fW = filterDropdown({ name: 'Wines', onChange: () => {} });
    fW.render([{ value: 'shown', label: 'Shown', n: 8 }, { value: 'hidden', label: 'Hidden', n: 3 }], new Set(), 11);
    $('ph-filter').replaceWith(fW.el);
    combo($<HTMLInputElement>('combo-in'), () => [{ value: 'Douro', group: 'Portugal' }, { value: 'Dão', group: 'Portugal' }, { value: 'Dolceacqua', hint: 'Liguria', group: 'Italy' }]);

    const levels = [{ value: 'easy', label: 'Easy', hint: 'For guests who are new to wine' }, { value: 'mid', label: 'Medium', hint: 'Some knowledge helps' }, { value: 'hard', label: 'Hard', hint: 'For the experts' }];
    $('cc-1').append(choiceCards({ legend: 'Difficulty', options: levels, value: 'mid' }).el);
    $('cc-2').append(choiceCards({ legend: 'Are you coming?', options: [{ value: 'yes', label: 'Yes' }, { value: 'no', label: 'No' }, { value: 'maybe', label: 'Maybe' }], value: 'yes', compact: true }).el);
    const dis = choiceCards({ legend: 'Disabled', options: levels.slice(0, 2), value: 'easy' }); dis.setDisabled(true);
    $('cc-3').append(dis.el);
    const err = choiceCards({ legend: 'Error (nothing chosen)', options: levels.slice(0, 2), compact: true }); err.el.classList.add('error');
    const focus = err.el.querySelector('input'); focus?.classList.add('is-focus');
    $('cc-4').append(err.el);
    // Tiles: a few short choices side by side, each with its line (the wine's bottle size)
    $('cc-5').append(choiceCards({ legend: 'Tiles (bottle size)', tiles: true, value: '150', options: [{ value: '37.5', label: '37,5 cl', hint: 'Half bottle' },
      { value: '75', label: '75 cl', hint: 'Ordinary' }, { value: '150', label: '150 cl', hint: 'Magnum' }, { value: '300', label: '300 cl', hint: 'Double magnum' }, { value: 'other', label: 'Other', hint: 'Type the size' }] }).el);

    bindSwitch($<HTMLInputElement>('sw-1'), { save: async () => true });
    bindSwitch($<HTMLInputElement>('sw-2'), { save: async () => true });
    const saving = switchRow({ title: 'Saving …', hint: 'Built with switchRow(): the spinner while it saves', checked: true, plain: true });
    saving.el.classList.add('saving');
    saving.input.disabled = true;
    saving.el.prepend(Object.assign(mk('span', 'sw-busy'), { innerHTML: '<span class="spin"></span>' }));
    $('sw-ts').append(saving.el);
    const ckErr = checkbox('I accept the terms (error)'); ckErr.el.classList.add('error');
    const ckFocus = checkbox('Focus'); ckFocus.input.classList.add('is-focus');
    $('ck-col').append(ckErr.el, ckFocus.el);
    initWhen('dv');
    initAddress('dva');

    const p1 = imagePicker({ onFile: () => {} });
    const p2 = imagePicker({ onFile: () => {} }); p2.setImage('/img/cellar-800.jpg', 'kopke-label.jpg', 'Read from the label');
    const p3 = imagePicker({ onFile: () => {} }); p3.setImage('/img/cellar-800.jpg', 'kopke-label.jpg'); p3.setBusy(true, 'Reading the label …');
    const p4 = imagePicker({ onFile: () => {} }); p4.el.classList.add('drag');
    const p5 = imagePicker({ onFile: () => {} }); p5.el.classList.add('err');
    for (const [p, l] of [[p1, 'Empty'], [p2, 'With a picture'], [p3, 'Busy'], [p4, 'A picture held over it'], [p5, 'Error']] as const) {
      const box = mk('div', 'field'); box.append(mk('span', 'flabel', l), p.el); $('pick-grid').append(box);
    }
    const st = $('stars-states');
    const add = (label: string, el: Node) => { st.append(mk('span', 'dv-lab', label)); const d = mk('div', 'dv-row'); d.append(el); st.append(d); };
    add('Rate', starsInput({ value: 4, label: 'Your rating', onRate: () => {} }).el);
    add('Not rated', starsInput({ label: 'Your rating', onRate: () => {} }).el);
    const sb = starsInput({ value: 3, label: 'Saving', onRate: () => {} }); sb.setBusy(true); add('Busy', sb.el);
    add('Disabled', starsInput({ value: 2, label: 'Closed', disabled: true, onRate: () => {} }).el);
    const ro = mk('span', 'dv-row'); ro.append(starsRo(4.3, '4,3 · 18 ratings'), starsRo(3, '', { chip: true }));
    add('Read-only', ro);
    const busyStep = stepper({ value: 3, min: 1, max: 48, label: 'Busy' }); busyStep.setBusy(true);
    const errStep = stepper({ value: 49, min: 1, max: 48, label: 'Too many' }); errStep.el.setAttribute('aria-invalid', 'true');
    $('stepper-row').append(stepper({ value: 2, min: 1, max: 48, label: 'Bottles' }).el, stepper({ value: 1, min: 1, max: 48, label: 'At the minimum' }).el,
      stepper({ value: 6, min: 2, max: 99, small: true, label: 'Small' }).el, busyStep.el, errStep.el);

    // ---------- C ----------
    $('chip-tones').append(chip('Neutral'), chip('Coming', 'ok'), chip('Waiting list', 'wait'), chip('No price', 'warn'), chip('Not paid', 'err'), chip('Owner', 'strong'), chip('Not coming', 'neutral', { dashed: true }), chip('A link chip', 'neutral', { href: '#c18' }), starsRo(4, '', { chip: true }));
    $('chip-status').append(...(Object.keys(STATUS) as StatusName[]).map((n) => statusChip(n)));
    $('thumbs').append(avatar('Morten Hansen', { size: 'small' }), avatar('Morten Hansen'), avatar('Morten Hansen', { size: 'large' }), avatar('Anne Berg', { host: true }), avatar('', { add: true }),
      wineThumb('/img/cellar-800.jpg', { size: 'small' }), wineThumb(null), wineThumb(null, { blind: true }), wineThumb('/img/cellar-800.jpg', { size: 'large' }));
    $('prices').append(price({ amount: 149.95 }), price({ amount: 129.95, was: 159.95, tiers: ['From 6 bottles: 119,95 kr. each'] }), price({ amount: null }), price({ amount: 595, size: 'large', was: 695 }), price({ amount: 89.5, align: 'right' }));
    setFact($('fs-1'), 'Saturday 14 November 2026, 19:00');
    setFact($('fs-2'), '11 wines');
    setFact($('fs-3'), null);
    $('facts-ruled').append(facts([{ label: 'Style', value: 'Tawny with an age statement – a blend of several vintages averaging about 10 years.' }, { label: 'Ageing', value: 'Oxidatively matured in oak casks.' }, { label: 'Nose', value: 'Ripe fruit, light caramel, dried fig and walnut.' }, { label: '', value: 'A line without a label spans the whole width.' }], 'ruled card')!);
    // A wine's details with the icon each heading gets (detailIcon() in src/lib/ui/detail-icon.ts)
    $('facts-icons').append(facts(['Hjemmeside', 'Adresse', 'Område', 'Producent', 'Vinmark', 'Året', 'Druer', 'Stil', 'Farve', 'Duft', 'Smag', 'Balance', 'Produktion', 'Lagring', 'Udvikling', 'Alkohol', 'Flaske', 'Anmeldelser', 'Sammenlignet', 'Sjældenhed', 'Mad', 'Servering', 'Alt andet']
      .map((label) => ({ label, value: 'Lorem ipsum dolor sit amet.', icon: detailIcon(label) })), 'ruled card')!);
    $('facts-ts').append(facts([{ label: 'Grapes', value: 'Touriga Nacional, Touriga Franca', icon: 'grapes' }, { label: 'Food', value: 'Blue cheese', icon: 'food' }, { label: 'Serving', value: '16–18 °C', icon: 'serving' }, { label: 'Number', value: '12 34 56 78', copy: { text: '12345678', label: 'Copy the number', done: 'Copied: 12 34 56 78' } }], 'card')!);
    $('flag-line').innerHTML = Object.values(FLAGS).join(' ');
    loadMap(DETAILED_MAPS[0].id).then((m) => {
      if (!m) return;
      $('map-normal').innerHTML = drawMap(m);
      $('map-mini').innerHTML = drawMap(m);
      const b = document.querySelector('#c23 .map-legend b'); if (b) b.textContent = DETAILED_MAPS[0].name;
    });
    type O = { who: string; wine: string; n: number; sum: number; when: string };
    const orders: O[] = [
      { who: 'Anne Berg', wine: 'Kopke Colheita 2008', n: 2, sum: 899.9, when: '14 Nov' },
      { who: 'Morten Hansen', wine: 'Quinta do Vesuvio 2019', n: 6, sum: 3570, when: '14 Nov' },
      { who: 'Jens Holm', wine: 'Taylor’s 20 Year Old Tawny', n: 1, sum: 549.95, when: '15 Nov' },
    ];
    $('tbl').append(table<O>({
      columns: [{ key: 'who', label: 'Guest', sort: (r) => r.who }, { key: 'wine', label: 'Wine', sort: (r) => r.wine, wideOnly: false },
        { key: 'n', label: 'Bottles', num: true, sort: (r) => r.n }, { key: 'sum', label: 'Amount', num: true, nowrap: true, cell: (r) => formatKr(r.sum), sort: (r) => r.sum, desc: true },
        { key: 'when', label: 'When', nowrap: true }],
      rows: orders, sort: { key: 'sum', desc: true }, foot: (rs) => ['Total', '', String(rs.reduce((a, r) => a + r.n, 0)), formatKr(rs.reduce((a, r) => a + r.sum, 0)), ''], caption: 'Orders',
    }).el);
    $('tbl-empty').append(table<O>({ columns: [{ key: 'who', label: 'Guest' }], rows: [], empty: { icon: 'cart', title: 'No orders yet', text: 'Orders come in when the guests order bottles.' } }).el);

    // ---------- D ----------
    const edit = () => iconButton('edit', 'Edit');
    const remove = () => iconButton('trash', 'Remove', { quiet: true });
    $('rows').append(
      listRow({ id: 1, grip: { label: 'Move Kopke Colheita 2008' }, no: 1, pic: wineThumb('/img/cellar-800.jpg'), title: 'Kopke Colheita 2008', onOpen: () => {},
        meta: [['Port', 'Douro, Portugal']], chips: [{ text: 'Shown', tone: 'ok' }, { text: 'Can be ordered' }], aside: price({ amount: 449.95, align: 'right', tiers: ['6+: 419,95 kr.'] }), actions: [iconButton('reveal', 'Reveal'), edit(), remove()] }),
      listRow({ id: 2, grip: { label: 'Move Blind wine' }, no: 2, pic: wineThumb(null, { blind: true }), title: 'Blind wine', meta: [['Red wine']], chips: [{ text: 'Blind', tone: 'strong' }, { text: 'Hidden', dashed: true }], aside: price({ amount: null, align: 'right' }), actions: [edit(), remove()] }),
      personRow({ id: 'p0', name: 'Mette Kjær', href: '#c25', meta: ['mette@example.dk', 'signed in 2 days ago'], chips: [{ text: 'Portvin 2026 · Coming', tone: 'ok', href: '#c25' }], actions: [edit(), remove()] }),
      personRow({ id: 'p1', name: 'Anne Berg', host: true, meta: ['anne@example.dk'], chips: [{ text: 'Coming', tone: 'ok' }, { text: 'Paid', tone: 'ok' }], actions: [iconButton('mail', 'Invite', { strong: true }), edit()] }),
      listRow({ id: 4, pic: avatar('Jens Holm'), title: 'Jens Holm', titleNote: 'you', meta: ['jens@example.dk', mk('span', 'note', '"Can’t eat nuts"')], chips: [statusChip('guest.waitlist')], actions: [edit()] }),
      listRow({ id: 5, pic: avatar('Old guest'), title: 'Muted row (not coming)', cls: 'muted', chips: [statusChip('guest.no')], actions: [edit()] }),
      listRow({ id: 6, pic: wineThumb(null), title: 'Busy row', cls: 'busy', meta: ['Saving …'], actions: [edit()] }),
      listRow({ id: 7, title: 'Portvin 2026', cls: 'big', href: '#c25', meta: ['Saturday 14 November · 22 guests'], chips: [{ text: 'Next', tone: 'wait' }] }),
    );
    // Activity: a sign in a circle, what happened (a link, or plain text when there is nowhere to go), where and when
    $('act-rows').append(
      activityRow({ icon: '✓', title: 'Said yes to Portvin 2026', href: '#c25', meta: ['Portvin 2026', '2 hours ago'] }),
      activityRow({ icon: '🛒', title: 'Ordered 6 bottles (1.134,00 kr.)', href: '#c25', meta: ['Portvin 2026', 'Awaiting payment', 'yesterday'] }),
      activityRow({ icon: '★', title: [starsRo(4), ' Quinta do Noval LBV'], href: '#c25', meta: ['Portvin 2026', '3 days ago'] }),
      activityRow({ icon: '→', title: 'Signed in', meta: ['last week'] }),
    );
    $('row-cards').append(
      listRow({ variant: 'card', cardHref: '#c25', title: 'Portvin 2026', meta: ['Saturday 14 November at 19:00', 'Strandvejen 12, Hellerup'], chips: [statusChip('guest.yes')], foot: [mk('span', '', '11 wines'), mk('b', '', '22 guests')] }),
      listRow({ variant: 'card', small: true, pic: wineThumb('/img/cellar-800.jpg'), title: 'Order 14 November', meta: ['3 bottles'], aside: price({ amount: 1049.7, align: 'right' }), chips: [statusChip('order.unpaid')] }),
    );
    const go = $<HTMLButtonElement>('dv-ar-go');
    addRow({ id: 'dv-ar', button: $<HTMLButtonElement>('dv-add-toggle'), fields: [$<HTMLInputElement>('dv-ar-name')], go, onSubmit: () => {
      const name = $<HTMLInputElement>('dv-ar-name').value.trim();
      if (!name) return;
      const row = listRow({ id: Date.now(), no: '+', pic: wineThumb(null), title: name, actions: [edit()] });
      $('ar-list').prepend(row); highlight(row); toast(`${name} is added`);
    } });
    $('ar-list').append(listRow({ id: 11, no: 1, pic: wineThumb('/img/cellar-800.jpg'), title: 'Kopke Colheita 2008', actions: [edit()] }));
    $('dv-add-toggle').click();
    const hl = listRow({ id: 21, pic: wineThumb(null), title: 'Graham’s Six Grapes', meta: ['Saved just now'], actions: [edit()] });
    $('hl-list').append(hl);
    hl.classList.add('saved');
    $('hl-go').addEventListener('click', () => highlight(hl));
    for (const name of ['Dow’s Late Bottled Vintage 2018', 'Niepoort Ruby Dum']) {
      const b = remove();
      const row = listRow({ id: name, pic: wineThumb(null), title: name, actions: [b] });
      b.addEventListener('click', () => deleteWithUndo({ row, label: `${name} is removed`, ask: { title: `Remove ${name}?`, text: 'It goes from the tasting. The library keeps it.', ok: 'Remove' }, commit: async () => true }));
      $('del-list').append(row);
    }
    ['Kopke Fine White', 'Ramos Pinto Lágrima', 'Taylor’s Chip Dry'].forEach((n, i) =>
      $('ro-list').append(listRow({ id: n, grip: { label: `Move ${n}`, tip: 'Drag or use ↑/↓' }, no: i + 1, pic: wineThumb(null), title: n })));
    reorder($('ro-list'), { save: async () => true, announce: (pos, total) => `Moved to place ${pos} of ${total}` });

    // ---------- E ----------
    const dlg = $<HTMLDialogElement>('dv-sheet');
    sheetPanel(dlg, { dirty: 'form' });
    $('sheet-open').addEventListener('click', () => dlg.showModal());
    $('dv-sheet-form').addEventListener('submit', (e) => { e.preventDefault(); dlg.close(); toast('Saved'); });
    $('sheet-ts-open').addEventListener('click', () => {
      const f1 = mk('div', 'field'); f1.append(mk('label', '', 'Price'), Object.assign(mk('input', 'input'), { value: '149,95' }));
      const s2 = sheet({ id: 'dv-sheet-ts', title: 'Built with sheet()', form: true, body: [f1], foot: [Object.assign(button('Save', { type: 'submit' }))] });
      sheetPanel(s2.dialog, { onClose: () => s2.dialog.remove() });
      s2.form?.addEventListener('submit', (e) => { e.preventDefault(); s2.dialog.close(); toast('Saved'); });
      s2.dialog.showModal();
    });
    $('cf-open').addEventListener('click', () => confirmModal({ title: 'Delete the tasting?', text: 'The guests lose their invitations. This cannot be undone.', ok: 'Delete the tasting', danger: true }));
    $('cf-open2').addEventListener('click', () => confirmModal({ title: 'Send the invitations?', text: '14 guests get an email.', ok: 'Send 14 invitations' }));
    $('t-ok').addEventListener('click', () => toast('Saved'));
    $('t-undo').addEventListener('click', () => toast('Kopke Fine White is removed', { action: { label: 'Undo', run: () => toast('Put back') } }));
    $('t-err').addEventListener('click', () => toast('The changes could not be saved', { kind: 'error' }));
    $('notice-ts').append(notice('warn', { title: 'Built with notice()', text: 'With a title and an action.', actions: [Object.assign(button('Add prices', { small: true }))] }));
    for (const [state, text] of [['busy', 'Reading the label …'], ['info', 'Fetched from supervin.dk'], ['ok', 'Found: Kopke Colheita 2008'], ['warn', 'No picture on the page'], ['error', 'The link could not be read']] as const) {
      const l = statusLine(); setStatus(l, state, text); $('status-lines').append(l);
    }
    $('empty-ts').append(emptyState({ icon: 'glass', title: 'No wines yet', text: 'Add the first wine with a photo of the label or a link.', actions: [{ label: 'Add wine', icon: 'plus' }, { label: 'From the library', secondary: true }] }));
    $('loading-ts').append(pageLoading('Fetching the wine …'));
    initHelpTips($('c36'));
    tooltip($('tt-target'), 'The name as a tip');
    $('disc-ts').append(disclosure('Built with disclosure()', [mk('p', '', 'From src/lib/ui/disclosure.ts.')]));
    const pr = progress({ label: 'Answered', value: 4, max: 12, text: '4 of 12' });
    const pr2 = progress({ label: 'Mails this month', value: 2700, max: 3000, text: '2.700 of 3.000', tone: 'warn', meter: true });
    const pr3 = progress({ label: 'Storage', value: 990, max: 1000, text: '99 %', tone: 'err', meter: true });
    $('prog-ts').append(pr, pr2, pr3);
    setProgress($('prog-static'), { value: 1, max: 3, text: '1 of 3' });
    $('prog-static-text').textContent = '1 of 3';

    // ---------- F ----------
    $('st-ts').append(sectionTitle('eyebrow', 'Built with sectionTitle()'), sectionTitle('h3', 'A sub-heading'));
    const cd = $('dv-count'); cd.hidden = false; cd.textContent = 'In 11 days';

    // ---------- G ----------
    const now = Date.now();
    const sample: ChatMessage[] = [
      { id: 1, author: 'Anne', body: 'Looking forward to it! Shall I bring cheese?', created_at: new Date(now - 3600e3).toISOString(), from_host: false, mine: false },
      { id: 2, author: 'Morten', body: 'Yes please – something blue for the vintage port.', created_at: new Date(now - 3000e3).toISOString(), from_host: true, mine: true },
      { id: 3, author: 'Jens', body: 'I am on the waiting list, fingers crossed 🍷', created_at: new Date(now - 600e3).toISOString(), from_host: false, mine: false },
    ];
    let first = true;
    const queue: ChatMessage[] = [];
    initChat({ prefix: 'dvc', load: async () => { if (first) { first = false; return sample; } return queue.splice(0); },
      send: async (body) => { queue.push({ id: Date.now(), author: 'Morten', body, created_at: new Date().toISOString(), from_host: true, mine: true }); return 'ok'; },
      remove: async () => true }).start();
    const wineCard = (i: number, name: string, style: string, amount: number) => {
      const li = listRow({ variant: 'card', cls: 'wine-card', id: i, cardHref: '#c49', no: String(i).padStart(2, '0'), pic: wineThumb(null, { size: 'large' }),
        kicker: styleTag({ style }), title: name, meta: [['2019', 'Douro, Portugal']],
        foot: [price({ amount }), Object.assign(mk('span', 'go', 'Read more'), { ariaHidden: 'true' })] });
      li.querySelector('.thumb')?.classList.add('fill');
      return li;
    };
    const cards = mk('ul', 'cards');
    cards.append(wineCard(1, 'Kopke Colheita 2008', 'Fortified', 449.95), wineCard(2, 'Quinta do Vesuvio', 'Fortified', 595), wineCard(3, 'Niepoort Redoma Branco', 'WhiteWine', 189.95));
    cards.firstElementChild?.classList.add('is-current');
    $('carousel').append(cards);
    for (const [id, name, n, unit] of [[31, 'Kopke Colheita 2008', 2, 449.95], [32, 'Graham’s Six Grapes', 1, 149.8]] as const) {
      const aside = document.createDocumentFragment();
      aside.append(stepper({ value: n, min: 1, max: 48, label: name }).el, price({ amount: n * unit, align: 'right' }));
      $('cart-lines').append(listRow({ id, pic: wineThumb(null), title: name, cls: 'cart-line', meta: [[`${formatKr(unit)} per bottle`]], aside, actions: [remove()] }));
    }
    const bar = document.querySelector<HTMLElement>('.dv-cartbar .cartbar');
    if (bar) { bar.hidden = false; const b = bar.querySelector('b'); if (b) b.textContent = '3 bottles'; const sm = bar.querySelector('small'); if (sm) sm.textContent = formatKr(1049.7); }
    setPayee('12345678');
    $('paybox').append(payBox(1049.7, 'Portvin 2026 – Anne'));
    $('quiz-prog').append(progress({ label: 'Question 3 of 12', value: 2, max: 12, text: '2 answered' }));
    const quiz = choiceCards({ options: [{ value: 'a', label: 'Touriga Nacional' }, { value: 'b', label: 'Cabernet Sauvignon' }, { value: 'c', label: 'Tinta Roriz' }], value: 'c' });
    quiz.el.classList.add('locked');
    quiz.setDisabled(true);
    const labels = quiz.el.querySelectorAll('label');
    labels[1].classList.add('right'); labels[1].append(mk('span', 'res', 'Right answer'));
    labels[2].classList.add('wrong'); labels[2].append(mk('span', 'res', 'Your answer'));
    $('quiz-cc').append(quiz.el);
    renderLeaderboard($<HTMLOListElement>('board'), [{ name: 'Anne', points: 11, answered: 12 }, { name: 'Morten', points: 9, answered: 12 }, { name: 'Jens', points: 9, answered: 10 }, { name: 'Line', points: 6, answered: 7 }], 12, 'Morten');
  }
</script>
