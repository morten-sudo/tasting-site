  // ================= Helpers =================
  let NAMES = new Map<string, string>();
  /** 'le-mesnil-sur-oger' → 'Le-Mesnil-sur-Oger' (areas that are on no list and have no title) */
  const prettyId = (id: string) => id.split('-').map((p, i) => (i && /^(sur|de|du|des|la|le|les|d|en|di|del|della)$/.test(p) ? p : p[0].toUpperCase() + p.slice(1))).join('-');
  const nameOf = (map: RegionMap, id: string) => NAMES.get(id) ?? map.areas[id]?.title ?? prettyId(id);
  /** Draws a part when it comes near the screen (the page has many maps) */
  const lazy = (el: HTMLElement, draw: () => Promise<void> | void) => {
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); Promise.resolve().then(draw).catch((e) => console.error('/dev/maps/', e)); } }, { rootMargin: '600px' });
    io.observe(el);
  };
  /** A map in the one frame, with zoom and the credit line under it */
  const mapFig = (svg: string, caption?: string | Node[], credit?: { sources: string | null; osm?: boolean }) => {
    const fig = mk('figure', 'dv-fig');
    const box = mk('div', 'map-box');
    box.innerHTML = svg;
    fig.append(box);
    if (credit) setMapCredit(box, credit.sources, credit.osm ?? false);
    if (caption) { const c = mk('figcaption'); if (typeof caption === 'string') c.textContent = caption; else c.append(...caption); fig.append(c); }
    requestAnimationFrame(() => mapZoom(box));
    return fig;
  };
  const capt = (bold: string, text: string) => { const b = mk('b', '', bold); return [b, document.createTextNode(` – ${text}`)]; };
  const regionName = (id: string) => DETAILED_MAPS.find((m) => m.id === id)?.name ?? id;
  const HOW: Record<MapHow, string> = {
    area: 'appellation_id → et område på det detaljerede kort',
    regionWide: 'appellation_id på listen, men intet område → hele regionen',
    region: 'kun regionen (ingen appellation på listen) → hele regionen',
    producer: 'producer_lat/lon → producentens nål',
    appellation: 'appellationens punkt fra listen',
    guess: 'Cloudflare AI\'s sted for appellationen',
    regionCentre: 'regionens midte (wine_regions)',
    country: 'kun landet → landets midte',
  };

  // ================= 1. The map types =================
  async function showTypes() {
    const [bdx, douro, bourgogne] = await Promise.all([loadMap('bordeaux'), loadMap('douro'), loadMap('bourgogne')]);
    if (!bdx || !douro || !bourgogne) return;
    // a) drawMap's modes and options
    const counts = new Map([['pauillac', 2], ['margaux', 1], ['saint-emilion-grand-cru', 3]]);
    const titles = new Map([...counts.keys()].map((id) => [id, nameOf(bdx, id)]));
    const pin = [{ lon: -7.268, lat: 41.135, title: 'Quinta do Vesuvio' }];
    $('a-maps').append(
      mapFig(drawMap(bdx, { counts, titles }), capt('full, counts + titles', 'smagningens kort: antal vine pr. område, numre og navne'), { sources: bdx.sources }),
      mapFig(drawMap(bdx, { counts: new Map([['pauillac', 1]]), titles: new Map([['pauillac', nameOf(bdx, 'pauillac')]]), badges: false }), capt('badges: false', 'én vins kort: området fyldt og navngivet, uden nummer'), { sources: bdx.sources }),
      mapFig(drawMap(douro, { wholeRegion: true }), capt('wholeRegion', 'hele regionen svagt (Porto), underområderne med versaler'), { sources: douro.sources }),
      mapFig(drawMap(douro, { wholeRegion: true, pins: pin }), capt('pins', 'producentens nål oven på kortet'), { sources: douro.sources, osm: true }),
    );
    // b) the overview map: Europe and the world, numbered pins, the inset, detail tiles
    const places = (await Promise.all([
      { appellation: 'Porto', appellation_id: 'porto', country: 'PT' }, { appellation: 'Pauillac', appellation_id: 'pauillac', country: 'FR' },
      { appellation: 'Barolo', appellation_id: 'barolo', country: 'IT' }, { appellation: 'Rioja', appellation_id: 'rioja', country: 'ES' },
    ].map((x) => placeOf(x)))).filter((p): p is Place => !!p);
    const far = (await Promise.all([{ appellation_id: 'napa-valley', country: 'US' }, { appellation_id: 'barossa-valley', country: 'AU' }, { appellation_id: 'stellenbosch', country: 'ZA' }, { appellation_id: 'porto', country: 'PT' }]
      .map((x) => placeOf(x)))).filter((p): p is Place => !!p);
    const [eu, world] = await Promise.all([loadOverview('europe'), loadOverview('world')]);
    if (eu && places.length) {
      const focus = await focusFor(places);
      $('b-maps').append(mapFig(drawOverview(eu, places.map((p, i) => ({ lon: p.lon, lat: p.lat, n: i + 1, label: p.label })), focus, 'full'),
        capt('europe, full', 'nummererede nåle med navne – som gæstens forside og smagningen uden detaljeret kort'), { sources: OVERVIEW_SOURCES }));
      const one = places[0];
      const f1 = await focusFor([one], true);
      const m = Math.max(f1.lon1 - f1.lon0, f1.lat1 - f1.lat0) * 0.35;
      const detail = await loadDetail({ lon0: f1.lon0 - m, lat0: f1.lat0 - m, lon1: f1.lon1 + m, lat1: f1.lat1 + m });
      $('b-maps').append(mapFig(drawOverview(eu, [{ lon: one.lon, lat: one.lat, label: one.label }], f1, 'full', detail),
        capt('full + loadDetail()', 'tæt på ét sted med de detaljerede fliser – som én vins kort'), { sources: OVERVIEW_SOURCES }));
      const fr = places.filter((p) => p.country === 'FR');
      const ffr = await focusFor(fr);
      $('b-maps').append(mapFig(drawOverview(eu, fr.map((p) => ({ lon: p.lon, lat: p.lat })), ffr, 'inset'), capt('inset', 'det lille kort ved "Anden region" (her i fuld bredde; på siden 9rem)'), { sources: OVERVIEW_SOURCES }));
    }
    if (world && far.length) {
      const focus = await focusFor(far);
      $('b-maps').append(mapFig(drawOverview(world, far.map((p, i) => ({ lon: p.lon, lat: p.lat, n: i + 1, label: p.label })), focus, 'full'),
        capt('world, full', 'når et sted ligger uden for Europa'), { sources: OVERVIEW_SOURCES }));
    }
    // c) one wine's map: the three ways it goes
    for (const [label, wine] of [
      ['area', w('Pauillac', null, 'Pauillac', 'Bordeaux', 'FR')], ['regionWide', w('Porto', null, 'Porto', 'Douro', 'PT')], ['appellation', w('Sancerre', null, 'Sancerre', 'Loire', 'FR')],
    ] as const) {
      const m = await wineMap(wine);
      if (!m) continue;
      const fig = mapFig(m.svg, capt(`how: ${m.how}`, `formularen: "${t(`wineMap.${m.how}` as Parameters<typeof t>[0])}"`));
      showMapCredit(fig.querySelector<HTMLElement>('.map-box')!, m);
      fig.dataset.case = label;
      $('c-maps').append(fig);
    }
    // d) the faint backgrounds, in a card as on the dashboards
    const bgCard = (caption: (string | Node)[], fill: (box: HTMLElement) => Promise<void> | void, left = false) => {
      const fig = mk('figure', 'dv-fig');
      const card = mk('div', 'card has-map-bg dv-bg');
      const box = mk('div', left ? 'hero-bg left' : 'hero-bg');
      box.setAttribute('aria-hidden', 'true');
      card.append(box);
      const c = mk('figcaption');
      c.append(...caption);
      fig.append(card, c);
      $('d-maps').append(fig);
      fill(box);
    };
    bgCard(capt('fillMapBackgrounds()', 'en fast region, hele regionen fyldt (data-map-bg="bourgogne", tilmeldingen)'), async (box) => { box.dataset.mapBg = 'bourgogne'; await fillMapBackgrounds(box.parentElement!); });
    bgCard(capt('pageBackground()', 'samme tegning, regionen valgt ud fra sidens adresse (Base.astro)'), (box) => { box.innerHTML = drawMap(bourgogne, { mode: 'background', wholeRegion: true }); });
    bgCard(capt('winesBackground(…, corner)', 'næste smagnings vine, i hjørnet (forsiderne)'), (box) => winesBackground(box,
      [{ id: 1, region: 'Bordeaux', appellation: 'Pauillac', appellation_id: 'pauillac' }, { id: 2, region: 'Bordeaux', appellation: 'Margaux', appellation_id: 'margaux' }, { id: 3, region: 'Bordeaux', appellation: null, appellation_id: 'saint-emilion-grand-cru' }], true));
    bgCard(capt('#hero-map', 'bag smagningens titel: vinenes områder fyldt'), (box) => { box.innerHTML = drawMap(bdx, { mode: 'background', counts }); });
    // e) the tasting's origins
    $('e-demo').append(originsDemo(TASTINGS[0]));
    // g) the credit line's variants
    for (const [sources, osm] of [[douro.sources, false], [bdx.sources, true], [OVERVIEW_SOURCES, false]] as const) {
      const holder = mk('div');
      const box = mk('div');
      holder.append(box);
      setMapCredit(box, sources, osm);
      box.remove();
      $('g-lines').append(holder);
    }
  }

  /** A tasting's "Where the wines come from", drawn by the real showOrigins(); the background behind the title in a card */
  function originsDemo(x: (typeof TASTINGS)[number]) {
    const wrap = mk('div', 'card dv-ex dv-origin');
    wrap.append(sectionTitle('h3', x.title, 'h3'), mk('p', 'dv-wine', x.wines.map((v, i) => `${i + 1}. ${v.name}`).join(' · ')));
    const block = mk('section');
    block.hidden = true;
    const box = mk('div', 'map-box origin-map'), legend = mk('ul', 'map-legend'), credit = mk('p', 'map-credit');
    block.append(box, legend, credit);
    const bgFig = mk('figure', 'dv-fig');
    const card = mk('div', 'card has-map-bg dv-bg');
    const hero = mk('div', 'hero-bg');
    card.append(hero);
    const c = mk('figcaption');
    c.append(...capt('#hero-map', 'baggrunden bag smagningens titel'));
    bgFig.append(card, c);
    wrap.append(block, bgFig, mk('p', '', x.note));
    const wines: MapWine[] = x.wines.map((v, i) => ({ id: 1000 + i, sort_order: i + 1, ...v }));
    lazy(wrap, () => showOrigins(wines, { hero, block, box, legend, credit }));
    return wrap;
  }

  // ================= 2. The structure of each detailed map =================
  async function showStructure() {
    const apps = await loadAppellations();
    $('s2-toc').append(...DETAILED_MAPS.map((m) => Object.assign(mk('a', '', m.name), { href: `#r-${m.id}` })));
    for (const meta of DETAILED_MAPS) {
      const sec = mk('section', 'dv-region');
      sec.id = `r-${meta.id}`;
      sec.append(sectionTitle('h3', `${meta.name} · ${countryName(meta.country) ?? meta.country}`, 'h3'));
      $('s2-maps').append(sec);
      lazy(sec, async () => {
        const map = await loadMap(meta.id);
        if (!map) return;
        const facts = areaFacts(map);
        const onList = new Set(apps.map((a) => a.id));
        const kind = (id: string) => (onList.has(id) ? 'Appellation' : map.areas[id].title ? 'Underområde' : 'Ikke på listen');
        const names = new Map(Object.keys(map.areas).map((id) => [id, nameOf(map, id)]));
        const help = mk('p', 'help', `public/maps/${map.id}.json · ${Object.keys(map.areas).length} områder · ${map.w} × ${map.h}`);
        const top = mk('div', 'dv-region-top');
        const side = mk('div');
        const nSub = Object.keys(map.areas).filter((id) => kind(id) === 'Underområde').length;
        const nApp = Object.keys(map.areas).filter((id) => kind(id) === 'Appellation').length;
        const nOff = Object.keys(map.areas).length - nSub - nApp;
        const nOver = facts.filter((f) => f.within.length || f.same.length || f.overlaps.length).length;
        const line = (label: string, text: string) => { const p = mk('p'); p.append(mk('b', '', `${label}: `), text); return p; };
        // Appellations of the region on the list that have no area: they light the whole region
        const regionApps = apps.filter((a) => mapIdFor(a.region) === map.id && !map.areas[a.id]).map((a) => a.name);
        side.append(
          line('Områder', `${nApp} appellationer, ${nSub} underområder${nOff ? `, ${nOff} ikke på appellationslisten (kan aldrig fyldes)` : ''}.`),
          line('Overlap', nOver ? `${nOver} af områderne ligger i, dækker eller overlapper et andet.` : 'Ingen – områderne ligger side om side.'),
          line('Hele regionen (whole)', `${map.whole.join(', ')} – står i filen, men læses ikke af koden.`),
          line('Lyser hele regionen i dag', regionApps.length ? `${regionApps.join(', ')} (på listen, intet område)` : 'ingen appellationer på listen uden område'),
          line('Kilder', map.sources),
        );
        top.append(mapFig(drawProposal(map, { names })), side);
        type Row = (typeof facts)[number] & { name: string; kind: string };
        const rows: Row[] = facts.map((f) => ({ ...f, name: names.get(f.id)!, kind: kind(f.id) }));
        const list = (ids: string[]) => ids.map((id) => names.get(id) ?? id).join(', ');
        const rel = (r: Row) => {
          const out: string[] = [];
          if (r.same.length) out.push(`samme område som ${list(r.same)}`);
          if (r.within.length) out.push(`ligger i ${list(r.within)}`);
          if (r.contains.length) out.push(`indeholder ${list(r.contains)}`);
          if (r.overlaps.length) out.push(`overlapper ${r.overlaps.map((o) => `${names.get(o.id)} (${Math.round(o.share * 100)} %)`).join(', ')}`);
          return out.join(' · ') || '–';
        };
        const tbl = table<Row>({
          caption: `${map.name}: områder`, rows, sort: { key: 'share', desc: true },
          columns: [
            { key: 'name', label: 'Område', sort: (r) => r.name },
            { key: 'id', label: 'Id', cell: (r) => mk('code', '', r.id), sort: (r) => r.id, wideOnly: true },
            { key: 'kind', label: 'Slags', cell: (r) => chip(r.kind, r.kind === 'Underområde' ? 'wait' : r.kind === 'Appellation' ? 'neutral' : 'warn', { dashed: r.kind === 'Ikke på listen' }), sort: (r) => r.kind },
            { key: 'share', label: 'Andel', num: true, nowrap: true, cell: (r) => (r.share < 0.005 ? '< 1 %' : `${Math.round(r.share * 100)} %`), sort: (r) => r.share, desc: true },
            { key: 'rel', label: 'Forhold til andre områder', cell: rel },
          ],
        });
        sec.append(help, top, tbl.el);
      });
    }
  }

  // ================= 3. The proposal =================
  const PROPOSALS: { title: string; wine: Wine; mid?: string[]; label?: string; note: string }[] = [
    { title: 'Pauillac', wine: w('Château Pichon Baron 2016', null, 'Pauillac', 'Bordeaux', 'FR'), mid: ['haut-medoc'],
      note: 'Bordeaux, Pauillac mørk, Haut-Médoc i mellemtone. Kortet tegner Haut-Médoc uden Pauillac (et hul), så mellemtonen sættes her med hånden – geometrien alene finder den ikke.' },
    { title: 'Saint-Émilion Grand Cru', wine: w('Château Chauvin 2020', null, 'Saint-Émilion Grand Cru', 'Bordeaux', 'FR'),
      note: 'Bordeaux, Saint-Émilion Grand Cru mørk. Kortets område "Saint-Émilion" har samme form, så der er intet større område til mellemtonen.' },
    { title: 'Porto', wine: w('Quinta do Noval LBV 2018', null, 'Porto', 'Douro', 'PT'), label: 'Porto',
      note: 'Hele Douro. Underområdet er ukendt, så alle tre er lyse, og navnet "Porto" står over kortet.' },
    { title: 'Barolo, Bricco San Pietro', wine: w('Barolo Bricco San Pietro 2022', 'Broccardo', 'Barolo', 'Piemonte', 'IT'),
      note: 'Dagens Piemonte-kort med Barolo mørk. "Hele Barolo med sine 11 comuni, Monforte d\'Alba mørk" kræver kommunegrænser, som sitet ikke har endnu.' },
    { title: 'Rivesaltes', wine: w('Rivesaltes Ambré 1966', 'Domaine Cazes', 'Rivesaltes', 'Roussillon', 'FR'),
      note: 'Roussillon, Rivesaltes mørk. Det dækker det meste af regionen, så kortet bliver næsten helt mørkt – her ses, at niveauerne er blandet.' },
  ];

  /** The proposal for a wine: dark = its appellation's area, middle = the areas that contain it, else all light with a name */
  async function proposalFor(wine: Wine, opts: { mid?: string[]; label?: string } = {}) {
    const mapId = mapIdFor(wine.region);
    const map = mapId ? await loadMap(mapId) : null;
    if (!map) return null;
    const apps = await loadAppellations();
    const id = wine.appellation_id ?? (wine.appellation ? matchAppellation(apps, wine.appellation)?.id ?? null : null);
    const inMap = !!(id && map.areas[id]);
    const pins = wine.producer_lat != null && wine.producer_lon != null ? [{ lon: wine.producer_lon, lat: wine.producer_lat, title: wine.producer ?? '' }] : [];
    const mid = inMap ? opts.mid ?? containersOf(map, id!) : [];
    const label = inMap ? undefined : opts.label ?? (id ? apps.find((a) => a.id === id)?.name : null) ?? wine.appellation ?? map.name;
    return { svg: drawProposal(map, { dark: inMap ? [id!] : [], mid, label, darkName: inMap ? nameOf(map, id!) : undefined, pins }), sources: map.sources,
      mid: mid.map((m) => nameOf(map, m)), osm: pins.length > 0 };
  }

  function showProposals() {
    $('s3-chip').append(chip('Forslag – ikke besluttet', 'warn'));
    const swatch = (cls: string, text: string) => {
      const s = mk('span');
      s.innerHTML = `<svg class="region-map proposal" viewBox="0 0 32 20" aria-hidden="true"><rect class="mp-fill ${cls}" x="1" y="1" width="30" height="18"/><rect class="mp-line ${cls}" x="1" y="1" width="30" height="18"/></svg>`;
      s.append(text);
      return s;
    };
    $('s3-tones').append(swatch('is-dark', 'Mørk: vinens laveste kendte område'), swatch('is-mid', 'Mellem: områder der indeholder det'), swatch('is-light', 'Lys: resten af regionen'));
    for (const p of PROPOSALS) {
      const card = mk('article', 'card dv-ex');
      card.append(sectionTitle('h3', p.title, 'h3'), mk('p', 'dv-wine', [p.wine.name, p.wine.appellation, p.wine.region].filter(Boolean).join(' · ')));
      const pair = mk('div', 'dv-pair');
      card.append(pair, mk('p', '', p.note));
      $('s3-cases').append(card);
      lazy(card, async () => {
        const [today, prop] = await Promise.all([wineMap(p.wine), proposalFor(p.wine, p)]);
        if (today) { const f = mapFig(today.svg, capt('I dag', `wineMap(), how: ${today.how}`)); showMapCredit(f.querySelector<HTMLElement>('.map-box')!, today); pair.append(f); }
        if (prop) pair.append(mapFig(prop.svg, capt('Forslag', prop.mid.length ? `mellemtone: ${prop.mid.join(', ')}` : 'ingen mellemtone'), { sources: prop.sources, osm: prop.osm }));
      });
    }
  }

  // ================= 4. Examples per country =================
  function showExamples() {
    const groups = EXAMPLES.map((g) => ({ ...g, title: g.title ?? countryName(g.country) ?? g.country }));
    $('s4-toc').append(...groups.map((g) => Object.assign(mk('a', '', g.title), { href: `#c-${g.country}` })),
      Object.assign(mk('a', '', 'Flere regioner'), { href: '#c-tastings' }));
    for (const g of groups) {
      const sec = mk('section', g.items.length > 1 ? 'dv-country wide' : 'dv-country');
      sec.id = `c-${g.country}`;
      const cards = mk('div', 'dv-cards');
      sec.append(sectionTitle('h3', g.title, 'h3'), cards);
      $('s4-groups').append(sec);
      for (const ex of g.items) cards.append(exampleCard(g.country === 'other' || g.country === 'none' ? `${countryName(ex.wine.country) ?? 'Intet land'} · ${ex.case}` : ex.case, ex));
    }
    const sec = mk('section', 'dv-country wide');
    sec.id = 'c-tastings';
    const cards = mk('div', 'dv-cases');
    sec.append(sectionTitle('h3', 'Smagninger med vine fra flere regioner', 'h3'),
      mk('p', '', 'Smagningens kort "Hvor vinene kommer fra", tegnet af showOrigins() som på smagningens side. Det lille kort ved "Anden region" er det, Morten finder forvirrende.'), cards);
    cards.append(...TASTINGS.map(originsDemo));
    $('s4-groups').append(sec);
  }

  function exampleCard(heading: string, ex: Example) {
    const card = mk('article', 'card dv-ex');
    const v = ex.wine;
    const data = [v.appellation && `appellation: ${v.appellation}`, v.region && `region: ${v.region}`, v.country && `land: ${v.country}`,
      v.producer_lat != null && `nål: ${v.producer_lat}, ${v.producer_lon}`].filter(Boolean).join(' · ');
    card.append(sectionTitle('h3', heading, 'h3'), mk('p', 'dv-wine', `${v.name}${v.producer ? ` (${v.producer})` : ''}`), mk('p', 'dv-how', data || 'ingen oprindelse'));
    const pair = mk('div', 'dv-pair');
    const how = mk('p', 'dv-how');
    card.append(pair, how, mk('p', '', ex.note));
    lazy(card, async () => {
      const [m, prop] = await Promise.all([wineMap(v), proposalFor(v, { mid: ex.mid })]);
      if (!m) {
        pair.append(mk('div', 'dv-nomap', 'Intet kort'));
        how.textContent = 'wineMap() → null';
        return;
      }
      const detailed = mapIdFor(v.region);
      let type = detailed && m.svg.includes('class="region-map full"') ? `detaljeret kort: ${regionName(detailed)}` : '';
      if (!type) {
        const apps = await loadAppellations();
        const place = await placeOf({ ...v, appellation_id: v.appellation_id ?? (v.appellation ? matchAppellation(apps, v.appellation)?.id ?? null : null) });
        type = `oversigtskort: ${place && overviewFor([place]) === 'world' ? 'verden' : 'Europa'}${m.svg.includes('fill-rule="evenodd"') ? ' med detaljefliser' : ''}`;
      }
      how.textContent = `${type} · how: ${m.how} – ${HOW[m.how]}`;
      const f = mapFig(m.svg, capt('I dag', 'wineMap()'));
      showMapCredit(f.querySelector<HTMLElement>('.map-box')!, m);
      pair.append(f);
      if (prop) pair.append(mapFig(prop.svg, capt('Forslag', prop.mid.length ? `mellemtone: ${prop.mid.join(', ')}` : 'ingen mellemtone'), { sources: prop.sources, osm: prop.osm }));
    });
    return card;
  }

  // ================= Start =================
  const host = await requireHost();
  if (host) {
    $('admin-main').hidden = false;
    NAMES = new Map((await loadAppellations()).map((a) => [a.id, a.name]));
    showTypes();
    showStructure();
    showProposals();
    showExamples();
  }
</script>
