---
import Base from '../layouts/Base.astro';
import { EVENT } from '../lib/config';
---
<Base title="Profil">
  <section class="wrap page">
    <p id="loading" class="hint">Henter din profil …</p>

    <div id="invalid" class="message error" hidden>
      <p><strong>Du er ikke logget ind.</strong></p>
      <p>
        <a href="/log-ind/">Log ind</a> med din e-mail eller med linket fra din
        invitation. Virker det ikke, så skriv til værten.
      </p>
    </div>

    <!-- Første gang: e-mail skal angives, før man kommer videre -->
    <form id="email-step" class="email-step" hidden novalidate>
      <h1 class="greeting">Velkommen, <span id="step-name"></span></h1>
      <p class="lead">Før du går videre, skal vi have din e-mail. Den bruges til at logge ind med et link på mail – fx hvis du skifter telefon.</p>
      <label for="step-email">Din e-mail</label>
      <input id="step-email" type="email" autocomplete="email" inputmode="email" maxlength="200" required />
      <p id="step-error" class="message error" hidden></p>
      <button class="btn" type="submit" id="step-btn">Fortsæt</button>
    </form>

    <div id="invite" hidden>
      <h1 class="greeting">Hej <span id="guest-name"></span></h1>
      <p class="when">
        {EVENT.dateLong} {EVENT.time}{EVENT.place && <><span aria-hidden="true"> · </span>{EVENT.place}</>}
      </p>

      <p id="current" class="status" role="status" hidden></p>


      <form id="rsvp-form" class="rsvp" novalidate>
        <fieldset class="seg-row">
          <legend>Kommer du?</legend>
          <div class="seg">
            <label><input type="radio" name="attending" value="yes" required /><span>Ja</span></label>
            <label><input type="radio" name="attending" value="no" /><span>Nej</span></label>
          </div>
        </fieldset>

        <div class="field">
          <label for="email">E-mail</label>
          <input id="email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="200" required aria-describedby="email-hint" />
          <p id="email-hint" class="field-hint">Til login med link på mail.</p>
        </div>

        <details id="note-box" class="note">
          <summary>Besked til værten</summary>
          <textarea id="note" name="note" maxlength="1000" aria-label="Besked til værten"></textarea>
        </details>

        <p id="form-error" class="message error" hidden></p>

        <div class="actions">
          <button type="submit" class="btn btn-small" id="submit">Gem</button>
          <span class="hint">Du kan ændre dit svar, så længe tilmeldingen er åben.</span>
        </div>
      </form>

      <section id="fee" class="fee" hidden>
        <h2>Betaling for smagningen</h2>
        <p id="fee-paid" class="message ok" hidden>Tak, din betaling for smagningen er modtaget.</p>
        <div id="fee-due" hidden>
          <p>Prisen for aftenen er fundet ud fra indkøb og antal gæster.</p>
          <div id="fee-pay"></div>
        </div>
      </section>
    </div>
  </section>
</Base>

<script>
  import { supabase, getGuestCode } from '../lib/supabase';
  import { EVENT } from '../lib/config';
  import { payBox } from '../lib/pay';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const code = getGuestCode();
  const form = $<HTMLFormElement>('rsvp-form');
  const current = $('current');
  const formError = $('form-error');
  const submit = $<HTMLButtonElement>('submit');

  let guestName = '';

  function showCurrent(status: string) {
    if (status === 'yes') {
      current.textContent = 'Du er tilmeldt. Vi ses!';
      current.dataset.state = 'yes';
      current.hidden = false;
    } else if (status === 'no') {
      current.textContent = 'Du har meldt fra.';
      current.dataset.state = 'no';
      current.hidden = false;
    } else {
      current.hidden = true;
    }
  }

  async function loadFee() {
    const { data } = await supabase.rpc('get_tasting_payment', { code });
    const row = Array.isArray(data) ? data[0] : null;
    const amount = row ? Number(row.amount) : 0;
    $('fee').hidden = !row || amount <= 0;
    if (!row || amount <= 0) return;
    $('fee-paid').hidden = !row.paid;
    $('fee-due').hidden = row.paid;
    if (!row.paid) $('fee-pay').replaceChildren(payBox(amount, `Portvin smagning ${guestName}`));
  }

  async function load() {
    if (!code) {
      $('loading').hidden = true;
      $('invalid').hidden = false;
      return;
    }
    const { data, error } = await supabase.rpc('get_invite', { code });
    $('loading').hidden = true;
    const row = Array.isArray(data) ? data[0] : null;
    if (error || !row) {
      $('invalid').hidden = false;
      return;
    }
    guestName = row.name;
    $('guest-name').textContent = row.name;
    if (row.status === 'yes' || row.status === 'no') {
      (form.querySelector(`input[value="${row.status}"]`) as HTMLInputElement).checked = true;
    }
    $<HTMLTextAreaElement>('note').value = row.note ?? '';
    ($('note-box') as HTMLDetailsElement).open = !!row.note;
    $<HTMLInputElement>('email').value = row.email ?? '';
    showCurrent(row.status);
    if (!row.email) {
      $('step-name').textContent = row.name;
      $('email-step').hidden = false;
      $<HTMLInputElement>('step-email').focus();
      return;
    }
    showProfile();
  }

  function showProfile() {
    $('email-step').hidden = true;
    $('invite').hidden = false;
    loadFee();
  }

  const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

  $('email-step').addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('step-error');
    err.hidden = true;
    const val = $<HTMLInputElement>('step-email').value.trim();
    if (!EMAIL_RE.test(val)) {
      err.textContent = val ? 'E-mailen ser ikke rigtig ud. Ret den, og prøv igen.' : 'Skriv din e-mail for at fortsætte.';
      err.hidden = false;
      return;
    }
    const btn = $<HTMLButtonElement>('step-btn');
    btn.disabled = true;
    btn.textContent = 'Gemmer …';
    const { error } = await supabase.rpc('set_my_email', { code, e: val });
    btn.disabled = false;
    btn.textContent = 'Fortsæt';
    if (error) {
      err.textContent = error.message.includes('bruges allerede')
        ? 'Den e-mail er allerede knyttet til en anden gæst. Brug en anden, eller skriv til værten.'
        : error.message.includes('Ugyldig')
        ? 'E-mailen ser ikke rigtig ud. Ret den, og prøv igen.'
        : 'E-mailen blev ikke gemt. Tjek din forbindelse, og prøv igen.';
      err.hidden = false;
      return;
    }
    $<HTMLInputElement>('email').value = val.toLowerCase();
    showProfile();
    window.scrollTo({ top: 0 });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.hidden = true;
    const choice = (form.elements.namedItem('attending') as RadioNodeList).value;
    if (!choice) {
      formError.textContent = 'Vælg, om du kommer eller ej.';
      formError.hidden = false;
      return;
    }
    const emailVal = $<HTMLInputElement>('email').value.trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(emailVal)) {
      formError.textContent = emailVal ? 'E-mailen ser ikke rigtig ud. Ret den, og prøv igen.' : 'Skriv din e-mail.';
      formError.hidden = false;
      $<HTMLInputElement>('email').focus();
      return;
    }
    submit.disabled = true;
    submit.textContent = 'Sender …';
    const attending = choice === 'yes';
    const mail = await supabase.rpc('set_my_email', { code, e: emailVal });
    if (mail.error) {
      submit.disabled = false;
      submit.textContent = 'Gem';
      formError.textContent = mail.error.message.includes('bruges allerede')
        ? 'Den e-mail er allerede knyttet til en anden gæst.'
        : mail.error.message.includes('Ugyldig')
        ? 'E-mailen ser ikke rigtig ud. Ret den, og prøv igen.'
        : 'Dit svar blev ikke gemt. Tjek din forbindelse og prøv igen.';
      formError.hidden = false;
      return;
    }
    const { data, error } = await supabase.rpc('respond_invite', {
      code,
      attending,
      diet: null,
      note: $<HTMLTextAreaElement>('note').value,
    });
    submit.disabled = false;
    submit.textContent = 'Gem';
    if (error) {
      formError.textContent = error.message.includes('lukket')
        ? 'Tilmeldingen er lukket. Skriv til værten, hvis du skal ændre noget.'
        : 'Dit svar blev ikke gemt. Tjek din forbindelse og prøv igen.';
      formError.hidden = false;
      return;
    }
    showCurrent(data as string);
    current.textContent = 'Gemt. ' + current.textContent;
    current.classList.remove('flash');
    void current.offsetWidth;
    current.classList.add('flash');
    loadFee();
  });

  load();
</script>

<style>
  .page { padding-top: 2rem; padding-bottom: 2rem; max-width: 34rem; }
  .greeting {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.2rem, 9vw, 3rem);
    line-height: 1;
    margin: 0 0 0.35rem;
  }
  .when { color: var(--muted); margin: 0 0 1.25rem; }
  .lead { margin-bottom: 1rem; }

  /* Første gang: e-mail */
  .email-step { display: grid; gap: 0.6rem; max-width: 28rem; }
  .email-step .btn { justify-self: start; margin-top: 0.3rem; }

  /* Status: en enkelt linje med en prik */
  .status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.5rem;
    font-size: 0.98rem;
  }
  .status::before {
    content: '';
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--ok);
  }
  .status[data-state='no']::before { background: var(--muted); }
  .status.flash { animation: flash 0.6s ease-out; }
  @keyframes flash { from { color: var(--amber); } }

  /* Betaling */
  .fee {
    border: 1px solid var(--lodge-3);
    border-radius: 0.75rem;
    padding: 0.9rem 1rem;
    margin-top: 2rem;
  }
  .fee h2 { font-family: var(--body); font-size: 1rem; font-weight: 600; margin: 0 0 0.3rem; }
  .fee #fee-paid { margin: 0; padding: 0; background: none; border: 0; color: var(--ok); }
  .fee #fee-due p { font-size: 0.92rem; color: var(--muted); }

  /* Formularen */
  .rsvp { display: grid; gap: 1.25rem; }
  .seg-row {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .seg-row legend { float: left; padding: 0; font-weight: 600; }
  .seg {
    display: inline-flex;
    padding: 0.2rem;
    border: 1px solid var(--lodge-3);
    border-radius: 999px;
  }
  .seg label { margin: 0; font-weight: 400; cursor: pointer; }
  .seg input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .seg span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: 999px;
    color: var(--muted);
    transition: background-color 0.15s, color 0.15s;
  }
  .seg label:hover span { color: var(--paper); }
  .seg input:checked + span { background: var(--amber); color: var(--lodge); font-weight: 600; }
  .seg input:focus-visible + span { outline: 2px solid var(--amber); outline-offset: 2px; }

  .field label { font-size: 0.85rem; color: var(--muted); font-weight: 400; margin-bottom: 0.15rem; }
  #email, #step-email {
    width: 100%;
    font: inherit;
    color: var(--paper);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--lodge-3);
    border-radius: 0;
    padding: 0.45rem 0;
  }
  #email:focus, #step-email:focus { outline: none; border-bottom-color: var(--amber); }
  .field-hint { margin: 0.3rem 0 0; font-size: 0.82rem; color: var(--muted); }

  .note summary {
    cursor: pointer;
    color: var(--amber);
    font-size: 0.95rem;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
  }
  .note summary::-webkit-details-marker { display: none; }
  .note summary::before { content: '+'; font-size: 1.1rem; line-height: 1; }
  .note[open] summary::before { content: '–'; }
  .note textarea { margin-top: 0.4rem; min-height: 4.5rem; }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
  .btn-small { min-height: 2.75rem; padding: 0.75rem 1.4rem; font-size: 1rem; border-radius: 999px; }
  .actions .hint { font-size: 0.85rem; }
  #form-error { margin: 0; }
</style>
