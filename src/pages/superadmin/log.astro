---
// The log for all accounts in one list: hosts, guests, sign-ins and the superadmin's own actions.
import Base from '../../layouts/Base.astro';
import Tabs from '../../components/ui/Tabs.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SuperNav from '../../components/SuperNav.astro';
import '../../styles/admin.css';
---
<Base title="super.log">
  <section class="wrap admin-page">
    <SuperNav active="log">
      <PageHeader title="super.log" />
      <Tabs id="log-filters" label="Log" items={[
            { id: 'all', label: 'super.logFilterAll' }, { id: 'host', label: 'super.logFilterHost' }, { id: 'guest', label: 'super.logFilterGuest' },
            { id: 'login', label: 'super.logFilterLogin' }, { id: 'admin', label: 'super.logFilterAdmin' }]} current="all" />
      <div id="log"></div>
    </SuperNav>
  </section>
</Base>

<script>
  import { tabs } from '../../lib/ui/tabs';
  import { chip } from '../../lib/ui/status';
  import { supabase } from '../../lib/supabase';
  import { t, i18nReady, type Key } from '../../i18n';
  import { requireAdmin, $, mk, timeFmt, tenantUrl } from '../../lib/super-common';
  import { table } from '../../lib/ui/table';
  import { eventText, eventGroup, GROUP_TONE } from '../../lib/super-events';

  type Ev = { at: string; kind: string; actor: string | null; tenant_id: string | null; tenant: string | null; detail: Record<string, unknown> };
  const GROUP: Record<string, Key> = { host: 'super.logFilterHost', guest: 'super.logFilterGuest', login: 'super.logFilterLogin', admin: 'super.logFilterAdmin' };
  const time = timeFmt();
  let kind = '';

  // The one table (24), newest first; the kind as a chip
  await i18nReady;
  const list = table<Ev>({
    caption: t('super.log'),
    empty: { icon: 'info', title: t('super.logNone') },
    columns: [
      { key: 'at', label: t('super.logWhen'), nowrap: true, cell: (e) => time.format(new Date(e.at)) },
      { key: 'kind', label: t('super.kind'), cell: (e) => { const g = eventGroup(e.kind); return chip(t(GROUP[g] ?? 'super.log'), GROUP_TONE[g] ?? 'neutral'); } },
      { key: 'what', label: t('super.logWhat'), cell: (e) => eventText(e.kind, e.detail) },
      { key: 'tenant', label: t('super.tenant'), cell: (e) => {
        if (!e.tenant_id || !e.tenant) return '—';
        const a = mk('a', '', e.tenant);
        a.href = tenantUrl(e.tenant_id, 'log');
        return a;
      } },
      { key: 'actor', label: t('super.logWho'), cell: (e) => e.actor ?? '' },
    ],
  });
  $('log').replaceChildren(list.el);

  async function load() {
    const { data } = await supabase.rpc('admin_events', { lim: 1000, grp: kind || null });
    list.setRows((data ?? []) as Ev[]);
  }

  // The kinds of entries: the one tab bar (arrow keys move between them)
  tabs($('log-filters'), { onChange: (id) => { kind = id === 'all' ? '' : id; load(); } });

  if (await requireAdmin()) load();
</script>
