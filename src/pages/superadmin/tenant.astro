---
// One tenant: /superadmin/tenants/<slug>/<section>/ (rewritten to this page in public/_redirects). An old link with
// the account's id still works and is replaced by the slug address.
// The parts (hosts, tastings, guests, wines, payments, log) are chosen in the menu on the left.
import Base from '../../layouts/Base.astro';
import Tabs from '../../components/ui/Tabs.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import SuperNav from '../../components/SuperNav.astro';
import Dropdown from '../../components/ui/Dropdown.astro';
import '../../styles/admin.css';
---
<Base title="page.superadmin">
  <section class="wrap admin-page">
    <SuperNav active="tenants">
      <EmptyState id="not-found" icon="search" title="super.notFound" hidden>
        <a class="btn small" href="/superadmin/" data-i18n="super.tenants">All accounts</a>
      </EmptyState>
      <div id="tenant" hidden>
        <PageHeader id="tn-name">
        <div class="tenant-meta">
          <span id="tn-owner"></span>
          <span id="tn-created"></span>
          <span class="tn-plan"><label for="tn-plan-btn" data-i18n="super.plan">Plan</label>
            <Dropdown id="tn-plan" full={false} small options={[{ value: 'free', label: 'Free' }, { value: 'pro', label: 'Pro' }, { value: 'commercial', label: 'Commercial' }]} />
          </span>
        </div>
        </PageHeader>

        <h2 id="sec-title"></h2>

        <section data-sec="hosts" hidden>
          <ul id="hosts" class="list"></ul>
        </section>

        <section data-sec="tastings" hidden>
          <div id="tastings"></div>
        </section>

        <section data-sec="guests" hidden>
          <div id="guests"></div>
        </section>

        <section data-sec="wines" hidden>
          <div id="wines"></div>
        </section>

        <section data-sec="payments" hidden>
          <div id="payments"></div>
        </section>

        <section data-sec="log" hidden>
          <Tabs id="log-filters" label="Log" items={[
            { id: 'all', label: 'super.logFilterAll' }, { id: 'host', label: 'super.logFilterHost' }, { id: 'guest', label: 'super.logFilterGuest' },
            { id: 'login', label: 'super.logFilterLogin' }, { id: 'admin', label: 'super.logFilterAdmin' }]} current="all" />
          <div id="log"></div>
        </section>
        <EmptyState id="none" icon="info" title="super.noRows" hidden />
      </div>
    </SuperNav>
  </section>
</Base>

<script>
  import { formatKr } from '../../lib/ui/kr';
  import { tabs } from '../../lib/ui/tabs';
  import { chip } from '../../lib/ui/status';
  import { getDropdown } from '../../lib/ui/dropdown';
  import { toast } from '../../lib/toast';
  import { supabase } from '../../lib/supabase';
  import { t, type Key } from '../../i18n';
  import { requireAdmin, $, mk, dateFmt, timeFmt, TENANT_SECTIONS, showTenantInMenu, markTenantSection, tenantUrl, rememberTenantSlug } from '../../lib/super-common';
  import { personRow } from '../../lib/ui/list-row';
  import { eventText, eventGroup, GROUP_TONE } from '../../lib/super-events';
  import { styleName } from '../../lib/wines';
  import { table, type Column } from '../../lib/ui/table';
  import { wineThumb } from '../../lib/ui/thumb';

  const m = location.pathname.match(/^\/superadmin\/tenants\/([a-z0-9-]+)\/(?:([a-z]+)\/?)?$/);
  // The address names the account by its slug (or, in an old link, its id); the id is looked up once signed in
  let id = '';
  const date = dateFmt();
  const time = timeFmt();
  const loaded = new Set<string>();
  type Ev = { at: string; kind: string; actor: string | null; detail: Record<string, unknown> };
  let events: Ev[] = [];
  let logKind = '';

  // Switching part without reloading (the menu on the left)
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('#side-tenant a[data-section]');
    if (!a || e.metaKey || e.ctrlKey) return;
    e.preventDefault();
    history.pushState(null, '', a.pathname);
    show(a.dataset.section!);
    window.scrollTo({ top: 0 });
  });
  window.addEventListener('popstate', () => {
    const s = location.pathname.match(/\/tenants\/[a-z0-9-]+\/([a-z]+)\//)?.[1] ?? 'hosts';
    show(s);
  });

  async function show(section: string) {
    const s = TENANT_SECTIONS.find((x) => x.id === section) ?? TENANT_SECTIONS[0];
    $('sec-title').textContent = t(s.label);
    document.querySelectorAll<HTMLElement>('[data-sec]').forEach((el) => { el.hidden = el.dataset.sec !== s.id; });
    markTenantSection(s.id);
    $('none').hidden = true;
    if (!loaded.has(s.id)) { loaded.add(s.id); await LOADERS[s.id](); }
    else $('none').hidden = (counts.get(s.id) ?? 0) > 0;
  }

  // How many rows each part has: none says so (the empty state under the heading)
  const counts = new Map<string, number>();
  const none = (section: string, n: number) => { counts.set(section, n); $('none').hidden = n > 0; };
  /** A part's rows as the one table (24) */
  const fillTable = <R,>(section: string, rows: R[], columns: Column<R>[]) => {
    $(section).replaceChildren(table<R>({ rows, columns, caption: $('sec-title').textContent ?? '' }).el);
    none(section, rows.length);
  };

  const LOADERS: Record<string, () => Promise<void>> = {
    async hosts() {
      const { data } = await supabase.rpc('admin_tenant_members', { tn: id });
      const rows = (data ?? []) as { email: string; name: string | null; owner: boolean; created_at: string }[];
      $('hosts').replaceChildren(...rows.map((r) => personRow({
        name: r.name || r.email, meta: [r.name ? r.email : '', r.created_at ? date.format(new Date(r.created_at)) : ''],
        chips: [r.owner ? { text: t('account.owner'), tone: 'strong' } : { text: t('account.host') }],
      })));
      none('hosts', rows.length);
    },
    async tastings() {
      const { data } = await supabase.rpc('admin_tenant_tastings', { tn: id });
      type R = { slug: string; title: string; starts_at: string | null; created_by: string | null; cohosts: number; invited: number; coming: number; wines: number; orders: number; order_amount: number };
      fillTable<R>('tastings', (data ?? []) as R[], [
        { key: 'title', label: t('admin.title'), sort: (r) => r.title, cell: (r) => { const a = mk('a', '', r.title); a.href = `/t/${r.slug}/admin/`; return a; } },
        { key: 'when', label: t('super.when'), nowrap: true, sort: (r) => r.starts_at ?? '', desc: true, cell: (r) => (r.starts_at ? date.format(new Date(r.starts_at)) : '—') },
        { key: 'created_by', label: t('super.createdBy'), cell: (r) => r.created_by ?? '—' },
        { key: 'cohosts', label: t('super.coHosts'), num: true, sort: (r) => Number(r.cohosts), desc: true },
        { key: 'invited', label: t('super.invited'), num: true, sort: (r) => Number(r.invited), desc: true, cell: (r) => `${r.invited} (${r.coming})` },
        { key: 'wines', label: t('adminNav.wines'), num: true, sort: (r) => Number(r.wines), desc: true },
        { key: 'orders', label: t('admin.orders'), num: true, sort: (r) => Number(r.order_amount), desc: true, cell: (r) => (Number(r.orders) ? `${r.orders} · ${formatKr(r.order_amount)}` : '0') },
      ]);
    },
    async guests() {
      const { data } = await supabase.rpc('admin_tenant_guests', { tn: id });
      type R = { name: string; email: string | null; created_at: string; invitations: number; coming: number; orders: number };
      fillTable<R>('guests', (data ?? []) as R[], [
        { key: 'name', label: t('admin.name'), sort: (r) => r.name },
        { key: 'email', label: t('common.email'), sort: (r) => r.email ?? '', cell: (r) => r.email ?? '—' },
        { key: 'invitations', label: t('super.invitations'), num: true, sort: (r) => Number(r.invitations), desc: true },
        { key: 'coming', label: t('admin.fYes'), num: true, sort: (r) => Number(r.coming), desc: true },
        { key: 'orders', label: t('admin.orders'), num: true, sort: (r) => Number(r.orders), desc: true },
        { key: 'created_at', label: t('super.created'), nowrap: true, sort: (r) => r.created_at, desc: true, cell: (r) => date.format(new Date(r.created_at)) },
      ]);
    },
    async wines() {
      const { data } = await supabase.rpc('admin_tenant_wines', { tn: id });
      type R = { name: string; producer: string | null; vintage: string | null; style: string | null; region: string | null; image_url: string | null; retail_price_dkk: number | null; tastings: number; ratings: number };
      const name = (r: R) => [r.name, r.vintage].filter(Boolean).join(' ');
      fillTable<R>('wines', (data ?? []) as R[], [
        // The wine with its picture (the one thumbnail, 20, small) and its type under the name
        { key: 'name', label: t('admin.name'), sort: (r) => name(r), cell: (r) => {
          const box = mk('span', 'cell-wine');
          const text = mk('span');
          text.append(name(r));
          if (r.style) text.append(mk('p', 'lmeta', styleName(r.style)));
          box.append(wineThumb(r, { size: 'small' }), text);
          return box;
        } },
        { key: 'producer', label: t('admin.producer'), sort: (r) => r.producer ?? '', cell: (r) => r.producer ?? '—' },
        { key: 'region', label: t('origin.region'), sort: (r) => r.region ?? '', cell: (r) => r.region ?? '—' },
        { key: 'retail', label: t('admin.retail'), num: true, sort: (r) => Number(r.retail_price_dkk ?? -1), desc: true, cell: (r) => (r.retail_price_dkk != null ? formatKr(r.retail_price_dkk) : '—') },
        { key: 'tastings', label: t('super.used'), num: true, sort: (r) => Number(r.tastings), desc: true },
        { key: 'ratings', label: t('super.ratings'), num: true, sort: (r) => Number(r.ratings), desc: true },
      ]);
    },
    async payments() {
      const { data } = await supabase.rpc('admin_tenant_payments', { tn: id });
      type R = { kind: string; at: string; tasting: string; guest: string; bottles: number; amount: number; paid: boolean };
      fillTable<R>('payments', (data ?? []) as R[], [
        { key: 'at', label: t('super.when'), nowrap: true, sort: (r) => r.at, desc: true, cell: (r) => date.format(new Date(r.at)) },
        { key: 'kind', label: t('super.kind'), cell: (r) => (r.kind === 'order' ? `${t('super.order')} · ${r.bottles} fl.` : t('super.fee')) },
        { key: 'tasting', label: t('page.tasting'), sort: (r) => r.tasting },
        { key: 'guest', label: t('admin.name'), sort: (r) => r.guest },
        { key: 'amount', label: t('super.amount'), num: true, sort: (r) => Number(r.amount), desc: true, cell: (r) => formatKr(r.amount) },
        { key: 'paid', label: t('super.paid'), sort: (r) => Number(r.paid), cell: (r) => chip(r.paid ? t('super.paid') : t('super.unpaid'), r.paid ? 'ok' : 'err') },
      ]);
    },
    async log() {
      const { data } = await supabase.rpc('admin_tenant_events', { tn: id, lim: 500 });
      events = (data ?? []) as Ev[];
      renderLog();
    },
  };

  function renderLog() {
    fillTable<Ev>('log', events.filter((e) => !logKind || eventGroup(e.kind) === logKind), [
      { key: 'at', label: t('super.logWhen'), nowrap: true, cell: (e) => time.format(new Date(e.at)) },
      { key: 'kind', label: t('super.kind'), cell: (e) => { const g = eventGroup(e.kind); return chip(t(({ host: 'super.logFilterHost', guest: 'super.logFilterGuest', login: 'super.logFilterLogin', admin: 'super.logFilterAdmin' } as Record<string, Key>)[g] ?? 'super.log'), GROUP_TONE[g] ?? 'neutral'); } },
      { key: 'what', label: t('super.logWhat'), cell: (e) => eventText(e.kind, e.detail) },
      { key: 'actor', label: t('super.logWho'), cell: (e) => e.actor ?? '' },
    ]);
  }
  // The kinds of entries: the one tab bar (arrow keys move between them)
  tabs($('log-filters'), { onChange: (id) => { logKind = id === 'all' ? '' : id; renderLog(); } });


  // Start once everything above is defined
  if (await requireAdmin()) {
    if (m?.[1]) id = ((await supabase.rpc('admin_tenant_id', { ref: m[1] })).data as string | null) ?? '';
    const { data } = id ? await supabase.rpc('admin_tenant', { tn: id }) : { data: null };
    if (!data) $('not-found').hidden = false;
    else {
      const tn = data as { slug: string; name: string; plan: string; created_at: string; owner_name: string | null; owner_email: string };
      // An old link (the id) or a renamed account: the address becomes the account's slug
      rememberTenantSlug(id, tn.slug);
      const here = tenantUrl(id, TENANT_SECTIONS.some((s) => s.id === m?.[2]) ? m![2] : 'hosts');
      if (location.pathname !== here) history.replaceState(null, '', here + location.search);
      $('tenant').hidden = false;
      $('tn-name').textContent = tn.name;
      document.title = `${tn.name} – Superadmin`;
      $('tn-owner').textContent = `${t('super.owner')}: ${tn.owner_name ?? ''} <${tn.owner_email}>`;
      $('tn-created').textContent = `${t('super.created')} ${date.format(new Date(tn.created_at))}`;
      // The one dropdown; saved straight away, put back with a message on an error
      const plan = getDropdown('tn-plan');
      plan.value = tn.plan;
      plan.el.addEventListener('change', async () => {
        plan.disabled = true;
        const { error } = await supabase.rpc('admin_set_plan', { tn: id, p: plan.value });
        plan.disabled = false;
        if (error) { plan.value = tn.plan; toast(t('admin.changeNotSaved'), { kind: 'error' }); }
        else { tn.plan = plan.value; loaded.delete('log'); toast(t('common.saved'), { kind: 'ok' }); }
      });
      const section = TENANT_SECTIONS.some((s) => s.id === m?.[2]) ? m![2] : 'hosts';
      showTenantInMenu(id, tn.name, section);
      show(section);
    }
  }
</script>
