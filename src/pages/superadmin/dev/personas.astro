---
// /superadmin/dev/personas/ – the personas as a shared language for all of Winetastr: guests, hosts and commercial
// customers. Tabs: the overview, one tab per group (comparison and scenarios), shop and online, and the comparison
// chart (two measures against each other). One persona opens from a card as #<id> and gets its own view with its
// group's tab chosen. The content follows the deck's persona one-pagers, not its looks.
// The texts are NOT in the repo or the build: after requireAdmin() the page reads the document 'personas' from
// public.dev_docs (only is_admin() can read it) and renders everything from it (types in src/lib/personas.ts).
// For developers and Morten: the superadmin only, in the superadmin menu under Dev, noindex (Base.astro). Danish.
import Base from '../../../layouts/Base.astro';
import SuperNav from '../../../components/SuperNav.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Tabs from '../../../components/ui/Tabs.astro';
import Dropdown from '../../../components/ui/Dropdown.astro';
import '../../../styles/admin.css';
---
<Base title="dev.personas">
  <section class="wrap admin-page">
    <SuperNav active="dev-personas">
    <div class="dv dv-pv">
      <PageHeader title="dev.personas" leadId="pv-lead" />
      <div id="pv-failed" class="empty-state" hidden></div>
      <div id="pv-body" hidden>
        <Tabs id="pv-tabs" label="Personaer" items={[]} />
        <div id="pv-panels"></div>

        <!-- The comparison chart: the two choices are static (their options come from the document) -->
        <section id="panel-sammenstil" role="tabpanel" aria-labelledby="tab-sammenstil" class="dv-panel" hidden>
          <p class="dv-intro" id="pivot-intro"></p>
          <div class="dv-axes">
            <div class="field">
              <label for="ax-x-btn">Vandret</label>
              <Dropdown id="ax-x" />
            </div>
            <div class="field">
              <label for="ax-y-btn">Lodret</label>
              <Dropdown id="ax-y" />
            </div>
          </div>
          <p class="dv-ax" aria-hidden="true">↑ <b id="ax-y-name"></b>: 5 øverst, 1 nederst</p>
          <div class="card dv-plot" id="plot">
            <ul class="dv-pts" id="plot-points" aria-label="Personaerne i sammenstillingen"></ul>
          </div>
          <p class="dv-ax dv-ax-x" aria-hidden="true"><b id="ax-x-name"></b>: 1 til venstre, 5 til højre →</p>
          <ul class="dv-legend" id="plot-legend" aria-label="Grupper"></ul>
        </section>

        <article id="pv-person" class="dv-person" hidden></article>
      </div>
    </div>
    </SuperNav>
  </section>
</Base>

<style is:global>
  /* The page's own layout, as on the other Dev pages (every class starts with dv-) */
  .dv { max-width: 60rem; }
  .dv-pv #pv-tabs { margin-bottom: 1.5rem; }
  .dv-group { margin-top: 2.25rem; }
  .dv-panel > :first-child { margin-top: 0; }
  .dv-panel > .notice + * { margin-top: 1.5rem; }
  .dv-intro { max-width: 46rem; margin: 0 0 1rem; }
  .dv-group > .hint { margin: -0.25rem 0 0.75rem; }
  .dv-points { margin: 0.5rem 0 0; padding-left: 1.2rem; display: grid; gap: 0.7rem; max-width: 46rem; }
  .dv-list { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.35rem; }
  .dv-checked { margin-top: 1rem; }
  .dv-panel > .notice { max-width: 46rem; }
  .dv-panel > .notice:not(:first-child) { margin-top: 1rem; }

  /* The cards: two columns on a large screen, one on a phone */
  .dv-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 0.75rem; }
  .dv-card { display: flex; gap: 1rem; align-items: flex-start; height: 100%; box-sizing: border-box; color: inherit; text-decoration: none; }
  .dv-card-text { display: grid; gap: 0.2rem; min-width: 0; }
  .dv-card .eyebrow { margin: 0; }
  .dv-card-name { font-weight: 600; font-size: 1.1rem; }
  .dv-card-quote { font-family: var(--display); font-style: italic; font-size: 1.2rem; line-height: 1.3; margin-top: 0.25rem; }
  .dv-card-short { color: var(--muted); font-size: 0.92rem; line-height: 1.4; }
  .dv-card .chips { margin-top: 0.5rem; }
  .dv-cards-mini { grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); margin: 0 0 0.5rem; }
  .dv-cards-mini .dv-card { align-items: center; gap: 0.75rem; }
  .dv-cards-mini .dv-card-name { font-size: 1rem; }

  /* Tables: the explanation under a chip */
  .dv-covered { display: grid; justify-items: start; gap: 0.3rem; min-width: 0; }
  .dv-note { display: block; color: var(--muted); font-size: 0.85rem; line-height: 1.35; }
  .dv-phase { color: var(--muted); }

  /* The comparison chart: two choices over a white surface with a cross through the middle */
  .dv-axes { display: grid; grid-template-columns: repeat(2, minmax(0, 14rem)); gap: 0.75rem 1rem; margin-bottom: 1rem; }
  .dv-plot { position: relative; aspect-ratio: 16 / 10; padding: 0; overflow: hidden; }
  .dv-plot::before, .dv-plot::after { content: ''; position: absolute; background: var(--lodge-3); }
  .dv-plot::before { left: 50%; top: 0; bottom: 0; width: 1px; }
  .dv-plot::after { top: 50%; left: 0; right: 0; height: 1px; }
  .dv-ax { margin: 0 0 0.4rem; color: var(--muted); font-size: 0.85rem; }
  .dv-ax b { color: var(--paper); font-weight: 600; }
  .dv-ax-x { margin: 0.4rem 0 0; text-align: right; }
  .dv-pts { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; z-index: 2; }
  /* --x / --y: the point's centre, set by the script (12–88 % of the surface, pushed apart where they would overlap) */
  .dv-pt { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%); transition: left 0.35s ease, top 0.35s ease; }
  .dv-pt a { display: grid; justify-items: center; gap: 0.15rem; padding: 0.2rem; border-radius: var(--radius); color: var(--paper); text-decoration: none; }
  .dv-pt a:hover .av, .dv-pt a:focus-visible .av { background: var(--lodge); }
  .dv-pt a:hover .dv-pt-name { text-decoration: underline; }
  .dv-pt .av { background: var(--lodge-2); }
  .dv-pt-name { font-size: 0.78rem; font-weight: 600; background: rgb(255 255 255 / 0.85); border-radius: 4px; padding: 0 0.2rem; }
  .dv-legend { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin: 0.75rem 0 0; padding: 0; font-size: 0.9rem; }
  .dv-legend li { display: flex; align-items: center; gap: 0.45rem; }
  .dv-legend .av { width: 1.3rem; height: 1.3rem; }
  @media (prefers-reduced-motion: reduce) { .dv-pt { transition: none; } }

  /* One persona */
  .dv-person > .text-btn.back { margin-bottom: 1rem; }
  .dv-who { display: flex; align-items: center; gap: 1.25rem; }
  .dv-who-text { min-width: 0; }
  .admin-page .dv-who h2 { margin: 0.1rem 0 0; font-size: 1.75rem; line-height: 1.2; }
  .dv .dv-who .eyebrow { margin: 0; }
  .dv-who .chips { margin-top: 0.5rem; }
  .dv-person .dv-quote { margin: 1.5rem 0 0; padding: 0; max-width: 44rem; font-family: var(--display); font-style: italic; font-size: 1.75rem; line-height: 1.25; }
  .dv-person p { margin: 0; }
  .admin-page .dv-person :is(section, div) > h3 { margin: 0 0 0.6rem; font-size: 1.05rem; }
  .admin-page .dv-person > h3 { margin: 2rem 0 0.6rem; font-size: 1.05rem; }
  .dv-split { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 1.5rem 2rem; margin-top: 2rem; align-items: start; }
  .dv-story { max-width: 42rem; }
  .dv-facts { margin-top: 1rem; }
  .dv-profile { display: grid; gap: 0.75rem; }
  .dv-bars { display: grid; gap: 0.7rem; }
  .dv-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 2rem; margin-top: 2rem; }
  .dv-person .dv-today-note { margin: -0.3rem 0 0.5rem; }
  .dv-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  .dv-person .dv-steps .eyebrow { margin-bottom: 0.3rem; }
  .dv-last { margin-top: 2rem; }
  .dv-prevnext { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--lodge-3); }

  @media (max-width: 48rem) {
    .dv-cards, .dv-split, .dv-two, .dv-steps, .dv-cards-mini { grid-template-columns: minmax(0, 1fr); }
    .dv-axes { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .dv-covered { justify-items: end; text-align: right; }
    .dv-plot { aspect-ratio: 4 / 5; }
    .dv-who { gap: 1rem; }
    .admin-page .dv-who h2 { font-size: 1.4rem; }
    .dv-person .dv-quote { font-size: 1.4rem; }
  }
</style>

<script>
  import { requireAdmin } from '../../../lib/super-common';
  import { supabase } from '../../../lib/supabase';
  import { $, mk } from '../../../lib/ui/dom';
  import { table } from '../../../lib/ui/table';
  import { chip } from '../../../lib/ui/status';
  import { progress } from '../../../lib/ui/progress';
  import { tabs, selectTab, tabButton } from '../../../lib/ui/tabs';
  import { getDropdown } from '../../../lib/ui/dropdown';
  import { notice } from '../../../lib/ui/notice';
  import { sectionTitle } from '../../../lib/ui/section-title';
  import { facts } from '../../../lib/ui/facts';
  import { textButton } from '../../../lib/ui/text-button';
  import { setEmpty } from '../../../lib/ui/empty';
  import { avatar, type AvatarRing } from '../../../lib/ui/thumb';
  import type { PersonasDoc, Persona, Group, Metric, Scenario, Block, Item } from '../../../lib/personas';

  const RING: Record<Group, AvatarRing> = { guest: 'solid', host: 'double', commercial: 'dashed' };
  const first = (p: Persona) => p.name.split(' ')[0];
  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
  const link = (href: string, ...kids: (string | Node)[]) => { const a = mk('a'); a.href = href; a.append(...kids); return a; };

  let doc: PersonasDoc;
  const inGroup = (g: Group) => doc.personas.filter((p) => p.group === g);
  const groupOf = (g: Group) => doc.groups.find((x) => x.id === g)!;

  // ---------- Small parts ----------
  /** One line: a bold start, the text, a source in brackets at the end */
  function line(it: Item, tag: 'li' | 'p' = 'li') {
    const el = mk(tag);
    if (it.strong) el.append(mk('b', '', it.strong), ' ');
    el.append(it.text);
    if (it.source) {
      const a = link(it.source.url, it.source.label);
      a.target = '_blank';
      a.rel = 'noopener';
      el.append(' (', a, ').');
    }
    return el;
  }
  const list = (items: string[], cls = 'dv-list') => { const ul = mk('ul', cls); ul.append(...items.map((x) => mk('li', '', x))); return ul; };
  function group(title: string, ...kids: (Node | null)[]) {
    const s = mk('section', 'dv-group');
    s.append(sectionTitle('h2', title), ...kids.filter((k): k is Node => !!k));
    return s;
  }

  /** A persona's card: the whole card is a link to the persona's view */
  function card(p: Persona, mini = false) {
    const a = link(`#${p.id}`);
    a.className = 'card dv-card' + (mini ? ' tight' : '');
    const text = mk('span', 'dv-card-text');
    if (mini) text.append(mk('span', 'dv-card-name', `${first(p)}, ${p.age}`), mk('span', 'dv-card-short', p.archetype));
    else {
      const chips = mk('span', 'chips');
      chips.append(...p.roles.map((r) => chip(r)));
      text.append(mk('span', 'eyebrow', p.archetype), mk('span', 'dv-card-name', `${first(p)}, ${p.age}`),
        mk('span', 'dv-card-quote', `”${p.quote}”`), mk('span', 'dv-card-short', p.short), chips);
    }
    a.append(avatar(p.name, { size: mini ? 'normal' : 'large', ring: RING[p.group] }), text);
    const li = mk('li');
    li.append(a);
    return li;
  }
  function cards(g: Group, mini = false) {
    const ul = mk('ul', 'cards dv-cards' + (mini ? ' dv-cards-mini' : ''));
    ul.append(...inGroup(g).map((p) => card(p, mini)));
    return ul;
  }

  /** The blocks of the overview and "shop and online" */
  function block(b: Block): Node[] {
    switch (b.type) {
      case 'notice': return [notice(b.tone ?? 'info', { body: b.items.map((it) => line(it, 'p')) })];
      case 'cards': return doc.groups.map((g) => group(g.label, cards(g.id)));
      case 'list': {
        const l = mk(b.ordered ? 'ol' : 'ul', 'dv-points');
        l.append(...b.items.map((it) => line(it)));
        return [group(b.title, b.hint ? mk('p', 'hint', b.hint) : null, l)];
      }
      case 'status': {
        type R = (typeof b.rows)[number];
        const t = table<R>({
          caption: b.title, rows: b.rows, cls: 'stack',
          columns: [
            { key: 'step', label: b.head[0], cell: (r) => r.step },
            { key: 'status', label: b.head[1], nowrap: true, cell: (r) => chip(r.status, r.done ? 'ok' : 'neutral') },
          ],
        }).el;
        const f = b.facts ? facts(b.facts.map(([label, value]) => ({ label, value })), 'ruled card dv-checked') : null;
        return [group(b.title, t, f)];
      }
      case 'table': {
        type R = string[];
        const t = table<R>({
          caption: b.title, rows: b.rows, cls: 'stack',
          columns: [{ key: 'what', label: 'Hvad', cell: (r) => r[0] }, ...b.head.map((h, i) => ({ key: `c${i}`, label: h, cell: (r: R) => r[i + 1] }))],
        }).el;
        return [group(b.title, t)];
      }
      case 'text': {
        const p = line({ text: b.text, source: b.source }, 'p');
        p.className = 'dv-intro';
        return b.title ? [group(b.title, p)] : [p];
      }
    }
    return [];
  }

  // ---------- One tab per group: the people, the comparison and the scenarios ----------
  function groupPanel(g: Group) {
    const people = inGroup(g);
    type C = { what: string; values: string[] };
    const rows: C[] = (people[0]?.compare ?? []).map(([what], i) => ({ what, values: people.map((p) => p.compare[i]?.[1] ?? '') }));
    const compare = table<C>({
      caption: `${groupOf(g).label} sammenlignet`, rows, cls: 'stack',
      columns: [
        { key: 'what', label: 'Hvad', cell: (r) => r.what },
        ...people.map((p, i) => ({ key: p.id, label: `${first(p)} · ${p.archetype}`, cell: (r: C) => r.values[i] })),
      ],
    }).el;
    const weight = (w: Scenario['weight'][string]) => (w === 'key' ? chip('Afgørende', 'strong') : w === 'use' ? 'Bruger' : '–');
    const COVER = { yes: ['Ja', 'ok'], partly: ['Delvist', 'wait'], no: ['Nej', 'err'] } as const;
    // The chip and its explanation as one piece (on a phone the card puts it right of "Dækket i dag")
    const covered = (s: Scenario) => {
      const box = mk('span', 'dv-covered');
      box.append(chip(COVER[s.covered][0], COVER[s.covered][1]));
      if (s.note) box.append(mk('span', 'dv-note', cap(s.note)));
      return box;
    };
    const scen = table<Scenario>({
      caption: 'Scenarier', rows: doc.scenarios[g] ?? [],
      columns: [
        { key: 'what', label: 'Scenarie', cell: (s) => [mk('span', 'dv-phase', `${s.phase}: `), s.what] },
        ...people.map((p) => ({ key: p.id, label: first(p), cell: (s: Scenario) => weight(s.weight[p.id] ?? null) })),
        { key: 'covered', label: 'Dækket i dag', cell: (s) => covered(s) },
      ],
    }).el;
    const note = groupOf(g).note;
    return [
      ...(note ? [notice('info', { text: note })] : []),
      cards(g, true),
      group('Sammenligning', compare),
      group('Scenarier', mk('p', 'dv-intro', doc.scenarioIntro), scen),
    ];
  }

  // ---------- One persona ----------
  function personView(p: Persona) {
    const g = groupOf(p.group);
    const people = inGroup(p.group);
    const i = people.indexOf(p);
    const el = $('pv-person');
    el.setAttribute('aria-labelledby', 'pv-person-h');

    const head = mk('header', 'dv-who');
    const who = mk('div', 'dv-who-text');
    const h = mk('h2', '', `${p.name}, ${p.age}`);
    h.id = 'pv-person-h';
    const chips = mk('span', 'chips');
    chips.append(...p.roles.map((r) => chip(r)), chip('Antagelse', 'neutral', { dashed: true }));
    who.append(mk('p', 'eyebrow', p.archetype), h, chips);
    head.append(avatar(p.name, { size: 'xl', ring: RING[p.group] }), who);

    const left = mk('div');
    left.append(sectionTitle('h3', 'Kort fortalt'), mk('p', 'dv-story', p.story),
      facts([{ label: 'Personlighed', value: p.personality }, { label: 'Drømmer om', value: p.dreams }, ...p.facts.map(([label, value]) => ({ label, value }))], 'ruled dv-facts') ?? '');
    const profile = mk('div', 'card dv-profile');
    const bars = mk('div', 'dv-bars');
    bars.append(...doc.metrics.map((m) => progress({ label: m.label, value: p.scores[m.id], max: 5, text: `${p.scores[m.id]} af 5`, tone: 'amber', meter: true })));
    profile.append(sectionTitle('h3', 'Profil'), bars, mk('p', 'help', 'Vores vurdering, ikke målt.'));
    const split = mk('div', 'dv-split');
    split.append(left, profile);

    const two = (a: string, aItems: string[], b: string, bItems: string[], aNote?: string) => {
      const box = mk('div', 'dv-two');
      const x = mk('div'), y = mk('div');
      x.append(sectionTitle('h3', a), ...(aNote ? [mk('p', 'help dv-today-note', aNote)] : []), list(aItems));
      y.append(sectionTitle('h3', b), list(bItems));
      box.append(x, y);
      return box;
    };
    const steps = mk('ol', 'dv-steps');
    for (const [label, text] of [['Før', p.evening.before], ['Under', p.evening.during], ['Efter', p.evening.after]]) {
      const li = mk('li', 'card tight');
      li.append(mk('p', 'eyebrow', label), mk('p', '', text));
      steps.append(li);
    }
    const nav = mk('nav', 'dv-prevnext');
    nav.setAttribute('aria-label', `Andre ${g.label.toLowerCase()}`);
    const prev = people[i - 1], next = people[i + 1];
    nav.append(prev ? textButton(`${first(prev)} · ${prev.archetype}`, { arrow: 'back', href: `#${prev.id}` }) : mk('span'));
    if (next) nav.append(textButton(`${first(next)} · ${next.archetype}`, { arrow: 'forward', href: `#${next.id}` }));

    el.replaceChildren(
      textButton(`Alle ${g.label.toLowerCase()}`, { arrow: 'back', href: `#${g.tab}` }),
      head,
      mk('blockquote', 'dv-quote', `”${p.quote}”`),
      split,
      two('Vil gerne', p.goals, 'Frustreres af', p.frustrations),
      sectionTitle('h3', `Aftenen set fra ${first(p)}`),
      steps,
      two('Får i dag', p.today, 'Mangler', p.gaps, g.note),
      facts([{ label: 'Tegn på værdi', value: p.signal }, { label: 'Spørg en rigtig person', value: p.check }], 'ruled card dv-last') ?? '',
      nav,
    );
  }

  // ---------- The comparison chart ----------
  function plot() {
    const ax = getDropdown('ax-x');
    const ay = getDropdown('ax-y');
    const opts = doc.metrics.map((m) => ({ value: m.id, label: m.label }));
    ax.setOptions(opts, doc.pivot.start[0]);
    ay.setOptions(opts, doc.pivot.start[1]);
    $('pivot-intro').textContent = doc.pivot.intro;
    $('plot-legend').append(...doc.groups.map((g) => { const li = mk('li'); li.append(avatar('', { size: 'small', ring: RING[g.id] }), g.label); return li; }));
    const items = doc.personas.map((p) => {
      const el = mk('li', 'dv-pt');
      const sr = mk('span', 'sr');
      el.append(link(`#${p.id}`, avatar(p.name, { size: 'small', ring: RING[p.group] }), mk('span', 'dv-pt-name', first(p)), sr));
      return { el, p, sr };
    });
    $('plot-points').append(...items.map((x) => x.el));

    const pos = (v: number) => 12 + ((v - 1) / 4) * 76;
    const label = (id: string) => doc.metrics.find((m) => m.id === id)?.label ?? id;
    const box = $('plot');
    const draw = () => {
      const x = ax.value as Metric, y = ay.value as Metric;
      $('ax-x-name').textContent = label(x);
      $('ax-y-name').textContent = label(y);
      const W = box.clientWidth, H = box.clientHeight;
      if (!W) return;
      // Each where its two scores put it (1–5 within 12–88 % of the surface); several in one place start side by side
      const spots = new Map<string, number>();
      const pts = items.map(({ el, p, sr }) => {
        const k = `${p.scores[x]},${p.scores[y]}`;
        const i = spots.get(k) ?? 0;
        spots.set(k, i + 1);
        sr.textContent = `, ${p.archetype}: ${label(x)} ${p.scores[x]} af 5, ${label(y)} ${p.scores[y]} af 5`;
        return { el, k, i, x: (pos(p.scores[x]) / 100) * W, y: (1 - pos(p.scores[y]) / 100) * H, w: el.offsetWidth, h: el.offsetHeight };
      });
      for (const pt of pts) { const n = spots.get(pt.k)!; pt.x += (pt.i - (n - 1) / 2) * (pt.w + 6); }
      // Then kept inside the surface, so no name is cut, and pushed apart until no two overlap
      const clamp = () => pts.forEach((pt) => {
        pt.x = Math.min(W - pt.w / 2 - 4, Math.max(pt.w / 2 + 4, pt.x));
        pt.y = Math.min(H - pt.h / 2 - 4, Math.max(pt.h / 2 + 4, pt.y));
      });
      clamp();
      for (let round = 0; round < 200; round++) {
        let moved = false;
        for (let a = 0; a < pts.length; a++) for (let b = a + 1; b < pts.length; b++) {
          const A = pts[a], B = pts[b];
          const dx = B.x - A.x, dy = B.y - A.y;
          const ox = (A.w + B.w) / 2 + 4 - Math.abs(dx), oy = (A.h + B.h) / 2 + 2 - Math.abs(dy);
          if (ox <= 0 || oy <= 0) continue;
          moved = true;
          // Along the smaller overlap – unless one of them already stands at the side edge, then up or down
          const atSide = (q: typeof A) => q.x <= q.w / 2 + 4.5 || q.x >= W - q.w / 2 - 4.5;
          if (ox < oy && !(atSide(A) || atSide(B))) { const s = (dx >= 0 ? 1 : -1) * ox / 2; A.x -= s; B.x += s; }
          else { const s = (dy > 0 || (dy === 0 && a < b) ? 1 : -1) * oy / 2; A.y -= s; B.y += s; }
        }
        clamp();
        if (!moved) break;
      }
      for (const pt of pts) { pt.el.style.setProperty('--x', `${Math.round(pt.x)}px`); pt.el.style.setProperty('--y', `${Math.round(pt.y)}px`); }
    };
    ax.el.addEventListener('change', draw);
    ay.el.addEventListener('change', draw);
    // Drawn when the tab is shown and whenever the surface changes size
    new ResizeObserver(draw).observe(box);
  }

  // ---------- Tabs and the persona views (remembered in the address: #vaerter, #<persona id>) ----------
  function views() {
    const bar = $('pv-tabs');
    const TABS = [
      { id: 'overblik', label: doc.tabs.overview, body: doc.overview.flatMap(block) },
      ...doc.groups.map((g) => ({ id: g.tab, label: g.label, body: groupPanel(g.id) })),
      { id: 'butik', label: doc.tabs.shop, body: doc.shop.flatMap(block) },
      { id: 'sammenstil', label: doc.tabs.pivot, body: null },
    ];
    for (const t of TABS) {
      const b = tabButton(t.id, t.label);
      b.id = `tab-${t.id}`;
      b.setAttribute('aria-controls', `panel-${t.id}`);
      bar.append(b);
      if (!t.body) continue;
      const panel = mk('section', 'dv-panel');
      panel.id = `panel-${t.id}`;
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', b.id);
      panel.hidden = true;
      panel.append(...t.body);
      $('pv-panels').append(panel);
    }
    const ids = TABS.map((t) => t.id);
    const person = $('pv-person');
    const show = (hash: string, scroll: boolean) => {
      const p = doc.personas.find((x) => x.id === hash);
      const tab = p ? groupOf(p.group).tab : ids.includes(hash) ? hash : 'overblik';
      selectTab(bar, tab);
      for (const id of ids) $(`panel-${id}`).hidden = !!p || id !== tab;
      person.hidden = !p;
      if (p) personView(p);
      if (scroll) bar.scrollIntoView({ block: 'start' });
    };
    tabs(bar, { onChange: (id) => { history.replaceState(null, '', id === 'overblik' ? location.pathname : `#${id}`); show(id, false); } });
    // A card, the back link or "previous / next": the browser follows the link, the page shows the view from the top
    addEventListener('hashchange', () => show(location.hash.slice(1), true));
    show(location.hash.slice(1), false);
  }

  function failed() {
    setEmpty($('pv-failed'), { icon: 'info', title: 'Personaerne kunne ikke hentes.', action: { label: 'Prøv igen', onClick: () => location.reload() } });
  }

  if (await requireAdmin()) {
    const { data, error } = await supabase.from('dev_docs').select('body').eq('id', 'personas').single();
    const body = (data as { body?: PersonasDoc } | null)?.body;
    if (error || !body?.personas?.length) failed();
    else {
      doc = body;
      try {
        $('pv-lead').textContent = doc.intro;
        views();
        plot();
        $('pv-body').hidden = false;
      } catch (e) {
        console.error('personas', e);
        $('pv-body').hidden = true;
        failed();
      }
    }
  }
</script>
