---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SuperNav from '../../components/SuperNav.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import '../../styles/admin.css';
---
<Base title="super.mapsTitle">
  <section class="wrap admin-page">
    <SuperNav active="maps">
      <PageHeader title="super.mapsTitle" />
      <!-- Maps: which regions the wines come from, to decide which detailed maps to make next -->
      <section class="block maps-block">
                <p class="hint" data-i18n="super.mapsHint">The regions the wines in all tastings come from. Regions without a detailed map are shown on the overview map – the most used ones are the next candidates for a detailed map.</p>
        <p id="maps-have" class="hint"></p>
        <div id="map-rows"></div>
        <h3 data-i18n="super.guessesTitle">Places found by Cloudflare AI</h3>
        <p class="hint" data-i18n="super.guessesHint">Appellations that are not on the list, placed by Cloudflare AI and checked against the country. Check the place; delete a wrong one and it is looked up again the next time a host saves the wine.</p>
        <ul id="guess-rows" class="list"></ul>
        <EmptyState id="guesses-none" icon="info" title="super.guessesNone" hidden />
      </section>


    </SuperNav>
  </section>
</Base>

<script>
  import { chip } from '../../lib/ui/status';
  import { confirmModal } from '../../lib/ui/confirm';
  import { toast } from '../../lib/ui/toast';
  import { listRow } from '../../lib/ui/list-row';
  import { iconButton } from '../../lib/ui/icon-button';
  import { table } from '../../lib/ui/table';

  import { supabase } from '../../lib/supabase';
  import { t } from '../../i18n';
  import { requireAdmin, $ } from '../../lib/super-common';
  import { mapIdFor, DETAILED_MAPS } from '../../lib/region-map';
  import { countryName } from '../../lib/origin';

  if (await requireAdmin()) loadMaps();

  // ---------- Maps: demand for detailed maps, and places found by Cloudflare AI ----------
  async function loadMaps() {
    const [{ data: demand }, { data: guesses }] = await Promise.all([
      supabase.rpc('admin_map_demand'),
      supabase.from('appellation_guesses').select('key, name, country, lat, lon, created_at').order('created_at', { ascending: false }),
    ]);
    type D = { region: string; country: string | null; wines: number; tastings: number; upcoming: number; hosts: number };
    // Every detailed map is in the table, also those no tasting uses yet
    const used = new Set(((demand ?? []) as D[]).map((r) => mapIdFor(r.region)));
    const unused: D[] = DETAILED_MAPS.filter((m) => !used.has(m.id))
      .map((m) => ({ region: m.name, country: m.country, wines: 0, tastings: 0, upcoming: 0, hosts: 0 }));
    $('maps-have').textContent = t('super.mapsHave', { n: DETAILED_MAPS.length, list: DETAILED_MAPS.map((m) => m.name).join(', ') });
    const rows = [...((demand ?? []) as D[]), ...unused].sort((a, b) => Number(!!mapIdFor(a.region)) - Number(!!mapIdFor(b.region)) || b.upcoming - a.upcoming || b.tastings - a.tastings);
    // The one table (24): sorts by any column; regions without a detailed map and with upcoming tastings first
    const status = (r: D) => {
      const has = !!mapIdFor(r.region);
      return chip(has ? t('super.mapHas') : Number(r.upcoming) > 0 ? t('super.mapMissingSoon') : t('super.mapMissing'),
        has ? 'ok' : Number(r.upcoming) > 0 ? 'warn' : 'neutral', { dashed: !has && !(Number(r.upcoming) > 0) });
    };
    $('map-rows').replaceChildren(table<D>({
      caption: t('super.mapsTitle'),
      rows,
      columns: [
        { key: 'region', label: t('super.mapRegion'), sort: (r) => r.region },
        { key: 'country', label: t('origin.country'), sort: (r) => countryName(r.country) ?? '', cell: (r) => countryName(r.country) ?? '' },
        { key: 'upcoming', label: t('super.mapUpcoming'), num: true, sort: (r) => Number(r.upcoming), desc: true },
        { key: 'tastings', label: t('adminNav.tastings'), num: true, sort: (r) => Number(r.tastings), desc: true },
        { key: 'wines', label: t('adminNav.wines'), num: true, sort: (r) => Number(r.wines), desc: true },
        { key: 'hosts', label: t('super.hosts'), num: true, sort: (r) => Number(r.hosts), desc: true },
        { key: 'detail', label: t('super.mapDetail'), cell: status, sort: (r) => Number(!!mapIdFor(r.region)) },
      ],
    }).el);
    type G = { key: string; name: string; country: string; lat: number; lon: number };
    const gs = (guesses ?? []) as G[];
    $('guesses-none').hidden = gs.length > 0;
    // One row per guess (the one list row): the place (opens it on a map), country and coordinates, and the quiet trash
    $('guess-rows').replaceChildren(...gs.map((g) => {
      const del = iconButton('trash', `${t('super.guessDelete')}: ${g.name}`, { quiet: true });
      del.dataset.tip = t('super.guessDelete');
      const li = listRow({ title: g.name, href: `https://www.google.com/maps?q=${g.lat},${g.lon}`,
        meta: [[countryName(g.country), `${g.lat.toFixed(3)}, ${g.lon.toFixed(3)}`]], actions: [del] });
      const a = li.querySelector<HTMLAnchorElement>('a.ltitle')!;
      a.target = '_blank';
      a.rel = 'noopener';
      a.title = t('super.guessShow');
      del.addEventListener('click', async () => {
        if (!(await confirmModal({ title: t('super.guessDeleteQ', { name: g.name }), text: t('super.guessDeleteText'), ok: t('super.guessDelete'), danger: true }))) return;
        const { error } = await supabase.rpc('admin_delete_place_guess', { k: g.key });
        if (error) { toast(t('admin.couldNotSave'), { kind: 'error' }); return; }
        li.remove();
        $('guesses-none').hidden = !!$('guess-rows').children.length;
        toast(t('super.guessDeleted', { name: g.name }));
      });
      return li;
    }));
  }

</script>
