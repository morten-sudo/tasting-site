---
import SearchField from '../../components/ui/SearchField.astro';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SuperNav from '../../components/SuperNav.astro';
import '../../styles/admin.css';
---
<Base title="super.tenantsNav">
  <section class="wrap admin-page">
    <SuperNav active="tenants">
      <PageHeader title="super.tenantsNav" />
      <!-- Totals across all hosts -->
      <div class="super-stats">
        <div class="card stat"><span id="t-hosts" class="stat-n"></span><span class="stat-label" data-i18n="super.hosts">Hosts</span></div>
        <div class="card stat"><span id="t-tastings" class="stat-n"></span><span class="stat-label" data-i18n="adminNav.tastings">Tastings</span><span id="t-upcoming" class="stat-sub"></span></div>
        <div class="card stat"><span id="t-wines" class="stat-n"></span><span class="stat-label" data-i18n="adminNav.wines">Wines</span></div>
        <div class="card stat"><span id="t-guests" class="stat-n"></span><span class="stat-label" data-i18n="adminNav.guests">Guests</span><span id="t-invited" class="stat-sub"></span></div>
        <div class="card stat"><span id="t-orders" class="stat-n"></span><span class="stat-label" data-i18n="admin.orders">Orders</span><span id="t-amount" class="stat-sub"></span></div>
        <div class="card stat"><span id="t-activity" class="stat-n"></span><span class="stat-label" data-i18n="super.active30">Active last 30 days</span></div>
      </div>

      <h2 class="sr" data-i18n="super.tenants">All accounts</h2>
      <SearchField id="search" label="adminTasting.search" class="list-search" />
      <div id="tenants"></div>

    </SuperNav>
  </section>
</Base>

<script>
  import { formatKr } from '../../lib/ui/kr';
  import { table } from '../../lib/ui/table';
  import { supabase } from '../../lib/supabase';
  import { t, i18nReady } from '../../i18n';
  import { requireAdmin, $, mk, dateFmt, tenantUrl } from '../../lib/super-common';

  type Tenant = { id: string; name: string | null; email: string; plan: string; created_at: string;
    members: number; tastings: number; upcoming: number; wines: number; guests: number; invited: number; coming: number;
    orders: number; order_amount: number; ratings: number; chat_messages: number; last_activity: string };

  let tenants: Tenant[] = [];
  const date = dateFmt();

  // The one table (24): every column sorts; the newest activity first to begin with
  await i18nReady;
  const list = table<Tenant>({
    caption: t('super.tenants'),
    sort: { key: 'last_activity', desc: true },
    empty: { icon: 'search', title: t('super.noTenantMatch'), action: { label: t('super.showAll'), secondary: true, onClick: () => {
      const f = $<HTMLInputElement>('search');
      f.value = '';
      render();
      f.focus();
    } } },
    columns: [
      { key: 'name', label: t('super.tenant'), sort: (x) => (x.name ?? '').toLowerCase(), cell: (x) => {
        // The account's name (or its owner's) opens the tenant; the owner's email below
        const a = mk('a', '', x.name || '—');
        a.href = tenantUrl(x.id);
        return [a, mk('p', 'lmeta', x.email)];
      } },
      { key: 'created_at', label: t('super.created'), nowrap: true, wideOnly: true, sort: (x) => x.created_at, desc: true, cell: (x) => date.format(new Date(x.created_at)) },
      { key: 'members', label: t('super.hosts'), num: true, sort: (x) => x.members, desc: true },
      { key: 'tastings', label: t('adminNav.tastings'), num: true, sort: (x) => x.tastings, desc: true, cell: (x) => (x.upcoming ? `${x.tastings} (${x.upcoming})` : String(x.tastings)) },
      { key: 'wines', label: t('adminNav.wines'), num: true, sort: (x) => x.wines, desc: true },
      { key: 'guests', label: t('adminNav.guests'), num: true, sort: (x) => x.guests, desc: true },
      { key: 'invited', label: t('super.invited'), num: true, sort: (x) => x.invited, desc: true, cell: (x) => (x.invited ? `${x.invited} (${x.coming})` : '0') },
      { key: 'orders', label: t('admin.orders'), num: true, sort: (x) => x.order_amount, desc: true, cell: (x) => (x.orders ? `${x.orders} · ${formatKr(x.order_amount)}` : '0') },
      { key: 'ratings', label: t('super.ratings'), num: true, wideOnly: true, sort: (x) => x.ratings, desc: true },
      { key: 'chat_messages', label: t('page.chat'), num: true, wideOnly: true, sort: (x) => x.chat_messages, desc: true },
      { key: 'last_activity', label: t('super.lastActive'), nowrap: true, sort: (x) => x.last_activity, desc: true, cell: (x) => date.format(new Date(x.last_activity)) },
    ],
  });
  $('tenants').replaceChildren(list.el);

  if (await requireAdmin()) {
    const { data } = await supabase.rpc('admin_tenants');
    tenants = ((data ?? []) as Tenant[]).map((x) => ({ ...x,
      members: Number(x.members) || 1, tastings: Number(x.tastings), upcoming: Number(x.upcoming), wines: Number(x.wines), guests: Number(x.guests),
      invited: Number(x.invited), coming: Number(x.coming), orders: Number(x.orders), order_amount: Number(x.order_amount),
      ratings: Number(x.ratings), chat_messages: Number(x.chat_messages) }));
    totals();
    render();
  }

  function totals() {
    const sum = (k: keyof Tenant) => tenants.reduce((n, x) => n + (x[k] as number), 0);
    $('t-hosts').textContent = String(sum('members'));
    $('t-tastings').textContent = String(sum('tastings'));
    $('t-upcoming').textContent = t('dash.upcoming', { n: sum('upcoming') });
    $('t-wines').textContent = String(sum('wines'));
    $('t-guests').textContent = String(sum('guests'));
    $('t-invited').textContent = t('super.invitedSub', { n: sum('invited'), coming: sum('coming') });
    $('t-orders').textContent = String(sum('orders'));
    $('t-amount').textContent = formatKr(sum('order_amount'));
    const month = Date.now() - 30 * 86400000;
    $('t-activity').textContent = String(tenants.filter((x) => new Date(x.last_activity).getTime() >= month).length);
  }

  function render() {
    const q = $<HTMLInputElement>('search').value.trim().toLowerCase();
    list.setRows(tenants.filter((x) => !q || `${x.name ?? ''} ${x.email}`.toLowerCase().includes(q)));
  }

  $('search').addEventListener('input', render);
</script>
