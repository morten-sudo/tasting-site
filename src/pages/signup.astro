---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import Actions from '../components/ui/Actions.astro';
import Notice from '../components/ui/Notice.astro';
import Loading from '../components/ui/Loading.astro';
import Steps from '../components/ui/Steps.astro';
import MapBackground from '../components/ui/MapBackground.astro';
import PlansAndFeatures from '../components/PlansAndFeatures.astro';
---
<Base title="page.signup">
  <section class="wrap signup-page">
    <!-- Hero: what Winetastr is, with the sign-up form beside it -->
    <div class="su-hero has-map-bg">
      <MapBackground map="bourgogne" side="left" />
      <div class="su-pitch">
        <PageHeader eyebrow="signup.eyebrow" title="signup.title" lead="signup.lead" class="su-ph" />
        <ul class="su-points">
          <li data-i18n="signup.point1">Free to get started</li>
          <li data-i18n="signup.point2">No app to install – for you or your guests</li>
          <li data-i18n="signup.point3">Nine languages, chosen per tasting</li>
        </ul>
      </div>

      <div id="signup" class="card su-card">
        <SectionTitle level="h3" as="h2" text="signup.formTitle" />
        <Loading id="checking" text="host.creating" hidden />
        <!-- Two steps, as when signing in: name and email, then the code from the email -->
        <Steps id="su-steps" label="Create account" labelKey="signup.formTitle" items={[{ label: 'signup.stepYou' }, { label: 'loginx.code' }]} />

        <!-- Step 1: name and email -->
        <form id="start-form" class="login-form" novalidate>
          <label for="name" data-i18n="host.name">Your name</label>
          <input class="input" id="name" type="text" autocomplete="name" required />
          <div id="email-wrap">
            <label for="email" data-i18n="common.email">Email</label>
            <input class="input" id="email" type="email" autocomplete="email" inputmode="email" required />
          </div>
          <button class="btn" type="submit" id="start-btn" data-i18n="login.sendCode">Send code</button>
          <p class="hint su-fine" data-i18n="signup.noPassword">We send you a code by email – no password needed.</p>
          <p class="hint su-fine su-terms" data-i18n-html="signup.terms">By creating an account you accept the <a href="/terms/" target="_blank" rel="noopener">terms ↗</a> and the <a href="/privacy/" target="_blank" rel="noopener">privacy policy ↗</a>. You must be at least 18.</p>
        </form>

        <!-- Step 2: code from the email -->
        <form id="otp-form" class="login-form" novalidate hidden>
          <!-- The email already has an account: the same code signs in instead -->
          <Notice id="su-exists" title="signup.existsTitle" hidden>
            <p data-i18n="signup.existsText">There is already an account with this email. Enter the code from the email to sign in.</p>
          </Notice>
          <p><span data-i18n="login.sentTo">We have sent a code to</span> <strong id="sent-to"></strong>. <span data-i18n="login.enterIt">Enter it here.</span></p>
          <label for="otp" data-i18n="login.codeLabel">Code from the email</label>
          <input id="otp" class="input code" type="text" inputmode="numeric" autocomplete="one-time-code"
                 pattern="[0-9]*" maxlength="10" required />
          <button class="btn" type="submit" id="otp-btn" data-i18n="signup.create">Create my account</button>
          <p id="otp-terms" class="hint su-fine su-terms" data-i18n-html="signup.terms">By creating an account you accept the <a href="/terms/" target="_blank" rel="noopener">terms ↗</a> and the <a href="/privacy/" target="_blank" rel="noopener">privacy policy ↗</a>. You must be at least 18.</p>
          <p class="hint">
            <button id="back" class="text-btn" type="button" data-i18n="host.back">Change name or email</button>
          </p>
        </form>

        <!-- Signed in and already invited as a guest: a host account is not needed to join – asked before one is made -->
        <div id="guest-choice" class="login-form" hidden>
          <Notice title="signup.guestTitle"><p id="guest-text"></p></Notice>
          <Actions>
            <a id="guest-go" class="btn" href="/home/" data-i18n="signup.guestGo">Go to my tastings</a>
            <button id="guest-host" class="btn secondary" type="button" data-i18n="signup.guestHost">Create a host account anyway</button>
          </Actions>
        </div>

        <p class="hint su-fine" data-i18n-html="host.already">Already a host? <a href="/login/?next=%2Fadmin%2F">Sign in here</a>.</p>
      </div>
    </div>

    <PlansAndFeatures />

    <section class="card su-final">
      <h2 data-i18n="signup.finalTitle">Ready for your next tasting?</h2>
      <a class="btn" href="#signup" data-i18n="signup.formTitle">Create your free account</a>
    </section>
  </section>
</Base>

<script>
  import { setLoading } from '../lib/ui/button';
  import { setSteps } from '../lib/ui/progress';
  import { $ } from '../lib/ui/dom';
  import { fillMapBackgrounds } from '../lib/ui/map-background';
  import { toast } from '../lib/ui/toast';
  import { fieldError } from '../lib/field-error';
  import { supabase } from '../lib/supabase';
  import { i18nReady, lang, t } from '../i18n';

  fillMapBackgrounds();
  await i18nReady;

  const step = (i: number) => setSteps($('su-steps'), i);
  const NAME_KEY = 'wt_host_name';
  let email = '';

  // Problems with what was typed go under the field; problems with sending as a toast
  const bad = (id: string, text: string) => { fieldError($(id), text); $(id).focus(); };
  const failed = (text: string) => toast(text, { kind: 'error' });

  function remember(name: string) { try { localStorage.setItem(NAME_KEY, name); } catch {} }
  function remembered() { try { return localStorage.getItem(NAME_KEY) ?? ''; } catch { return ''; } }

  // Signed in: make the user a host and go to admin
  let busy = false;
  async function finish(name: string, sure = false) {
    if (busy) return;
    busy = true;
    $('start-form').hidden = true;
    $('otp-form').hidden = true;
    $('su-steps').hidden = true;
    $('guest-choice').hidden = true;
    $('checking').hidden = false;
    // Already invited as a guest (known only now, signed in with the email): ask before making them a host –
    // most of them came to sign in to a tasting
    if (!sure) {
      const { data: mine } = await supabase.rpc('my_tastings');
      const list = Array.isArray(mine) ? mine as { title: string; starts_at: string | null }[] : [];
      if (list.length) {
        const next = [...list].sort((a, b) => (a.starts_at ?? '').localeCompare(b.starts_at ?? '')).find((x) => !x.starts_at || new Date(x.starts_at) > new Date()) ?? list[0];
        $('guest-text').textContent = t('signup.guestText', { title: next.title });
        $('checking').hidden = true;
        $('guest-choice').hidden = false;
        busy = false;
        return;
      }
    }
    const { error } = await supabase.rpc('become_host', { host_name: name });
    if (error) {
      busy = false;
      $('checking').hidden = true;
      $('start-form').hidden = false;
      $('su-steps').hidden = false;
      step(0);
      failed(t('host.failed'));
      return;
    }
    try { localStorage.removeItem(NAME_KEY); } catch {}
    location.replace('/admin/');
  }

  // Only a guest after all: nothing is made; the name typed is forgotten
  $('guest-go').addEventListener('click', () => { try { localStorage.removeItem(NAME_KEY); } catch {} });
  $('guest-host').addEventListener('click', () => finish(remembered() || (($('name') as HTMLInputElement).value.trim()), true));

  async function start() {
    const { data } = await supabase.auth.getSession();
    if (!data.session) {
      ($('name') as HTMLInputElement).value = remembered();
      return;
    }
    // Already a host? Go straight to admin.
    const { data: hostId } = await supabase.rpc('current_host_id');
    if (hostId) { location.replace('/admin/'); return; }
    const pending = remembered();
    if (pending) { finish(pending); return; }
    // Signed in (e.g. as a guest) but no name yet: only ask for the name – one step, no steps to show
    $('email-wrap').hidden = true;
    $('su-steps').hidden = true;
    ($('start-btn') as HTMLButtonElement).textContent = t('signup.create');
    ($('start-form') as HTMLFormElement).dataset.signedIn = '1';
  }

  // An existing account: say so and sign in with the same code (nothing is created)
  let existing = false;
  function setExisting(on: boolean) {
    existing = on;
    $('su-exists').hidden = !on;
    $('otp-terms').hidden = on;
    const b = $('otp-btn') as HTMLButtonElement;
    b.dataset.i18n = on ? 'login.submit' : 'signup.create';
    b.textContent = t(on ? 'login.submit' : 'signup.create');
  }

  async function sendCode() {
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { emailRedirectTo: location.origin + '/signup/', shouldCreateUser: true, data: { lang: lang() } },
    });
    if (error?.status === 429) { failed(t('login.tooManyMails')); return false; }
    if (error) { failed(t('login.sendFailed')); return false; }
    // Counted for the superadmin's Usage page (the code is sent through Resend)
    supabase.rpc('log_usage', { feature: 'login' }).then(() => {}, () => {});
    return true;
  }

  $('start-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = ($('name') as HTMLInputElement).value.trim();
    if (!name) { bad('name', t('host.nameMissing')); return; }
    remember(name);
    if (($('start-form') as HTMLFormElement).dataset.signedIn) { finish(name); return; }

    email = ($('email') as HTMLInputElement).value.trim().toLowerCase();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { bad('email', t('common.invalidEmail')); return; }

    const btn = $('start-btn') as HTMLButtonElement;
    setLoading(btn, true, t('common.sending'));
    // Registers the sign-up first (WIN-284: the database only lets a user be created for a known email or one that
    // signup_start() was called for) and says whether the email already has a host account
    let { data: taken, error: startError } = await supabase.rpc('signup_start', { e: email });
    if (startError?.message.includes('too_many')) { setLoading(btn, false); failed(t('login.tooManyChecks')); return; }
    // A database without signup_start() yet (the order is database first, but a test database may lag behind)
    if (startError) ({ data: taken } = await supabase.rpc('signup_email_taken', { e: email }));
    setExisting(taken === true);
    const ok = await sendCode();
    setLoading(btn, false);
    if (!ok) return;

    $('sent-to').textContent = email;
    $('start-form').hidden = true;
    $('otp-form').hidden = false;
    step(1);
    ($('otp') as HTMLInputElement).focus();
  });

  ($('otp') as HTMLInputElement).addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    t.value = t.value.replace(/\D/g, '');
  });

  $('otp-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = ($('otp') as HTMLInputElement).value.replace(/\D/g, '');
    if (token.length < 6) { bad('otp', t('login.wholeCode')); return; }
    const btn = $('otp-btn') as HTMLButtonElement;
    setLoading(btn, true);
    const { error } = await supabase.auth.verifyOtp({ email, token, type: 'email' });
    setLoading(btn, false);
    if (error) {
      bad('otp', error.status === 429 ? t('login.tooManyTries') : t('login.wrongCode'));
      return;
    }
    // Already a host (said so above, or found now): signed in – nothing to create
    if (existing || (await supabase.rpc('current_host_id')).data) {
      try { localStorage.removeItem(NAME_KEY); } catch {}
      location.replace('/admin/');
      return;
    }
    finish(remembered());
  });

  $('back').addEventListener('click', () => {
    $('otp-form').hidden = true;
    $('start-form').hidden = false;
    step(0);
  });

  start();
</script>

<style>
  .signup-page { padding-top: 2.5rem; padding-bottom: 4rem; }
  .su-hero { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 56rem) { .su-hero { grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.9fr); gap: 3.5rem; } }
  .su-ph { margin-bottom: 1.2rem; }
  .su-ph :global(.lead) { max-width: 36rem; }
  .su-points { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .su-points li { display: flex; gap: 0.6rem; align-items: baseline; }
  .su-points li::before { content: '✓'; color: var(--ok); font-weight: 700; }

  .su-card { padding: 1.5rem; scroll-margin-top: 6rem; }
  .su-card > h2 { margin: 0 0 1rem; }
  .su-fine { font-size: 0.88rem; margin: 0.6rem 0 0; }
  .login-form { display: grid; gap: 0.6rem; }
  .login-form .btn { justify-self: stretch; margin-top: 0.3rem; }
  #email-wrap { display: grid; gap: 0.6rem; }
  #email-wrap label { margin: 0; }

  .su-final { margin-top: 4.5rem; padding: 2rem 1.5rem; text-align: center; }
  .su-final > h2 { margin-bottom: 1rem; }
</style>
