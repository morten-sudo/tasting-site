---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Loading from '../../components/ui/Loading.astro';
import Notice from '../../components/ui/Notice.astro';
import SignInState from '../../components/ui/SignInState.astro';
---
<Base title="page.quiz" tasting>
  <section class="wrap quiz-page">
    <PageHeader title="page.quiz" />

    <Loading text="gate.loadingQuiz" />

    <SignInState id="no-code" title="gate.quizTitle" />

    <Notice id="closed" hidden><p data-i18n="quiz.closed">The quiz opens during the tasting. Keep this page open – it starts by itself when the host opens it.</p></Notice>

    <!-- Quiz in progress -->
    <div id="play" hidden>
      <p class="hint rules" id="rules">
        Answer at your own pace. An answer cannot be changed once it is locked.
      </p>
      <ol id="dots" class="dots" aria-label="Your answers" data-i18n-attr="aria-label=quiz.yourAnswers"></ol>

      <div id="question" class="card">
        <p id="q-count" class="q-count"></p>
        <h2 id="q-text" class="q-text"></h2>
        <div id="q-options"></div>
        <button id="q-lock" class="btn block" type="button" disabled data-i18n="quiz.lock">Lock answer</button>
      </div>

      <Notice id="done" tone="ok" hidden><p data-i18n="quiz.done">All your answers are locked. Follow the standings below – answers and explanations come when the host closes the quiz.</p></Notice>
    </div>

    <!-- Quiz finished -->
    <div id="results" hidden>
      <p data-i18n="quiz.over">The quiz is over. Here are the answers and explanations.</p>
      <ol id="result-list" class="results"></ol>
    </div>

    <section id="board-wrap" class="board-wrap" hidden>
      <h2 id="board-title" data-i18n="quiz.standings">Standings</h2>
      <ol id="board" class="board"></ol>
    </section>
  </section>
</Base>

<script>
  import { supabase } from '../../lib/supabase';
  import { tooltip } from '../../lib/ui/tooltip';
  import { toast } from '../../lib/ui/toast';
  import { setLoading } from '../../lib/ui/button';
  import { choiceCards } from '../../lib/ui/choice-cards';
  import { resolveGuestCode, tastingUrl, currentSlug } from '../../lib/guest';
  import { i18nReady, t as tr } from '../../i18n';

  await i18nReady;
  import { fetchLeaderboard, renderLeaderboard } from '../../lib/leaderboard';

  type Option = { key: string; text: string };
  type Q = {
    id: number; sort_order: number; question: string; options: Option[];
    correct_key: string | null; explanation: string | null;
  };

  const $ = (id: string) => document.getElementById(id)!;
  const code = await resolveGuestCode();
  const slug = currentSlug() ?? '';

  let questions: Q[] = [];
  const answers = new Map<number, string>();
  let myName = '';
  let current = 0;
  let selected: string | null = null;
  let mode: 'closed' | 'open' | 'finished' | null = null;

  function show(id: string, on: boolean) { $(id).hidden = !on; }

  let quizTotal = 13;

  async function readSettings() {
    const { data } = await supabase.rpc('get_tasting', { code });
    const s = (data ?? {}) as Record<string, unknown>;
    quizTotal = Number(s.quiz_count) || questions.length || 13;
    if (s.quiz_finished === true) return 'finished';
    if (s.quiz_open === true) return 'open';
    return 'closed';
  }

  async function loadQuestions() {
    const { data } = await supabase.rpc('get_quiz', { code });
    questions = (data ?? []) as Q[];
    if (code) {
      const mine = await supabase.rpc('get_my_answers', { code });
      for (const a of (mine.data ?? []) as { question_id: number; answer_key: string }[]) {
        answers.set(a.question_id, a.answer_key);
      }
    }
  }

  // ---------- Play ----------
  function firstUnanswered() {
    const i = questions.findIndex((q) => !answers.has(q.id));
    return i === -1 ? questions.length : i;
  }

  function renderDots() {
    const ol = $('dots');
    ol.replaceChildren();
    questions.forEach((q, i) => {
      const li = document.createElement('li');
      li.className = 'dot';
      if (answers.has(q.id)) li.classList.add('answered');
      if (i === current) li.classList.add('current');
      const what = tr(answers.has(q.id) ? 'quiz.dotAnswered' : 'quiz.dot', { n: i + 1 });
      tooltip(li, what);
      li.append(Object.assign(document.createElement('span'), { className: 'sr', textContent: what }));
      ol.append(li);
    });
  }

  function renderQuestion() {
    renderDots();
    const all = current >= questions.length;
    show('question', !all);
    show('done', all);
    if (all) return;

    const q = questions[current];
    selected = null;
    $('q-count').textContent = tr('quiz.count', { n: current + 1, total: questions.length });
    $('rules').textContent = tr('quiz.rules', { total: questions.length });
    $('q-text').textContent = q.question;
    // The answers: the choice cards (one answer among a few); the question names the group
    const cards = choiceCards({
      name: `q-${q.id}`, options: q.options.map((o) => ({ value: o.key, label: o.text })),
      onChange: (key) => { selected = key; ($('q-lock') as HTMLButtonElement).disabled = false; },
    });
    cards.el.setAttribute('aria-labelledby', 'q-text');
    $('q-options').replaceChildren(cards.el);
    ($('q-lock') as HTMLButtonElement).disabled = true;
  }

  $('q-lock').addEventListener('click', async () => {
    if (!selected) return;
    const q = questions[current];
    const btn = $('q-lock') as HTMLButtonElement;
    setLoading(btn, true, tr('quiz.locking'));
    const { error } = await supabase.rpc('submit_answer', { code, q_id: q.id, a_key: selected });
    setLoading(btn, false);
    if (error) {
      toast(error.message.includes('ikke åben') ? tr('quiz.closedForAnswers') : tr('quiz.notSaved'), { kind: 'error' });
      if (error.message.includes('ikke åben')) start();
      return;
    }
    answers.set(q.id, selected);
    current = firstUnanswered();
    renderQuestion();
    refreshBoard();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ---------- Answers ----------
  function renderResults() {
    const ol = $('result-list');
    ol.replaceChildren();
    for (const q of questions) {
      const mine = answers.get(q.id);
      const li = document.createElement('li');
      li.className = 'result ' + (!mine ? 'skipped' : mine === q.correct_key ? 'right' : 'wrong');

      const h = document.createElement('h3');
      h.textContent = q.question;
      li.append(h);

      const ul = document.createElement('ul');
      for (const o of q.options) {
        const item = document.createElement('li');
        item.textContent = `${o.key}) ${o.text}`;
        if (o.key === q.correct_key) item.classList.add('correct');
        if (o.key === mine) item.classList.add('mine');
        ul.append(item);
      }
      li.append(ul);

      const verdict = document.createElement('p');
      verdict.className = 'verdict';
      verdict.textContent = !mine ? tr('quiz.unanswered') : mine === q.correct_key ? tr('quiz.right') : tr('quiz.wrong');
      li.append(verdict);

      if (q.explanation) {
        const p = document.createElement('p');
        p.className = 'explanation';
        p.textContent = q.explanation;
        li.append(p);
      }
      ol.append(li);
    }
  }

  // ---------- Leaderboard ----------
  async function refreshBoard() {
    const rows = await fetchLeaderboard({ code });
    if (!rows) return;
    renderLeaderboard($('board') as HTMLOListElement, rows, quizTotal, myName);
  }

  // ---------- Start ----------
  async function start() {
    const next = await readSettings();
    if (next === mode) return;
    mode = next;
    $('loading').hidden = true;

    show('closed', mode === 'closed');
    show('play', false);
    show('results', false);
    show('board-wrap', mode !== 'closed');

    if (mode === 'closed') return;
    await loadQuestions();

    if (mode === 'open') {
      current = firstUnanswered();
      show('play', true);
      renderQuestion();
      $('board-title').textContent = tr('quiz.standingsNow');
    } else {
      show('results', true);
      renderResults();
      $('board-title').textContent = tr('quiz.final');
      $('results').before($('board-wrap'));
    }
    refreshBoard();
  }

  async function init() {
    if (!code) {
      $('loading').hidden = true;
      $('no-code').hidden = false;
      return;
    }
    const inv = await supabase.rpc('get_invite', { code });
    const row = Array.isArray(inv.data) ? inv.data[0] : null;
    if (!row) {
      $('loading').hidden = true;
      $('no-code').hidden = false;
      return;
    }
    myName = row.name;
    await start();
    // Poll for quiz open/close and the standings
    setInterval(start, 10000);
    setInterval(() => { if (mode !== 'closed') refreshBoard(); }, 5000);
  }

  init();
</script>

<style is:global>
  .quiz-page { padding-top: 2.5rem; padding-bottom: 3rem; }
  .quiz-page .rules { margin-bottom: 1rem; }

  .quiz-page .dots {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(13, 1fr);
    gap: 4px;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .quiz-page .dot { height: 6px; border-radius: 3px; background: var(--lodge-3); }
  .quiz-page .dot.answered { background: var(--tawny); }
  .quiz-page .dot.current { background: var(--amber); }

  .quiz-page .card { padding: 1.25rem 1.1rem 1.4rem; }
  .quiz-page .q-count { color: var(--muted); font-size: 0.92rem; margin-bottom: 0.4rem; }
  .quiz-page .q-text {
    font-family: var(--body);
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 1.35;
    letter-spacing: 0;
    margin-bottom: 1.1rem;
  }
  /* The answers are the choice cards (component 10); only the space under them is the page's */
  .quiz-page #q-options .cc { margin-bottom: 1.2rem; }

  .quiz-page .board-wrap { margin-top: 2.5rem; }
  .quiz-page .board-wrap + #results { margin-top: 2.5rem; }
  .quiz-page .result.skipped .verdict { color: var(--muted); }

  .quiz-page .results { list-style: none; margin: 1.5rem 0 0; padding: 0; }
  .quiz-page .result {
    padding: 1.1rem 0 1.25rem;
    border-bottom: 1px solid var(--lodge-3);
  }
  .quiz-page .result h3 {
    font-family: var(--body);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: 0.6rem;
  }
  .quiz-page .result ul { list-style: none; margin: 0 0 0.6rem; padding: 0; }
  .quiz-page .result ul li { padding: 0.15rem 0; color: var(--muted); }
  .quiz-page .result ul li.correct { color: var(--ok); font-weight: 500; }
  .quiz-page .result ul li.mine:not(.correct) { color: var(--error); text-decoration: line-through; }
  .quiz-page .verdict { font-weight: 500; margin-bottom: 0.4rem; }
  .quiz-page .result.right .verdict { color: var(--ok); }
  .quiz-page .result.wrong .verdict { color: var(--error); }
  .quiz-page .explanation { margin: 0; font-size: 0.95rem; }
</style>
