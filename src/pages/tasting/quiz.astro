---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Loading from '../../components/ui/Loading.astro';
import Notice from '../../components/ui/Notice.astro';
import SignInState from '../../components/ui/SignInState.astro';
import Progress from '../../components/ui/Progress.astro';
---
<Base title="page.quiz" tasting>
  <section class="wrap page-pad quiz-page">
    <PageHeader size="section" title="page.quiz" />

    <Loading text="gate.loadingQuiz" />

    <SignInState id="no-code" title="gate.quizTitle" />

    <Notice id="closed" hidden><p data-i18n="quiz.closed">The quiz opens during the tasting. Keep this page open – it starts by itself when the host opens it.</p></Notice>

    <!-- Quiz in progress -->
    <div id="play" hidden>
      <p class="hint rules" id="rules">
        Answer at your own pace. An answer cannot be changed once it is locked.
      </p>
      <div id="question" class="card">
        <Progress id="q-prog" tone="amber" />
        <h2 id="q-text" class="quiz-q"></h2>
        <div id="q-options"></div>
        <button id="q-lock" class="btn block" type="button" disabled data-i18n="quiz.lock">Lock answer</button>
      </div>

      <Notice id="done" tone="ok" hidden><p data-i18n="quiz.done">All your answers are locked. Follow the standings below – answers and explanations come when the host closes the quiz.</p></Notice>
    </div>

    <!-- Quiz finished -->
    <div id="results" hidden>
      <p data-i18n="quiz.over">The quiz is over. Here are the answers and explanations.</p>
      <ul id="result-list" class="list results"></ul>
    </div>

    <section id="board-wrap" class="board-wrap" hidden>
      <h2 id="board-title" data-i18n="quiz.standings">Standings</h2>
      <ol id="board" class="board"></ol>
    </section>
  </section>
</Base>

<script>
  import { supabase } from '../../lib/supabase';
  import { setProgress } from '../../lib/ui/progress';
  import { listRow } from '../../lib/ui/list-row';
  import { chip } from '../../lib/ui/status';
  import { $, mk } from '../../lib/ui/dom';
  import { toast, hideErrorToast } from '../../lib/ui/toast';
  import { setLoading } from '../../lib/ui/button';
  import { choiceCards } from '../../lib/ui/choice-cards';
  import { resolveGuestCode, tastingUrl, currentSlug } from '../../lib/guest';
  import { i18nReady, t as tr } from '../../i18n';

  await i18nReady;
  import { fetchLeaderboard, renderLeaderboard } from '../../lib/leaderboard';

  type Option = { key: string; text: string };
  type Q = {
    id: number; sort_order: number; question: string; options: Option[];
    correct_key: string | null; explanation: string | null;
  };

  const code = await resolveGuestCode();
  const slug = currentSlug() ?? '';

  let questions: Q[] = [];
  const answers = new Map<number, string>();
  let current = 0;
  let selected: string | null = null;
  let mode: 'closed' | 'open' | 'finished' | null = null;

  function show(id: string, on: boolean) { $(id).hidden = !on; }

  // The number of questions: from the tasting (also before they are loaded), else the ones loaded
  let quizTotal = 0;

  async function readSettings() {
    const { data } = await supabase.rpc('get_tasting', { code });
    const s = (data ?? {}) as Record<string, unknown>;
    quizTotal = Number(s.quiz_count) || questions.length;
    if (s.quiz_finished === true) return 'finished';
    if (s.quiz_open === true) return 'open';
    return 'closed';
  }

  async function loadQuestions() {
    const { data } = await supabase.rpc('get_quiz', { code });
    questions = (data ?? []) as Q[];
    if (code) {
      const mine = await supabase.rpc('get_my_answers', { code });
      for (const a of (mine.data ?? []) as { question_id: number; answer_key: string }[]) {
        answers.set(a.question_id, a.answer_key);
      }
    }
  }

  // ---------- Play ----------
  function firstUnanswered() {
    const i = questions.findIndex((q) => !answers.has(q.id));
    return i === -1 ? questions.length : i;
  }

  // Where the guest is: "Question 4 of 12" and the bar (component 38), "3 of 12 answered" at the right
  function renderProgress() {
    const total = questions.length;
    const done = questions.filter((q) => answers.has(q.id)).length;
    const label = current < total ? tr('quiz.count', { n: current + 1, total }) : tr('quiz.allAnswered');
    setProgress($('q-prog'), { label, value: done, max: total, text: tr('quiz.answeredOf', { n: done, total }) });
  }

  function renderQuestion() {
    renderProgress();
    const all = current >= questions.length;
    show('question', !all);
    show('done', all);
    // How to answer is no use once every answer is locked (it also kept its untranslated placeholder then)
    show('rules', !all);
    if (all) return;

    const q = questions[current];
    selected = null;
    $('rules').textContent = tr('quiz.rules', { total: questions.length });
    $('q-text').textContent = q.question;
    // The answers: the choice cards (one answer among a few); the question names the group
    const cards = choiceCards({
      name: `q-${q.id}`, options: q.options.map((o) => ({ value: o.key, label: o.text })),
      onChange: (key) => { selected = key; ($('q-lock') as HTMLButtonElement).disabled = false; },
    });
    cards.el.setAttribute('aria-labelledby', 'q-text');
    $('q-options').replaceChildren(cards.el);
    ($('q-lock') as HTMLButtonElement).disabled = true;
  }

  $('q-lock').addEventListener('click', async () => {
    if (!selected) return;
    const q = questions[current];
    const btn = $('q-lock') as HTMLButtonElement;
    setLoading(btn, true, tr('quiz.locking'));
    const { error } = await supabase.rpc('submit_answer', { code, q_id: q.id, a_key: selected });
    setLoading(btn, false);
    if (error) {
      toast(error.message.includes('ikke åben') ? tr('quiz.closedForAnswers') : tr('quiz.notSaved'), { kind: 'error' });
      if (error.message.includes('ikke åben')) start();
      return;
    }
    // A new try worked: the error from the last one goes (WIN-314)
    hideErrorToast();
    answers.set(q.id, selected);
    current = firstUnanswered();
    renderQuestion();
    refreshBoard();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ---------- Answers ----------
  // One row per question (the list row, 25): its number, the question, a chip with how it went, the answers as
  // locked choice cards (the right one green, a wrong pick red) and the explanation
  function renderResults() {
    $('result-list').replaceChildren(...questions.map((q, i) => {
      const mine = answers.get(q.id);
      const verdict = !mine ? chip(tr('quiz.unanswered'), 'neutral', { dashed: true })
        : mine === q.correct_key ? chip(tr('quiz.right'), 'ok') : chip(tr('quiz.wrong'), 'err');
      const cc = mk('fieldset', 'cc locked');
      cc.append(mk('legend', 'sr', tr('quiz.answers')));
      for (const o of q.options) {
        const right = o.key === q.correct_key;
        const picked = o.key === mine;
        const lab = mk('label', right ? 'right' : picked ? 'wrong' : '');
        lab.append(Object.assign(mk('input'), { type: 'radio', name: `r-${q.id}`, checked: picked, disabled: true }));
        const text = mk('span');
        text.append(mk('b', '', o.text));
        lab.append(text);
        if (right || picked) lab.append(mk('span', 'res', right ? (picked ? tr('quiz.right') : tr('quiz.correctAnswer')) : tr('quiz.yourAnswer')));
        cc.append(lab);
      }
      const body: Node[] = [cc];
      if (q.explanation) body.push(mk('p', 'lmeta explanation', q.explanation));
      return listRow({ no: i + 1, title: q.question, chips: [verdict], body });
    }));
  }

  // ---------- Leaderboard ----------
  async function refreshBoard() {
    const rows = await fetchLeaderboard({ code });
    if (!rows) return;
    renderLeaderboard($('board') as HTMLOListElement, rows, quizTotal || questions.length);
  }

  // ---------- Start ----------
  async function start() {
    const next = await readSettings();
    if (next === mode) return;
    mode = next;
    $('loading').hidden = true;

    show('closed', mode === 'closed');
    show('play', false);
    show('results', false);
    show('board-wrap', mode !== 'closed');

    if (mode === 'closed') return;
    await loadQuestions();

    if (mode === 'open') {
      current = firstUnanswered();
      show('play', true);
      renderQuestion();
      $('board-title').textContent = tr('quiz.standingsNow');
    } else {
      show('results', true);
      renderResults();
      $('board-title').textContent = tr('quiz.final');
      $('results').before($('board-wrap'));
    }
    refreshBoard();
  }

  async function init() {
    if (!code) {
      $('loading').hidden = true;
      $('no-code').hidden = false;
      return;
    }
    const inv = await supabase.rpc('get_invite', { code });
    const row = Array.isArray(inv.data) ? inv.data[0] : null;
    if (!row) {
      $('loading').hidden = true;
      $('no-code').hidden = false;
      return;
    }
    await start();
    // Poll for quiz open/close and the standings
    setInterval(start, 10000);
    setInterval(() => { if (mode !== 'closed') refreshBoard(); }, 5000);
  }

  init();
</script>

<style>
  .quiz-page .rules { margin-bottom: 1rem; }
  .quiz-page #q-options :global(.cc) { margin-bottom: 1.2rem; }
  .quiz-page .board-wrap { margin-top: 2.5rem; }
  .quiz-page .board-wrap + #results { margin-top: 2.5rem; }
  .quiz-page .results { margin-top: 1.5rem; }
  .quiz-page .results :global(.explanation) { color: var(--paper); margin-top: 0.6rem; }
</style>
