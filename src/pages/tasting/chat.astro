---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Loading from '../../components/ui/Loading.astro';
import SignInState from '../../components/ui/SignInState.astro';
import ChatBox from '../../components/ChatBox.astro';
---
<Base title="page.chat" tasting>
  <section class="wrap page-pad">
    <PageHeader size="section" title="page.chat" />
    <Loading text="gate.loadingChat" />
    <SignInState id="no-code" title="gate.chatTitle" />
    <div id="chat-wrap" hidden>
      <p class="hint" data-i18n="chat.intro">Everyone invited to the tasting and the host can read along.</p>
      <ChatBox prefix="g" />
    </div>
  </section>
</Base>

<script>
  import { $ } from '../../lib/ui/dom';
  import { supabase } from '../../lib/supabase';
  import { resolveGuestCode, currentSlug, chatSeenKey } from '../../lib/guest';
  import { initChat, type ChatMessage } from '../../lib/chat';
  import { i18nReady } from '../../i18n';

  await i18nReady;
  const code = await resolveGuestCode();
  $('loading').hidden = true;
  if (!code) {
    $('no-code').hidden = false;
  } else {
    $('chat-wrap').hidden = false;
    await initChat({
      prefix: 'g',
      load: async (after) => {
        const { data, error } = await supabase.rpc('get_chat', { code, after_id: after });
        if (error) return null;
        const list = data as ChatMessage[];
        // The newest message seen here, so the home page can say how many are new
        const newest = Math.max(0, ...list.map((m) => Number(m.id)));
        const slug = currentSlug();
        if (slug && newest) try { localStorage.setItem(chatSeenKey(slug), String(newest)); } catch { /* private mode: no count */ }
        return list;
      },
      send: async (body) => {
        const { error } = await supabase.rpc('post_chat', { code, body });
        if (!error) return 'ok';
        return error.message.includes('too_many') ? 'too_many' : 'error';
      },
    }).start();
  }
</script>

