---
import Icon from '../../components/ui/Icon.astro';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Loading from '../../components/ui/Loading.astro';
import Notice from '../../components/ui/Notice.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import SignInState from '../../components/ui/SignInState.astro';
import Disclosure from '../../components/ui/Disclosure.astro';
import CartBar from '../../components/ui/CartBar.astro';
---
<Base title="page.wine" tasting>
  <article class="wine-page">
    <div class="wrap top">
      <a href="/home/" data-tpath="wines/" class="text-btn back"><Icon name="left" /><span data-i18n="wine.all">All wines</span></a>
      <SignInState id="need-login" title="gate.winesTitle" />
      <Loading text="gate.loadingWine" />
      <EmptyState id="load-error" icon="glass" title="wine.notFound" hidden>
        <a class="btn small" href="/home/" data-tpath="wines/" data-i18n="wine.back">Back to the wines</a>
      </EmptyState>
    </div>

    <div id="wine" class="layout" hidden>
      <div id="pic" class="pic"><span id="no" class="lno" aria-hidden="true"></span></div>
      <div class="text">

      <p id="style-tag" class="style-tag lg"></p>
      <PageHeader id="name" class="wine-ph">
        <p id="meta" class="meta"></p>
        <p id="origin" class="origin" hidden><Icon name="pin" /><span id="origin-text"></span></p>
      </PageHeader>

      <!-- What the guest does here comes first: price and cart, then their own rating; reading after -->
      <div id="buy" class="buy">
        <div id="price"></div>
        <div id="add-row" class="buy-act" hidden>
          <span id="qty"></span>
          <button id="add" type="button" class="btn" data-i18n="wine.add">Add to cart</button>
        </div>
      </div>
      <Notice id="order-status" hidden><p data-i18n="wine.orderNeedsLogin"></p><div class="actions"><a class="btn small secondary" href="/login/" data-login data-i18n="login.submit">Sign in</a></div></Notice>

      <div id="my-rating"></div>

      <div id="desc-box" class="desc-box">
        <p id="desc" class="desc"></p>
        <button id="desc-more" class="text-btn" type="button" hidden aria-expanded="false" aria-controls="desc" data-i18n="wine.readMore">Read more</button>
      </div>
      <div id="facts" class="w-facts"></div>
      <div id="mini-map" class="map-box" hidden></div>
      <Disclosure id="details-box" class="w-details" summary="wine.moreAbout" hidden>
        <div id="details"></div>
      </Disclosure>

      <nav id="pager" class="pager" aria-label="Other wines" data-i18n-attr="aria-label=wine.others" hidden>
        <a id="prev" class="icon-act lg" aria-disabled="true"><Icon name="left" /></a>
        <p id="pager-count" class="count"></p>
        <a id="next" class="icon-act lg" aria-disabled="true"><Icon name="right" /></a>
      </nav>
      </div>
    </div>
  </article>

  <CartBar />
</Base>

<script>
  import { supabase } from '../../lib/supabase';
  import { tooltip } from '../../lib/ui/tooltip';
  import { toast } from '../../lib/ui/toast';
  import { stepper } from '../../lib/ui/stepper';
  import { wineThumb } from '../../lib/ui/thumb';
  import { price } from '../../lib/ui/price';
  import { facts } from '../../lib/ui/facts';
  import { $, mk } from '../../lib/ui/dom';
  import { resolveGuestCode, tastingUrl, currentSlug } from '../../lib/guest';
  import { i18nReady, t } from '../../i18n';
  import { fetchMyRatings, ratingBox } from '../../lib/rating';
  import { initCartBar } from '../../lib/cart-bar';

  await i18nReady;
  import { getCart, addToCart, MAX_PER_WINE } from '../../lib/cart';
  import { type Wine, wineSlug, wineSlugs, styleTag, vintageLabel, tierLabels, wineFacts, nameBlind, watchBlind } from '../../lib/wines';
  import { originFull } from '../../lib/origin';
  import { bulkNote } from '../../lib/bulk';
  import { wineMap, showMapCredit } from '../../lib/wine-map';
  import { mapZoom } from '../../lib/ui/map-zoom';

  // The wine from the address: its name (/wines/rivesaltes-ambre-1966/) or, on old links, its number
  const part = decodeURIComponent(location.pathname.match(/\/wines\/([^/]+)/)?.[1] ?? new URLSearchParams(location.search).get('id') ?? '');
  const code = await resolveGuestCode();
  const slug = currentSlug() ?? '';
  let wines: Wine[] = [];
  let slugs = new Map<number, string>();

  async function showMiniMap(w: Wine) {
    const box = $('mini-map');
    const m = await wineMap(w);
    if (!m) return;
    box.innerHTML = m.svg;
    tooltip(box, originFull(w) ?? '');
    box.hidden = false;
    mapZoom(box);
    showMapCredit(box, m);
  }

  // Previous and next: the round icon buttons around "2 of 11"; the wine's name is their name and tip
  function pager(index: number) {
    const link = (a: HTMLAnchorElement, w: Wine | undefined, dir: string) => {
      if (!w) { a.removeAttribute('href'); a.setAttribute('aria-disabled', 'true'); a.setAttribute('aria-label', dir); return; }
      a.href = tastingUrl(slug, `wines/${slugs.get(w.id)}/`);
      a.removeAttribute('aria-disabled');
      a.setAttribute('aria-label', `${dir}: ${w.name}`);
      a.dataset.tip = `${dir}: ${w.name}`;
    };
    link($('prev') as HTMLAnchorElement, wines[index - 1], t('wine.prev'));
    link($('next') as HTMLAnchorElement, wines[index + 1], t('wine.next'));
    $('pager-count').textContent = t('wines.position', { n: index + 1, total: wines.length });
    $('pager').hidden = wines.length < 2;
  }

  function head(w: Wine, index: number) {
    $('pic').append(wineThumb(w, { size: 'large', blind: w.blind }));
    $('pic').querySelector('.thumb')!.classList.add('fill');
    $('no').textContent = String(index + 1).padStart(2, '0');
    $('style-tag').replaceWith(Object.assign(styleTag(w, true), { id: 'style-tag' }));
    $('name').textContent = w.name;
  }

  async function load() {
    if (!code) {
      $('loading').hidden = true;
      $('need-login').hidden = false;
      return;
    }
    const [winesRes, settingsRes] = await Promise.all([
      supabase.rpc('get_wines', { code }),
      supabase.rpc('get_tasting', { code }),
    ]);
    $('loading').hidden = true;
    wines = nameBlind((winesRes.data ?? []) as Wine[]);
    if (!winesRes.error && !wines.length) { $('load-error').hidden = false; return; }
    slugs = wineSlugs(wines);
    const index = /^\d+$/.test(part)
      ? wines.findIndex((w) => w.id === Number(part))
      : wines.findIndex((w) => slugs.get(w.id) === part || wineSlug(w.name) === wineSlug(part));
    if (winesRes.error || index < 0) { $('load-error').hidden = false; return; }
    const w = wines[index];
    // Old links with a number (or another spelling) show the name in the address
    const canonical = tastingUrl(slug, `wines/${slugs.get(w.id)}/`);
    if (location.pathname !== canonical) history.replaceState(null, '', canonical + location.search);

    document.title = `${w.name} – Winetastr`;
    head(w, index);
    pager(index);

    // A blind wine: its number, type and the guest's own rating – the rest comes when the host reveals it
    if (w.blind) {
      $('meta').textContent = t('blind.hint');
      $('buy').hidden = true;
      $('desc').hidden = true;
      const mine = await fetchMyRatings(code);
      $('my-rating').replaceChildren(ratingBox(code, w.id, mine.get(w.id)));
      $('wine').hidden = false;
      // Revealed by the host: show the whole wine
      watchBlind(async () => {
        const { data, error } = await supabase.rpc('get_wines', { code });
        if (error) throw error;
        return ((data ?? []) as Wine[]).filter((x) => x.id === w.id);
      }, [w], () => location.reload());
      return;
    }

    $('meta').textContent = [
      vintageLabel(w),
      w.producer,
      w.abv ? `${w.abv.toString().replace('.', ',')} %` : null,
    ].filter(Boolean).join(' · ');
    const origin = originFull(w);
    if (origin) {
      $('origin-text').textContent = origin;
      $('origin').hidden = false;
    }
    // Small map: the detailed region map with the appellation filled in, or else the overview map
    // with a pin at the appellation (or in the middle of the country)
    showMiniMap(w);

    // The price (21): ours, the regular one struck through, the quantity prices – and how far the guest (or all the
    // guests together) is towards one
    const settings = ((settingsRes.data ?? {}) as Record<string, unknown>);
    const note = w.price_dkk != null ? bulkNote(w, (settings.bulk_mode as 'guest' | 'pooled' | null) ?? null) : null;
    $('price').replaceChildren(price({ amount: w.price_dkk, was: w.retail_price_dkk, size: 'large', tiers: [...tierLabels(w), ...(note ? [note] : [])] }));

    if (w.description) {
      $('desc').textContent = w.description;
      // A long text starts folded (a few lines) with "Read more"
      requestAnimationFrame(() => {
        const d = $('desc');
        d.classList.add('folded');
        if (d.scrollHeight > d.clientHeight + 8) {
          const more = $('desc-more') as HTMLButtonElement;
          more.hidden = false;
          more.onclick = () => {
            const open = d.classList.toggle('folded') === false;
            more.setAttribute('aria-expanded', String(open));
            more.textContent = t(open ? 'wine.readLess' : 'wine.readMore');
          };
        } else d.classList.remove('folded');
      });
    } else $('desc').hidden = true;
    // Grapes, food and serving – each with its icon (the facts list, 22)
    const strip = wineFacts(w);
    $('facts').replaceChildren(...(strip ? [strip] : []));

    // More about the wine and the producer: the producer's website and address, and the wine's details ("Label: text")
    {
      const site = w.producer_website ? (() => {
        const a = mk('a', '', (() => { try { return new URL(w.producer_website!).hostname.replace(/^www\./, ''); } catch { return w.producer_website!; } })());
        a.href = w.producer_website!;
        a.target = '_blank';
        a.rel = 'noopener';
        return a;
      })() : null;
      const lines = (w.details ?? '').split('\n').map((l) => l.trim()).filter(Boolean).map((line) => {
        const i = line.indexOf(':');
        return i > 0 && i < 30 ? { label: line.slice(0, i), value: line.slice(i + 1).trim() } : { label: '', value: line };
      });
      const list = facts([{ label: t('producer.websiteShort'), value: site }, { label: t('producer.addressShort'), value: w.producer_address }, ...lines]);
      if (list) {
        $('details').replaceChildren(list);
        $('details-box').hidden = false;
        // On larger screens there is room: the details start open
        if (matchMedia('(min-width: 900px)').matches) ($('details-box') as HTMLDetailsElement).open = true;
      }
    }

    // Ordering: how many (the stepper, 17) and "Add to cart"; the cart bar at the bottom follows
    if (settings.orders_open === true && w.orderable) {
      const btn = $('add') as HTMLButtonElement;
      const qty = stepper({ value: 1, min: 1, max: MAX_PER_WINE, label: t('wine.qty') });
      $('qty').replaceWith(qty.el);
      const sync = () => {
        const n = getCart()[w.id] ?? 0;
        btn.textContent = n ? t('wine.addMore', { n }) : t('wine.add');
        btn.classList.toggle('secondary', n > 0);
        qty.setMax(Math.max(1, MAX_PER_WINE - n));
        btn.disabled = n >= MAX_PER_WINE;
      };
      btn.addEventListener('click', () => {
        addToCart(w.id, qty.value);
        qty.set(1);
        // The cart bar at the bottom shows the new count and leads to the cart
        toast(t('wine.added'));
      });
      window.addEventListener('cart-change', sync);
      sync();
      $('add-row').hidden = false;
      initCartBar(() => wines);
    } else if (settings.orders_open === true) {
      $('order-status').hidden = false;
    }

    const mine = await fetchMyRatings(code);
    $('my-rating').replaceChildren(ratingBox(code, w.id, mine.get(w.id)));

    $('wine').hidden = false;
  }

  load();
</script>

<style is:global>
  /* The wine page uses the full screen width: the picture runs edge to edge, and on large screens picture and text
     sit side by side */
  .wine-page { padding-top: 0.5rem; padding-bottom: 3rem; }
  .wine-page .text { padding: 0 var(--gutter); min-width: 0; }
  .wine-page .pic {
    position: relative; margin-top: 0.25rem; background: #fff; display: grid; place-items: center; padding: 1.5rem; overflow: hidden;
    /* Phones: a smaller picture, so name, price, cart and rating come up near the top */
    height: 34vh; min-height: 13rem; max-height: 20rem;
  }
  .wine-page .pic > .lno { position: absolute; top: 0.7rem; left: 0.95rem; z-index: 1; min-width: 0; }
  @media (min-width: 900px) {
    .wine-page .layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: start; }
    .wine-page .pic { position: sticky; top: 6rem; height: calc(100vh - 9rem); min-height: 0; max-height: none; margin: 0 0 0 var(--gutter); border-radius: var(--radius); }
    .wine-page .text { max-width: 40rem; padding-left: clamp(2rem, 5vw, 5rem); }
  }
  .wine-page .style-tag { margin: 1.4rem 0 0.5rem; }
  .wine-page .wine-ph { margin: 0; }
  .wine-page .meta { margin: 0.5rem 0 0; color: var(--muted); }
  .wine-page .origin { margin: 0.3rem 0 0; color: var(--muted); display: flex; align-items: center; gap: 0.4rem; }
  .wine-page .origin svg.i { width: 1rem; height: 1rem; }

  .wine-page .buy {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.9rem 1rem;
    margin-top: 1.25rem; padding: 1rem 0; border-top: 1px solid var(--lodge-3); border-bottom: 1px solid var(--lodge-3);
  }
  .wine-page .buy-act { display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
  @media (max-width: 30rem) { .wine-page .buy-act { width: 100%; } .wine-page .buy-act .btn { flex: 1; } }

  .wine-page .desc { margin: 1.6rem 0 0; font-size: 1.02rem; line-height: 1.8; }
  .wine-page .desc.folded { display: -webkit-box; -webkit-line-clamp: 5; line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  .wine-page .w-facts { margin-top: 1.25rem; }
  .wine-page .map-box { margin-top: 1.25rem; }
  .wine-page .w-details { margin-top: 1.5rem; }
  .wine-page .my-rating { margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--lodge-3); }
  /* Right under the price and cart (which has its line): no second line */
  .wine-page #buy:not([hidden]) + #order-status[hidden] + #my-rating .my-rating { border-top: 0; padding-top: 0.25rem; }
  .wine-page .rating-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .wine-page .rating-head h2 { margin: 0; }
  /* The stars are the shared component (components.css); only the space around them is the page's */
  .wine-page .my-rating .stars { margin: 0.4rem 0 0.9rem -0.55rem; }
  .wine-page .my-rating .note-label { margin-bottom: 0.4rem; }
  .wine-page .rating-hint { font-size: 0.85rem; margin-top: 0.4rem; }
  .wine-page .pager { margin-top: 2rem; }
</style>
