---
import Base from '../../layouts/Base.astro';
---
<Base title="Vin" tasting>
  <article class="wine-page">
    <div class="wrap top">
      <a href="/tastings/" data-tpath="wines/" class="back">Alle vinene</a>
      <div id="need-login" class="message need-login" hidden>
        <p><strong>Log ind for at se vinene.</strong></p>
        <p>Brug linket fra din invitation, eller log ind med din e-mail.</p>
        <a class="btn" href="/login/">Log ind</a>
      </div>
      <p id="loading" class="hint">Henter vinen …</p>
      <p id="load-error" class="message error" hidden>
        Vinen kunne ikke findes. <a href="/tastings/" data-tpath="wines/">Gå tilbage til vinene</a>.
      </p>
    </div>

    <div id="wine" class="layout" hidden>
      <div id="pic" class="pic"><span id="no" class="no" aria-hidden="true"></span></div>
      <div class="text">

      <p id="style-tag" class="style-tag"></p>
      <h1 id="name" class="name"></h1>
      <p id="meta" class="meta"></p>

      <div class="buy">
        <p id="price" class="price"></p>
        <button id="add" type="button" class="add" hidden>Læg i kurv</button>
      </div>
      <p id="order-status" class="hint" hidden></p>

      <p id="desc" class="desc"></p>
      <dl id="details" class="details" hidden></dl>

      <nav class="pager" aria-label="Andre vine">
        <a id="prev" class="pager-link prev" hidden></a>
        <a id="next" class="pager-link next" hidden></a>
      </nav>
      </div>
    </div>
  </article>

  <a id="basket" class="basket" href="/tastings/" data-tpath="cart/" hidden>
    <div class="wrap basket-inner">
      <div>
        <span id="basket-count"></span>
        <strong id="basket-total"></strong>
      </div>
      <span class="basket-go">Gå til kurven</span>
    </div>
  </a>
</Base>

<script>
  import { supabase } from '../../lib/supabase';
  import { resolveGuestCode, tastingUrl, currentSlug } from '../../lib/guest';
  import { getCart, addToCart, cartCount } from '../../lib/cart';
  import { type Wine, styleLabel, styleTone, vintageLabel, kr } from '../../lib/wines';

  const $ = (id: string) => document.getElementById(id)!;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  };

  const id = Number(location.pathname.match(/\/wines\/(\d+)/)?.[1] ?? new URLSearchParams(location.search).get('id'));
  const code = await resolveGuestCode();
  const slug = currentSlug() ?? '';
  let wines: Wine[] = [];

  function renderBasket() {
    const cart = getCart();
    let total = 0;
    for (const w of wines) total += (cart[w.id] ?? 0) * (w.price_dkk ?? 0);
    const bottles = cartCount(cart);
    $('basket').hidden = bottles === 0;
    $('basket-count').textContent = `${bottles} ${bottles === 1 ? 'flaske' : 'flasker'} i kurven, `;
    $('basket-total').textContent = kr.format(total);
  }

  function pagerLink(a: HTMLAnchorElement, w: Wine | undefined, label: string) {
    if (!w) return;
    a.href = tastingUrl(slug, `wines/${w.id}/`);
    a.append(el('span', 'dir', label), el('span', 'to', w.name));
    a.hidden = false;
  }

  async function load() {
    if (!code) {
      $('loading').hidden = true;
      $('need-login').hidden = false;
      return;
    }
    const [winesRes, settingsRes] = await Promise.all([
      supabase.rpc('get_wines', { code }),
      supabase.rpc('get_tasting', { code }),
    ]);
    $('loading').hidden = true;
    wines = (winesRes.data ?? []) as Wine[];
    if (!winesRes.error && !wines.length) { $('need-login').hidden = false; return; }
    const index = wines.findIndex((w) => w.id === id);
    if (winesRes.error || index < 0) { $('load-error').hidden = false; return; }
    const w = wines[index];

    document.title = `${w.name} – Portvin 2026`;

    const pic = $('pic');
    if (w.image_url) {
      const img = el('img');
      img.src = w.image_url;
      img.alt = w.name;
      img.referrerPolicy = 'no-referrer';
      img.addEventListener('error', () => pic.classList.add('empty'));
      pic.prepend(img);
    } else {
      pic.classList.add('empty');
    }
    $('no').textContent = String(index + 1).padStart(2, '0');

    const tag = $('style-tag');
    tag.textContent = styleLabel(w);
    tag.style.setProperty('--tone', styleTone(w));
    $('name').textContent = w.name;
    $('meta').textContent = [
      vintageLabel(w),
      w.producer,
      w.abv ? `${w.abv.toString().replace('.', ',')} %` : null,
    ].filter(Boolean).join(' · ');

    const price = $('price');
    if (w.price_dkk != null) {
      price.append(el('span', 'ours', kr.format(w.price_dkk)));
      if (w.retail_price_dkk != null && w.retail_price_dkk > w.price_dkk) {
        const normal = el('span', 'normal');
        normal.append('Normalpris ', el('s', '', kr.format(w.retail_price_dkk)));
        price.append(normal);
      }
    }

    if (w.description) $('desc').textContent = w.description;
    else $('desc').hidden = true;

    if (w.details) {
      const dl = $('details');
      for (const line of w.details.split('\n')) {
        const i = line.indexOf(':');
        if (i > 0 && i < 30) {
          dl.append(el('dt', '', line.slice(0, i)), el('dd', '', line.slice(i + 1).trim()));
        } else if (line.trim()) {
          dl.append(el('dd', '', line.trim()));
        }
      }
      dl.hidden = false;
    }

    // Ordering
    const settings = ((settingsRes.data ?? {}) as Record<string, unknown>);
    const status = $('order-status');
    if (settings.orders_open === true && code && w.orderable) {
      const btn = $('add') as HTMLButtonElement;
      const sync = () => {
        const n = getCart()[w.id] ?? 0;
        btn.textContent = n ? `Læg i kurv (${n} i kurven)` : 'Læg i kurv';
        btn.classList.toggle('in-cart', n > 0);
      };
      btn.addEventListener('click', () => {
        addToCart(w.id);
        sync();
        btn.classList.remove('pop');
        void btn.offsetWidth;
        btn.classList.add('pop');
      });
      window.addEventListener('cart-change', () => { sync(); renderBasket(); });
      sync();
      btn.hidden = false;
      renderBasket();
    } else if (settings.orders_open === true) {
      status.textContent = 'Brug linket fra din invitation for at bestille.';
      status.hidden = false;
    }

    pagerLink($('prev') as HTMLAnchorElement, wines[index - 1], 'Forrige');
    pagerLink($('next') as HTMLAnchorElement, wines[index + 1], 'Næste');

    $('wine').hidden = false;
  }

  load();
</script>

<style is:global>
  /* The wine page uses the full screen width:
     the image runs edge to edge, and on large screens image and text sit side by side */
  .wine-page { padding-top: 0.5rem; padding-bottom: 6rem; }
  .wine-page .text { padding: 0 var(--gutter); }
  @media (min-width: 900px) {
    .wine-page .layout {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
    }
    .wine-page .layout .pic {
      position: sticky;
      top: 6rem;
      height: calc(100vh - 9rem);
      max-height: none;
      margin: 0 0 0 var(--gutter);
      border-radius: var(--radius);
    }
    .wine-page .text { max-width: 40rem; padding-left: clamp(2rem, 5vw, 5rem); }
    .wine-page .style-tag { margin-top: 0.5rem; }
  }
  .wine-page .back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    color: var(--muted);
    text-decoration: none;
  }
  .wine-page .back::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-left: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
  }
  .wine-page .back:hover { color: var(--paper); }

  .wine-page .pic {
    position: relative;
    margin-top: 0.25rem;
    height: 62vh;
    min-height: 20rem;
    max-height: 34rem;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    overflow: hidden;
  }
  .wine-page .pic img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .wine-page .pic.empty { background: linear-gradient(180deg, var(--ruby), var(--tawny)); }
  .wine-page .pic.empty img { display: none; }
  .wine-page .no {
    position: absolute;
    top: 0.7rem;
    left: 0.95rem;
    font-family: var(--display);
    font-weight: 400;
    font-style: italic;
    font-size: 1.8rem;
    line-height: 1;
    color: #8a7f72;
  }

  .wine-page .style-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.4rem 0 0.4rem;
    color: var(--muted);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .wine-page .style-tag::before {
    content: '';
    width: 1.5rem;
    height: 3px;
    border-radius: 2px;
    background: var(--tone);
  }
  .wine-page .name {
    font-family: var(--display);
    font-size: clamp(2.2rem, 7vw, 3.2rem);
    font-weight: 300;
    line-height: 1.05;
    margin: 0 0 0.5rem;
  }
  .wine-page .meta { margin: 0; color: var(--muted); }

  .wine-page .buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--lodge-3);
    border-bottom: 1px solid var(--lodge-3);
  }
  .wine-page .price {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }
  .wine-page .price .ours { font-weight: 400; font-size: 1.2rem; letter-spacing: 0.02em; }
  .wine-page .price .normal { color: var(--muted); font-size: 0.88rem; }
  .wine-page .add {
    font: 500 0.78rem/1 var(--body);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lodge);
    background: var(--amber);
    border: 1px solid var(--amber);
    border-radius: var(--radius);
    padding: 0 1.75rem;
    min-height: 3rem;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .wine-page .add:hover { background: transparent; color: var(--amber); }
  .wine-page .add.in-cart { background: none; color: var(--amber); box-shadow: inset 0 0 0 1px var(--amber); }
  .wine-page .add.pop { animation: pop 0.25s ease-out; }
  @keyframes pop { 50% { transform: scale(1.06); } }
  .wine-page #order-status { margin: 0.6rem 0 0; }

  .wine-page .desc { margin-top: 1.6rem; font-size: 1.02rem; line-height: 1.8; }
  .wine-page .details {
    margin: 1.5rem 0 0;
    padding: 0;
    line-height: 1.5;
  }
  .wine-page .details dt {
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding-top: 0.9rem;
    border-top: 1px solid var(--lodge-3);
  }
  .wine-page .details dt:first-child { padding-top: 0; border-top: 0; }
  .wine-page .details dd { margin: 0 0 0.7rem; }
  .wine-page .details dd:last-child { margin-bottom: 0; }

  .wine-page .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .wine-page .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--lodge-3);
    border-radius: var(--radius);
    color: var(--paper);
    text-decoration: none;
    min-width: 0;
  }
  .wine-page .pager-link.next { grid-column: 2; text-align: right; }
  .wine-page .pager-link:hover { border-color: var(--amber); }
  .wine-page .pager-link .dir { color: var(--muted); font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; }
  .wine-page .pager-link .to { font-family: var(--display); font-size: 1.15rem; line-height: 1.25; }

  .basket {
    display: block;
    color: var(--paper);
    text-decoration: none;
    position: fixed;
    left: 0; right: 0; bottom: 0;
    background: var(--lodge-2);
    border-top: 2px solid var(--amber);
    padding: 0.9rem 0 calc(0.9rem + env(safe-area-inset-bottom));
  }
  .basket-inner { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  #basket-total { font-size: 1.15rem; }
  .basket-go { color: var(--amber); font-weight: 500; white-space: nowrap; }
  .basket:hover .basket-go { color: var(--paper); }
</style>
