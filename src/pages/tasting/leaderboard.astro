---
import '../../styles/global.css';
import '../../styles/components.css';
---
<!doctype html>
<html lang="en" class="i18n-pending">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Leaderboard – Winetastr</title>
    <style is:inline>html.i18n-pending body { visibility: hidden; }</style>
    <script is:inline src="/i18n-reveal.js"></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500&display=swap"
    />
  </head>
  <body class="tv">
    <main class="tv-main">
      <header class="tv-head">
        <h1 id="tv-title" data-i18n="page.leaderboard">Leaderboard</h1>
        <p id="tv-status" data-i18n="board.notStarted">The quiz has not started yet</p>
      </header>
      <div class="spectrum" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
      <ol id="board" class="board big tv-board"></ol>
    </main>

    <script>
      import { supabase } from '../../lib/supabase';
      import { fetchLeaderboard, renderLeaderboard } from '../../lib/leaderboard';
      import { currentSlug } from '../../lib/guest';
      import { i18nReady, t } from '../../i18n';

      await i18nReady;
      document.title = `${t('page.leaderboard')} – Winetastr`;

      const slug = currentSlug();
      const status = document.getElementById('tv-status')!;
      const board = document.getElementById('board') as HTMLOListElement;
      const main = document.querySelector('.tv-main') as HTMLElement;

      async function tick() {
        const { data } = await supabase.rpc('get_tasting', { slug });
        const s = (data ?? {}) as Record<string, unknown>;
        if (typeof s.title === 'string') document.getElementById('tv-title')!.textContent = s.title;
        const TOTAL = Number(s.quiz_count) || 0;
        const rows = await fetchLeaderboard({ slug });
        if (!rows) return;
        renderLeaderboard(board, rows, TOTAL);
        // More than 6 guests: the board goes into two (over 30: three) columns on a wide screen, and the lines are
        // sized to the screen's height, so everyone fits on the TV without scrolling
        const cols = rows.length > 30 ? 3 : rows.length > 6 ? 2 : 1;
        main.classList.toggle('cols-2', cols === 2);
        main.classList.toggle('cols-3', cols === 3);
        main.style.setProperty('--per-col', String(Math.max(1, Math.ceil(rows.length / cols))));
        const done = TOTAL ? rows.filter((r) => r.answered >= TOTAL).length : 0;
        if (s.quiz_finished === true) status.textContent = t('quiz.final');
        else if (s.quiz_open === true) status.textContent = t('board.doneCount', { done, total: rows.length });
        else status.textContent = t('board.notStarted');
      }
      tick();
      setInterval(tick, 4000);
    </script>

    <style is:global>
      body.tv { min-height: 100vh; }
      .tv-main {
        max-width: 64rem;
        margin: 0 auto;
        padding: 4vh 4vw;
      }
      .tv-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 2rem;
        flex-wrap: wrap;
      }
      .tv-head h1 {
        font-family: var(--display);
        font-weight: 400;
        font-size: clamp(3rem, 9vw, 8rem);
        line-height: 0.85;
        margin: 0;
      }
      #tv-status { color: var(--muted); font-size: clamp(1rem, 2.2vw, 1.8rem); margin: 0; }
      .tv-main .spectrum { margin: 3vh 0 2vh; }
      /* The big screen: the leaderboard (components.css) scaled to the screen */
      .tv-board > li { grid-template-columns: 3em minmax(0, 1fr) auto 3em; font-size: clamp(1.1rem, 2.6vw, 2.3rem); padding-block: 1.4vh; }
      /* (.big from components.css is more specific – the TV's own sizes must win, or the names end up the smallest text) */
      .tv-board.big .who { font-size: 1em; }
      .tv-board.big .pts { font-size: 1.5em; }
      .tv-board.big .pr { font-size: 0.7em; }
      /* Many guests on a wide screen: columns, read top to bottom, sized to the screen's height as well */
      @media (min-width: 60rem) {
        .tv-main.cols-2, .tv-main.cols-3 { max-width: none; padding-block: 3vh; }
        .tv-main.cols-2 .tv-head h1, .tv-main.cols-3 .tv-head h1 { font-size: clamp(3rem, min(6vw, 10vh), 7rem); }
        .tv-main.cols-2 .tv-board { columns: 2; column-gap: 5vw; }
        .tv-main.cols-3 .tv-board { columns: 3; column-gap: 3.5vw; }
        .tv-main.cols-2 .tv-board > li, .tv-main.cols-3 .tv-board > li { break-inside: avoid; padding-block: 0.9vh; }
        /* a line is about 1.7 × the font plus its padding; the board gets about 78 % of the screen's height */
        .tv-main.cols-2 .tv-board > li { font-size: clamp(1rem, min(1.9vw, calc((78vh / var(--per-col) - 1.8vh) / 1.7)), 2.3rem); }
        .tv-main.cols-3 .tv-board > li { font-size: clamp(1rem, min(1.3vw, calc((78vh / var(--per-col) - 1.8vh) / 1.7)), 2rem); }
        .tv-main.cols-2 .tv-board.big .pts, .tv-main.cols-3 .tv-board.big .pts { font-size: 1.25em; line-height: 1.1; }
      }
    </style>
  </body>
</html>
