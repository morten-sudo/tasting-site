---
import ChoiceCards from '../../components/ui/ChoiceCards.astro';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/ui/Hero.astro';
import Icon from '../../components/ui/Icon.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import Actions from '../../components/ui/Actions.astro';
import Loading from '../../components/ui/Loading.astro';
import Notice from '../../components/ui/Notice.astro';
import SignInState from '../../components/ui/SignInState.astro';
import Disclosure from '../../components/ui/Disclosure.astro';
---
<Base title="page.tasting" tasting>
  <section class="wrap page-pad">
    <Loading text="gate.loadingTasting" />
    <SignInState id="invalid" title="gate.tastingTitle" />

    <!-- First visit: email required before continuing -->
    <form id="email-step" class="email-step" hidden novalidate>
      <PageHeader lead="guest.emailLead"><Fragment slot="title"><span data-i18n="guest.welcome">Welcome,</span> <span id="step-name"></span></Fragment></PageHeader>
      <label for="step-email" data-i18n="guest.yourEmail">Your email</label>
      <input class="input" id="step-email" type="email" autocomplete="email" inputmode="email" maxlength="200" required />
      <Actions tight><button class="btn" type="submit" id="step-btn" data-i18n="common.continue">Continue</button></Actions>
    </form>

    <div id="invite" class="t-home" hidden>
      <!-- The tasting at a glance: the one hero, its "tasting" variant (the region's map faint behind the heading) -->
      <Hero variant="tasting" titleId="h-title" countdownId="t-countdown" backgroundId="hero-map">
        <li id="f-when" hidden>
          <Icon name="calendar" />
          <span><span id="h-when"></span><button id="h-ics" type="button" class="text-btn small" data-i18n="tastingHome.calendar">Add to calendar</button></span>
        </li>
        <li id="f-place" hidden>
          <Icon name="pin" />
          <span><span id="h-place"></span><a id="h-map" class="text-btn small" target="_blank" rel="noopener" data-i18n="tastingHome.map">Open in maps</a></span>
        </li>
        <li id="f-host" hidden>
          <Icon name="user" />
          <span id="h-host"></span>
        </li>
      </Hero>

      <div class="t-grid">
        <!-- Sign-up and payment (right column on large screens, right after the heading on phones) -->
        <aside class="t-side">
          <section class="card rsvp-card">
            <SectionTitle level="h3" as="h2" text="tastingHome.yourAnswer" />
            <p id="current" class="rsvp-status" role="status" hidden></p>
            <p id="h-coming" class="coming" hidden></p>
            <button id="change" type="button" class="text-btn" hidden data-i18n="tastingHome.change">Change answer</button>
            <p id="closed-hint" class="help" hidden data-i18n="tastingHome.closedHint">Sign-up is closed.</p>
            <p id="full-hint" class="help" hidden data-i18n="guest.fullHint">The tasting is full. If you say yes, you go on the waiting list.</p>

            <form id="rsvp-form" class="rsvp" novalidate>
              <!-- The choice cards, compact (component 10) -->
              <ChoiceCards id="attending" name="attending" legend="guest.coming" compact options={[{ value: 'yes', label: 'common.yes' }, { value: 'no', label: 'common.no' }]} />

              <div class="field">
                <label for="email" data-i18n="common.email">Email</label>
                <input class="input" id="email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="200" required aria-describedby="email-hint" />
                <p id="email-hint" class="help" data-i18n="guest.emailHint">For signing in with a code by email.</p>
              </div>

              <Disclosure id="note-box" summary="guest.note" optional>
                <textarea class="input" id="note" name="note" maxlength="1000" aria-label="Message to the host" data-i18n-attr="aria-label=guest.note"></textarea>
              </Disclosure>


              <Actions tight>
                <button type="submit" class="btn small" id="submit" data-i18n="common.save">Save</button>
                <span class="help" data-i18n="guest.canChange">You can change your answer while sign-up is open.</span>
              </Actions>
            </form>
          </section>

          <section id="fee" class="card fee" hidden>
            <SectionTitle level="h3" as="h2" text="guest.feeTitle" />
            <Notice id="fee-paid" tone="ok" hidden><p data-i18n="guest.feePaid">Thank you, your payment for the tasting has been received.</p></Notice>
            <div id="fee-due" hidden>
              <p data-i18n="guest.feeText">The price for the evening is based on purchases and the number of guests.</p>
              <div id="fee-pay"></div>
            </div>
          </section>
        </aside>

        <div class="t-main">
          <section id="intro-block" class="intro-block" hidden>
            <SectionTitle level="eyebrow" as="h2" text="tastingHome.about" />
            <div id="h-intro" class="h-intro"></div>
          </section>

          <!-- Where the wines come from: the region's map with their appellations -->
          <section id="origin-block" class="origin-block" hidden>
            <SectionTitle level="eyebrow" as="h2" text="map.title" />
            <div id="origin-map" class="map-box origin-map"></div>
            <ul id="origin-legend" class="map-legend"></ul>
            <p id="map-source" class="map-credit"></p>
          </section>

          <section>
            <SectionTitle level="eyebrow" as="h2" text="tastingHome.during" />
            <ul class="tiles">
              <li><a id="tile-wines" class="card tile" href="/home/">
                <Icon name="glass" />
                <span><strong data-i18n="nav.wines">Wines</strong><span id="tile-wines-sub" class="tile-sub"></span></span>
              </a></li>
              <li id="tile-quiz-li" hidden><a id="tile-quiz" class="card tile" href="/home/">
                <Icon name="question" />
                <span><strong data-i18n="nav.quiz">Quiz</strong><span id="tile-quiz-sub" class="tile-sub"></span></span>
              </a></li>
              <li><a id="tile-chat" class="card tile" href="/home/">
                <Icon name="chat" />
                <span><strong data-i18n="nav.chat">Chat</strong><span class="tile-sub" data-i18n="tastingHome.chatSub">Talk with the other guests</span></span>
              </a></li>
            </ul>
          </section>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { $, mk } from '../../lib/ui/dom';
  import { statusChip, guestStatus } from '../../lib/ui/status';
  import { toast } from '../../lib/toast';
  import { fieldError } from '../../lib/field-error';
  import { setLoading } from '../../lib/ui/button';
  import { supabase } from '../../lib/supabase';
  import { resolveGuestCode, tastingUrl, currentSlug } from '../../lib/guest';
  import { payBox, setPayee } from '../../lib/pay';
  import { i18nReady, t, formatWhen, lang, type Key } from '../../i18n';
  import { loadMap, mainRegion, groupWines, drawMap, fitToAreas, numberRanges } from '../../lib/region-map';
  import { placeOf, loadOverview, overviewFor, focusFor, drawOverview, type Place } from '../../lib/overview-map';
  import { mapZoom } from '../../lib/ui/map-zoom';
  import { countryName } from '../../lib/origin';
  import { setMapCredit, OVERVIEW_SOURCES } from '../../lib/wine-map';

  await i18nReady;


  const code = await resolveGuestCode();
  const slug = currentSlug() ?? '';
  const form = $<HTMLFormElement>('rsvp-form');
  const current = $('current');
  const submit = $<HTMLButtonElement>('submit');

  let guestName = '';

  // The answer as the status chip (one word and tone, as everywhere) with a sentence on what it means
  const SENTENCE: Record<string, Key> = { yes: 'guest.statusYes', waitlist: 'guest.statusWaitlist', no: 'guest.statusNo' };
  function showCurrent(status: string) {
    const sentence = SENTENCE[status];
    current.hidden = !sentence;
    if (!sentence) return;
    current.replaceChildren(statusChip(guestStatus(status)), Object.assign(document.createElement('span'), { textContent: t(sentence) }));
  }

  // ---------- The tasting at a glance ----------
  let headerDone = false;
  function showHeader(info: Record<string, unknown>) {
    signupOpen = info.signup_open !== false;
    // Full: a yes goes on the waiting list – said before the guest answers
    $('full-hint').hidden = info.full !== true;
    updateRsvpView();
    if (headerDone) {
      setComing(info.coming);
      return;
    }
    headerDone = true;
    const title = String(info.title ?? '');
    $('h-title').textContent = title;
    const starts = typeof info.starts_at === 'string' ? info.starts_at : null;
    const place = typeof info.place === 'string' && info.place ? info.place : null;
    if (starts) {
      const ends = typeof info.ends_at === 'string' ? info.ends_at : null;
      $('h-when').textContent = formatWhen(starts, { year: new Date(starts).getFullYear() !== new Date().getFullYear(), end: ends });
      $('f-when').hidden = false;
      $('h-ics').onclick = () => downloadIcs(title, starts, place, ends);
      const count = countdown(starts);
      $('t-countdown').textContent = count ?? '';
      $('t-countdown').hidden = !count;
    }
    if (place) {
      $('h-place').textContent = place;
      ($('h-map') as HTMLAnchorElement).href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place)}`;
      $('f-place').hidden = false;
    }
    // One host or several ("Morten and Erlingur")
    const names = (Array.isArray(info.host_names) ? info.host_names : [info.host_name])
      .filter((n): n is string => typeof n === 'string' && n.trim() !== '');
    if (names.length) {
      const list = new Intl.ListFormat(lang(), { style: 'long', type: 'conjunction' }).format(names);
      $('h-host').textContent = names.length > 1 ? t('tastingHome.hosts', { names: list }) : t('tastingHome.host', { name: list });
      $('f-host').hidden = false;
    }
    setComing(info.coming);
    // The host's introduction: plain text, blank lines separate paragraphs
    const intro = typeof info.intro === 'string' ? info.intro.trim() : '';
    $('h-intro').replaceChildren(...intro.split(/\n\s*\n/).map((para) => mk('p', '', para.trim())));
    $('intro-block').hidden = !intro;
    // Tiles for the evening
    ($('tile-wines') as HTMLAnchorElement).href = tastingUrl(slug, 'wines/');
    ($('tile-quiz') as HTMLAnchorElement).href = tastingUrl(slug, 'quiz/');
    ($('tile-chat') as HTMLAnchorElement).href = tastingUrl(slug, 'chat/');
    const quizCount = Number(info.quiz_count ?? 0);
    $('tile-quiz-li').hidden = quizCount === 0;
    $('tile-quiz-sub').textContent = info.quiz_finished ? t('tastingHome.quizDone')
      : info.quiz_open ? t('tastingHome.quizOpen') : t('tastingHome.quizLater');
    supabase.rpc('get_wines', { code }).then(({ data: wines }) => {
      const list = (Array.isArray(wines) ? wines : []) as MapWine[];
      $('tile-wines-sub').textContent = list.length ? t('tastingHome.winesSub', { n: list.length }) : '';
      showOrigins(list);
    });
  }

  // ---------- Where the wines come from ----------
  type MapWine = { id: number; sort_order: number; name: string; region: string | null; appellation: string | null; appellation_id: string | null; country: string | null;
    producer: string | null; producer_lat?: number | null; producer_lon?: number | null };
  async function showOrigins(wines: MapWine[]) {
    const region = mainRegion(wines);
    const map = region ? await loadMap(region) : null;
    if (!map) { await showOverviewOrigins(wines); return; }
    const groups = await groupWines(map, wines);
    const counts = new Map(groups.filter((g) => g.inMap).map((g) => [g.key, g.count]));
    const titles = new Map(groups.filter((g) => g.inMap).map((g) => [g.key, g.title]));
    const whole = groups.some((g) => g.whole);
    // Faint map behind the heading
    $('hero-map').innerHTML = drawMap(map, { mode: 'background', counts, wholeRegion: whole && !counts.size });
    // The map card; on phones it zooms to the filled appellations
    const box = $('origin-map');
    // Producers with an exact place get a pin (one per producer)
    const pins = [...new Map(wines.filter((w) => w.producer_lat != null && w.producer_lon != null)
      .map((w) => [`${w.producer_lat},${w.producer_lon}`, { lon: w.producer_lon!, lat: w.producer_lat!, title: w.producer ?? '' }])).values()];
    box.innerHTML = drawMap(map, { counts, titles, wholeRegion: whole && !counts.size, pins });
    // Shown before zooming: sizes can only be measured on a visible map
    $('origin-block').hidden = false;
    if (matchMedia('(max-width: 40rem)').matches) fitToAreas(box.querySelector('svg')!, map);
    mapZoom(box);
    // The legend: number of wines per appellation, with their numbers in the evening
    const no = new Map(wines.map((w, i) => [w.id, i + 1]));
    const byId = new Map(wines.map((w) => [w.id, w]));
    $('origin-legend').replaceChildren(...await Promise.all(groups.map(async (g) => {
      const nums = t('map.wineNumbers', { list: numberRanges(g.wines.map((id) => no.get(id) ?? 0)) });
      const li = legendItem(g.inMap ? 'in-map' : g.whole ? 'whole' : 'other', g.count, g.title,
        g.inMap ? nums : g.whole ? `${t('map.wholeRegion', { region: map.name })} · ${nums}` : `${t('map.otherRegion')} · ${nums}`);
      // Wines from another region: a small map of their country with the place marked
      if (!g.inMap && !g.whole) {
        const places = (await Promise.all(g.wines.map((id) => placeOf(byId.get(id)!)))).filter((p): p is Place => !!p);
        if (places.length) {
          const [ov, focus] = await Promise.all([loadOverview(overviewFor(places)), focusFor(places)]);
          if (ov) {
            const inset = mk('span', 'map-box');
            inset.innerHTML = drawOverview(ov, places.map((p) => ({ lon: p.lon, lat: p.lat })), focus, 'inset');
            li.querySelector('.txt')!.append(inset);
          }
        }
      }
      return li;
    })));
    setMapCredit($('origin-map'), map.sources, pins.length > 0, $('map-source'));
    $('origin-block').hidden = false;
  }

  // No detailed map for these wines: the overview map with a numbered pin per place
  async function showOverviewOrigins(wines: MapWine[]) {
    const placed = (await Promise.all(wines.map(async (w) => ({ w, p: await placeOf(w) })))).filter((x) => x.p) as { w: MapWine; p: Place }[];
    if (!placed.length) return;
    const groups = new Map<string, { p: Place; wines: MapWine[] }>();
    for (const { w, p } of placed) {
      const key = `${p.lon.toFixed(2)},${p.lat.toFixed(2)}`;
      const g = groups.get(key) ?? { p, wines: [] };
      g.wines.push(w);
      groups.set(key, g);
    }
    const list = [...groups.values()].sort((a, b) => b.wines.length - a.wines.length);
    const places = list.map((g) => g.p);
    const [ov, focus] = await Promise.all([loadOverview(overviewFor(places)), focusFor(places)]);
    if (!ov) return;
    const pins = list.map((g) => ({ lon: g.p.lon, lat: g.p.lat, n: g.wines.length, label: g.p.label }));
    $('origin-map').innerHTML = drawOverview(ov, pins, focus, 'full');
    mapZoom($('origin-map'));
    $('hero-map').innerHTML = '';
    const no = new Map(wines.map((w, i) => [w.id, i + 1]));
    $('origin-legend').replaceChildren(...list.map((g) => {
      const where = [g.wines[0].region, countryName(g.p.country)].filter((x, i, a) => x && a.indexOf(x) === i).join(', ');
      const nums = t('map.wineNumbers', { list: numberRanges(g.wines.map((w) => no.get(w.id) ?? 0)) });
      return legendItem('in-map', g.wines.length, g.p.label, [where, nums].filter(Boolean).join(' · '));
    }));
    setMapCredit($('origin-map'), OVERVIEW_SOURCES, false, $('map-source'));
    $('origin-block').hidden = false;
  }

  // One line of the map's legend (component 23): the number of wines in a circle, the place, what it covers
  function legendItem(kind: string, count: number, titleText: string, subText: string) {
    const li = mk('li', kind);
    const text = mk('span', 'txt');
    text.append(mk('b', '', titleText), mk('span', 'sub', subText));
    li.append(mk('span', 'no', String(count)), text);
    return li;
  }

  function setComing(n: unknown) {
    const count = Number(n ?? 0);
    $('h-coming').textContent = count > 0 ? t('tastingHome.coming', { n: count }) : '';
    $('h-coming').hidden = count === 0;
  }

  // "In 21 days", "Tomorrow", "Today" – in the page's language
  function countdown(iso: string): string | null {
    const day = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
    const days = Math.round((day(new Date(iso)) - day(new Date())) / 86400000);
    if (days < 0 || days > 60) return null;
    const text = new Intl.RelativeTimeFormat(lang(), { numeric: 'auto' }).format(days, 'day');
    return text.charAt(0).toUpperCase() + text.slice(1);
  }

  // A calendar file (.ics) the phone or computer can open in its calendar
  function downloadIcs(title: string, startsAt: string, place: string | null, endsAt: string | null = null) {
    const stamp = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    const esc = (v: string) => v.replace(/[\\;,]/g, (c) => '\\' + c).replace(/\n/g, '\\n');
    const start = new Date(startsAt);
    // Without an end time the calendar gets four hours
    const end = endsAt ? new Date(endsAt) : new Date(start.getTime() + 4 * 3600 * 1000);
    const lines = [
      'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Winetastr//EN', 'BEGIN:VEVENT',
      `UID:${slug}@winetastr`, `DTSTAMP:${stamp(new Date())}`, `DTSTART:${stamp(start)}`, `DTEND:${stamp(end)}`,
      `SUMMARY:${esc(title)}`, ...(place ? [`LOCATION:${esc(place)}`] : []),
      `URL:${location.origin}${tastingUrl(slug)}`, 'END:VEVENT', 'END:VCALENDAR',
    ];
    const blob = new Blob([lines.join('\r\n')], { type: 'text/calendar' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `${slug}.ics`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }

  // ---------- Answer: a short summary once answered, the form when changing ----------
  let signupOpen = true;
  let editing = false;
  function updateRsvpView() {
    const answered = !current.hidden;
    form.hidden = answered && !editing || !signupOpen && answered;
    $('change').hidden = !answered || editing || !signupOpen;
    $('closed-hint').hidden = signupOpen;
  }
  $('change').addEventListener('click', () => {
    editing = true;
    updateRsvpView();
    form.querySelector<HTMLInputElement>('input[name="attending"]:checked')?.focus();
  });

  async function loadFee() {
    const [{ data }, tastingRes] = await Promise.all([
      supabase.rpc('get_tasting_payment', { code }),
      supabase.rpc('get_tasting', { code }),
    ]);
    const info = (tastingRes.data ?? {}) as Record<string, unknown>;
    setPayee(info.mobilepay ?? null);
    showHeader(info);
    const row = Array.isArray(data) ? data[0] : null;
    const amount = row ? Number(row.amount) : 0;
    $('fee').hidden = !row || amount <= 0;
    if (!row || amount <= 0) return;
    $('fee-paid').hidden = !row.paid;
    $('fee-due').hidden = row.paid;
    if (!row.paid) $('fee-pay').replaceChildren(payBox(amount, t('pay.feeComment', { name: guestName })));
  }

  async function load() {
    if (!code) {
      $('loading').hidden = true;
      $('invalid').hidden = false;
      return;
    }
    const { data, error } = await supabase.rpc('get_invite', { code });
    $('loading').hidden = true;
    const row = Array.isArray(data) ? data[0] : null;
    if (error || !row) {
      $('invalid').hidden = false;
      return;
    }
    guestName = row.name;
    if (row.status === 'yes' || row.status === 'no' || row.status === 'waitlist') {
      (form.querySelector(`input[value="${row.status === 'no' ? 'no' : 'yes'}"]`) as HTMLInputElement).checked = true;
    }
    $<HTMLTextAreaElement>('note').value = row.note ?? '';
    ($('note-box') as HTMLDetailsElement).open = !!row.note;
    $<HTMLInputElement>('email').value = row.email ?? '';
    // Opened with the link only: the email is shown partly hidden and can only be changed when signed in with it
    if (row.email && row.email.includes('***')) {
      $<HTMLInputElement>('email').readOnly = true;
      $('email-hint').innerHTML = t('guest.emailLockedHint');
    }
    showCurrent(row.status);
    if (!row.email) {
      $('step-name').textContent = row.name;
      $('email-step').hidden = false;
      $<HTMLInputElement>('step-email').focus();
      return;
    }
    showProfile();
  }

  function showProfile() {
    $('email-step').hidden = true;
    $('invite').hidden = false;
    loadFee();
  }

  const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

  $('email-step').addEventListener('submit', async (e) => {
    e.preventDefault();
    const stepEmail = $<HTMLInputElement>('step-email');
    const val = stepEmail.value.trim();
    if (!EMAIL_RE.test(val)) {
      fieldError(stepEmail, val ? t('guest.emailBad') : t('guest.emailMissing'));
      stepEmail.focus();
      return;
    }
    const btn = $<HTMLButtonElement>('step-btn');
    setLoading(btn, true, t('common.saving'));
    const { error } = await supabase.rpc('set_my_email', { code, e: val });
    setLoading(btn, false);
    if (error) {
      if (error.message.includes('bruges allerede')) fieldError(stepEmail, t('guest.emailTakenLong'));
      else if (error.message.includes('Ugyldig')) fieldError(stepEmail, t('guest.emailBad'));
      else toast(t('guest.emailNotSaved'), { kind: 'error' });
      return;
    }
    $<HTMLInputElement>('email').value = val.toLowerCase();
    showProfile();
    window.scrollTo({ top: 0 });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const choice = (form.elements.namedItem('attending') as RadioNodeList).value;
    if (!choice) {
      // The error under the choice, which goes as soon as one is picked
      fieldError($('attending'), t('guest.chooseYesNo'));
      form.querySelector<HTMLInputElement>('input[name="attending"]')?.focus();
      return;
    }
    const emailEl = $<HTMLInputElement>('email');
    const emailVal = emailEl.value.trim();
    if (!emailEl.readOnly && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(emailVal)) {
      fieldError(emailEl, emailVal ? t('guest.emailBad') : t('guest.emailMissing'));
      emailEl.focus();
      return;
    }
    setLoading(submit, true, t('common.sending'));
    const attending = choice === 'yes';
    const mail = emailEl.readOnly ? { error: null } : await supabase.rpc('set_my_email', { code, e: emailVal });
    if (mail.error) {
      setLoading(submit, false);
      if (mail.error.message.includes('bruges allerede')) fieldError(emailEl, t('guest.emailTaken'));
      else if (mail.error.message.includes('Ugyldig')) fieldError(emailEl, t('guest.emailBad'));
      else toast(t('guest.answerNotSaved'), { kind: 'error' });
      return;
    }
    const { data, error } = await supabase.rpc('respond_invite', {
      code,
      attending,
      diet: null,
      note: $<HTMLTextAreaElement>('note').value,
    });
    setLoading(submit, false);
    if (error) {
      toast(error.message.includes('lukket') ? t('guest.signupClosed') : t('guest.answerNotSaved'), { kind: 'error' });
      return;
    }
    showCurrent(data as string);
    editing = false;
    updateRsvpView();
    toast(t('common.saved'), { kind: 'ok' });
    loadFee();
  });

  load();
</script>

<style>
  #email-step, #invalid { max-width: 34rem; }

  /* The tasting at a glance */
  .t-home { overflow-x: clip; }
  /* Larger screens: the map at half width with the legend beside it */
