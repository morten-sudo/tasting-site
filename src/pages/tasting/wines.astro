---
import Icon from '../../components/ui/Icon.astro';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Loading from '../../components/ui/Loading.astro';
import Notice from '../../components/ui/Notice.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import SignInState from '../../components/ui/SignInState.astro';
import CartBar from '../../components/ui/CartBar.astro';
---
<Base title="page.wines" tasting>
  <section class="wrap page-pad">
    <PageHeader title="page.wines" lead="wines.intro" leadId="intro" />

    <SignInState id="need-login" title="gate.winesTitle" />
    <Loading text="gate.loadingWines" />
    <EmptyState id="no-wines" icon="glass" title="wines.none" text="wines.noneHelp" hidden>
      <a class="btn small secondary" href="/home/" data-tpath="" data-i18n="gate.toTasting">To the tasting</a>
    </EmptyState>
    <Notice id="load-error" tone="error" hidden>
      <p data-i18n="wines.loadError">The wines could not be loaded. Check your connection and reload the page.</p>
      <div class="actions"><button class="btn small secondary" type="button" onclick="location.reload()" data-i18n="gate.reload">Reload</button></div>
    </Notice>

    <div id="wine-list" class="carousel" role="region" aria-roledescription="carousel" aria-label="Wines" data-i18n-attr="aria-roledescription=wines.carousel;aria-label=page.wines" tabindex="0"></div>

    <div id="carousel-nav" class="pager" hidden>
      <button type="button" id="prev" class="icon-act lg" aria-label="Previous wine" data-i18n-attr="aria-label=wines.prevWine;data-tip=wines.prevWine" data-tip="Previous wine"><Icon name="left" /></button>
      <p id="counter" class="count" aria-live="polite"></p>
      <button type="button" id="next" class="icon-act lg" aria-label="Next wine" data-i18n-attr="aria-label=wines.nextWine;data-tip=wines.nextWine" data-tip="Next wine"><Icon name="right" /></button>
    </div>
  </section>

  <CartBar />
</Base>

<script>
  import { supabase } from '../../lib/supabase';
  import { resolveGuestCode, tastingUrl, currentSlug } from '../../lib/guest';
  import { i18nReady, t } from '../../i18n';
  import { fetchMyRatings, type MyRating } from '../../lib/rating';
  import { starsRo } from '../../lib/ui/stars';
  import { listRow } from '../../lib/ui/list-row';
  import { chip } from '../../lib/ui/status';
  import { wineThumb } from '../../lib/ui/thumb';
  import { price } from '../../lib/ui/price';
  import { iconSvg } from '../../lib/ui/icons';
  import { $, mk } from '../../lib/ui/dom';
  import { initCartBar } from '../../lib/cart-bar';
  import { type Wine, wineSlugs, styleTag, vintageLabel, tierLabels, nameBlind, watchBlind } from '../../lib/wines';
  import { originLine } from '../../lib/origin';

  let myRatings = new Map<number, MyRating>();

  await i18nReady;

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const code = await resolveGuestCode();
  const slug = currentSlug() ?? '';
  let wines: Wine[] = [];
  let slugs = new Map<number, string>();
  let drawCartBar: (() => void) | null = null;

  // One wine as a card: the list row's card variant (25) with the wine's picture (20), price (21) and stars (16)
  function wineCard(w: Wine, index: number, total: number) {
    const foot: Node[] = [];
    // A blind wine says so; its price comes with it when the host reveals it
    foot.push(w.blind ? chip(t('blind.blind'), 'strong') : price({ amount: w.price_dkk, was: w.retail_price_dkk, tiers: tierLabels(w) }));
    const mine = myRatings.get(w.id)?.rating;
    if (mine) {
      const my = starsRo(mine);
      my.setAttribute('aria-label', t('rating.yours', { n: mine }));
      foot.push(my);
    }
    const go = mk('span', 'go', t('wines.readMore'));
    go.insertAdjacentHTML('beforeend', iconSvg('right'));
    go.setAttribute('aria-hidden', 'true');
    foot.push(go);
    const li = listRow({
      variant: 'card', cls: 'wine-card', id: w.id, cardHref: tastingUrl(slug, `wines/${slugs.get(w.id)}/`),
      no: String(index + 1).padStart(2, '0'), pic: wineThumb(w, { size: 'large', blind: w.blind }),
      kicker: styleTag(w), title: w.name,
      meta: [w.blind ? mk('span', 'note', t('blind.hint')) : null, [vintageLabel(w), originLine(w)]],
      foot,
    });
    li.querySelector('.thumb')?.classList.add('fill');
    li.querySelector('.lno')?.setAttribute('aria-hidden', 'true');
    li.setAttribute('aria-roledescription', t('wines.slide'));
    li.setAttribute('aria-label', t('wines.position', { n: index + 1, total }));
    return li;
  }

  let cards: HTMLElement[] = [];
  let current = 0;
  const track = () => $('wine-list').querySelector<HTMLElement>('.cards');
  const leftOf = (tr: HTMLElement, card: HTMLElement) => card.offsetLeft - tr.offsetLeft - (parseFloat(getComputedStyle(tr).scrollPaddingLeft) || 0);

  function scrollToCard(i: number) {
    const tr = track();
    const card = cards[Math.max(0, Math.min(cards.length - 1, i))];
    if (!tr || !card) return;
    tr.scrollTo({ left: leftOf(tr, card), behavior: reduceMotion ? 'auto' : 'smooth' });
  }

  function setCurrent(i: number) {
    current = i;
    $('counter').textContent = t('wines.position', { n: i + 1, total: cards.length });
    $<HTMLButtonElement>('prev').disabled = i === 0;
    $<HTMLButtonElement>('next').disabled = i === cards.length - 1;
    cards.forEach((c, n) => c.classList.toggle('is-current', n === i));
  }

  function render() {
    const list = $('wine-list');
    const tr = mk('ul', 'cards');
    cards = wines.map((w, i) => wineCard(w, i, wines.length));
    tr.append(...cards);
    list.replaceChildren(tr);
    $('carousel-nav').hidden = cards.length < 2;

    let ticking = false;
    tr.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        let best = 0, dist = Infinity;
        cards.forEach((c, n) => {
          const d = Math.abs(leftOf(tr, c) - tr.scrollLeft);
          if (d < dist) { dist = d; best = n; }
        });
        if (best !== current) setCurrent(best);
      });
    }, { passive: true });

    if (!list.dataset.keys) {
      list.dataset.keys = '1';
      list.addEventListener('keydown', (e) => {
        if (e.target !== list) return;
        if (e.key === 'ArrowRight') { e.preventDefault(); scrollToCard(current + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); scrollToCard(current - 1); }
      });
    }

    setCurrent(0);
    drawCartBar?.();
  }

  $('prev').addEventListener('click', () => scrollToCard(current - 1));
  $('next').addEventListener('click', () => scrollToCard(current + 1));

  const fetchWines = async () => {
    const { data, error } = await supabase.rpc('get_wines', { code: code! });
    if (error) throw error;
    return (data ?? []) as Wine[];
  };

  // A wine was revealed: draw the list again on the same wine
  async function refresh() {
    const at = current;
    wines = nameBlind(await fetchWines());
    slugs = wineSlugs(wines);
    render();
    const tr = track();
    const card = cards[Math.min(at, cards.length - 1)];
    if (tr && card) tr.scrollLeft = leftOf(tr, card);
    if (wines.some((w) => w.blind)) watchBlind(fetchWines, wines, refresh);
  }

  async function load() {
    if (!code) {
      $('loading').hidden = true;
      $('need-login').hidden = false;
      return;
    }
    const [winesRes, settingsRes, ratings] = await Promise.all([
      supabase.rpc('get_wines', { code }),
      supabase.rpc('get_tasting', { code }),
      fetchMyRatings(code),
    ]);
    myRatings = ratings;
    $('loading').hidden = true;
    if (winesRes.error) { $('load-error').hidden = false; return; }
    // Signed in with a code but no wines to show yet: say so (not "sign in")
    if (!winesRes.data?.length) { $('no-wines').hidden = false; return; }
    wines = nameBlind(winesRes.data as Wine[]);
    slugs = wineSlugs(wines);
    // While a wine is blind, the list follows the host revealing it
    if (wines.some((w) => w.blind)) watchBlind(fetchWines, wines, refresh);

    const settings = ((settingsRes.data ?? {}) as Record<string, unknown>);
    if (settings.orders_open === true) {
      $('intro').textContent = t('wines.introOrder');
      drawCartBar = initCartBar(() => wines);
    }
    render();
  }

  load();
</script>

