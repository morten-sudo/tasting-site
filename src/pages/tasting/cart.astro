---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Loading from '../../components/ui/Loading.astro';
import Notice from '../../components/ui/Notice.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import SignInState from '../../components/ui/SignInState.astro';
---
<Base title="page.cart" tasting>
  <section class="wrap page-pad cart-page">
    <PageHeader size="section" title="page.cart" />

    <Loading text="gate.loadingCart" />

    <SignInState id="no-code" title="gate.cartTitle" />

    <Notice id="closed" hidden><p data-i18n="cart.closed">Ordering is not open right now.</p></Notice>

    <Notice id="confirm" tone="ok" class="confirm" hidden><b id="confirm-title" class="n-title"></b><div id="confirm-pay"></div></Notice>

    <div id="cart" hidden>
      <ul id="lines" class="list"></ul>
      <div class="cart-sum">
        <span data-i18n="cart.total">Total</span>
        <b id="total"></b>
      </div>
      <button id="send" class="btn block send" type="button" data-i18n="cart.send">Send order</button>
      <p class="help" data-i18n="cart.binding">When you send it, the order is binding. The price is the one shown with the wine now.</p>
    </div>

    <EmptyState id="empty" icon="cart" title="cart.empty" text="cart.emptyHelp" hidden>
      <a class="btn small" href="/home/" data-tpath="wines/" data-i18n="cart.seeWines">See the wines</a>
    </EmptyState>

    <section id="history" class="history" hidden>
      <h2 data-i18n="cart.yourOrders">Your orders</h2>
      <ul id="orders" class="cards"></ul>
    </section>
  </section>
</Base>

<script>
  import { formatKr } from '../../lib/ui/kr';
  import { stepper } from '../../lib/ui/stepper';
  import { statusChip } from '../../lib/ui/status';
  import { listRow } from '../../lib/ui/list-row';
  import { wineThumb } from '../../lib/ui/thumb';
  import { iconButton } from '../../lib/ui/icon-button';
  import { deleteWithUndo } from '../../lib/ui/delete-undo';
  import { setLoading } from '../../lib/ui/button';
  import { toast } from '../../lib/ui/toast';
  import { price as priceBox } from '../../lib/ui/price';
  import { disclosure } from '../../lib/ui/disclosure';
  import { $, mk } from '../../lib/ui/dom';
  import { supabase } from '../../lib/supabase';
  import { resolveGuestCode, tastingUrl, currentSlug } from '../../lib/guest';
  import { i18nReady, t, locale } from '../../i18n';
  import { getCart, setQty, clearCart, MAX_PER_WINE } from '../../lib/cart';
  import { payBox, setPayee } from '../../lib/pay';
  import { unitPrice, nextTierLabel, type PriceTier } from '../../lib/wines';
  import { bulkNote } from '../../lib/bulk';
  import { bottleText, nameWithSize } from '../../lib/bottle';

  type Wine = { id: number; name: string; price_dkk: number | null; orderable: boolean; sort_order: number;
    price_tiers: PriceTier[] | null; ordered?: number; image_url?: string | null; blind?: boolean; bottle_cl?: number | null };
  type Line = {
    order_id: number; created_at: string; paid: boolean;
    wine_id: number; wine_name: string; quantity: number; unit_price: number;
  };

  await i18nReady;
  const date = new Intl.DateTimeFormat(locale(), { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });

  const code = await resolveGuestCode();
  const slug = currentSlug() ?? '';
  let wines = new Map<number, Wine>();
  // Every revealed wine's size (also wines that can no longer be ordered), for the order history
  let sizes = new Map<number, number | null>();
  const keepSizes = (list: Wine[]) => { sizes = new Map(list.map((x) => [x.id, x.bottle_cl ?? null])); };
  let open = false;
  // What counts towards a quantity price: the guest's own bottles over all their orders, or everyone's (pooled)
  let bulkMode: 'guest' | 'pooled' | null = null;
  // Pooled prices can still fall while ordering is open, so paying waits until the host closes it
  const payLater = () => bulkMode === 'pooled' && open;

  function renderCart() {
    const cart = getCart();
    const ids = Object.keys(cart).map(Number).filter((id) => wines.has(id))
      .sort((a, b) => wines.get(a)!.sort_order - wines.get(b)!.sort_order);

    $('cart').hidden = ids.length === 0;
    $('empty').hidden = ids.length !== 0 || !$('confirm').hidden;

    const ul = $('lines');
    ul.replaceChildren();
    let total = 0;
    for (const id of ids) {
      const w = wines.get(id)!;
      const n = cart[id];
      // Bottles already ordered count towards the quantity price too
      const counted = (w.ordered ?? 0) + n;
      const price = unitPrice(w, counted);
      total += n * price;

      // The one stepper (src/lib/ui/stepper.ts): 1 up to what may be ordered; the trash takes the line away
      const step = stepper({ value: n, min: 1, max: MAX_PER_WINE, label: w.name,
        lessLabel: t('cart.oneLess', { name: w.name }), moreLabel: t('cart.oneMore', { name: w.name }),
        onChange: (v) => {
          const which = document.activeElement === step.el.lastElementChild ? 'last' : 'first';
          setQty(id, v); renderCart();
          // Keep the focus on the same button after the list is drawn again
          const again = ul.querySelector<HTMLElement>(`[data-id="${id}"] .stepper button:${which}-of-type`);
          (again && !(again as HTMLButtonElement).disabled ? again : ul.querySelector<HTMLElement>(`[data-id="${id}"] .stepper button:not(:disabled)`))?.focus();
        } });
      const aside = document.createDocumentFragment();
      aside.append(step.el, priceBox({ amount: n * price, align: 'right' }));
      // Removing a line: the quiet trash, asked about first, with Undo
      const remove = iconButton('trash', `${t('cart.remove')}: ${w.name}`, { quiet: true });
      remove.dataset.tip = t('cart.remove');
      remove.addEventListener('click', () => deleteWithUndo({
        label: t('cart.removed', { name: w.name }),
        ask: { title: t('cart.removeQ', { name: w.name }), ok: t('cart.remove') },
        hide: () => { setQty(id, 0); renderCart(); },
        restore: () => { setQty(id, n); renderCart(); },
        commit: async () => true,
      }));
      const note = bulkNote(w, bulkMode, n);
      // One line per wine (the one list row): picture, name, price per bottle, the stepper and the line's total
      ul.append(listRow({
        id, pic: wineThumb(w, { blind: w.blind === true }), title: w.name, cls: 'cart-line',
        meta: [[bottleText(w.bottle_cl, locale()), t('cart.perBottle', { price: formatKr(price) }), nextTierLabel(w, counted)], note ? mk('span', 'tier', note) : null],
        aside, actions: [remove],
      }));
    }
    $('total').textContent = formatKr(total);
    ($('send') as HTMLButtonElement).disabled = !open;
  }

  async function renderHistory() {
    if (!code) return;
    const { data } = await supabase.rpc('get_my_orders', { code });
    const lines = (data ?? []) as Line[];
    $('history').hidden = lines.length === 0;
    const box = $('orders');
    box.replaceChildren();
    const byOrder = new Map<number, Line[]>();
    for (const l of lines) {
      if (!byOrder.has(l.order_id)) byOrder.set(l.order_id, []);
      byOrder.get(l.order_id)!.push(l);
    }
    // One card per order (the card variant of the one list row) – the same as in the wine book
    box.replaceChildren(...[...byOrder].reverse().map(([id, ls]) => {
      const total = ls.reduce((s, l) => s + l.quantity * Number(l.unit_price), 0);
      const ul = mk('ul');
      for (const l of ls) ul.append(mk('li', '', `${l.quantity} × ${nameWithSize(l.wine_name, sizes.get(l.wine_id), locale())}`));
      const body: Node[] = [ul];
      if (!ls[0].paid && payLater()) body.push(mk('p', 'lmeta', t('bulk.payLater')));
      else if (!ls[0].paid) {
        body.push(disclosure(t('cart.howToPay'), [payBox(total, t('pay.orderComment', { id }))]));
      }
      return listRow({
        variant: 'card', small: true, title: t('pay.orderComment', { id }),
        chips: [statusChip(ls[0].paid ? 'order.paid' : 'order.unpaid')],
        meta: [date.format(new Date(ls[0].created_at))],
        body, foot: [mk('span', '', t('cart.total')), mk('b', '', formatKr(total))],
      });
    }));
  }

  $('send').addEventListener('click', async () => {
    const cart = getCart();
    const items = Object.entries(cart)
      .filter(([id]) => wines.has(Number(id)))
      .map(([id, qty]) => ({ wine_id: Number(id), qty }));
    if (!items.length) return;

    const btn = $('send') as HTMLButtonElement;
    setLoading(btn, true, t('common.sending'));

    const { data, error } = await supabase.rpc('place_order', { code, items });
    setLoading(btn, false);
    btn.disabled = true;

    if (error) {
      toast(error.message.includes('lukket') ? t('cart.errClosed')
        : error.message.includes('kan ikke bestilles') ? t('cart.errWine') : t('cart.errSend'), { kind: 'error' });
      btn.disabled = false;
      return;
    }

    const total = items.reduce((s, i) => {
      const w = wines.get(i.wine_id);
      return s + i.qty * (w ? unitPrice(w, (w.ordered ?? 0) + i.qty) : 0);
    }, 0);
    clearCart();
    $('confirm-title').textContent = t('cart.thanks', { id: String(data) });
    $('confirm-pay').replaceChildren(payLater()
      ? Object.assign(document.createElement('p'), { textContent: t('bulk.payLater') })
      : payBox(total, t('pay.orderComment', { id: String(data) })));
    // The counts changed: fetch them again
    const { data: fresh } = await supabase.rpc('get_wines', { code });
    keepSizes((fresh ?? []) as Wine[]);
    wines = new Map(((fresh ?? []) as Wine[]).filter((x) => x.orderable).map((x) => [x.id, x]));
    $('confirm').hidden = false;
    renderCart();
    await renderHistory();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  async function init() {
    if (!code) {
      $('loading').hidden = true;
      $('no-code').hidden = false;
      return;
    }
    const [w, s] = await Promise.all([
      supabase.rpc('get_wines', { code }),
      supabase.rpc('get_tasting', { code }),
    ]);
    keepSizes((w.data ?? []) as Wine[]);
    wines = new Map(((w.data ?? []) as Wine[]).filter((x) => x.orderable).map((x) => [x.id, x]));
    const settings = ((s.data ?? {}) as Record<string, unknown>);
    open = settings.orders_open === true;
    bulkMode = (settings.bulk_mode as 'guest' | 'pooled' | null) ?? null;
    setPayee(settings.mobilepay ?? null);
    $('loading').hidden = true;
    $('closed').hidden = open;
    renderCart();
    renderHistory();
  }

  init();
</script>

<style>
  .cart-page :global(.confirm), .cart-page #closed { margin-bottom: 1.5rem; }
  .cart-page .send { margin-bottom: 0.6rem; }
  .cart-page .history { margin-top: 3rem; }
  .cart-page .history .cards { margin-top: 0.75rem; }
</style>
