---
import Base from '../../layouts/Base.astro';
import Loading from '../../components/ui/Loading.astro';
import Notice from '../../components/ui/Notice.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import SignInState from '../../components/ui/SignInState.astro';
---
<Base title="page.cart" tasting>
  <section class="wrap cart-page">
    <h1 class="title" data-i18n="page.cart">Cart</h1>

    <Loading text="gate.loadingCart" />

    <SignInState id="no-code" title="gate.cartTitle" />

    <Notice id="closed" hidden><p data-i18n="cart.closed">Ordering is not open right now.</p></Notice>

    <Notice id="confirm" tone="ok" class="confirm" hidden><b id="confirm-title" class="n-title"></b><div id="confirm-pay"></div></Notice>

    <div id="cart" hidden>
      <ul id="lines" class="lines"></ul>
      <div class="sum">
        <span data-i18n="cart.total">Total</span>
        <strong id="total"></strong>
      </div>
      <button id="send" class="btn block send" type="button" data-i18n="cart.send">Send order</button>
      <p class="hint" data-i18n="cart.binding">When you send it, the order is binding. The price is the one shown with the wine now.</p>
    </div>

    <EmptyState id="empty" icon="cart" title="cart.empty" text="cart.emptyHelp" hidden>
      <a class="btn small" href="/home/" data-tpath="wines/" data-i18n="cart.seeWines">See the wines</a>
    </EmptyState>

    <section id="history" class="history" hidden>
      <h2 data-i18n="cart.yourOrders">Your orders</h2>
      <div id="orders"></div>
    </section>
  </section>
</Base>

<script>
  import { stepper } from '../../lib/ui/stepper';
  import { statusChip } from '../../lib/ui/status';
  import { setLoading } from '../../lib/ui/button';
  import { toast } from '../../lib/ui/toast';
  import { supabase } from '../../lib/supabase';
  import { resolveGuestCode, tastingUrl, currentSlug } from '../../lib/guest';
  import { i18nReady, t, money, locale } from '../../i18n';
  import { getCart, setQty, clearCart, MAX_PER_WINE } from '../../lib/cart';
  import { payBox, setPayee } from '../../lib/pay';
  import { unitPrice, nextTierLabel, type PriceTier } from '../../lib/wines';
  import { bulkNote } from '../../lib/bulk';

  type Wine = { id: number; name: string; price_dkk: number | null; orderable: boolean; sort_order: number;
    price_tiers: PriceTier[] | null; ordered?: number };
  type Line = {
    order_id: number; created_at: string; paid: boolean;
    wine_id: number; wine_name: string; quantity: number; unit_price: number;
  };

  const $ = (id: string) => document.getElementById(id)!;
  await i18nReady;
  const kr = { format: money };
  const date = new Intl.DateTimeFormat(locale(), { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });

  const code = await resolveGuestCode();
  const slug = currentSlug() ?? '';
  let wines = new Map<number, Wine>();
  let open = false;
  // What counts towards a quantity price: the guest's own bottles over all their orders, or everyone's (pooled)
  let bulkMode: 'guest' | 'pooled' | null = null;
  // Pooled prices can still fall while ordering is open, so paying waits until the host closes it
  const payLater = () => bulkMode === 'pooled' && open;

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }

  function renderCart() {
    const cart = getCart();
    const ids = Object.keys(cart).map(Number).filter((id) => wines.has(id))
      .sort((a, b) => wines.get(a)!.sort_order - wines.get(b)!.sort_order);

    $('cart').hidden = ids.length === 0;
    $('empty').hidden = ids.length !== 0 || !$('confirm').hidden;

    const ul = $('lines');
    ul.replaceChildren();
    let total = 0;
    for (const id of ids) {
      const w = wines.get(id)!;
      const n = cart[id];
      // Bottles already ordered count towards the quantity price too
      const counted = (w.ordered ?? 0) + n;
      const price = unitPrice(w, counted);
      total += n * price;

      const li = el('li', 'line');
      const info = el('div', 'line-info');
      info.append(el('p', 'line-name', w.name), el('p', 'line-unit', [t('cart.perBottle', { price: kr.format(price) }),
        nextTierLabel(w, counted)].filter(Boolean).join(' · ')));
      const note = bulkNote(w, bulkMode, n);
      if (note) info.append(el('p', 'line-bulk', note));

      const ctrl = el('div', 'line-ctrl');
      // The one stepper (src/lib/ui/stepper.ts): 1 up to what may be ordered; "Remove" takes the line away
      const step = stepper({ value: n, min: 1, max: MAX_PER_WINE, label: w.name,
        lessLabel: t('cart.oneLess', { name: w.name }), moreLabel: t('cart.oneMore', { name: w.name }),
        onChange: (v) => {
          const which = document.activeElement === step.el.lastElementChild ? 'last' : 'first';
          setQty(id, v); renderCart();
          // Keep the focus on the same button after the list is drawn again
          const again = ul.querySelector<HTMLElement>(`[data-line="${id}"] .stepper button:${which}-of-type`);
          (again && !(again as HTMLButtonElement).disabled ? again : ul.querySelector<HTMLElement>(`[data-line="${id}"] .stepper button:not(:disabled)`))?.focus();
        } });
      li.dataset.line = String(id);

      const remove = el('button', 'text-btn danger small', t('cart.remove'));
      remove.type = 'button';
      remove.addEventListener('click', () => { setQty(id, 0); renderCart(); });

      ctrl.append(step.el, el('span', 'line-total', kr.format(n * price)), remove);
      li.append(info, ctrl);
      ul.append(li);
    }
    $('total').textContent = kr.format(total);
    ($('send') as HTMLButtonElement).disabled = !open;
  }

  async function renderHistory() {
    if (!code) return;
    const { data } = await supabase.rpc('get_my_orders', { code });
    const lines = (data ?? []) as Line[];
    $('history').hidden = lines.length === 0;
    const box = $('orders');
    box.replaceChildren();
    const byOrder = new Map<number, Line[]>();
    for (const l of lines) {
      if (!byOrder.has(l.order_id)) byOrder.set(l.order_id, []);
      byOrder.get(l.order_id)!.push(l);
    }
    for (const [id, ls] of [...byOrder].reverse()) {
      const total = ls.reduce((s, l) => s + l.quantity * Number(l.unit_price), 0);
      const card = el('div', 'card order' + (ls[0].paid ? ' paid' : ''));
      const head = el('div', 'order-head');
      head.append(
        el('strong', '', t('pay.orderComment', { id })),
        statusChip(ls[0].paid ? 'order.paid' : 'order.unpaid'),
      );
      card.append(head, el('p', 'hint', date.format(new Date(ls[0].created_at))));
      const ul = el('ul');
      for (const l of ls) ul.append(el('li', '', `${l.quantity} × ${l.wine_name}`));
      card.append(ul);
      const foot = el('div', 'order-foot');
      foot.append(el('span', '', t('cart.total')), el('strong', '', kr.format(total)));
      card.append(foot);
      if (!ls[0].paid && payLater()) {
        card.append(el('p', 'hint', t('bulk.payLater')));
      } else if (!ls[0].paid) {
        const more = el('details', 'pay-more');
        more.append(el('summary', '', t('cart.howToPay')));
        more.append(payBox(total, t('pay.orderComment', { id })));
        card.append(more);
      }
      box.append(card);
    }
  }

  $('send').addEventListener('click', async () => {
    const cart = getCart();
    const items = Object.entries(cart)
      .filter(([id]) => wines.has(Number(id)))
      .map(([id, qty]) => ({ wine_id: Number(id), qty }));
    if (!items.length) return;

    const btn = $('send') as HTMLButtonElement;
    setLoading(btn, true, t('common.sending'));

    const { data, error } = await supabase.rpc('place_order', { code, items });
    setLoading(btn, false);
    btn.disabled = true;

    if (error) {
      toast(error.message.includes('lukket') ? t('cart.errClosed')
        : error.message.includes('kan ikke bestilles') ? t('cart.errWine') : t('cart.errSend'), { kind: 'error' });
      btn.disabled = false;
      return;
    }

    const total = items.reduce((s, i) => {
      const w = wines.get(i.wine_id);
      return s + i.qty * (w ? unitPrice(w, (w.ordered ?? 0) + i.qty) : 0);
    }, 0);
    clearCart();
    $('confirm-title').textContent = t('cart.thanks', { id: String(data) });
    $('confirm-pay').replaceChildren(payLater()
      ? Object.assign(document.createElement('p'), { textContent: t('bulk.payLater') })
      : payBox(total, t('pay.orderComment', { id: String(data) })));
    // The counts changed: fetch them again
    const { data: fresh } = await supabase.rpc('get_wines', { code });
    wines = new Map(((fresh ?? []) as Wine[]).filter((x) => x.orderable).map((x) => [x.id, x]));
    $('confirm').hidden = false;
    renderCart();
    await renderHistory();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  async function init() {
    if (!code) {
      $('loading').hidden = true;
      $('no-code').hidden = false;
      return;
    }
    const [w, s] = await Promise.all([
      supabase.rpc('get_wines', { code }),
      supabase.rpc('get_tasting', { code }),
    ]);
    wines = new Map(((w.data ?? []) as Wine[]).filter((x) => x.orderable).map((x) => [x.id, x]));
    const settings = ((s.data ?? {}) as Record<string, unknown>);
    open = settings.orders_open === true;
    bulkMode = (settings.bulk_mode as 'guest' | 'pooled' | null) ?? null;
    setPayee(settings.mobilepay ?? null);
    $('loading').hidden = true;
    $('closed').hidden = open;
    renderCart();
    renderHistory();
  }

  init();
</script>

<style is:global>
  .cart-page { padding-top: 2.5rem; padding-bottom: 3rem; }
  .cart-page .title {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(3rem, 16vw, 5rem);
    line-height: 0.9;
    margin-bottom: 1.25rem;
  }
  .cart-page .confirm, .cart-page #closed { margin-bottom: 1.5rem; }

  .cart-page .lines { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--lodge-3); }
  .cart-page .line { padding: 1rem 0; border-bottom: 1px solid var(--lodge-2); }
  .cart-page .line-name { margin: 0; font-weight: 500; line-height: 1.35; }
  .cart-page .line-unit { margin: 0.1rem 0 0.6rem; color: var(--muted); font-size: 0.9rem; }
  .cart-page .line-bulk { margin: -0.3rem 0 0.6rem; color: var(--amber); font-size: 0.88rem; }
  .cart-page .line-ctrl { display: flex; align-items: center; gap: 1rem; }
  .cart-page .line-total { margin-left: auto; font-variant-numeric: tabular-nums; }

  .cart-page .sum {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.1rem 0;
    font-size: 1.15rem;
  }
  .cart-page .sum strong { font-size: 1.35rem; font-variant-numeric: tabular-nums; }
  .cart-page .send { margin-bottom: 0.6rem; }

  .cart-page .history { margin-top: 3rem; }
  .cart-page .order { padding: 0.9rem 1rem; margin-bottom: 0.75rem; border-left: 3px solid var(--amber); }
  .cart-page .order.paid { border-left-color: var(--ok); }
  .cart-page .order-head, .cart-page .order-foot { display: flex; justify-content: space-between; gap: 1rem; }
  .cart-page .order-head { align-items: center; }
  .cart-page .order .hint { margin: 0.1rem 0 0.5rem; font-size: 0.85rem; }
  .cart-page .order ul { margin: 0 0 0.6rem; padding-left: 1.1rem; font-size: 0.95rem; }
  .cart-page .order-foot { border-top: 1px solid var(--lodge-3); padding-top: 0.5rem; }

  .cart-page .pay-more { margin-top: 0.6rem; }
  .cart-page .pay-more summary { cursor: pointer; color: var(--amber); font-size: 0.95rem; padding: 0.3rem 0; }
</style>
