---
import Base from '../../layouts/Base.astro';
---
<Base title="page.cart" tasting>
  <section class="wrap cart-page">
    <h1 class="title" data-i18n="page.cart">Cart</h1>

    <p id="loading" class="hint" data-i18n="common.loading">Loading …</p>

    <div id="no-code" class="message" hidden>
      <p data-i18n="cart.noCode">To order you need to be signed in. Sign in with your email or open the link from your invitation, then come back here.</p>
    </div>

    <p id="closed" class="message" hidden data-i18n="cart.closed">
      Ordering is not open right now.
    </p>

    <div id="confirm" class="message ok confirm" hidden>
      <p><strong id="confirm-title"></strong></p>
      <div id="confirm-pay"></div>
    </div>

    <div id="cart" hidden>
      <ul id="lines" class="lines"></ul>
      <div class="sum">
        <span data-i18n="cart.total">Total</span>
        <strong id="total"></strong>
      </div>
      <p id="send-error" class="message error" hidden></p>
      <button id="send" class="btn send" type="button" data-i18n="cart.send">Send order</button>
      <p class="hint" data-i18n="cart.binding">When you send it, the order is binding. The price is the one shown with the wine now.</p>
    </div>

    <div id="empty" hidden>
      <p data-i18n="cart.empty">Your cart is empty.</p>
      <a class="btn" href="/tastings/" data-tpath="wines/" data-i18n="cart.seeWines">See the wines</a>
    </div>

    <section id="history" class="history" hidden>
      <h2 data-i18n="cart.yourOrders">Your orders</h2>
      <div id="orders"></div>
    </section>
  </section>
</Base>

<script>
  import { supabase } from '../../lib/supabase';
  import { resolveGuestCode, tastingUrl, currentSlug } from '../../lib/guest';
  import { i18nReady, t, money, locale } from '../../i18n';
  import { getCart, setQty, clearCart, MAX_PER_WINE } from '../../lib/cart';
  import { payBox, setPayee } from '../../lib/pay';
  import { unitPrice, nextTierLabel, type PriceTier } from '../../lib/wines';

  type Wine = { id: number; name: string; price_dkk: number | null; orderable: boolean; sort_order: number;
    price_tiers: PriceTier[] | null };
  type Line = {
    order_id: number; created_at: string; paid: boolean;
    wine_id: number; wine_name: string; quantity: number; unit_price: number;
  };

  const $ = (id: string) => document.getElementById(id)!;
  await i18nReady;
  const kr = { format: money };
  const date = new Intl.DateTimeFormat(locale(), { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });

  const code = await resolveGuestCode();
  const slug = currentSlug() ?? '';
  let wines = new Map<number, Wine>();
  let open = false;

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }

  function renderCart() {
    const cart = getCart();
    const ids = Object.keys(cart).map(Number).filter((id) => wines.has(id))
      .sort((a, b) => wines.get(a)!.sort_order - wines.get(b)!.sort_order);

    $('cart').hidden = ids.length === 0;
    $('empty').hidden = ids.length !== 0 || !$('confirm').hidden;

    const ul = $('lines');
    ul.replaceChildren();
    let total = 0;
    for (const id of ids) {
      const w = wines.get(id)!;
      const n = cart[id];
      const price = unitPrice(w, n);
      total += n * price;

      const li = el('li', 'line');
      const info = el('div', 'line-info');
      info.append(el('p', 'line-name', w.name), el('p', 'line-unit', [t('cart.perBottle', { price: kr.format(price) }),
        nextTierLabel(w, n)].filter(Boolean).join(' · ')));

      const ctrl = el('div', 'line-ctrl');
      const minus = el('button', 'step', '−');
      const count = el('output', 'count', String(n));
      const plus = el('button', 'step', '+');
      minus.type = plus.type = 'button';
      minus.setAttribute('aria-label', t('cart.oneLess', { name: w.name }));
      plus.setAttribute('aria-label', t('cart.oneMore', { name: w.name }));
      plus.disabled = n >= MAX_PER_WINE;
      minus.addEventListener('click', () => { setQty(id, n - 1); renderCart(); });
      plus.addEventListener('click', () => { setQty(id, n + 1); renderCart(); });
      const stepper = el('div', 'stepper');
      stepper.append(minus, count, plus);

      const remove = el('button', 'remove', t('cart.remove'));
      remove.type = 'button';
      remove.addEventListener('click', () => { setQty(id, 0); renderCart(); });

      ctrl.append(stepper, el('span', 'line-total', kr.format(n * price)), remove);
      li.append(info, ctrl);
      ul.append(li);
    }
    $('total').textContent = kr.format(total);
    ($('send') as HTMLButtonElement).disabled = !open;
  }

  async function renderHistory() {
    if (!code) return;
    const { data } = await supabase.rpc('get_my_orders', { code });
    const lines = (data ?? []) as Line[];
    $('history').hidden = lines.length === 0;
    const box = $('orders');
    box.replaceChildren();
    const byOrder = new Map<number, Line[]>();
    for (const l of lines) {
      if (!byOrder.has(l.order_id)) byOrder.set(l.order_id, []);
      byOrder.get(l.order_id)!.push(l);
    }
    for (const [id, ls] of [...byOrder].reverse()) {
      const total = ls.reduce((s, l) => s + l.quantity * Number(l.unit_price), 0);
      const card = el('div', 'order' + (ls[0].paid ? ' paid' : ''));
      const head = el('div', 'order-head');
      head.append(
        el('strong', '', t('pay.orderComment', { id })),
        el('span', 'status', ls[0].paid ? t('cart.paid') : t('cart.awaiting')),
      );
      card.append(head, el('p', 'hint', date.format(new Date(ls[0].created_at))));
      const ul = el('ul');
      for (const l of ls) ul.append(el('li', '', `${l.quantity} × ${l.wine_name}`));
      card.append(ul);
      const foot = el('div', 'order-foot');
      foot.append(el('span', '', t('cart.total')), el('strong', '', kr.format(total)));
      card.append(foot);
      if (!ls[0].paid) {
        const more = el('details', 'pay-more');
        more.append(el('summary', '', t('cart.howToPay')));
        more.append(payBox(total, t('pay.orderComment', { id })));
        card.append(more);
      }
      box.append(card);
    }
  }

  $('send').addEventListener('click', async () => {
    const cart = getCart();
    const items = Object.entries(cart)
      .filter(([id]) => wines.has(Number(id)))
      .map(([id, qty]) => ({ wine_id: Number(id), qty }));
    if (!items.length) return;

    const btn = $('send') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = t('common.sending');
    $('send-error').hidden = true;

    const { data, error } = await supabase.rpc('place_order', { code, items });
    btn.textContent = t('cart.send');

    if (error) {
      $('send-error').textContent = error.message.includes('lukket')
        ? t('cart.errClosed')
        : error.message.includes('kan ikke bestilles')
        ? t('cart.errWine')
        : t('cart.errSend');
      $('send-error').hidden = false;
      btn.disabled = false;
      return;
    }

    const total = items.reduce((s, i) => s + i.qty * (wines.has(i.wine_id) ? unitPrice(wines.get(i.wine_id)!, i.qty) : 0), 0);
    clearCart();
    $('confirm-title').textContent = t('cart.thanks', { id: String(data) });
    $('confirm-pay').replaceChildren(payBox(total, t('pay.orderComment', { id: String(data) })));
    $('confirm').hidden = false;
    renderCart();
    await renderHistory();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  async function init() {
    if (!code) {
      $('loading').hidden = true;
      $('no-code').hidden = false;
      return;
    }
    const [w, s] = await Promise.all([
      supabase.rpc('get_wines', { code }),
      supabase.rpc('get_tasting', { code }),
    ]);
    wines = new Map(((w.data ?? []) as Wine[]).filter((x) => x.orderable).map((x) => [x.id, x]));
    const settings = ((s.data ?? {}) as Record<string, unknown>);
    open = settings.orders_open === true;
    setPayee(settings.mobilepay ?? null);
    $('loading').hidden = true;
    $('closed').hidden = open;
    renderCart();
    renderHistory();
  }

  init();
</script>

<style is:global>
  .cart-page { padding-top: 2.5rem; padding-bottom: 3rem; }
  .cart-page .title {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(3rem, 16vw, 5rem);
    line-height: 0.9;
    margin-bottom: 1.25rem;
  }
  .cart-page .confirm, .cart-page #closed { margin-bottom: 1.5rem; }
  .cart-page .confirm p:last-child { margin-bottom: 0; }

  .cart-page .lines { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--lodge-3); }
  .cart-page .line { padding: 1rem 0; border-bottom: 1px solid var(--lodge-2); }
  .cart-page .line-name { margin: 0; font-weight: 500; line-height: 1.35; }
  .cart-page .line-unit { margin: 0.1rem 0 0.6rem; color: var(--muted); font-size: 0.9rem; }
  .cart-page .line-ctrl { display: flex; align-items: center; gap: 1rem; }
  .cart-page .line-total { margin-left: auto; font-variant-numeric: tabular-nums; }
  .cart-page .remove {
    font: inherit;
    font-size: 0.88rem;
    background: none;
    border: 0;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
    padding: 0.4rem 0;
  }
  .cart-page .remove:hover { color: var(--paper); }

  .cart-page .stepper {
    display: flex;
    align-items: center;
    border: 1px solid var(--lodge-3);
    border-radius: var(--radius);
    background: transparent;
  }
  .cart-page .step {
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: none;
    color: var(--paper);
    font-size: 1.35rem;
    cursor: pointer;
    border-radius: var(--radius);
  }
  .cart-page .step:disabled { color: var(--lodge-3); cursor: default; }
  .cart-page .count { min-width: 1.5rem; text-align: center; font-weight: 500; font-variant-numeric: tabular-nums; }

  .cart-page .sum {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.1rem 0;
    font-size: 1.15rem;
  }
  .cart-page .sum strong { font-size: 1.35rem; font-variant-numeric: tabular-nums; }
  .cart-page .send { width: 100%; margin-bottom: 0.6rem; }
  .cart-page #send-error { margin-bottom: 1rem; }

  .cart-page .history { margin-top: 3rem; }
  .cart-page .order {
    border: 1px solid var(--lodge-3);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    margin-bottom: 0.75rem;
    border-left: 4px solid var(--amber);
  }
  .cart-page .order.paid { border-left-color: var(--ok); }
  .cart-page .order-head, .cart-page .order-foot { display: flex; justify-content: space-between; gap: 1rem; }
  .cart-page .order .status { color: var(--amber); font-size: 0.9rem; }
  .cart-page .order.paid .status { color: var(--ok); }
  .cart-page .order .hint { margin: 0.1rem 0 0.5rem; font-size: 0.85rem; }
  .cart-page .order ul { margin: 0 0 0.6rem; padding-left: 1.1rem; font-size: 0.95rem; }
  .cart-page .order-foot { border-top: 1px solid var(--lodge-3); padding-top: 0.5rem; }

  .cart-page .pay-more { margin-top: 0.6rem; }
  .cart-page .pay-more summary { cursor: pointer; color: var(--amber); font-size: 0.95rem; padding: 0.3rem 0; }
</style>
