---
import Base from '../layouts/Base.astro';
---
<Base title="page.profile">
  <section class="wrap profile-page">
    <p id="loading" class="hint loading-line"><span class="glass-spinner" aria-hidden="true"></span><span data-i18n="common.loading">Loading …</span></p>

    <div id="signed-out" hidden>
      <h1 class="title" data-i18n="page.profile">Profile</h1>
      <p data-i18n="profile.signedOut">You are not signed in.</p>
      <a class="btn" href="/login/" data-i18n="login.submit">Sign in</a>
    </div>

    <div id="me" hidden>
      <!-- Name and email; edited only after tapping the pencil -->
      <header class="me-head">
        <div class="name-row">
          <h1 class="title" id="me-name"></h1>
          <button id="edit-toggle" class="icon-edit" type="button" aria-label="Edit name and email" title="Edit name and email" data-i18n-attr="aria-label=profile.edit;title=profile.edit">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4z" /><path d="M13.5 6.5l4 4" /></svg>
          </button>
        </div>
        <p id="me-email" class="hint"></p>
      </header>

      <!-- Edit panel: from the right on larger screens, a sheet from the bottom on phones -->
      <dialog id="edit-panel" class="sheet" aria-labelledby="edit-title">
        <div class="sheet-head">
          <h2 id="edit-title" data-i18n="profile.edit">Edit name and email</h2>
          <button id="edit-close" class="sheet-close" type="button" aria-label="Close" data-i18n-attr="aria-label=admin.close">×</button>
        </div>
      <form id="edit-form" class="profile-form" novalidate>
        <div id="name-field">
          <label for="name" data-i18n="profile.name">Your name</label>
          <input id="name" type="text" autocomplete="name" maxlength="80" />
          <p class="hint" data-i18n="profile.nameHint">Shown at the top of the site. Hosts may list you under the name they invited you by.</p>
        </div>
        <label for="email" data-i18n="common.email">Email</label>
        <input id="email" type="email" autocomplete="email" inputmode="email" maxlength="200" />
        <p id="edit-msg" class="message" hidden></p>
        <div class="row">
          <button id="edit-save" class="btn small" type="submit" data-i18n="common.save">Save</button>
          <button id="edit-cancel" class="btn small ghost" type="button" data-i18n="common.cancel">Cancel</button>
        </div>
      </form>
      </dialog>

      <!-- Only an invite link on this device -->
      <div id="link-only" class="message" hidden>
        <p data-i18n="profile.linkOnly">You are signed in with an invitation link on this device. Sign in with your email to see all your tastings on any device.</p>
        <a class="btn small" href="/login/" data-i18n="login.submit">Sign in</a>
      </div>

      <!-- Tastings, wines and orders live in the wine book -->
      <a class="book-link" href="/my/">
        <span><b data-i18n="book.title">My wine book</b><span data-i18n="book.linkText">The wines you have tasted, your tastings and what you have bought</span></span>
        <span aria-hidden="true">→</span>
      </a>

      <section id="host-block" class="profile-block" hidden>
        <h2 data-i18n="tastings.asHost">As a host</h2>
        <a class="btn small ghost" href="/admin/" data-i18n="tastings.toAdmin">Go to admin</a>
        <a class="btn small ghost" href="/home/" data-i18n="landing.goHome">Go to your home</a>
      </section>

      <!-- Hosts: what they want an email about (all tastings they host) -->
      <section id="notify" class="profile-block" hidden>
        <h2 data-i18n="notify.title">Email me when a guest …</h2>
        <div class="notify-list">
          <label class="toggle"><input type="checkbox" data-notify="notify_yes" /> <span data-i18n="notify.yes">says yes (or goes on the waiting list)</span></label>
          <label class="toggle"><input type="checkbox" data-notify="notify_no" /> <span data-i18n="notify.no">says no</span></label>
          <label class="toggle"><input type="checkbox" data-notify="notify_note" /> <span data-i18n="notify.note">writes a note or a diet</span></label>
          <label class="toggle"><input type="checkbox" data-notify="notify_chat" /> <span data-i18n="notify.chat">writes in the chat</span></label>
          <label class="toggle"><input type="checkbox" data-notify="notify_order" /> <span data-i18n="notify.order">orders wine</span></label>
        </div>
        <p class="hint" data-i18n="notify.hint">For all tastings you host. Several things at once come in one email per tasting.</p>
        <p id="notify-msg" class="hint" aria-live="polite"></p>
      </section>

      <section class="profile-block">
        <h2 data-i18n="profile.language">Language</h2>
        <ul id="lang-buttons" class="lang-list" role="list"></ul>
      </section>

      <button id="sign-out" class="btn ghost" type="button" data-i18n="nav.signOut">Sign out</button>
    </div>
  </section>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  import { loadMe, signOut, getCodes, tastingUrl } from '../lib/guest';
  import { i18nReady, t, LANGS, lang, setLang, money, locale } from '../i18n';
  import { FLAGS } from '../i18n/flags';

  await i18nReady;
  const $ = <E extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as E;
  const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;


  const me = await loadMe();
  $('loading').hidden = true;

  // ---------- Header and edit form ----------
  function showMe() {
    $('me-name').textContent = me?.name ?? t('nav.profile');
    $('me-email').textContent = me?.email ?? '';
  }

  function openEdit() {
    $<HTMLInputElement>('name').value = me?.name ?? '';
    $<HTMLInputElement>('email').value = me?.email ?? '';
    $('name-field').hidden = !me?.signedIn; // with only an invite link the host decides the name
    $('edit-msg').hidden = true;
    $<HTMLDialogElement>('edit-panel').showModal();
    $<HTMLInputElement>(me?.signedIn ? 'name' : 'email').focus();
  }
  function closeEdit() {
    $<HTMLDialogElement>('edit-panel').close();
  }
  function editMsg(text: string, ok: boolean) {
    const m = $('edit-msg');
    m.textContent = text;
    m.className = 'message ' + (ok ? 'ok' : 'error');
    m.hidden = false;
  }

  $('edit-toggle').addEventListener('click', openEdit);
  $('edit-cancel').addEventListener('click', closeEdit);
  $('edit-close').addEventListener('click', closeEdit);
  // Tap outside the panel (on the backdrop) to close
  $('edit-panel').addEventListener('click', (e) => { if (e.target === e.currentTarget) closeEdit(); });

  $('edit-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!me) return;
    const name = $<HTMLInputElement>('name').value.trim();
    const email = $<HTMLInputElement>('email').value.trim().toLowerCase();
    if (me.signedIn && !name) { editMsg(t('host.nameMissing'), false); return; }
    if (!EMAIL_RE.test(email)) { editMsg(t('guest.emailBad'), false); return; }
    const btn = $<HTMLButtonElement>('edit-save');
    btn.disabled = true;

    if (me.signedIn) {
      // Name: on the account (and as host name)
      if (name !== me.name) {
        const { error } = await supabase.auth.updateUser({ data: { name } });
        if (error) { btn.disabled = false; editMsg(t('admin.changesNotSaved'), false); return; }
        if (me.isHost) {
          const { data: hostId } = await supabase.rpc('current_host_id');
          if (hostId) await supabase.from('hosts').update({ name }).eq('id', hostId);
        }
        me.name = name;
        $('user-name').textContent = name;
        try { localStorage.setItem('display_name', name); } catch {}
      }
      // Email: the sign-in address changes once the confirmation link has been opened
      if (email !== (me.email ?? '').toLowerCase()) {
        const { error } = await supabase.auth.updateUser(
          { email }, { emailRedirectTo: location.origin + '/profile/' });
        btn.disabled = false;
        if (error) { editMsg(error.status === 429 ? t('login.tooManyMails') : t('profile.emailNotChanged'), false); return; }
        showMe();
        editMsg(t('profile.emailConfirm', { email }), true);
        return;
      }
    } else {
      // Only invite links: update the email on each invitation on this device
      for (const code of Object.values(getCodes())) {
        const { error } = await supabase.rpc('set_my_email', { code, e: email });
        if (error) {
          btn.disabled = false;
          editMsg(error.message.includes('bruges') ? t('guest.emailTaken')
            : error.message.includes('email_locked') ? t('guest.emailLocked') : t('guest.emailNotSaved'), false);
          return;
        }
      }
      me.email = email;
    }
    btn.disabled = false;
    showMe();
    closeEdit();
  });

  // ---------- Startup ----------
  if (!me) {
    $('signed-out').hidden = false;
  } else {
    $('me').hidden = false;
    showMe();
    $('link-only').hidden = me.signedIn;
    $('host-block').hidden = !me.isHost;
    if (me.isHost) initNotify();
  }

  // ---------- Emails to the host ----------
  async function initNotify() {
    const { data: hostId } = await supabase.rpc('current_host_id');
    if (!hostId) return;
    const { data } = await supabase.from('hosts').select('notify_yes, notify_no, notify_note, notify_chat, notify_order').eq('id', hostId).maybeSingle();
    if (!data) return;
    const row = data as Record<string, boolean>;
    $('notify').hidden = false;
    document.querySelectorAll<HTMLInputElement>('input[data-notify]').forEach((box) => {
      box.checked = row[box.dataset.notify!] === true;
      box.addEventListener('change', async () => {
        const { error } = await supabase.from('hosts').update({ [box.dataset.notify!]: box.checked }).eq('id', hostId);
        if (error) box.checked = !box.checked;
        $('notify-msg').textContent = error ? t('admin.changeNotSaved') : t('common.saved');
        setTimeout(() => ($('notify-msg').textContent = ''), 2000);
      });
    });
    if (location.hash === '#notify') $('notify').scrollIntoView({ block: 'start' });
  }

  // Languages as a quiet list: flag, name and a tick on the current one
  for (const l of LANGS) {
    const li = document.createElement('li');
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'lang-option';
    b.lang = l.code;
    b.innerHTML = FLAGS[l.code];
    const name = document.createElement('span');
    name.textContent = l.name;
    b.append(name);
    if (l.code === lang()) {
      b.setAttribute('aria-current', 'true');
      b.insertAdjacentHTML('beforeend', '<svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>');
    }
    b.addEventListener('click', () => { if (l.code !== lang()) setLang(l.code); });
    li.append(b);
    $('lang-buttons').append(li);
  }

  $('sign-out').addEventListener('click', () => {
    signOut();
    location.href = '/';
  });
</script>

<style is:global>
  .notify-list { display: grid; gap: 0.5rem; margin: 0.5rem 0 0.75rem; }
  .notify-list .toggle { display: flex; align-items: center; gap: 0.6rem; cursor: pointer; }
  .notify-list input { width: 1.1rem; height: 1.1rem; accent-color: var(--ruby, #6e0f1f); }
  .profile-page { padding-top: 2.5rem; padding-bottom: 3rem; max-width: 48rem; }
  .profile-page .title {
    font-family: var(--display); font-weight: 400; font-size: clamp(2.6rem, 12vw, 4.5rem);
    line-height: 0.95; margin-bottom: 0.4rem; overflow-wrap: anywhere;
  }
  .profile-page .name-row { display: flex; align-items: center; gap: 0.75rem; }
  /* The name stays on one line (shortened with … if it is very long) */
  .profile-page .name-row .title {
    margin: 0; min-width: 0; font-size: clamp(1.5rem, 6.5vw, 3rem); line-height: 1.15;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; overflow-wrap: normal;
  }
  .profile-page .me-head .hint { margin: 0.4rem 0 0; }
  .profile-page .icon-edit {
    flex: none; width: 2.6rem; height: 2.6rem; display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%; border: 1px solid var(--lodge-3); background: transparent; color: var(--paper); cursor: pointer;
  }
  .profile-page .icon-edit:hover { border-color: var(--amber); color: var(--amber); }
  .profile-page .icon-edit svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .profile-page .btn.ghost { background: transparent; color: var(--paper); border-color: var(--lodge-3); }
  .profile-page .btn.ghost:hover { border-color: var(--amber); color: var(--amber); }
  .profile-page .btn.small { min-height: 2.5rem; padding: 0 1rem; }
  .profile-page .profile-form { display: grid; gap: 0.4rem; }

  .profile-page .profile-form #name-field { display: grid; gap: 0.4rem; margin-bottom: 0.4rem; }
  .profile-page .profile-form .hint { margin: 0; font-size: 0.88rem; }
  .profile-page .profile-form .row { display: flex; gap: 0.6rem; margin-top: 0.4rem; }
  .profile-page #link-only { margin-top: 1.5rem; }
  .profile-page .profile-block { margin-top: 2.5rem; }
  .profile-page .profile-block h2 { font-size: 1.6rem; }
  .profile-page .book-link {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 2rem;
    padding: 1.1rem 1.25rem; border: 1px solid var(--lodge-3); border-radius: 0.8rem; background: var(--lodge-2);
    color: var(--paper); text-decoration: none;
  }
  .profile-page .book-link:hover { border-color: var(--amber); }
  .profile-page .book-link b { display: block; font-size: 1.1rem; }
  .profile-page .book-link span span { display: block; color: var(--muted); font-size: 0.9rem; margin-top: 0.15rem; }
  .profile-page .lang-list {
    list-style: none; margin: 0; padding: 0; max-width: 34rem;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); gap: 0.4rem;
  }
  .profile-page .lang-list .lang-option {
    display: flex; align-items: center; gap: 0.6rem; width: 100%; padding: 0.6rem 0.75rem;
    font: inherit; font-size: 0.95rem; color: var(--paper); text-align: left; cursor: pointer;
    background: var(--lodge-2); border: 1px solid var(--lodge-3); border-radius: 0.55rem;
    transition: border-color 0.15s;
  }
  .profile-page .lang-list .lang-option:hover { border-color: var(--muted); }
  .profile-page .lang-list .lang-option[aria-current='true'] { border-color: var(--amber); box-shadow: inset 0 0 0 1px var(--amber); font-weight: 600; }
  .profile-page .lang-list .lang-option span { flex: 1; }
  .profile-page .lang-list .flag { width: 1.1rem; height: auto; aspect-ratio: 3 / 2; border-radius: 2px; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12); flex-shrink: 0; }
  .profile-page .lang-list .tick { width: 1rem; height: 1rem; fill: none; stroke: var(--amber); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .profile-page > div > .btn.ghost:last-child { margin-top: 2.5rem; }
</style>
