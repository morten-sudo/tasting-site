---
import Icon from '../components/ui/Icon.astro';
import Sheet from '../components/ui/Sheet.astro';
import Switch from '../components/ui/Switch.astro';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Loading from '../components/ui/Loading.astro';
import Notice from '../components/ui/Notice.astro';
import SignInState from '../components/ui/SignInState.astro';
---
<Base title="page.profile">
  <section class="wrap profile-page">
    <Loading />

    <div id="signed-out" hidden>
      <PageHeader title="page.profile" />
      <SignInState title="gate.profileTitle" hidden={false} />
    </div>

    <div id="me" hidden>
      <!-- Name and email; edited only after tapping the pencil -->
      <PageHeader id="me-name" leadId="me-email">
        <button slot="actions" id="edit-toggle" class="icon-act md" type="button" aria-label="Edit name and email" data-tip="Edit name and email" data-i18n-attr="aria-label=profile.edit;data-tip=profile.edit"><Icon name="edit" /></button>
      </PageHeader>
      <!-- A new email waits for its confirmation link -->
      <Notice id="email-pending" hidden />

      <!-- Edit panel: from the right on larger screens, a sheet from the bottom on phones -->
      <Sheet id="edit-panel" title="profile.edit" titleId="edit-title" form="edit-form" formClass="profile-form">
        <div id="name-field" class="sh-part">
          <label for="name" data-i18n="profile.name">Your name</label>
          <input class="input" id="name" type="text" autocomplete="name" maxlength="80" />
          <p class="help" data-i18n="profile.nameHint">Shown at the top of the site. Hosts may list you under the name they invited you by.</p>
        </div>
        <label for="email" data-i18n="common.email">Email</label>
        <input class="input" id="email" type="email" autocomplete="email" inputmode="email" maxlength="200" />
        <button slot="foot" id="edit-save" class="btn" type="submit" data-i18n="common.save">Save</button>
      </Sheet>

      <!-- Only an invite link on this device -->
      <Notice id="link-only" hidden>
        <p data-i18n="profile.linkOnly">You are signed in with an invitation link on this device. Sign in with your email to see all your tastings on any device.</p>
        <div class="actions"><a class="btn small secondary" href="/login/?next=/profile/" data-i18n="login.submit">Sign in</a></div>
      </Notice>

      <!-- Tastings, wines and orders live in the wine book -->
      <a class="card book-link" href="/my/">
        <span><b data-i18n="book.title">My wine book</b><span data-i18n="book.linkText">The wines you have tasted, your tastings and what you have bought</span></span>
        <Icon name="right" />
      </a>

      <section id="host-block" class="profile-block" hidden>
        <h2 data-i18n="tastings.asHost">As a host</h2>
        <a class="btn small secondary" href="/admin/" data-i18n="tastings.toAdmin">Go to admin</a>
        <a class="btn small secondary" href="/home/" data-i18n="landing.goHome">Go to your home</a>
      </section>

      <!-- Hosts: what they want an email about (all tastings they host) -->
      <section id="notify" class="profile-block" hidden>
        <h2 data-i18n="notify.title">Email me when a guest …</h2>
        <p class="hint" data-i18n="notify.hint">For all tastings you host. Several things at once come in one email per tasting.</p>
        <!-- Each is on or off and saved straight away: the one switch (component 11) -->
        <div class="notify-list">
          <Switch title="notify.yes" data-notify="notify_yes" />
          <Switch title="notify.no" data-notify="notify_no" />
          <Switch title="notify.note" data-notify="notify_note" />
          <Switch title="notify.chat" data-notify="notify_chat" />
          <Switch title="notify.order" data-notify="notify_order" last />
        </div>
      </section>

      <section class="profile-block">
        <h2 data-i18n="profile.language">Language</h2>
        <div id="lang-buttons" class="lang-list"></div>
      </section>

      <button id="sign-out" class="btn secondary" type="button" data-i18n="nav.signOut">Sign out</button>
    </div>
  </section>
</Base>

<script>
  import { formatKr } from '../lib/ui/kr';
  import { supabase } from '../lib/supabase';
  import { loadMe, signOut, getCodes, tastingUrl } from '../lib/guest';
  import { i18nReady, t, LANGS, lang, setLang, locale, type Lang } from '../i18n';
  import { FLAGS } from '../i18n/flags';
  import { bindSwitch } from '../lib/ui/switch';
  import { sheetPanel } from '../lib/ui/sheet';
  import { toast } from '../lib/ui/toast';
  import { setNotice } from '../lib/ui/notice';
  import { setLoading } from '../lib/ui/button';
  import { fieldError } from '../lib/field-error';
  import { choiceCards } from '../lib/ui/choice-cards';

  await i18nReady;
  const $ = <E extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as E;
  const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;


  const me = await loadMe();
  $('loading').hidden = true;

  // ---------- Header and edit form ----------
  function showMe() {
    $('me-name').textContent = me?.name ?? t('nav.profile');
    $('me-email').textContent = me?.email ?? '';
  }

  function openEdit() {
    $<HTMLInputElement>('name').value = me?.name ?? '';
    $<HTMLInputElement>('email').value = me?.email ?? '';
    $('name-field').hidden = !me?.signedIn; // with only an invite link the host decides the name
    for (const id of ['name', 'email']) fieldError($(id), null);
    panel.open();
    $<HTMLInputElement>(me?.signedIn ? 'name' : 'email').focus();
  }
  // The one side panel: closing with changes asks first
  const panel = sheetPanel($<HTMLDialogElement>('edit-panel'), { dirty: 'form' });
  const closeEdit = () => panel.close();
  const bad = (id: string, text: string) => { fieldError($(id), text); $(id).focus(); };

  $('edit-toggle').addEventListener('click', openEdit);

  $('edit-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!me) return;
    const name = $<HTMLInputElement>('name').value.trim();
    const email = $<HTMLInputElement>('email').value.trim().toLowerCase();
    if (me.signedIn && !name) { bad('name', t('host.nameMissing')); return; }
    if (!EMAIL_RE.test(email)) { bad('email', t('guest.emailBad')); return; }
    const btn = $<HTMLButtonElement>('edit-save');
    setLoading(btn, true);

    if (me.signedIn) {
      // Name: on the account (and as host name)
      if (name !== me.name) {
        const { error } = await supabase.auth.updateUser({ data: { name } });
        if (error) { setLoading(btn, false); toast(t('admin.changesNotSaved'), { kind: 'error' }); return; }
        if (me.isHost) {
          const { data: hostId } = await supabase.rpc('current_host_id');
          if (hostId) await supabase.from('hosts').update({ name }).eq('id', hostId);
        }
        me.name = name;
        $('user-name').textContent = name;
        try { localStorage.setItem('display_name', name); } catch {}
      }
      // Email: the sign-in address changes once the confirmation link has been opened
      if (email !== (me.email ?? '').toLowerCase()) {
        const { error } = await supabase.auth.updateUser(
          { email }, { emailRedirectTo: location.origin + '/profile/' });
        setLoading(btn, false);
        if (error) { toast(error.status === 429 ? t('login.tooManyMails') : t('profile.emailNotChanged'), { kind: 'error' }); return; }
        showMe();
        closeEdit();
        setNotice($('email-pending'), t('profile.emailConfirm', { email }));
        return;
      }
    } else {
      // Only invite links: update the email on each invitation on this device
      for (const code of Object.values(getCodes())) {
        const { error } = await supabase.rpc('set_my_email', { code, e: email });
        if (error) {
          setLoading(btn, false);
          if (error.message.includes('bruges')) bad('email', t('guest.emailTaken'));
          else if (error.message.includes('email_locked')) bad('email', t('guest.emailLocked'));
          else toast(t('guest.emailNotSaved'), { kind: 'error' });
          return;
        }
      }
      me.email = email;
    }
    setLoading(btn, false);
    showMe();
    closeEdit();
    toast(t('common.saved'));
  });

  // ---------- Startup ----------
  if (!me) {
    $('signed-out').hidden = false;
  } else {
    $('me').hidden = false;
    showMe();
    $('link-only').hidden = me.signedIn;
    $('host-block').hidden = !me.isHost;
    if (me.isHost) initNotify();
  }

  // ---------- Emails to the host ----------
  async function initNotify() {
    const { data: hostId } = await supabase.rpc('current_host_id');
    if (!hostId) return;
    const { data } = await supabase.from('hosts').select('notify_yes, notify_no, notify_note, notify_chat, notify_order').eq('id', hostId).maybeSingle();
    if (!data) return;
    const row = data as Record<string, boolean>;
    $('notify').hidden = false;
    document.querySelectorAll<HTMLInputElement>('input[data-notify]').forEach((box) => {
      box.checked = row[box.dataset.notify!] === true;
      bindSwitch(box, { save: async (on) => !(await supabase.from('hosts').update({ [box.dataset.notify!]: on }).eq('id', hostId)).error });
    });
    if (location.hash === '#notify') $('notify').scrollIntoView({ block: 'start' });
  }

  // Languages: the choice cards, compact (flag and name); choosing one switches straight away
  const langs = choiceCards({
    name: 'language', legend: t('profile.language'), compact: true, value: lang(),
    options: LANGS.map((l) => ({ value: l.code, label: l.name, lead: FLAGS[l.code], lang: l.code })),
    onChange: (code) => setLang(code as Lang),
  });
  langs.el.querySelector('legend')!.className = 'sr';
  $('lang-buttons').append(langs.el);

  $('sign-out').addEventListener('click', () => {
    signOut();
    location.href = '/';
  });
</script>

<style is:global>
  .notify-list { margin: 0.75rem 0 0; max-width: 34rem; }
  .profile-page { padding-top: 2.5rem; padding-bottom: 3rem; max-width: 48rem; }
  .profile-page .profile-block { margin-top: 2.5rem; }
  .profile-page .book-link { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 2rem; }
  .profile-page .book-link svg { color: var(--amber); }
  .profile-page .book-link b { display: block; font-weight: 600; }
  .profile-page .book-link span span { display: block; color: var(--muted); font-size: 0.9rem; margin-top: 0.15rem; }
  .profile-page .lang-list { max-width: 34rem; }
  .profile-page .lang-list .cc.compact { grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); }
  .profile-page #sign-out { margin-top: 2.5rem; }
</style>
