---
import Icon from '../components/ui/Icon.astro';
import Checkbox from '../components/ui/Checkbox.astro';
import Base from '../layouts/Base.astro';
import Hero from '../components/ui/Hero.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Loading from '../components/ui/Loading.astro';
import Notice from '../components/ui/Notice.astro';
import Steps from '../components/ui/Steps.astro';
import Disclosure from '../components/ui/Disclosure.astro';
---
<Base title="page.login">
  <section class="login-page">
    <!-- Left (top on phones): the cellar photo and what you can do here -->
    <Hero size="fill" class="lp-visual" eyebrow="Winetastr" title="loginx.claim" titleTag="p" sizes="(min-width: 60rem) 50vw, 100vw">
        <div class="lp-roles">
        <div class="lp-role">
          <h2 class="eyebrow" data-i18n="loginx.asGuest">As a guest</h2>
          <ul>
            <li><Icon name="check" /><span data-i18n="loginx.g1">Reply to the invitation</span></li>
            <li><Icon name="bottle" /><span data-i18n="loginx.g2">See the wines of the evening</span></li>
            <li><Icon name="cart" /><span data-i18n="loginx.g3">Order bottles and pay with MobilePay</span></li>
            <li><Icon name="star" /><span data-i18n="loginx.g4">Rate, play the quiz and chat</span></li>
          </ul>
        </div>
        <div class="lp-role">
          <h2 class="eyebrow" data-i18n="loginx.asHost">As a host</h2>
          <ul>
            <li><Icon name="calendar" /><span data-i18n="loginx.h1">Set up a tasting in minutes</span></li>
            <li><Icon name="users" /><span data-i18n="loginx.h2">Invite guests and follow replies</span></li>
            <li><Icon name="camera" /><span data-i18n="loginx.h3">Snap the label – the wine fills itself in</span></li>
            <li><Icon name="grid" /><span data-i18n="loginx.h4">Keep track of orders and payments</span></li>
          </ul>
        </div>
      </div>
    </Hero>

    <!-- Right: signing in -->
    <div class="lp-main">
      <div class="card lp-card">
        <PageHeader title="login.title" />
        <!-- An invitation for another email, opened while signed in -->
        <Notice id="other-invite" tone="warn" hidden>
          <p data-i18n="login.otherInvite">This invitation is for another email than the one you are signed in with.</p>
          <div class="actions">
            <button id="other-signout" class="btn small" type="button" data-i18n="login.otherSignOut">Sign out and open the invitation</button>
            <a id="other-stay" class="text-btn" href="/home/" data-i18n="login.otherStay">Stay signed in</a>
          </div>
        </Notice>
        <Loading id="checking" text="login.checking" hidden />

        <div id="forms">
          <!-- Two steps: email, then the code from the email -->
          <Steps id="login-steps" label="Sign in" labelKey="login.submit" items={[{ label: 'common.email', id: 'step-mail' }, { label: 'loginx.code', id: 'step-code' }]} />

          <!-- Step 1: email -->
          <form id="mail-form" class="login-form" novalidate>
            <p class="lp-lead" id="mail-lead" data-i18n="login.mailLead">Enter your email and we will send you a code.</p>
            <label for="email" data-i18n="common.email">Email</label>
            <input class="input" id="email" type="email" autocomplete="email" inputmode="email" required />
            <!-- Remember me: stay signed in on this device and fill in the email next time -->
            <Checkbox label="login.remember" id="remember" checked />
            <button class="btn" type="submit" id="mail-btn" data-i18n="login.sendCode">Send code</button>
            <p class="hint lp-fine" data-i18n="loginx.noPassword">No password needed – we email you a one-time code.</p>
          </form>

          <!-- Step 2: code from the email -->
          <form id="otp-form" class="login-form" novalidate hidden>
            <!-- The same words whether the email is known or not (WIN-181): the page never says which -->
            <p class="lp-lead" id="sent-lead"></p>
            <label for="otp" data-i18n="login.codeLabel">Code from the email</label>
            <input id="otp" class="input code" type="text" inputmode="numeric" autocomplete="one-time-code"
                   pattern="[0-9]*" maxlength="10" required />
            <button class="btn" type="submit" id="otp-btn" data-i18n="login.submit">Sign in</button>
            <p class="hint small-links">
              <button id="resend" class="text-btn" type="button" data-i18n="login.resend">Send a new code</button>
              <span aria-hidden="true">·</span>
              <button id="other-mail" class="text-btn" type="button" data-i18n="login.otherEmail">Use another email</button>
            </p>
            <Notice id="no-code" title="login.noCodeTitle" class="lp-nocode">
              <p data-i18n="login.noCodeHelp">Check that the email is spelled correctly and look in your spam folder. You can also sign in with the link from your invitation.</p>
            </Notice>
          </form>

          <p class="lp-or"><span data-i18n="loginx.or">or</span></p>

          <!-- Invite link or code -->
          <Disclosure id="alt-invite" class="boxed" icon="link" summary="login.inviteSummary">
            <form id="code-form" class="login-form" novalidate>
              <p data-i18n-html="login.inviteHelp">Paste the link from your invitation.</p>
              <label for="code" data-i18n="login.inviteLabel">Invitation link</label>
              <input class="input" id="code" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" required />
              <button class="btn" type="submit" data-i18n="login.submit">Sign in</button>
            </form>
          </Disclosure>


          <p class="hint lp-fine lp-lost" data-i18n="login.lostHint">
            If we don't know your email, sign in with your invitation link and add it on your page.
            If you have lost both, contact the host.
          </p>
        </div>
      </div>

      <a class="card lp-signup" href="/signup/">
        <span><b data-i18n="loginx.newHere">New to Winetastr?</b> <span data-i18n="loginx.newHereText">Create a free account and host your first tasting.</span></span>
        <Icon name="right" />
      </a>
    </div>
  </section>
</Base>

<script>
  import { setSteps } from '../lib/ui/progress';
  // The step indicator follows which form is showing
  {
    const otpForm = document.getElementById('otp-form')!;
    const sync = () => setSteps(document.getElementById('login-steps')!, otpForm.hidden ? 0 : 1);
    new MutationObserver(sync).observe(otpForm, { attributes: true, attributeFilter: ['hidden'] });
    // On phones the "what you can do" lists follow below the sign-in card
    const roles = document.querySelector('.lp-roles');
    if (roles) {
      const copy = roles.cloneNode(true) as HTMLElement;
      copy.classList.add('lp-roles-below');
      document.querySelector('.lp-main')!.append(copy);
    }
  }
</script>

<script>
  import { setLoading } from '../lib/ui/button';
  import { toast } from '../lib/ui/toast';
  import { fieldError } from '../lib/field-error';
  import { supabase, setRememberMe, rememberMe, lastEmail } from '../lib/supabase';
  import { fetchMyTastings, setCode, tastingUrl, signOut as guestSignOut } from '../lib/guest';
  import { landingUrl } from '../lib/landing';
  import { i18nReady, lang, t } from '../i18n';

  await i18nReady;
  import { $ } from '../lib/ui/dom';
  const params = new URLSearchParams(location.search);
  // Remember me: the choice from last time, and the email when it was remembered
  ($('remember') as HTMLInputElement).checked = rememberMe();
  { const last = lastEmail(); const el = $('email') as HTMLInputElement; if (last && !el.value) el.value = last; }
  const rawNext = params.get('next') ?? '';
  // Only a page on this site: read as the browser would (so "/\\evil.example" and "//evil.example" are another site)
  const next = (() => {
    if (!rawNext.startsWith('/')) return '';
    try {
      const u = new URL(rawNext, location.origin);
      return u.origin === location.origin ? u.pathname + u.search + u.hash : '';
    } catch { return ''; }
  })();
  const wantsAdmin = /^\/(t\/[a-z0-9-]+\/)?admin\//.test(next);

  let email = '';

  // Problems with what was typed go under the field; problems with sending as a toast
  const bad = (id: string, text: string) => { fieldError($(id), text); $(id).focus(); };
  const failed = (text: string) => toast(text, { kind: 'error' });

  // ---------- After sign-in: send the user to the right place ----------
  let routing = false;
  async function route() {
    if (routing) return true;
    const { data } = await supabase.auth.getSession();
    if (!data.session) return false;
    routing = true;
    // Sign-in emails use the language stored on the account
    if (data.session.user.user_metadata?.lang !== lang()) {
      supabase.auth.updateUser({ data: { lang: lang() } }).catch(() => {});
    }
    $('forms').hidden = true;
    $('checking').hidden = false;

    // A link that asked for sign-in goes back there; otherwise everyone lands on their home
    if (next) { location.replace(next); return true; }
    const [mine, hostRes, adminRes] = await Promise.all([
      fetchMyTastings(),
      supabase.rpc('current_host_id'),
      supabase.rpc('is_admin'),
    ]);
    const to = landingUrl(mine, !!hostRes.data, adminRes.data === true);
    if (to) { location.replace(to); return true; }

    routing = false;
    $('checking').hidden = true;
    $('forms').hidden = false;
    showMailStep();
    bad('email', t('login.notOnList'));
    await supabase.auth.signOut({ scope: 'local' });
    return true;
  }

  supabase.auth.onAuthStateChange((event) => {
    if (event === 'SIGNED_IN') route();
  });
  if (location.hash.includes('access_token') || params.has('code')) {
    $('forms').hidden = true;
    $('checking').hidden = false;
  }

  // ---------- Step 1: send code ----------
  function showMailStep() {
    $('otp-form').hidden = true;
    $('mail-form').hidden = false;
    ($('email') as HTMLInputElement).focus();
  }

  // Asks Supabase to send a code. The answer looks the same whether the email is known or not, so
  // the page shows the same next step for both (WIN-181). Only problems that do not depend on the
  // email are shown: the connection, or too many emails in a short time.
  const NOT_SENT_FOR_UNKNOWN = ['otp_disabled', 'signup_disabled', 'user_not_found'];
  async function sendCode(): Promise<boolean> {
    const redirect = location.origin + '/login/' + (next ? '?next=' + encodeURIComponent(next) : '');
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { emailRedirectTo: redirect, shouldCreateUser: true, data: { lang: lang() } },
    });
    // Answers that would only come for an email we do not know (if sign-ups are turned off) are shown as sent
    if (error?.code && NOT_SENT_FOR_UNKNOWN.includes(error.code)) return true;
    if (error?.status === 429) {
      failed(t('login.tooManyMails'));
      return false;
    }
    if (error) {
      failed(t('login.sendFailed'));
      return false;
    }
    // Counted for the superadmin's Usage page (the code is sent through Resend)
    supabase.rpc('log_usage', { feature: 'login' }).then(() => {}, () => {});
    return true;
  }

  $('mail-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    email = ($('email') as HTMLInputElement).value.trim().toLowerCase();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { bad('email', t('common.invalidEmail')); return; }
    // Chosen before signing in, so the session is kept where the guest wants it
    setRememberMe(($('remember') as HTMLInputElement).checked, email);

    const btn = $('mail-btn') as HTMLButtonElement;
    setLoading(btn, true, t('common.sending'));
    const ok = await sendCode();
    setLoading(btn, false);
    if (!ok) return;

    showSentLead();
    $('mail-form').hidden = true;
    $('otp-form').hidden = false;
    fieldError($('otp'), null);
    ($('otp') as HTMLInputElement).value = '';
    ($('otp') as HTMLInputElement).focus();
  });

  // "We have sent a code to <email> if we know the email": the email in bold, so a typo is easy to see
  function showSentLead() {
    const lead = $('sent-lead');
    const [before, after = ''] = t('login.sentIfKnown').split('{email}');
    const strong = document.createElement('strong');
    strong.textContent = email;
    lead.replaceChildren(before, strong, after);
  }

  // ---------- Step 2: verify the code ----------
  $('otp-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = ($('otp') as HTMLInputElement).value.replace(/\D/g, '');
    if (token.length < 6) { bad('otp', t('login.wholeCode')); return; }

    const btn = $('otp-btn') as HTMLButtonElement;
    setLoading(btn, true, t('login.checkingCode'));
    const { error } = await supabase.auth.verifyOtp({ email, token, type: 'email' });
    setLoading(btn, false);
    if (error) {
      bad('otp', error.status === 429 ? t('login.tooManyTries') : t('login.wrongCode'));
      return;
    }
    route();
  });

  $('resend').addEventListener('click', async () => {
    const ok = await sendCode();
    if (ok) toast(t('login.resent'));
    else { $('otp-form').hidden = true; $('mail-form').hidden = false; }
  });

  $('other-mail').addEventListener('click', () => {
    fieldError($('email'), null);
    showMailStep();
  });

  // Digits only in the code field (also when pasted with spaces)
  ($('otp') as HTMLInputElement).addEventListener('input', (e) => {
    const v = (e.target as HTMLInputElement).value.replace(/\D/g, '');
    (e.target as HTMLInputElement).value = v;
  });

  // ---------- Invite link or code ----------
  function extractCode(raw: string) {
    const v = raw.trim();
    const m = v.match(/[?&]k=([A-Za-z0-9]+)/);
    return (m ? m[1] : v).trim();
  }

  $('code-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = extractCode(($('code') as HTMLInputElement).value);
    if (!code) { bad('code', t('login.pasteCode')); return; }
    const { data } = await supabase.rpc('get_invite', { code });
    const row = Array.isArray(data) ? data[0] : null;
    if (!row) { bad('code', t('login.codeNotFound')); return; }
    const { data: info } = await supabase.rpc('get_tasting', { code });
    const slug = (info as { slug?: string } | null)?.slug;
    if (!slug) { bad('code', t('login.codeNotFound')); return; }
    setCode(slug, code);
    location.href = tastingUrl(slug);
  });

  if (wantsAdmin) {
    (document.querySelector('#mail-form .lp-lead') as HTMLElement).textContent =
      t('login.hostMailLead');
    $('alt-invite').hidden = true;
    (document.querySelector('.lp-or') as HTMLElement).hidden = true;
  }

  // Opened an invitation for someone else while signed in: choose to sign out and open it, or stay
  async function handleOther(): Promise<boolean> {
    const code = params.get('other');
    if (!code) return false;
    const { data } = await supabase.auth.getSession();
    if (!data.session) {
      // Not signed in (any more): the invitation opens as usual
      const { data: tr } = await supabase.rpc('get_tasting', { code });
      const slug = (tr as { slug?: string } | null)?.slug;
      if (slug) { location.replace(`${tastingUrl(slug)}?k=${encodeURIComponent(code)}`); return true; }
      return false;
    }
    $('forms').hidden = true;
    $('other-invite').hidden = false;
    $('other-signout').addEventListener('click', async () => {
      guestSignOut();
      await supabase.auth.signOut({ scope: 'local' }).catch(() => {});
      const { data: tr } = await supabase.rpc('get_tasting', { code });
      const slug = (tr as { slug?: string } | null)?.slug;
      location.replace(slug ? `${tastingUrl(slug)}?k=${encodeURIComponent(code)}` : '/login/');
    });
    return true;
  }
  if (!(await handleOther())) route();
</script>

<style>
  .login-page { display: grid; min-height: calc(100vh - 4rem); background: var(--lodge); }
  @media (min-width: 60rem) { .login-page { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }

  /* Photo side: the one hero (Hero.astro) filling the column */
  .lp-visual { min-height: 15rem; }
  .lp-visual :global(.hero-in) { padding: 1.5rem var(--gutter) 3.5rem; }
  .lp-visual :global(.hero-title) { font-size: clamp(2rem, 7vw, 3.4rem); max-width: 14ch; }
  .lp-roles { display: none; }
  @media (min-width: 60rem) {
    .lp-visual { min-height: 0; }
    .lp-visual :global(.hero-in) { padding: 3rem clamp(2rem, 4vw, 4rem); }
    .lp-roles { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2.25rem; }
  }
  .lp-role h2 { margin: 0 0 0.75rem; }
  .lp-role ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .lp-role li { display: flex; gap: 0.65rem; align-items: flex-start; font-size: 0.97rem; line-height: 1.35; }
  .lp-role :global(svg.i) { width: 1.2rem; height: 1.2rem; margin-top: 0.05rem; color: #f3d9c4; }

  .lp-roles.lp-roles-below { display: grid; gap: 1.5rem; width: 100%; max-width: 28rem; align-self: center; margin-top: 1rem; color: var(--paper); }
  .lp-roles-below :global(svg.i) { color: var(--amber); }
  @media (min-width: 60rem) { .lp-roles.lp-roles-below { display: none; } }

  /* Sign-in side */
  .lp-main { padding: 1.5rem var(--gutter) 2.5rem; display: flex; flex-direction: column; gap: 1rem; align-items: stretch; }
  @media (min-width: 60rem) { .lp-main { justify-content: center; padding: 3rem clamp(2rem, 5vw, 5rem); } }
  .lp-card { width: 100%; max-width: 28rem; align-self: center; padding: 1.75rem 1.5rem; }
  @media (max-width: 30rem) { .lp-card { padding: 1.4rem 1.1rem; margin-top: -2.5rem; position: relative; } }
  .lp-card :global(.ph) { margin-bottom: 1rem; }

  .lp-lead { margin: 0 0 0.3rem; }
  .login-form { display: grid; gap: 0.6rem; }
  .login-form .btn { justify-self: stretch; margin-top: 0.3rem; }
  .lp-fine { font-size: 0.85rem; margin: 0.2rem 0 0; }
  .small-links { margin: 0.2rem 0 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0 0.5rem; }
  /* The email on a line of its own rather than broken at a hyphen, so a typo is easy to see */
  #sent-lead :global(strong) { display: inline-block; max-width: 100%; overflow-wrap: anywhere; }

  .lp-or { display: flex; align-items: center; gap: 0.75rem; margin: 1.4rem 0 0.6rem; color: var(--muted); font-size: 0.82rem; }
  .lp-or::before, .lp-or::after { content: ''; flex: 1; height: 1px; background: var(--lodge-3); }
  #alt-invite .login-form { padding-bottom: 0.2rem; }
  .lp-lost { margin-top: 1.2rem; }
  .lp-nocode { margin-top: 0.5rem; font-size: 0.9rem; }
  code { font-size: 0.9em; color: var(--amber); }


  .lp-signup { width: 100%; max-width: 28rem; align-self: center; display: flex; justify-content: space-between; align-items: center; gap: 1rem; font-size: 0.93rem; line-height: 1.4; }
  .lp-signup b { font-weight: 600; }
  .lp-signup svg { color: var(--amber); }
</style>
