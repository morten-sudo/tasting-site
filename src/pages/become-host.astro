---
import Base from '../layouts/Base.astro';
---
<Base title="page.becomeHost">
  <section class="wrap host-page">
    <p class="eyebrow" data-i18n="host.eyebrow">Free</p>
    <h1 class="title" data-i18n="host.title">Host your own tasting</h1>
    <p class="lead" data-i18n="host.lead">
      Invite your guests, show them the wines, take orders and finish with a quiz.
      Sign up with your email and you are ready in a few minutes.
    </p>

    <p id="checking" class="hint" hidden data-i18n="host.creating">Setting you up as a host …</p>

    <!-- Step 1: name and email -->
    <form id="start-form" class="login-form" novalidate>
      <label for="name" data-i18n="host.name">Your name</label>
      <input id="name" type="text" autocomplete="name" required />
      <div id="email-wrap">
        <label for="email" data-i18n="common.email">Email</label>
        <input id="email" type="email" autocomplete="email" inputmode="email" required />
      </div>
      <p id="start-msg" class="message" hidden></p>
      <button class="btn" type="submit" id="start-btn" data-i18n="login.sendCode">Send code</button>
    </form>

    <!-- Step 2: code from the email -->
    <form id="otp-form" class="login-form" novalidate hidden>
      <p><span data-i18n="login.sentTo">We have sent a code to</span> <strong id="sent-to"></strong>. <span data-i18n="login.enterIt">Enter it here.</span></p>
      <label for="otp" data-i18n="login.codeLabel">Code from the email</label>
      <input id="otp" class="otp" type="text" inputmode="numeric" autocomplete="one-time-code"
             pattern="[0-9]*" maxlength="10" required />
      <p id="otp-msg" class="message" hidden></p>
      <button class="btn" type="submit" id="otp-btn" data-i18n="host.create">Make me a host</button>
      <p class="hint">
        <button id="back" class="link-btn" type="button" data-i18n="host.back">Change name or email</button>
      </p>
    </form>

    <p class="hint small" data-i18n-html="host.already">Already a host? <a href="/login/?next=%2Fadmin%2F">Sign in here</a>.</p>
  </section>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  import { i18nReady, lang, t } from '../i18n';

  await i18nReady;

  const $ = (id: string) => document.getElementById(id)!;
  const NAME_KEY = 'wt_host_name';
  let email = '';

  function show(el: HTMLElement, text: string, ok: boolean) {
    el.textContent = text;
    el.className = 'message ' + (ok ? 'ok' : 'error');
    el.hidden = false;
  }

  function remember(name: string) { try { localStorage.setItem(NAME_KEY, name); } catch {} }
  function remembered() { try { return localStorage.getItem(NAME_KEY) ?? ''; } catch { return ''; } }

  // Signed in: make the user a host and go to admin
  let busy = false;
  async function finish(name: string) {
    if (busy) return;
    busy = true;
    $('start-form').hidden = true;
    $('otp-form').hidden = true;
    $('checking').hidden = false;
    const { error } = await supabase.rpc('become_host', { host_name: name });
    if (error) {
      busy = false;
      $('checking').hidden = true;
      $('start-form').hidden = false;
      show($('start-msg'), t('host.failed'), false);
      return;
    }
    try { localStorage.removeItem(NAME_KEY); } catch {}
    location.replace('/admin/');
  }

  async function start() {
    const { data } = await supabase.auth.getSession();
    if (!data.session) {
      ($('name') as HTMLInputElement).value = remembered();
      return;
    }
    // Already a host? Go straight to admin.
    const { data: hostId } = await supabase.rpc('current_host_id');
    if (hostId) { location.replace('/admin/'); return; }
    const pending = remembered();
    if (pending) { finish(pending); return; }
    // Signed in (e.g. as a guest) but no name yet: only ask for the name
    $('email-wrap').hidden = true;
    ($('start-btn') as HTMLButtonElement).textContent = t('host.create');
    ($('start-form') as HTMLFormElement).dataset.signedIn = '1';
  }

  supabase.auth.onAuthStateChange((event) => {
    if (event === 'SIGNED_IN' && remembered()) finish(remembered());
  });

  async function sendCode() {
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { emailRedirectTo: location.origin + '/become-host/', shouldCreateUser: true, data: { lang: lang() } },
    });
    if (error?.status === 429) { show($('start-msg'), t('login.tooManyMails'), false); return false; }
    if (error) { show($('start-msg'), t('login.sendFailed'), false); return false; }
    return true;
  }

  $('start-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    $('start-msg').hidden = true;
    const name = ($('name') as HTMLInputElement).value.trim();
    if (!name) { show($('start-msg'), t('host.nameMissing'), false); return; }
    remember(name);
    if (($('start-form') as HTMLFormElement).dataset.signedIn) { finish(name); return; }

    email = ($('email') as HTMLInputElement).value.trim().toLowerCase();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { show($('start-msg'), t('common.invalidEmail'), false); return; }

    const btn = $('start-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = t('common.sending');
    const ok = await sendCode();
    btn.disabled = false;
    btn.textContent = t('login.sendCode');
    if (!ok) return;

    $('sent-to').textContent = email;
    $('start-form').hidden = true;
    $('otp-form').hidden = false;
    ($('otp') as HTMLInputElement).focus();
  });

  ($('otp') as HTMLInputElement).addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    t.value = t.value.replace(/\D/g, '');
  });

  $('otp-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('otp-msg');
    const token = ($('otp') as HTMLInputElement).value.replace(/\D/g, '');
    if (token.length < 6) { show(msg, t('login.wholeCode'), false); return; }
    const btn = $('otp-btn') as HTMLButtonElement;
    btn.disabled = true;
    const { error } = await supabase.auth.verifyOtp({ email, token, type: 'email' });
    btn.disabled = false;
    if (error) {
      show(msg, error.status === 429 ? t('login.tooManyTries') : t('login.wrongCode'), false);
      return;
    }
    // onAuthStateChange handles the rest
    finish(remembered());
  });

  $('back').addEventListener('click', () => {
    $('otp-form').hidden = true;
    $('start-form').hidden = false;
  });

  start();
</script>

<style>
  .host-page { padding-top: 2.5rem; padding-bottom: 3rem; }
  .title {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.6rem, 11vw, 4.5rem);
    line-height: 0.95;
    margin: 0.4rem 0 1rem;
    max-width: 14ch;
  }
  .lead { max-width: 32rem; margin-bottom: 1.75rem; }
  .login-form { display: grid; gap: 0.6rem; max-width: 26rem; }
  .login-form .btn { justify-self: start; margin-top: 0.3rem; }
  #email-wrap { display: grid; gap: 0.6rem; }
  #email-wrap label { margin: 0; }
  .login-form input.otp {
    font-family: var(--display);
    font-size: 2rem;
    letter-spacing: 0.35em;
    padding: 0.4rem 0.8rem;
    max-width: 16rem;
    width: 100%;
    color: var(--paper);
    background: transparent;
    border: 1px solid var(--lodge-3);
    border-radius: var(--radius);
  }
  .link-btn {
    font: inherit; color: var(--amber); background: none; border: 0; padding: 0; cursor: pointer;
    text-decoration: underline; text-underline-offset: 0.22em; text-decoration-thickness: 1px;
  }
  .small { margin-top: 2rem; font-size: 0.9rem; }
</style>
